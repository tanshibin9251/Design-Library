ar(--c-surface);border-radius:16px;padding:10px;display:grid;grid-template-columns:1.2fr 1fr 1fr .8fr auto;gap:8px;box-shadow:0 20px 40px -20px color-mix(in srgb,#000 50%,transparent);max-width:880px}\n.hs-search label{display:block;padding:6px 12px;border-right:1px solid var(--c-border)}.hs-search label:nth-last-child(2){border:0}\n.hs-search small{display:block;font:700 11px var(--f-body);letter-spacing:.1em;text-transform:uppercase;opacity:.6}\n.hs-search input,.hs-search select{border:0;background:transparent;font:600 15px var(--f-body);color:var(--c-text);width:100%;padding:2px 0}\n.hs-sec{padding:var(--pad) 20px}.hs-sec>.in{max-width:var(--w);margin:auto}\n.hs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px 20px}\n.hs-card{text-decoration:none;display:block}\n.hs-card .ph{aspect-ratio:4/3;border-radius:16px}\n.hs-card .t{display:flex;justify-content:space-between;gap:10px;margin-top:10px}.hs-card h3{font:600 20px var(--f-head)}\n.hs-card .r{font:700 14px var(--f-body);white-space:nowrap}.hs-card .r::before{content:\"★ \";color:var(--c-accent)}\n.hs-card small{opacity:.7;display:block}.hs-card .p{margin-top:4px;font:700 17px var(--f-body)}.hs-card .p span{font-weight:500;opacity:.7}\n.hs-am{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.hs-am span{font:600 12.5px var(--f-body);background:color-mix(in srgb,var(--c-primary) 10%,var(--c-surface));border-radius:99px;padding:.2em .7em}\n.hs-g{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:200px 200px;gap:8px;border-radius:18px;overflow:hidden}\n.hs-g .ph{border-radius:0;height:100%}.hs-g .ph:first-child{grid-row:span 2}\n.hs-book{position:sticky;top:90px;border:1px solid var(--c-border);border-radius:18px;padding:22px;box-shadow:0 24px 50px -30px color-mix(in srgb,var(--c-text) 60%,transparent);background:var(--c-surface)}\n.hs-book .pr{font:700 26px var(--f-head)}.hs-book .pr small{font:500 14px var(--f-body);opacity:.7}\n.hs-cal{display:grid;grid-template-columns:repeat(7,1fr