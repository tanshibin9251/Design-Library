essed=\"false\" data-i=\"16\" data-k=\"shop\" aria-label=\"Charms\">C5</button><button type=\"button\" aria-pressed=\"false\" data-i=\"17\" data-k=\"shop\" aria-label=\"Souvenirs\">C6</button></div><div class=\"mt-leg\"><span><i style=\"background:var(--c-accent)\"></i>Food</span><span><i style=\"background:var(--c-secondary)\"></i>Games</span><span><i style=\"background:var(--c-primary)\"></i>Shops</span></div></div><div class=\"mt-card\" id=\"mt-card\" aria-live=\"polite\"></div></div></section><script>(function(){var D=[{\"c\": \"A1\", \"k\": \"food\", \"n\": \"Yakisoba\", \"d\": \"Noodles on a griddle, red ginger, aonori. RM 8\"}, {\"c\": \"A2\", \"k\": \"food\", \"n\": \"Takoyaki\", \"d\": \"Eight pieces, bonito flakes. RM 10\"}, {\"c\": \"A3\", \"k\": \"food\", \"n\": \"Kakigori\", \"d\": \"Shaved ice, three syrups. RM 6\"}, {\"c\": \"A4\", \"k\": \"food\", \"n\": \"Yakitori\", \"d\": \"Charcoal chicken skewers. RM 5 each\"}, {\"c\": \"A5\", \"k\": \"food\", \"n\": \"Taiyaki\", \"d\": \"Red bean or custard. RM 5\"}, {\"c\": \"A6\", \"k\": \"food\", \"n\": \"Ramune\", \"d\": \"Marble soda, ice bucket. RM 4\"}, {\"c\": \"B1\", \"k\": \"game\", \"n\": \"Goldfish scooping\", \"d\": \"Three paper scoops, one bowl of luck. RM 5\"}, {\"c\": \"B2\", \"k\": \"game\", \"n\": \"Yo-yo fishing\", \"d\": \"Hook the water balloon. RM 3\"}, {\"c\": \"B3\", \"k\": \"game\", \"n\": \"Shooting gallery\", \"d\": \"Cork rifles, five shots. RM 5\"}, {\"c\": \"B4\", \"k\": \"game\", \"n\": \"Ring toss\", \"d\": \"Three rings, any prize. RM 3\"}, {\"c\": \"B5\", \"k\": \"game\", \"n\": \"Super ball\", \"d\": \"Scoop bouncy balls. RM 3\"}, {\"c\": \"B6\", \"k\": \"game\", \"n\": \"Lucky draw\", \"d\": \"Pull a string. RM 2\"}, {\"c\": \"C1\", \"k\": \"shop\", \"n\": \"Yukata rental\", \"d\": \"Choose one, with sash and sandals. RM 40\"}, {\"c\": \"C2\", \"k\": \"shop\", \"n\": \"Hand fans\", \"d\": \"Painted by local students. RM 8\"}, {\"c\": \"C3\", \"k\": \"shop\", \"n\": \"Masks\", \"d\": \"Fox, tengu and cat. RM 10\"}, {\"c\": \"C4\", \"k\": \"shop\", \"n\": \"Glow sticks\", \"d\": \"For the fireworks. RM 4\"}, {\"c\": \"C5\", \"k\": \"shop\", \"n\": \"Charms\", \"d\": \"Omamori for the year. RM 12\"}, {\"c\": \"C6\", \"k\": \"shop\", \"n\": \"Souvenirs\", \"d\": \"Tenugui and festival tees. RM 30\"}];var g=document.querySelector(\".mt-grid\");if(!g)return;var bs=g.querySelectorAll(\"button\"),o=document.getElementById(\"mt-card\"),K={food:\"Food\",game:\"Games\",shop:\"Shops\"};function p(i){bs.forEach(function(b,j){b.setAttribute(\"aria-pressed\",j===i)});var s=D[i];o.innerHTML=\"<div class=id>\"+s.c+\"</div><h3>\"+s.n+\"</h3><p>\"+s.d+\"</p><p style=\\\"margin-top:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:12px\\\">\"+K[s.k]+\"</p>\"}bs.forEach(function(b,i){b.onclick=function(){p(i)}});p(0)})();</script>","fireworks":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Fireworks</b></div><h1 style=\"font-family:var(--f-head)\">花火</h1></div></section><section class=\"mt-sec\" style=\"padding-top:20px\"><div class=\"mt-two\"><div class=\"mt-ph\" style=\"min-height:360px\" data-l=\"Fireworks over the river (缺图)\"></div><div><h2>二十分間の夜空。</h2><p>1,200 shells fired from the river barge, in five parts: opening, flowers, willow, finale, and a single quiet gold at the end. Best viewing from the east lawn, with the sound arriving about three seconds late.</p><p style=\"margin-top:20px\">Reserved seats on the lawn are RM 30; the riverbank is free but fills by 19:00.</p></div></div></section>","tickets":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Tickets</b></div><h1 style=\"font-family:var(--f-head)\">切符</h1><p class=\"lead\">Entry is free. Seats and token sets are limited.</p></div></section><section class=\"mt-sec\" style=\"padding-top:20px\"><div class=\"mt-tks\"><div class=\"mt-tk\"><span class=\"n\">壱</span><h3>Entry</h3><span class=\"pr\">Free</span><p>Walk-in on the night.</p><div class=\"st\"><span>Gate A–C</span><span>No.001</span></div></div><div class=\"mt-tk hl\"><span class=\"n\">弐</span><h3>Fireworks seat</h3><span class=\"pr\">RM 30</span><p>Reserved spot on the east lawn.</p><div class=\"st\"><span>East lawn</span><span>No.002</span></div></div><div class=\"mt-tk\"><span class=\"n\">参</span><h3>Family pack</h3><span class=\"pr\">RM 100</span><p>Four seats, tokens and fans.</p><div class=\"st\"><span>Up to 4</span><span>No.003</span></div></div></div></section>","access":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Access</b></div><h1 style=\"font-family:var(--f-head)\">道順</h1><p class=\"lead\">No parking on site. Walk, cycle or take the shuttle.</p></div></section><section class=\"mt-sec\" style=\"padding-top:20px\"><div class=\"mt-two\"><div class=\"mt-ph\" style=\"min-height:300px\" data-l=\"Map (缺图)\"></div><div><h2>行き方</h2><p><b>Train</b> — 8 minutes' walk from Contoh Station, east exit.</p><p style=\"margin-top:12px\"><b>Shuttle</b> — every 15 minutes from the station, 16:30–22:30, free.</p><p style=\"margin-top:12px\"><b>Cycle</b> — free bicycle parking at Gate C.</p></div></div></section>","volunteer":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Volunteer</b></div><h1 style=\"font-family:var(--f-head)\">ボランティア</h1><p class=\"lead\">The festival is run by neighbours. Help for an hour or for the week.</p></div></section><section class=\"mt-sec\" style=\"padding-top:20px\"><div class=\"mt-two\" style=\"align-items:start\"><form class=\"form\" style=\"grid-template-columns:1fr 1fr\" onsubmit=\"return false\"><div class=\"fld\"><span>Name</span><input></div><div class=\"fld\"><span>Email</span><input type=\"email\"></div><div class=\"fld span2\"><span>I can help with</span><select><option>Stalls</option><option>Crowd guiding</option><option>Clean-up</option><option>Kids' corner</option></select></div><div class=\"fld span2\"><button type=\"button\" class=\"mt-btn\">Sign me up</button></div></form><div class=\"mt-card\" style=\"position:static\"><div class=\"id\">手</div><h3>Why volunteer</h3><p>Free festival T-shirt, a meal voucher, and the best view of the fireworks from the barge landing.</p></div></div></section>","news":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>News</b></div><h1 style=\"font-family:var(--f-head)\">お知らせ</h1></div></section><section class=\"mt-sec\" style=\"padding-top:20px\"><a class=\"mt-news\" href=\"#\"><time>2026.07.20</time><h3>Fireworks seats on sale</h3><span class=\"t\">Tickets</span></a><a class=\"mt-news\" href=\"#\"><time>2026.07.02</time><h3>Call for stall applications closes July 15</h3><span class=\"t\">Stalls</span></a><a class=\"mt-news\" href=\"#\"><time>2026.06.10</time><h3>Taiko rehearsals open to the public</h3><span class=\"t\">Event</span></a></section>","faq":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>FAQ</b></div><h1 style=\"font-family:var(--f-head)\">よくある質問</h1></div></section><section class=\"mt-sec\" style=\"padding-top:20px\"><div class=\"faq\"><details open><summary>What if it rains?</summary><p>The festival runs in light rain. If the fireworks are postponed, we announce a new date at 18:00.</p></details><details><summary>Can I bring a pet?</summary><p>Leashed dogs are welcome; please keep them away from the stalls.</p></details><details><summary>Is there a quiet space?</summary><p>Yes, behind the community hall, with seats and water.</p></details></div></section>","privacy":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Privacy policy</b></div><h1 style=\"\">Privacy policy</h1></div></section><section class=\"mt-sec\" style=\"padding-top:20px\"><div class=\"prose\"><p>Replace with your privacy policy: what you collect, why, how long you keep it and how customers can ask for deletion.</p></div></section>","404":"<section class=\"mt-sec\" style=\"text-align:center;padding-top:clamp(60px,10vw,140px)\"><span class=\"mt-k\">Error 404</span><h1 style=\"font:400 clamp(90px,18vw,240px)/1 var(--f-head);color:var(--c-accent);-webkit-text-stroke:3px var(--c-primary);paint-order:stroke fill\">404</h1><h2 style=\"margin:10px 0 28px;font:400 28px var(--f-head);letter-spacing:.1em\">花火は、もう終わりました。</h2><a class=\"mt-btn\" href=\"{{p:home}}\">TOPへ戻る</a></section>"}}