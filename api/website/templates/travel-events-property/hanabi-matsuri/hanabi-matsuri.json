0,1fr);gap:clamp(24px,5vw,70px);align-items:start}\n.mt-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;padding:14px;border:3px solid var(--c-primary);background:color-mix(in srgb,var(--c-secondary) 18%,var(--c-surface))}\n.mt-grid button{aspect-ratio:1;border:3px solid var(--c-primary);background:var(--c-surface);cursor:pointer;font:400 18px var(--f-head);color:var(--c-primary);min-height:44px;position:relative;transition:transform .12s}\n.mt-grid button:hover{transform:translateY(-3px)}\n.mt-grid button[data-k=food]{background:var(--c-accent);color:var(--on-accent)}\n.mt-grid button[data-k=game]{background:var(--c-secondary)}\n.mt-grid button[data-k=shop]{background:var(--c-primary);color:var(--on-primary)}\n.mt-grid button[aria-pressed=true]{outline:4px solid var(--c-accent);outline-offset:2px;transform:scale(1.06)}\n.mt-grid .path{grid-column:1/-1;height:34px;display:grid;place-items:center;font:700 11px var(--f-body);letter-spacing:.5em;color:var(--c-primary)}\n.mt-leg{display:flex;gap:16px;flex-wrap:wrap;margin-top:14px;font:700 12px var(--f-body);letter-spacing:.14em;text-transform:uppercase}\n.mt-leg i{display:inline-block;width:16px;height:16px;border:2px solid var(--c-primary);vertical-align:-3px;margin-right:6px}\n.mt-card{border:3px solid var(--c-primary);padding:30px;background:var(--c-surface);box-shadow:8px 8px 0 var(--c-accent);position:sticky;top:24px}\n.mt-card .id{font:400 70px/1 var(--f-head);color:var(--c-accent)}\n.mt-card h3{font:400 26px var(--f-head);letter-spacing:.08em;margin:6px 0 10px}\n@media(max-width:900px){.mt-map{grid-template-columns:1fr}.mt-card{position:static}}\n.mt-two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,80px);align-items:center}\n.mt-two h2{font:400 clamp(30px,4.4vw,var(--h2)) var(--f-head);letter-spacing:.06em;margin-bottom:14px}\n.mt-two p{line-height:1.95;max-width:46ch}\n@media(max-width:800px){.mt-two{grid-template-columns:1fr}}\n.mt-news{display:grid;grid-template-columns:130px 1fr