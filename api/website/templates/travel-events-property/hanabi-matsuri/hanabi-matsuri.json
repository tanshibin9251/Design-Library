secondary);--d:3.1s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + 46px);top:calc(52% + 0px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + 41px);top:calc(52% + 20px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + 29px);top:calc(52% + 36px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + 10px);top:calc(52% + 45px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + -10px);top:calc(52% + 45px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + -29px);top:calc(52% + 36px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + -41px);top:calc(52% + 20px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + -46px);top:calc(52% + 0px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + -41px);top:calc(52% + -20px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + -29px);top:calc(52% + -36px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + -10px);top:calc(52% + -45px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + 10px);top:calc(52% + -45px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + 29px);top:calc(52% + -36px);background:var(--c-accent);--d:0.6s\"></span><span class=\"mt-fw\" style=\"left:calc(90% + 41px);top:calc(52% + -20px);background:var(--c-accent);--d:0.6s\"></span><div class=\"mt-hero-in\"><span class=\"en\">Summer festival · one night · volunteer run</span><h1>花火祭</h1><p class=\"d\">8月15日 土曜日 · 17:00 〜 21:30</p>\n<div class=\"mt-cd\" id=\"mt-cd\" aria-label=\"Countdown to fireworks\"><div><b>00</b><span>Days</span></div><div><b>00</b><span>Hours</span></div><div><b>00</b><span>Min</span></div><div><b>00</b><span>Sec</span></div></div>\n<p style=\"display:flex;gap:16px;justify-content:center;flex-wrap:wrap\"><a class=\"mt-btn\" href=\"{{p:tickets}}\">切符 Get tickets</a><a class=\"mt-btn y\" href=\"{{p:program}}\">番組 Program</a></p></div></section>\n<section class=\"mt-sec\" style=\"padding-top:calc(var(--pad)*.4)\"><span class=\"mt-k\">01 · Tonight</span><div class=\"mt-prog\"><div><time>17:00</time><i></i><div><h3>Gates &amp; stalls open</h3><p>Yukata photo corner, goldfish scooping, the first yakisoba.</p></div></div><div><time>18:30</time><i></i><div><h3>Taiko &amp; bon odori</h3><p>Join the circle. Teachers wear red; follow them.</p></div></div><div><time>20:00</time><i></i><div><h3>Fireworks · 20 minutes</h3><p>Best seen from the east lawn; blankets welcome.</p></div></div></div></section>\n<section class=\"mt-sec\" style=\"padding-top:0\"><div class=\"mt-two\"><div class=\"mt-ph\" style=\"min-height:340px\" data-l=\"Stall street at dusk (缺图)\"></div><div><span class=\"mt-k\">02 · Stalls</span><h2>屋台 — eighteen stalls, one street.</h2><p>Food, games and little shops run by neighbourhood groups. Pick a stall on the map to see what it sells before you queue.</p><p style=\"margin-top:26px\"><a class=\"mt-btn\" href=\"{{p:stalls}}\">Open stall map</a></p></div></div></section>\n<section class=\"mt-sec\" style=\"padding-top:0\"><span class=\"mt-k\">03 · Tickets</span><div class=\"mt-tks\"><div class=\"mt-tk\"><span class=\"n\">壱</span><h3>Entry</h3><span class=\"pr\">Free</span><p>Walk-in. Stall tokens sold on site.</p><div class=\"st\"><span>Gate A–C</span><span>No.001</span></div></div><div class=\"mt-tk hl\"><span class=\"n\">弐</span><h3>Fireworks seat</h3><span class=\"pr\">RM 30</span><p>Reserved blanket spot on the east lawn.</p><div class=\"st\"><span>East lawn</span><span>No.002</span></div></div><div class=\"mt-tk\"><span class=\"n\">参</span><h3>Family pack</h3><span class=\"pr\">RM 100</span><p>Four seats, four token sets, four fans.</p><div class=\"st\"><span>Up to 4</span><span>No.003</span></div></div></div></section><script>(function(){var el=document.getElementById(\"mt-cd\");if(!el)return;var n=new Date(),t=new Date(n.getFullYear(),7,15,20,0,0);if(t<n)t=new Date(n.getFullYear()+1,7,15,20,0,0);function u(){var s=Math.max(0,Math.floor((t-new Date())/1000)),d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60),c=s%60,v=[d,h,m,c];el.querySelectorAll(\"b\").forEach(function(b,i){b.textContent=String(v[i]).padStart(2,\"0\")})}u();setInterval(u,1000)})();</script>","program":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Program</b></div><h1 style=\"font-family:var(--f-head)\">番組</h1><p class=\"lead\">Every start time on the night. Rain or shine; only lightning stops the show.</p></div></section><section class=\"mt-sec\" style=\"padding-top:20px\"><div class=\"mt-prog\"><div><time>17:00</time><i></i><div><h3>Gates &amp; stalls open</h3><p>Kids' goldfish scooping until 19:00.</p></div></div><div><time>17:30</time><i></i><div><h3>Yukata parade</h3><p>Prize for the best-dressed family.</p></div></div><div><time>18:30</time><i></i><div><h3>Taiko &amp; bon odori</h3><p>Open circle, all ages.</p></div></div><div><time>19:30</time><i></i><div><h3>Mikoshi procession</h3><p>The portable shrine passes along the main walk.</p></div></div><div><time>20:00</time><i></i><div><h3>Fireworks</h3><p>20 minutes, 1,200 shells.</p></div></div><div><time>21:30</time><i></i><div><h3>Gates close</h3><p>Please help clear the lawn.</p></div></div></div></section>","stalls":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Stall map</b></div><h1 style=\"font-family:var(--f-head)\">屋台マップ</h1><p class=\"lead\">Tap a stall to see what it sells.</p></div></section><section class=\"mt-sec\" style=\"padding-top:20px\"><div class=\"mt-map\"><div><di