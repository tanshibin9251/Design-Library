s}\n.mt-btn:hover{transform:translateY(3px);box-shadow:0 2px 0 var(--c-primary)}\n.mt-btn.y{background:var(--c-secondary);color:var(--c-primary)}\n.mt-ph{position:relative;min-height:220px;border:3px solid var(--c-primary);background:radial-gradient(circle,var(--c-primary) 0 2px,transparent 3px) 0 0/18px 18px,color-mix(in srgb,var(--c-secondary) 25%,var(--c-surface))}\n.mt-ph::after{content:attr(data-l);position:absolute;left:10px;bottom:8px;background:var(--c-surface);border:2px solid var(--c-primary);font:700 10px var(--f-body);letter-spacing:.14em;text-transform:uppercase;padding:3px 9px}\n\n/* hero: night sky + fireworks + countdown */\n.mt-hero{position:relative;background:var(--c-primary);color:var(--on-primary);overflow:hidden;padding:clamp(50px,7vw,110px) clamp(20px,5vw,80px) clamp(120px,12vw,180px);text-align:center;clip-path:polygon(0 0,100% 0,100% 100%,50% calc(100% - 40px),0 100%)}\n.mt-fw{position:absolute;width:6px;height:6px;border-radius:50%;opacity:0;animation:mtburst 4.2s ease-out infinite;animation-delay:var(--d)}\n@keyframes mtburst{0%{opacity:0;transform:scale(.2)}8%{opacity:1}60%{opacity:.9;transform:scale(1)}100%{opacity:0;transform:scale(1.25)}}\n.mt-hero-in{position:relative;z-index:1}\n.mt-hero .en{font:700 13px var(--f-body);letter-spacing:.36em;text-transform:uppercase;color:var(--c-secondary)}\n.mt-hero h1{font:400 clamp(70px,16vw,230px)/1 var(--f-head);color:var(--c-secondary);margin:12px 0 10px;-webkit-text-stroke:3px var(--c-accent);paint-order:stroke fill;text-shadow:8px 8px 0 var(--c-accent);letter-spacing:.06em}\n.mt-hero p.d{font:700 clamp(16px,2vw,24px) var(--f-body);letter-spacing:.14em}\n.mt-cd{display:inline-grid;grid-template-columns:repeat(4,auto);gap:clamp(10px,2vw,26px);margin:30px 0 34px;padding:16px clamp(16px,3vw,36px);border:3px solid var(--c-secondary);border-radius:18px;background:color-mix(in srgb,var(--c-primary) 85%,#000)}\n.mt-cd div{text-align:center}\n.mt-cd b{display:block;font:400 clamp(34px,5vw,64px)/1 var(-