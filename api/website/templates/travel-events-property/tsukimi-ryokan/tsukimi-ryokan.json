ding-top:18px;border-top:1px solid var(--c-border);font:300 12px var(--f-body);letter-spacing:.2em;color:var(--c-secondary);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}\n@media(max-width:800px){.ts-foot-top{grid-template-columns:1fr}.ts-foot .cols{grid-template-columns:1fr 1fr}}\n.faq summary{letter-spacing:.1em}\nhtml,body{overflow-x:clip}img,video,svg{max-width:100%}\n@media(max-width:700px){.ts-sec{padding-left:18px;padding-right:18px}.ts-hero{padding-left:18px;padding-right:18px}}\n@media(prefers-reduced-motion:reduce){.ts-room,.ts-room .d,.ts-room .pr{transition:none}}\n</style>\n<header class=\"ts-head\">\n<a class=\"ts-logo\" href=\"{{p:home}}\"><i></i><span>月見荘<small>TSUKIMI INN</small></span></a>\n<ul class=\"ts-nav\"><li><a href=\"{{p:rooms}}\"><b>一</b>Rooms</a></li><li><a href=\"{{p:kaiseki}}\"><b>二</b>Dinner</a></li><li><a href=\"{{p:onsen}}\"><b>三</b>Onsen</a></li><li><a href=\"{{p:seasons}}\"><b>四</b>Seasons</a></li><li class=\"more\"><a href=\"#\" tabindex=\"0\"><b>他</b>More</a><div class=\"dd\"><div><h4>Stay</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:rooms}}\">Rooms</a><a href=\"{{p:room}}\">Room: Tsuki</a><a href=\"{{p:plans}}\">Plans & rates</a><a href=\"{{p:reserve}}\">Reserve</a></div><div><h4>Experience</h4><a href=\"{{p:kaiseki}}\">Kaiseki dinner</a><a href=\"{{p:onsen}}\">Onsen</a><a href=\"{{p:seasons}}\">Four seasons</a><a href=\"{{p:gallery}}\">Gallery</a></div><div><h4>Visit</h4><a href=\"{{p:access}}\">Access</a><a href=\"{{p:faq}}\">FAQ</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li></ul>\n<details class=\"ts-m\"><summary>MENU</summary><nav><a href=\"{{p:home}}\">Home</a><a href=\"{{p:rooms}}\">Rooms</a><a href=\"{{p:room}}\">Room: Tsuki</a><a href=\"{{p:plans}}\">Plans & rates</a><a href=\"{{p:reserve}}\">Reserve</a><a href=\"{{p:kaiseki}}\">Kaiseki dinner</a><a href=\"{{p:onsen}}\">Onsen</a><a href=\"{{p:seasons}}\">Four seasons</a><a href=\"{{p:gallery}}\">Gallery</a><a href=\"{{p:access}}\">Access</a><a href=\"{{p:faq}}\">FAQ</a><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></nav></details>\n<a class=\"ts-key\" href=\"{{p:reserve}}\">予約</a>\n</header>","foot":"<footer class=\"ts-foot\"><div class=\"ts-foot-top\"><div><div class=\"big\">月見荘</div><p style=\"margin-top:14px;font:300 14px/1.9 var(--f-body);color:var(--c-secondary);max-width:34ch\">Nine rooms, one hot spring and a table that is set when the moon is up. Template demo content.</p></div><div class=\"cols\"><div><h4>Stay</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:rooms}}\">Rooms</a></li><li><a href=\"{{p:room}}\">Room: Tsuki</a></li><li><a href=\"{{p:plans}}\">Plans & rates</a></li><li><a href=\"{{p:reserve}}\">Reserve</a></li></ul></div><div><h4>Experience</h4><ul><li><a href=\"{{p:kaiseki}}\">Kaiseki dinner</a></li><li><a href=\"{{p:onsen}}\">Onsen</a></li><li><a href=\"{{p:seasons}}\">Four seasons</a></li><li><a href=\"{{p:gallery}}\">Gallery</a></li></ul></div><div><h4>Visit</h4><ul><li><a href=\"{{p:access}}\">Access</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div></div><div class=\"copy\"><span>© 2026 TSUKIMI INN</span><span>CHECK-IN 15:00 · CHECK-OUT 11:00</span></div></footer>","pages":{"home":"<section class=\"ts-hero\"><div class=\"ts-lattice\"></div><div class=\"ts-moon\" id=\"ts-moon\" style=\"color:var(--c-primary)\"></div><div class=\"ts-hero-in\"><span class=\"en\">Onsen inn · nine rooms · open for the moon</span><h1>月を、<br>待つ宿。</h1><p class=\"lead\">A small inn in the hills with one hot spring and a table set only after dark. We keep the lights low so you can see the moon.</p><p style=\"margin-top:30px;display:flex;gap:14px;flex-wrap:wrap\"><a class=\"ts-btn f\" href=\"{{p:reserve}}\">Reserve a night</a><a class=\"ts-btn\" href=\"{{p:rooms}}\">See the rooms</a></p></div><div class=\"ts-tonight\">Tonight<b id=\"ts-ph\">—</b></div></section>\n<section class=\"ts-sec\"><div class=\"ts-k\"><b>一</b>Rooms</div><div class=\"ts-rooms\"><a class=\"ts-room on\" href=\"{{p:room}}\"><span class=\"n\">壱</span><div><h3>Tsuki · 月</h3><p class=\"d\">Corner suite, 62 m², private cypress bath and a window cut to frame the moon.</p><span class=\"pr\">RM 1,480 / night</span></div></a><a class=\"ts-room\" href=\"{{p:room}}\"><span class=\"n\">弐</span><div><h3>Kaze · 風</h3><p class=\"d\">Garden room, 48 m², tatami and engawa facing the bamboo.</p><span class=\"pr\">RM 1,120 / night</span></div></a><a class=\"ts-room\" href=\"{{p:room}}\"><span class=\"n\">参</span><div><h3>Yuki · 雪</h3><p class=\"d\">Quiet twin, 38 m², deep soaking tub and low futon beds.</p><span class=\"pr\">RM 880 / night</span></div></a><a class=\"ts-room\" href=\"{{p:room}}\"><span class=\"n\">肆</span><div><h3>Hana · 花</h3><p class=\"d\">Compact double, 30 m², best for one-night stays.</p><span class=\"pr\">RM 680 / night</span></div></a></div></section>\n<section class=\"ts-sec\" style=\"padding-top:0\"><div class=\"ts-two\"><div class=\"ts-ph\" style=\"min-height:420px\" data-l=\"Kaiseki tray, candle light (缺图)\"></div><div><div class=\"ts-k\"><b>二</b>Dinner</div><h2>夕餉 — a table set after dark.</h2><p>Eight small courses cooked on the day from what the valley gives: river fish, wild greens, rice from the terraces below. Served in your room, never rushed.</p><p style=\"margin-top:28px\"><a class=\"ts-btn\" href=\"{{p:kaiseki}}\">The courses</a></p></div></div></section>\n<section class=\"ts-sec\" style=\"padding-top:0\"><div class=\"ts-k\"><b>四</b>Seasons</div><div class=\"ts-seasons\"><div><span class=\"k\">春</span><h3>Haru</h3><p>Plum and cherry along the stream. Mist at dawn.</p></div><div><span class=\"k\">夏</span><h3>Natsu</h3><p>Fireflies in June. Cool nights, open screens.</p></div><div><span class=\"k\">秋</span><h3>Aki</h3><p>Our moon-viewing season. Maple, sake and clear skies.</p></div><div><span class=\"k\">冬</span><h3>Fuyu</h3><p>Snow on the bath's roof. Quiet, hot, long evenings.</p></div></div></section>\n<section class=\"ts-sec\" style=\"padding-top:0;text-align:center\"><div class=\"ts-k\" style=\"justify-content:center\">予約</div><h2 style=\"font-weight:400;letter-spacing:.16em;margin-bottom:26px\">Nine rooms. Most nights, two are free.</h2><a class=\"ts-btn f\" href=\"{{p:reserve}}\">Check availability</a></section><script>(function(){var el=document.getElementById(\"ts-moon\"),nm=document.getElementById(\"ts-ph\");if(!el)return;var syn=29.530588853,ref=Date.UTC(2000,0,6,18,14),p=(((Date.now()-ref)/864e5)%syn+syn)%syn/syn,a=2*Math.PI*p,rx=Math.abs(50*Math.cos(a)).toFixed(1),w=p<.5,outer=w?1:0,inner=w?(p<.25?0:1):(p<.75?0:1);var d=\"M50 0A50 50 0 0 \"+outer+\" 50 100A\"+rx+\" 50 0 0 \"+inner+\" 50 0Z\";el.innerHTML='<svg viewBox=\"0 0 100 100\" role=\"img\" aria-label=\"Tonight\\'s moon\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"currentColor\" opacity=\".14\"/><path d=\"'+d+'\" fill=\"currentColor\"/></svg>';var N=[[\"新月\",\"New moon\"],[\"三日月\",\"Crescent\"],[\"上弦の月\",\"First quarter\"],[\"十三夜\",\"Waxing gibbous\"],[\"満月\",\"Full moon\"],[\"十六夜\",\"Waning gibbous\"],[\"下弦の月\",\"Last quarter\"],[\"有明月\",\"Waning crescent\"]];var i=Math.round(p*8)%8;if(nm)nm.textContent=N[i][0]+\" · \"+N[i][1]})();</script><script>(function(){var r=document.querySelectorAll(\".ts-room\");function on(x){r.forEach(function(y){y.classList.toggle(\"on\",y===x)})}r.forEach(function(x){x.addEventListener(\"mouseenter\",function(){on(x)});x.addEventListener(\"focus\",function(){on(x)});x.addEventListener(\"touchstart\",function(){on(x)},{passive:true})})})();</script>","rooms":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Rooms</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">客室</h1><p class=lead>Nine rooms in four types. Every one has tatami, a deep tub and a view of the ridge.</p></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><div class=\"ts-rooms\"><a class=\"ts-room on\" href=\"{{p:room}}\"><span class=\"n\">壱</span><div><h3>Tsuki · 月</h3><p class=\"d\">Corner suite, 62 m², private cypress bath and a window cut to frame the moon.</p><span class=\"pr\">RM 1,480 / night</span></div></a><a class=\"ts-room\" href=\"{{p:room}}\"><span class=\"n\">弐</span><div><h3>Kaze · 風</h3><p class=\"d\">Garden room, 48 m², tatami and engawa facing the bamboo.</p><span class=\"pr\">RM 1,120 / night</span></div></a><a class=\"ts-room\" href=\"{{p:room}}\"><span class=\"n\">参</span><div><h3>Yuki · 雪</h3><p class=\"d\">Quiet twin, 38 m², deep soaking tub and low futon beds.</p><span class=\"pr\">RM 880 / night</span></div></a><a class=\"ts-room\" href=\"{{p:room}}\"><span class=\"n\">肆</span><div><h3>Hana · 花</h3><p class=\"d\">Compact double, 30 m², best for one-night stays.</p><span class=\"pr\">RM 680 / night</span></div></a></div><table class=\"ts-tbl\" style=\"margin-top:56px\"><tr><th>Room</th><th>Size</th><th>Sleeps</th><th>Rate (per night, 2 guests, with dinner)</th></tr><tr><td>Tsuki · 月</td><td>62 m²</td><td>2–3</td><td>RM 1,480</td></tr><tr><td>Kaze · 風</td><td>48 m²</td><td>2–4</td><td>RM 1,120</td></tr><tr><td>Yuki · 雪</td><td>38 m²</td><td>2</td><td>RM 880</td></tr><tr><td>Hana · 花</td><td>30 m²</td><td>2</td><td>RM 680</td></tr></table></section><script>(function(){var r=document.querySelectorAll(\".ts-room\");function on(x){r.forEach(function(y){y.classList.toggle(\"on\",y===x)})}r.forEach(function(x){x.addEventListener(\"mouseenter\",function(){on(x)});x.addEventListener(\"focus\",function(){on(x)});x.addEventListener(\"touchstart\",function(){on(x)},{passive:true})})})();</script>","room":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Room: Tsuki</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">月 — Tsuki</h1></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><div class=\"ts-two\"><div class=\"ts-ph\" style=\"min-height:520px\" data-l=\"Tsuki, moon window (缺图)\"></div><div><div class=\"ts-k\">壱 · 62 m²</div><h2>The room that was built around a window.</h2><p>A corner suite with one low window placed so the full moon crosses it at about nine in the evening in autumn. Cypress bath on the engawa, two futons, a writing desk.</p><dl class=\"ts-kv\" style=\"margin:30px 0\"><dt>Bed</dt><dd>Two futons, extra on request</dd><dt>Bath</dt><dd>Private hinoki, spring-fed</dd><dt>View</dt><dd>East ridge, garden</dd><dt>Rate</dt><dd>RM 1,480 per night, two guests, with dinner &amp; breakfast</dd></dl><a class=\"ts-btn f\" href=\"{{p:reserve}}\">Reserve Tsuki</a></div></div></section>","plans":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Plans & rates</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">宿泊プラン</h1><p class=lead>Three ways to stay. Rates are per night for two guests and include dinner and breakfast.</p></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><div class=\"ts-plans\"><div><span class=\"jp\">一</span><h3>One night</h3><span class=\"pr\">from RM 680</span><ul><li>Kaiseki dinner, 8 courses</li><li>Breakfast at 8:00</li><li>Onsen anytime</li></ul></div><div><span class=\"jp\">二</span><h3>Two nights, slow</h3><span class=\"pr\">from RM 1,980</span><ul><li>Dinner both nights, different menu</li><li>Late check-out 13:00</li><li>One tea ceremony</li></ul></div><div><span class=\"jp\">月</span><h3>Moon-viewing</h3><span class=\"pr\">from RM 1,680</span><ul><li>Full-moon weekends only</li><li>Sake pairing with dinner</li><li>Lights off on the terrace</li></ul></div></div></section>","reserve":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Reserve</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">ご予約</h1></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><div class=\"ts-two\" style=\"align-items:start\"><form class=\"form\" style=\"grid-template-columns:1fr 1fr\" onsubmit=\"return false\"><div class=\"fld\"><span>Check-in</span><input type=\"date\"></div><div class=\"fld\"><span>Nights</span><select id=\"ts-n\"><option>1</option><option>2</option><option>3</option></select></div><div class=\"fld span2\"><span>Room</span><select id=\"ts-r\"><option value=\"1480\">Tsuki · 月 — RM 1,480</option><option value=\"1120\">Kaze · 風 — RM 1,120</option><option value=\"880\">Yuki · 雪 — RM 880</option><option value=\"680\">Hana · 花 — RM 680</option></select></div><div class=\"fld\"><span>Guests</span><select id=\"ts-g\"><option value=\"0\">2 adults</option><option value=\"180\">3 adults</option><option value=\"360\">4 adults</option></select></div><div class=\"fld\"><span>Name</span><input></div><div class=\"fld span2\"><span>Notes (allergies, anniversaries)</span><textarea rows=\"3\"></textarea></div><div class=\"fld span2\"><button type=\"button\" class=\"ts-btn f\">Send request</button></div></form>\n<div class=\"ts-est\" aria-live=\"polite\"><div><span>Room × nights</span><span id=\"ts-e1\">RM 1,480</span></div><div><span>Extra guest</span><span id=\"ts-e2\">RM 0</span></div><div><span>Service &amp; tax (16%)</span><span id=\"ts-e3\">RM 237</span></div><div class=\"t\"><span>Estimate</span><span id=\"ts-e4\">RM 1,717</span></div><p style=\"font:300 13px/1.8 var(--f-body);color:var(--c-secondary)\">Estimate only. We confirm availability within one working day.</p></div></div></section>\n<script>(function(){var n=document.getElementById(\"ts-n\");if(!n)return;var r=document.getElementById(\"ts-r\"),g=document.getElementById(\"ts-g\");function f(x){return\"RM \"+Math.round(x).toLocaleString(\"en-US\")}function u(){var a=+r.value*+n.value,b=+g.value*+n.value,t=(a+b)*.16;document.getElementById(\"ts-e1\").textContent=f(a);document.getElementById(\"ts-e2\").textContent=f(b);document.getElementById(\"ts-e3\").textContent=f(t);document.getElementById(\"ts-e4\").textContent=f(a+b+t)}[n,r,g].forEach(function(x){x.addEventListener(\"change\",u)});u()})();</script>","kaiseki":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Kaiseki dinner</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">会席</h1><p class=lead>Eight courses, one tray at a time. The menu follows the week, so this list is only a guide.</p></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><ol class=\"ts-course\"><li><span class=\"jp\">先付</span><div><h3>Sakizuke</h3><p>A single bite to open: sesame tofu with fresh wasabi.</p></div></li><li><span class=\"jp\">椀物</span><div><h3>Wanmono</h3><p>Clear soup with river fish and yuzu peel.</p></div></li><li><span class=\"jp\">造り</span><div><h3>Tsukuri</h3><p>Sashimi of the day, cut thick and eaten with local salt.</p></div></li><li><span class=\"jp\">焼物</span><div><h3>Yakimono</h3><p>Grilled trout, charcoal, one bay leaf.</p></div></li><li><span class=\"jp\">煮物</span><div><h3>Nimono</h3><p>Simmered vegetables from the hill garden.</p></div></li><li><span class=\"jp\">御飯</span><div><h3>Gohan</h3><p>Terrace rice cooked in an iron pot, with pickles and miso soup.</p></div></li><li><span class=\"jp\">水菓子</span><div><h3>Mizugashi</h3><p>Seasonal fruit and a small sweet; matcha or roasted tea.</p></div></li></ol></section>","onsen":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Onsen</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">温泉</h1><p class=lead>One spring, three baths, used by turns so you are rarely sharing.</p></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><div class=\"ts-two\"><div class=\"ts-ph\" style=\"min-height:360px\" data-l=\"Outdoor bath, steam (缺图)\"></div><div><h2>The water</h2><p>Soft, slightly alkaline spring at 42°C, drawn from beneath the ridge. Good for the skin; best taken slowly, twice a day.</p><table class=\"ts-tbl\" style=\"margin-top:26px\"><tr><th>Bath</th><th>Hours</th></tr><tr><td>Hinoki indoor</td><td>06:00 – 23:00</td></tr><tr><td>Rock outdoor</td><td>06:00 – 09:00 · 15:00 – 23:00</td></tr><tr><td>Private (book)</td><td>Hourly, 45 min</td></tr></table></div></div></section><section class=\"ts-sec\" style=\"padding-top:0\"><div class=\"ts-k\">Before you enter</div><ol class=\"ts-course\"><li><span class=\"jp\">一</span><div><h3>Wash first</h3><p>Sit and wash completely before entering the bath.</p></div></li><li><span class=\"jp\">二</span><div><h3>Towel stays out</h3><p>Keep the small towel on your head or on the rim, not in the water.</p></div></li><li><span class=\"jp\">三</span><div><h3>Tattoos welcome</h3><p>Private baths are available and tattoos are fine in all of them.</p></div></li></ol></section>","seasons":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Four seasons</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">四季</h1><p class=lead>The inn is a different place in each season. Choose the one you want to remember.</p></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><div class=\"ts-seasons\"><div><span class=\"k\">春</span><h3>Haru · Mar–May</h3><p>Plum then cherry along the stream. Bamboo shoots on the menu.</p></div><div><span class=\"k\">夏</span><h3>Natsu · Jun–Aug</h3><p>Fireflies, river fish, screens open.</p></div><div><span class=\"k\">秋</span><h3>Aki · Sep–Nov</h3><p>Moon-viewing nights, mushrooms, maples.</p></div><div><span class=\"k\">冬</span><h3>Fuyu · Dec–Feb</h3><p>Snow, hot pot, the bath at its best.</p></div></div></section>","gallery":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Gallery</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">写真</h1></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><div class=\"ts-gal\"><div class=\"ts-ph a\" data-l=\"Entrance (缺图)\"></div><div class=\"ts-ph b\" data-l=\"Futon (缺图)\"></div><div class=\"ts-ph c\" data-l=\"Lantern (缺图)\"></div><div class=\"ts-ph d\" data-l=\"Garden (缺图)\"></div><div class=\"ts-ph b\" data-l=\"Tray (缺图)\"></div><div class=\"ts-ph c\" data-l=\"Steam (缺图)\"></div><div class=\"ts-ph d\" data-l=\"Engawa (缺图)\"></div></div></section>","access":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Access</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">アクセス</h1></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><dl class=\"ts-kv\" style=\"max-width:820px\"><dt>Address</dt><dd>1 Jalan Contoh, Bukit Contoh (replace with your address)</dd><dt>By car</dt><dd>90 minutes from the city. Free parking for six cars.</dd><dt>By shuttle</dt><dd>From the town station at 14:30 and 16:00. Please book in advance.</dd><dt>Check-in</dt><dd>15:00 – 19:00. Dinner starts at 18:30.</dd><dt>Check-out</dt><dd>By 11:00</dd></dl></section>","faq":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>FAQ</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">よくある質問</h1></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><div class=\"faq\"><details open><summary>Do you serve vegetarian dinner?</summary><p>Yes. Tell us at booking; we change the menu rather than remove dishes.</p></details><details><summary>Are children welcome?</summary><p>From age 8, to keep the evenings quiet.</p></details><details><summary>Is there a phone signal?</summary><p>Weak in the valley. The inn has Wi-Fi in the lounge only.</p></details><details><summary>Cancellation?</summary><p>Free until 7 days before. After that, 50% of the first night.</p></details></div></section>","privacy":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Privacy policy</b></div><h1 style=\"letter-spacing:.14em;font-weight:400\">Privacy policy</h1></div></section><section class=\"ts-sec\" style=\"padding-top:20px\"><div class=\"prose\"><p>Replace with your privacy policy: what you collect, why, how long you keep it and how guests can ask for deletion.</p></div></section>","404":"<section class=\"ts-sec\" style=\"text-align:center;padding-top:clamp(80px,12vw,180px)\"><div class=\"ts-k\" style=\"justify-content:center\">Error 404</div><h1 style=\"font-size:clamp(70px,14vw,200px);font-weight:400;letter-spacing:.2em\">404</h1><h2 style=\"margin:10px 0 28px;font-weight:400;letter-spacing:.14em\">この道は、月に隠れました。</h2><a class=\"ts-btn f\" href=\"{{p:home}}\">Back to the inn</a></section>"}}