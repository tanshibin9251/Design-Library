n;background:var(--c-border)}.dl-visual:before,.dl-visual:after{display:none!important}.dl-visual>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1}.dl-visual>span{position:relative;z-index:1}.dl-photo-failed>img{display:none}.dl-photo-failed:after{display:grid!important;position:absolute;inset:0;place-items:center;content:'Image unavailable · 缺图';padding:16px;background:var(--c-surface);color:var(--c-text);font:500 14px var(--f-body)}\n.dl-stock-label{position:absolute;left:10px;bottom:10px;padding:4px 8px;max-width:calc(100% - 20px);background:var(--c-surface);color:var(--c-text);font-size:11px;line-height:1.5;border-radius:4px}.dl-credits{padding:20px 0;font-size:13px}.dl-credits summary{cursor:pointer;min-height:44px;display:flex;align-items:center}.dl-credits li{margin-block:8px}.dl-credits a{overflow-wrap:anywhere}\n:where(button,a,input,select,textarea,summary):focus-visible{outline:3px solid var(--c-accent);outline-offset:4px}\n@media(max-width:820px){.dl-mobile{display:block;position:relative}.dl-mobile summary{display:flex;align-items:center;justify-content:center;min-width:64px;min-height:44px;padding:8px 12px;border:1px solid var(--c-border);border-radius:var(--radius);cursor:pointer;list-style:none;font:600 14px var(--f-body)}.dl-mobile summary::-webkit-details-marker{display:none}.dl-mobile-links{position:fixed;top:74px;left:12px;right:12px;z-index:9999;max-height:75dvh;overflow:auto;background:var(--c-surface);color:var(--c-text);padding:16px 20px;border:1px solid var(--c-border);border-radius:var(--radius);box-shadow:0 16px 40px #0002}.dl-mobile-links a{display:flex;align-items:center;min-height:44px;text-decoration:none}.dl-mobile-links h4{font-size:12px;margin:18px 0 4px;color:var(--c-secondary)}.burger summary,.bmenu a{min-height:44px}.burger summary{display:flex;align-items:center}.burger:not([open])>.bmenu{display:none}.btn,.chip,.qty button{min-height:44px}.qty button{min-width:44px}[data-dl-footer] .cols{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}[data-dl-footer] .cols>div:first-child{grid-column:1/-1}.pdp,.split{min-width:0}.pdp>*{min-width:0}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n</style><a class=\"dl-skip\" href=\"#dl-content\">Skip to content</a><style>\n/* Nexus Summit — tokens only */\n.ex-head{position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--c-surface) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--c-border)}\n.ex-head .in{max-width:var(--w);margin:auto;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 20px}\n.ex-logo{font:900 22px var(--f-head);letter-spacing:-.02em;text-decoration:none;display:flex;align-items:center;gap:8px}\n.ex-logo i{width:14px;height:14px;border-radius:50%;background:linear-gradient(135deg,var(--c-accent),var(--c-primary))}\n.ex-head ul{display:flex;gap:22px;list-style:none;font:700 14px var(--f-body)}.ex-head ul a{text-decoration:none}.ex-head ul a:hover{color:var(--c-primary)}\n.ex-btn{background:linear-gradient(135deg,var(--c-primary),var(--c-accent));color:var(--on-primary);padding:.8em 1.5em;border-radius:99px;font:800 14px var(--f-body);text-decoration:none;display:inline-block}\n.ex-btn.o{background:none;color:var(--c-text);box-shadow:inset 0 0 0 2px var(--c-text)}\n.ex-hero{position:relative;overflow:hidden;text-align:center;padding:clamp(40px,7vw,100px) 20px;background:radial-gradient(circle at 20% 20%,color-mix(in srgb,var(--c-accent) 35%,transparent),transparent 45%),radial-gradient(circle at 85% 30%,color-mix(in srgb,var(--c-primary) 35%,transparent),transparent 50%),var(--c-surface)}\n.ex-hero small{font:800 13px var(--f-body);letter-spacing:.2em;text-transform:uppercase}\n.ex-hero h1{font:900 clamp(48px,11vw,var(--h1));line-height:.92;letter-spacing:-.04em;margin:14px 0;color:var(--c-text)}\n.ex-hero h1 span{background:linear-gradient(90deg,var(--c-primary),var(--c-accent));-webkit-background-clip:text;background-clip:text;color:transparent}\n.ex-hero p{font:500 19px/1.6 var(--f-body);max-width:50ch;margin:0 auto 24px}\n.ex-cd{display:inline-grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:8px 0 26px}\n.ex-cd div{background:var(--c-surface);border:1px solid var(--c-border);border-radius:16px;padding:14px 18px;min-width:76px;box-shadow:0 10px 26px -14px color-mix(in srgb,var(--c-text) 40%,transparent)}\n.ex-cd b{display:block;font:900 clamp(28px,5vw,44px)/1 var(--f-head);font-variant-numeric:tabular-nums}.ex-cd span{font:700 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;opacity:.6}\n.ex-meta{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;font:700 14px var(--f-body)}.ex-meta span{background:var(--c-surface);border:1px solid var(--c-border);padding:.4em 1em;border-radius:99px}\n.ex-sec{padding:var(--pad) 20px}.ex-sec>.in{max-width:var(--w);margin:auto}\n.ex-tabs{display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap;position:relative}\n.ex-tabs input{position:absolute;opacity:0}.ex-tabs label{padding:.6em 1.3em;border-radius:99px;border:2px solid var(--c-text);font:800 14px var(--f-body);cursor:pointer}\n.ex-tabs input:checked+label{background:var(--c-text);color:var(--c-surface)}.ex-tabs input:focus-visible+label{outline:3px solid var(--c-primary)}\n.ex-day{display:none}#ex-d1:checked~.d1,#ex-d2:checked~.d2{display:block}\n.ex-s{display:grid;grid-template-columns:110px 1fr auto;gap:16px;padding:16px 0;border-bottom:1px solid var(--c-border);align-items:center}\n.ex-s .t{font:900 18px var(--f-head);font-variant-numeric:tabular-nums}.ex-s h3{font:800 19px var(--f-head);margin-bottom:2px}.ex-s small{opacity:.7}\n.ex-s .tag{font:800 11px var(--f-body);letter-spacing:.08em;text-transform:uppercase;padding:.25em .8em;border-radius:99px;background:color-mix(in srgb,var(--c-accent) 22%,var(--c-surface))}\n.ex-sp{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.ex-sp .ph{aspect-ratio:1;border-radius:22px}.ex-sp h3{font:800 18px var(--f-head);margin-top:10px}.ex-sp small{opacity:.7;display:block}\n.ex-tk{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n.ex-tc{border:2px solid var(--c-text);border-radius:22px;padding:26px;background:var(--c-surface);position:relative}\n.ex-tc.hl{background:linear-gradient(160deg,var(--c-primary),var(--c-accent));color:var(--on-primary);border-color:transparent}.ex-tc.hl h3,.ex-tc.hl .am{color:inherit}\n.ex-tc h3{font:900 22px var(--f-head)}.ex-tc .am{font:900 40px var(--f-head);margin:8px 0}.ex-tc .left{font:800 12px var(--f-body);letter-spacing:.1em;text-transform:uppercase;opacity:.75}\n.ex-tc ul{list-style:none;padding:0;margin:14px 0 20px;display:grid;gap:6px;font:600 15px var(--f-body)}\n.ex-foot{background:var(--c-text);color:var(--c-surface)}\n@media(max-width:820px){.ex-head ul{display:none}.ex-sp{grid-template-columns:1fr 1fr}.ex-tk{grid-template-columns:1fr}.ex-s{grid-template-columns:78px 1fr}.ex-s .tag{grid-column:2;justify-self:start}}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}.ex-head .more{position:relative}.ex-head .dd{position:absolute;right:0;top:100%;display:none;grid-template-columns:repeat(3,minmax(130px,1fr));gap:20px 30px;padding:22px 26px;background:var(--c-surface);color:var(--c-text);border:1px solid var(--c-border);min-width:500px;z-index:60;text-align:left;font-family:var(--f-body);text-transform:none;letter-spacing:0;font-style:normal;border-radius:16px;}.ex-head .more:hover .dd,.ex-head .more:focus-within .dd{display:grid}.ex-head .dd h4{font:700 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;margin:0 0 8px;opacity:.55;color:inherit}.ex-head .dd a{display:block;padding:4px 0;font:500 14px var(--f-body);text-transform:none;letter-spacing:0;border:0;height:auto;opacity:.85;color:inherit;text-decoration:none;background:none;transform:none}.ex-head .dd a:hover{color:var(--c-accent);opacity:1}\nh1,h2,h3{color:var(--c-text)}.ex-tc.hl h3{color:var(--on-primary)}</style><header class=\"ex-head\"><div class=\"in\"><a class=\"ex-logo\" href=\"{{p:home}}\"><i></i>Nexus Summit</a><ul><li><a href=\"{{p:agenda}}\">Agenda</a></li><li><a href=\"{{p:speakers}}\">Speakers</a></li><li><a href=\"{{p:venue}}\">Venue</a></li><li><a href=\"{{p:sponsors}}\">Sponsors</a></li><li class=\"more\" style=\"position:relative\"><a href=\"#\" tabindex=\"0\">More ▾</a><div class=\"dd\"><div><h4>Event</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:agenda}}\">Agenda</a><a href=\"{{p:speakers}}\">Speakers</a><a href=\"{{p:tickets}}\">Tickets</a><a href=\"{{p:venue}}\">Venue & travel</a><a href=\"{{p:sponsors}}\">Sponsors</a><a href=\"{{p:faq}}\">FAQ</a><a href=\"{{p:contact}}\">Contact</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li></ul><a class=\"ex-btn\" href=\"{{p:tickets}}\">Get tickets</a><details class=\"dl-mobile\"><summary>Menu</summary><nav class=\"dl-mobile-links\" aria-label=\"Template pages\"><h4>Event</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:agenda}}\">Agenda</a><a href=\"{{p:speakers}}\">Speakers</a><a href=\"{{p:tickets}}\">Tickets</a><a href=\"{{p:venue}}\">Venue &amp; travel</a><a href=\"{{p:sponsors}}\">Sponsors</a><a href=\"{{p:faq}}\">FAQ</a><a href=\"{{p:contact}}\">Contact</a><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a></nav></details></div></header><script>/* Runs in previews AND exported files. No requests, credentials or submissions. */\n(function(){\n 'use strict';\n function start(){\n  var root=document.querySelector('[data-dl-template]');if(!root)return;\n  document.querySelectorAll('[data-dl-demo-form]').forEach(function(form,index){\n   if(form.dataset.dlBound)return;form.dataset.dlBound='1';\n   var note=document.createElement('p');note.className='dl-form-note';note.textContent='Interactive demo · Nothing is sent. Use sample details only. No account, booking or payment will be created.';form.prepend(note);\n   var result=document.createElement('p');result.className='dl-feedback';result.setAttribute('role','status');result.setAttribute('aria-live','polite');result.hidden=true;form.append(result);\n   form.querySelectorAll('input,textarea,select').forEach(function(input,i){\n    if(!input.name)input.name='demo-'+index+'-'+i;\n    var label=input.closest('label'),text=(label?label.textContent:input.placeholder||'').toLowerCase();\n    if(/name|email|message|date|time/.test(text)&&!/optional/.test(text))input.required=true;\n    if(input.type==='password')input.autocomplete='new-password';\n    if(/card number|cvc|expiry/.test(text)){input.disabled=true;input.placeholder='Disabled in demo';}\n   });\n   function submit(e){if(e)e.preventDefault();if(!form.reportValidity())return;result.hidden=false;result.textContent='Demo complete. Your entries passed the browser checks. Nothing was sent, charged, booked or stored.';}\n   form.addEventListener('submit',submit);\n   if(!form.querySelector('[type=\"submit\"],button:not([type])')){var buttons=form.querySelectorAll('button[type=\"button\"]');if(buttons.length===1)buttons[0].addEventListener('click',submit);}\n  });\n  document.querySelectorAll('.dl-visual img').forEach(function(img){img.addEventListener('error',function(){img.parentElement.classList.add('dl-photo-failed')});if(img.complete&&!img.naturalWidth)img.parentElement.classList.add('dl-photo-failed')});\n  document.querySelectorAll('.shoptop').forEach(function(top){\n   var grid=top.nextElementSibling;if(!grid||!grid.matches('.products'))return;\n   var cards=Array.from(grid.children),chips=Array.from(top.querySelectorAll('.chip')),sort=top.querySelector('select'),category='All';\n   var empty=document.createElement('p');empty.className='dl-filter-empty';empty.textContent='No sample items match this category. Choose All to see the collection.';empty.hidden=true;grid.after(empty);\n   function update(){var shown=0;cards.forEach(function(card){var tag=card.querySelector('small');card.hidden=category!=='All'&&(!tag||tag.textContent.trim()!==category);if(!card.hidden)shown++});empty.hidden=shown!==0;var count=top.querySelector('.sort span');if(count)count.textContent=shown+' sample items';}\n   chips.forEach(function(chip){chip.type='button';chip.setAttribute('aria-pressed',chip.classList.contains('on'));chip.addEventListener('click',function(){category=chip.textContent.trim();chips.forEach(function(c){c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',c===chip)});update()})});\n   if(sort){sort.setAttribute('aria-label','Sort sample items');Array.from(sort.options).forEach(function(o){if(/newest/i.test(o.textContent))o.textContent='Reverse featured'});sort.addEventListener('change',function(){var ordered=cards.slice();if(sort.selectedIndex===1||sort.selectedIndex===2){ordered.sort(function(a,b){function price(c){var p=c.querySelector('.price');return Number((p?p.textContent:'').replace(/[^0-9.]/g,''))||0}return price(a)-price(b)});if(sort.selectedIndex===2)ordered.reverse()}else if(sort.selectedIndex===3)ordered.reverse();ordered.forEach(function(card){grid.append(card)})})}\n  });\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.burger[open],.dl-mobile[open],.nav details[open]').forEach(function(menu){menu.open=false;var summary=menu.querySelector('summary');if(summary)summary.focus()})});\n  document.addEventListener('click',function(e){var a=e.target.closest('.dl-mobile a,.bmenu a');if(a){var menu=a.closest('details');if(menu)menu.open=false;}});\n  document.querySelectorAll('.more>a[href=\"#\"]').forEach(function(a){a.setAttribute('role','button');a.setAttribute('aria-expanded','false');function set(open){a.parentElement.classList.toggle('dl-menu-open',open);a.setAttribute('aria-expanded',open)}function toggle(e){e.preventDefault();set(a.getAttribute('aria-expanded')!=='true')}a.addEventListener('click',toggle);a.addEventListener('keydown',function(e){if(e.key===' ')toggle(e)});a.parentElement.addEventListener('mouseenter',function(){set(true)});a.parentElement.addEventListener('mouseleave',function(){if(!a.parentElement.contains(document.activeElement))set(false)})});\n  document.addEventListener('click',function(e){var a=e.target.closest('a[href=\"#\"]');if(!a||e.defaultPrevented||a.onclick||a.closest('.more'))return;e.preventDefault();var note=a.parentElement.querySelector(':scope>.dl-missing-link');if(!note){note=document.createElement('p');note.className='dl-feedback dl-missing-link';note.setAttribute('role','status');a.after(note)}note.textContent='Demonstration link. Add the real destination before launching this site.'});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.dl-menu-open').forEach(function(menu){menu.classList.remove('dl-menu-open');var a=menu.querySelector(':scope>a');if(a){a.setAttribute('aria-expanded','false');a.focus()}})});\n  document.querySelectorAll('.dl-skip').forEach(function(link){link.addEventListener('click',function(e){e.preventDefault();var target=document.querySelector('main.on [data-dl-content],main:not([data-page]) [data-dl-content]');if(target){target.focus();target.scrollIntoView({block:'start'})}})});\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>/* Sample commerce only: local item choices, quantities and consistent totals. */\n(function(){\n 'use strict';\n function start(){\n  var marker=document.querySelector('[data-dl-template]');if(!marker||marker.dataset.dlTemplate==='restaurant-warm')return;\n  var carts=Array.from(document.querySelectorAll('.cart')).filter(function(x){return x.querySelector('.crow')}),details=Array.from(document.querySelectorAll('.pdp,[data-dl-product]')).filter(function(x){return x.querySelector('.pinfo .price')}),checkouts=Array.from(document.querySelectorAll('aside.side-card')).filter(function(x){return x.querySelector('.kv')&&x.previousElementSibling&&x.previousElementSibling.querySelector('form')});\n  if(!carts.length&&!details.length&&!checkouts.length)return;\n  var currency='RM ',rows=[],key='dl-sample-cart:'+marker.dataset.dlTemplate;\n  function amount(text){return Number(String(text).replace(/[^0-9.]/g,''))||0}\n  function money(n){return currency+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function item(name,price,qty){return {name:String(name).slice(0,120),price:Math.max(0,Math.min(10000000,price)),qty:Math.max(1,Math.min(99,qty))}}\n  if(carts.length){rows=Array.from(carts[0].querySelectorAll('.crow')).map(function(row){var p=row.querySelector(':scope>b'),h=row.querySelector('h3'),q=row.querySelector('.qty span');if(p){currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' '}return item(h?h.textContent:'Sample item',amount(p?p.textContent:0),amount(q?q.textContent:1)||1)})}\n  else if(checkouts.length){rows=Array.from(checkouts[0].querySelectorAll('.kv li:not(.tot)')).filter(function(row){return row.querySelector('b')&&amount(row.querySelector('b').textContent)>0&&!/tax|shipping|delivery|subtotal|fee/i.test(row.textContent)}).map(function(row){var p=row.querySelector('b');currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' ';return item(row.querySelector('span').textContent,amount(p.textContent),1)})}\n  try{var saved=JSON.parse(localStorage.getItem(key));if(saved&&Array.isArray(saved.rows)&&saved.rows.length<=100){rows=saved.rows.filter(function(r){return typeof r.name==='string'&&Number.isFinite(r.price)&&r.price>=0&&Number.isInteger(r.qty)&&r.qty>0&&r.qty<=99}).map(function(r){return item(r.name,r.price,r.qty)});if(typeof saved.currency==='string'&&/^[A-Z$€£¥ ]{1,8}$/.test(saved.currency))currency=saved.currency;}}catch(e){}\n  function save(){try{localStorage.setItem(key,JSON.stringify({currency:currency,rows:rows}))}catch(e){}}\n  function totals(){var sub=rows.reduce(function(sum,r){return sum+r.price*r.qty},0);return {subtotal:sub,total:sub}}\n  function makeLine(label,value,total){var li=document.createElement('li');if(total)li.className='tot';var span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=value;li.append(span,b);return li}\n  function render(){\n   document.querySelectorAll('header a[href]').forEach(function(a){var match=a.textContent.trim().match(/^(Cart|Bag)\\s*\\(\\d+\\)$/i);if(match)a.textContent=match[1]+' ('+rows.reduce(function(sum,r){return sum+r.qty},0)+')'});\n   carts.forEach(function(cart){cart.querySelectorAll('.crow,.dl-cart-empty').forEach(function(r){r.remove()});rows.forEach(function(row,i){var el=document.createElement('div');el.className='crow';el.dataset.dlCartRow=i;var spacer=document.createElement('div'),info=document.createElement('div'),h=document.createElement('h3'),small=document.createElement('small');h.textContent=row.name;small.textContent=money(row.price)+' each · sample item';info.append(h,small);var qty=document.createElement('div');qty.className='qty';[-1,1].forEach(function(change){var b=document.createElement('button');b.type='button';b.dataset.dlCartChange=change;b.textContent=change<0?'−':'+';b.setAttribute('aria-label',(change<0?'Decrease ':'Increase ')+row.name);if(change>0){var value=document.createElement('span');value.textContent=row.qty;qty.append(value)}qty.append(b)});var price=document.createElement('b');price.textContent=money(row.price*row.qty);var remove=document.createElement('button');remove.type='button';remove.className='btn ghost';remove.dataset.dlCartRemove='';remove.textContent='Remove';remove.setAttribute('aria-label','Remove '+row.name);el.append(spacer,info,qty,price,remove);cart.insertBefore(el,cart.querySelector(':scope>a'))});if(!rows.length){var empty=document.createElement('p');empty.className='dl-cart-empty';empty.setAttribute('role','status');empty.textContent='Your sample cart is empty. Browse the collection to add an item.';cart.prepend(empty)}var aside=cart.parentElement.querySelector('aside.side-card');if(aside){var list=aside.querySelector('.kv');if(list){list.replaceChildren(makeLine('Subtotal',money(totals().subtotal)),makeLine('Demo delivery / fees','Not applied'),makeLine('Total',money(totals().total),true))}var note=aside.querySelector('p');if(note)note.textContent='Local sample cart. Real delivery, tax and payment must be configured before launch.'}});\n   checkouts.forEach(function(aside){var list=aside.querySelector('.kv');list.replaceChildren();rows.forEach(function(r){list.append(makeLine(r.qty+' × '+r.name,money(r.price*r.qty)))});list.append(makeLine('Total · demo only',money(totals().total),true));var form=aside.parentElement.querySelector('form'),button=form&&form.querySelector('[type=submit]');if(button){button.textContent=rows.length?'Preview checkout · '+money(totals().total):'Add an item before checkout';button.disabled=!rows.length}});\n  }\n  details.forEach(function(detail){detail.querySelectorAll('.qty button').forEach(function(b){b.type='button';b.setAttribute('aria-label',b.textContent.trim()==='+'?'Increase quantity':'Decrease quantity')});detail.querySelectorAll('.chips .chip').forEach(function(b){b.type='button';b.setAttribute('aria-pressed',b.classList.contains('on'));b.addEventListener('click',function(){b.parentElement.querySelectorAll('.chip').forEach(function(x){x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)})})})});\n  document.addEventListener('click',function(e){var row=e.target.closest('[data-dl-cart-row]');if(row){var index=Number(row.dataset.dlCartRow),change=e.target.closest('[data-dl-cart-change]');if(e.target.closest('[data-dl-cart-remove]'))rows.splice(index,1);else if(change&&rows[index])rows[index].qty=Math.max(1,Math.min(99,rows[index].qty+Number(change.dataset.dlCartChange)));save();render();return}\n   var detail=e.target.closest('.pdp,[data-dl-product]');if(!detail)return;var button=e.target.closest('.qty button');if(button&&!button.onclick){var span=button.parentElement.querySelector('span');if(span)span.textContent=Math.max(1,Math.min(99,amount(span.textContent)+(button.textContent.trim()==='+'?1:-1)))}\n   var link=e.target.closest('.buy a,[data-dl-add]');if(link&&!e.defaultPrevented&&link.getAttribute('aria-disabled')!=='true'&&/cart(?:\\.|$)|#\\/cart/.test(link.getAttribute('href')||'')){var h=detail.querySelector('.pinfo h1'),price=detail.querySelector('.pinfo .price'),q=detail.querySelector('.qty span');if(h&&price){var chosen=Array.from(detail.querySelectorAll('.pinfo .chip.on,.pinfo .ok-finish [aria-pressed=true]')).map(function(b){return b.getAttribute('aria-label')||b.textContent.trim()}),name=h.textContent+(chosen.length?' · '+chosen.join(' / '):''),quantity=amount(q?q.textContent:1)||1,found=rows.find(function(r){return r.name===name});if(found)found.qty=Math.min(99,found.qty+quantity);else rows.push(item(name,amount(price.textContent),quantity));save();render()}}\n  });\n  render();\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script>","foot":"<footer data-dl-footer class=\"ex-foot\"><div class=\"wrap\" style=\"padding-top:48px\"><div class=\"cols\"><div><div class=\"ex-logo\" style=\"color:inherit\"><i></i>Nexus Summit</div><p style=\"margin-top:12px;opacity:.8;max-width:30ch\">Asia’s product and design summit. 14–15 November 2026, KLCC.</p></div><div><h4>Event</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:agenda}}\">Agenda</a></li><li><a href=\"{{p:speakers}}\">Speakers</a></li><li><a href=\"{{p:tickets}}\">Tickets</a></li><li><a href=\"{{p:venue}}\">Venue & travel</a></li><li><a href=\"{{p:sponsors}}\">Sponsors</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li><li><a href=\"{{p:contact}}\">Contact</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a>