clip:text;background-clip:text;color:transparent}\n.ap-hero p{font:500 19px/1.6 var(--f-body);max-width:46ch;margin:0 auto 26px;opacity:.85}\n.ap-stage{position:relative;margin:50px auto 0;height:clamp(300px,50vw,520px);overflow:hidden}\n.ap-phone{position:absolute;left:50%;top:0;translate:-50% 0;width:min(300px,64vw);aspect-ratio:9/18;border-radius:42px;background:var(--c-text);padding:10px;box-shadow:0 40px 80px -30px color-mix(in srgb,var(--c-primary) 70%,#000)}\n.ap-scr{height:100%;border-radius:32px;background:linear-gradient(170deg,color-mix(in srgb,var(--c-primary) 14%,var(--c-surface)),var(--c-surface));padding:34px 16px 16px;overflow:hidden}\n.ap-scr h4{font:800 20px var(--f-head);margin-bottom:12px}\n.ap-scr .c{background:var(--c-surface);border-radius:16px;padding:12px;margin-bottom:10px;box-shadow:0 8px 20px -14px color-mix(in srgb,var(--c-text) 60%,transparent);display:flex;gap:10px;align-items:center;font:700 13px var(--f-body)}\n.ap-scr .c i{width:36px;height:36px;border-radius:12px;background:linear-gradient(135deg,var(--c-primary),var(--c-accent));flex:none}.ap-scr .c small{display:block;font-weight:500;opacity:.6}\n.ap-chip{position:absolute;background:var(--c-surface);border-radius:16px;padding:10px 14px;font:700 13px var(--f-body);box-shadow:0 18px 36px -18px color-mix(in srgb,var(--c-text) 60%,transparent);animation:ap-fl 5s ease-in-out infinite}\n.ap-chip.a{left:6%;top:24%}.ap-chip.b{right:6%;top:52%;animation-delay:-2s}\n@keyframes ap-fl{50%{translate:0 -10px}}\n.ap-sec{padding:var(--pad) 20px}.ap-sec>.in{max-width:var(--w);margin:auto;position:relative}\n.ap-ft{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n.ap-fc{border-radius:26px;padding:26px;background:color-mix(in srgb,var(--c-primary) 6%,var(--c-surface));border:1px solid var(--c-border)}\n.ap-fc .ic{width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,var(--c-primary),var(--c-accent));margin-bottom:14px}\n.ap-fc h3{font:800 20px var(--f-head);margin-bottom:6px}\n.ap-tg{display:inline-flex;border:2px solid var(--c-text);border-radius:99px;padding:3px;margin-bottom:24px}\n.ap-tg label{padding:.5em 1.3em;border-radius:99px;font:700 14px var(--f-body);cursor:pointer}\n#ap-mo:checked~.ap-tg label[for=ap-mo],#ap-yr:checked~.ap-tg label[for=ap-yr]{background:var(--c-text);color:var(--c-surface)}#ap-mo:focus-visible~.ap-tg label[for=ap-mo],#ap-yr:focus-visible~.ap-tg label[for=ap-yr]{outline:3px solid var(--c-primary)}\n.ap-price{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n.ap-pc{border:2px solid var(--c-border);border-radius:26px;padding:26px;background:var(--c-surface)}\n.ap-pc.hl{border-color:transparent;background:linear-gradient(var(--c-surface),var(--c-surface)) padding-box,linear-gradient(135deg,var(--c-primary),var(--c-accent)) border-box;border:2px solid transparent}\n.ap-pc h3{font:800 20px var(--f-head)}.ap-pc .am{font:800 44px var(--f-head);letter-spacing:-.03em;margin:8px 0}.ap-pc .am small{font:600 15px var(--f-body);opacity:.6}\n.ap-pc .am .y{display:none}#ap-yr:checked~.ap-price .am .m{display:none}#ap-yr:checked~.ap-price .am .y{display:inline}\n.ap-pc ul{list-style:none;padding:0;margin:14px 0 22px;display:grid;gap:8px;font:500 15px var(--f-body)}.ap-pc li::before{content:\"✓ \";font-weight:800;color:var(--c-primary)}\n.ap-log{border-left:3px solid var(--c-border);padding-left:20px;display:grid;gap:26px}\n.ap-log .v b{font:800 20px var(--f-head)}.ap-log .v small{opacity:.6;margin-left:8px}.ap-log ul{margin:8px 0 0;padding-left:20px;font:500 15px/1.7 var(--f-body)}\n.ap-foot{border-top:1px solid var(--c-border)}\n@media(max-width:820px){.ap-head ul{display:none}.ap-ft,.ap-price{grid-template-columns:1fr}.ap-chip{display:none}}\n@media(prefers-reduced-motion:reduce){.ap-chip{animation:none}}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}.ap-head .more{position:relative}.ap-head .dd{position:absolute;right:0;top:100%;display:none;grid-template-columns:repeat(3,minmax(130px,1fr));gap:20px 30px;padding:22px 26px;background:var(--c-surface);color:var(--c-text);border:1px solid var(--c-border);min-width:500px;z-index:60;text-align:left;font-family:var(--f-body);text-transform:none;letter-spacing:0;font-style:normal;border-radius:16px;}.ap-head .more:hover .dd,.ap-head .more:focus-within .dd{display:grid}.ap-head .dd h4{font:700 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;margin:0 0 8px;opacity:.55;color:inherit}.ap-head .dd a{display:block;padding:4px 0;font:500 14px var(--f-body);text-transform:none;letter-spacing:0;border:0;height:auto;opacity:.85;color:inherit;text-decoration:none;background:none;transform:none}.ap-head .dd a:hover{color:var(--c-accent);opacity:1}\nh1,h2,h3{color:var(--c-text)}</style><header class=\"ap-head\"><div class=\"in\"><a class=\"ap-logo\" href=\"{{p:home}}\"><i></i>Pocket</a><ul><li><a href=\"{{p:features}}\">Features</a></li><li><a href=\"{{p:pricing}}\">Pricing</a></li><li><a href=\"{{p:changelog}}\">What’s new</a></li><li class=\"more\" style=\"position:relative\"><a href=\"#\" tabindex=\"0\">More ▾</a><div class=\"dd\"><div><h4>App</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:features}}\">Features</a><a href=\"{{p:pricing}}\">Pricing</a><a href=\"{{p:download}}\">Download</a><a href=\"{{p:changelog}}\">What’s new</a><a href=\"{{p:faq}}\">FAQ</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li></ul><a class=\"ap-btn\" href=\"{{p:download}}\">Get the app</a><details class=\"dl-mobile\"><summary>Menu</summary><nav class=\"dl-mobile-links\" aria-label=\"Template pages\"><h4>App</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:features}}\">Features</a><a href=\"{{p:pricing}}\">Pricing</a><a href=\"{{p:download}}\">Download</a><a href=\"{{p:changelog}}\">What’s new</a><a href=\"{{p:faq}}\">FAQ</a><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a></nav></details></div></header><script>/* Runs in previews AND exported files. No requests, credentials or submissions. */\n(function(){\n 'use strict';\n function start(){\n  var root=document.querySelector('[data-dl-template]');if(!root)return;\n  document.querySelectorAll('[data-dl-demo-form]').forEach(function(form,index){\n   if(form.dataset.dlBound)return;form.dataset.dlBound='1';\n   var note=document.createElement('p');note.className='dl-form-note';note.textContent='Interactive demo · Nothing is sent. Use sample details only. No account, booking or payment will be created.';form.prepend(note);\n   var result=document.createElement('p');result.className='dl-feedback';result.setAttribute('role','status');result.setAttribute('aria-live','polite');result.hidden=true;form.append(result);\n   form.querySelectorAll('input,textarea,select').forEach(function(input,i){\n    if(!input.name)input.name='demo-'+index+'-'+i;\n    var label=input.closest('label'),text=(label?label.textContent:input.placeholder||'').toLowerCase();\n    if(/name|email|message|date|time/.test(text)&&!/optional/.test(text))input.required=true;\n    if(input.type==='password')input.autocomplete='new-password';\n    if(/card number|cvc|expiry/.test(text)){input.disabled=true;input.placeholder='Disabled in demo';}\n   });\n   function submit(e){if(e)e.preventDefault();if(!form.reportValidity())return;result.hidden=false;result.textContent='Demo complete. Your entries passed the browser checks. Nothing was sent, charged, booked or stored.';}\n   form.addEventListener('submit',submit);\n   if(!form.querySelector('[type=\"submit\"],button:not([type])')){var buttons=form.querySelectorAll('button[type=\"button\"]');if(buttons.length===1)buttons[0].addEventListener('click',submit);}\n  });\n  document.querySelectorAll('.dl-visual img').forEach(function(img){img.addEventListener('error',function(){img.parentElement.classList.add('dl-photo-failed')});if(img.complete&&!img.naturalWidth)img.parentElement.classList.add('dl-photo-failed')});\n  document.querySelectorAll('.shoptop').forEach(function(top){\n   var grid=top.nextElementSibling;if(!grid||!grid.matches('.products'))return;\n   var cards=Array.from(grid.children),chips=Array.from(top.querySelectorAll('.chip')),sort=top.querySelector('select'),category='All';\n   var empty=document.createElement('p');empty.className='dl-filter-empty';empty.textContent='No sample items match this category. Choose All to see the collection.';empty.hidden=true;grid.after(empty);\n   function update(){var shown=0;cards.forEach(function(card){var tag=card.querySelector('small');card.hidden=category!=='All'&&(!tag||tag.textContent.trim()!==category);if(!card.hidden)shown++});empty.hidden=shown!==0;var count=top.querySelector('.sort span');if(count)count.textContent=shown+' sample items';}\n   chips.forEach(function(chip){chip.type='button';chip.setAttribute('aria-pressed',chip.classList.contains('on'));chip.addEventListener('click',function(){category=chip.textContent.trim();chips.forEach(function(c){c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',c===chip)});update()})});\n   if(sort){sort.setAttribute('aria-label','Sort sample items');Array.from(sort.options).forEach(function(o){if(/newest/i.test(o.textContent))o.textContent='Reverse featured'});sort.addEventListener('change',function(){var ordered=cards.slice();if(sort.selectedIndex===1||sort.selectedIndex===2){ordered.sort(function(a,b){function price(c){var p=c.querySelector('.price');return Number((p?p.textContent:'').replace(/[^0-9.]/g,''))||0}return price(a)-price(b)});if(sort.selectedIndex===2)ordered.reverse()}else if(sort.selectedIndex===3)ordered.reverse();ordered.forEach(function(card){grid.append(card)})})}\n  });\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.burger[open],.dl-mobile[open],.nav details[open]').forEach(function(menu){menu.open=false;var summary=menu.querySelector('summary');if(summary)summary.focus()})});\n  document.addEventListener('click',function(e){var a=e.target.closest('.dl-mobile a,.bmenu a');if(a){var menu=a.closest('details');if(menu)menu.open=false;}});\n  document.querySelectorAll('.more>a[href=\"#\"]').forEach(function(a){a.setAttribute('role','button');a.setAttribute('aria-expanded','false');function set(open){a.parentElement.classList.toggle('dl-menu-open',open);a.setAttribute('aria-expanded',open)}function toggle(e){e.preventDefault();set(a.getAttribute('aria-expanded')!=='true')}a.addEventListener('click',toggle);a.addEventListener('keydown',function(e){if(e.key===' ')toggle(e)});a.parentElement.addEventListener('mouseenter',function(){set(true)});a.parentElement.addEventListener('mouseleave',function(){if(!a.parentElement.contains(document.activeElement))set(false)})});\n  document.addEventListener('click',function(e){var a=e.target.closest('a[href=\"#\"]');if(!a||e.defaultPrevented||a.onclick||a.closest('.more'))return;e.preventDefault();var note=a.parentElement.querySelector(':scope>.dl-missing-link');if(!note){note=document.createElement('p');note.className='dl-feedback dl-missing-link';note.setAttribute('role','status');a.after(note)}note.textContent='Demonstration link. Add the real destination before launching this site.'});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.dl-menu-open').forEach(function(menu){menu.classList.remove('dl-menu-open');var a=menu.querySelector(':scope>a');if(a){a.setAttribute('aria-expanded','false');a.focus()}})});\n  document.querySelectorAll('.dl-skip').forEach(function(link){link.addEventListener('click',function(e){e.preventDefault();var target=document.querySelector('main.on [data-dl-content],main:not([data-page]) [data-dl-content]');if(target){target.focus();target.scrollIntoView({block:'start'})}})});\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>/* Sample commerce only: local item choices, quantities and consistent totals. */\n(function(){\n 'use strict';\n function start(){\n  var marker=document.querySelector('[data-dl-template]');if(!marker||marker.dataset.dlTemplate==='restaurant-warm')return;\n  var carts=Array.from(document.querySelectorAll('.cart')).filter(function(x){return x.querySelector('.crow')}),details=Array.from(document.querySelectorAll('.pdp,[data-dl-product]')).filter(function(x){return x.querySelector('.pinfo .price')}),checkouts=Array.from(document.querySelectorAll('aside.side-card')).filter(function(x){return x.querySelector('.kv')&&x.previousElementSibling&&x.previousElementSibling.querySelector('form')});\n  if(!carts.length&&!details.length&&!checkouts.length)return;\n  var currency='RM ',rows=[],key='dl-sample-cart:'+marker.dataset.dlTemplate;\n  function amount(text){return Number(String(text).replace(/[^0-9.]/g,''))||0}\n  function money(n){return currency+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function item(name,price,qty){return {name:String(name).slice(0,120),price:Math.max(0,Math.min(10000000,price)),qty:Math.max(1,Math.min(99,qty))}}\n  if(carts.length){rows=Array.from(carts[0].querySelectorAll('.crow')).map(function(row){var p=row.querySelector(':scope>b'),h=row.querySelector('h3'),q=row.querySelector('.qty span');if(p){currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' '}return item(h?h.textContent:'Sample item',amount(p?p.textContent:0),amount(q?q.textContent:1)||1)})}\n  else if(checkouts.length){rows=Array.from(checkouts[0].querySelectorAll('.kv li:not(.tot)')).filter(function(row){return row.querySelector('b')&&amount(row.querySelector('b').textContent)>0&&!/tax|shipping|delivery|subtotal|fee/i.test(row.textContent)}).map(function(row){var p=row.querySelector('b');currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' ';return item(row.querySelector('span').textContent,amount(p.textContent),1)})}\n  try{var saved=JSON.parse(localStorage.getItem(key));if(saved&&Array.isArray(saved.rows)&&saved.rows.length<=100){rows=saved.rows.filter(function(r){return typeof r.name==='string'&&Number.isFinite(r.price)&&r.price>=0&&Number.isInteger(r.qty)&&r.qty>0&&r.qty<=99}).map(function(r){return item(r.name,r.price,r.qty)});if(typeof saved.currency==='string'&&/^[A-Z$€£¥ ]{1,8}$/.test(saved.currency))currency=saved.currency;}}catch(e){}\n  function save(){try{localStorage.setItem(key,JSON.stringify({currency:currency,rows:rows}))}catch(e){}}\n  function totals(){var sub=rows.reduce(function(sum,r){return sum+r.price*r.qty},0);return {subtotal:sub,total:sub}}\n  function makeLine(label,value,total){var li=document.createElement('li');if(total)li.className='tot';var span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=value;li.append(span,b);return li}\n  function render(){\n   document.querySelectorAll('header a[href]').forEach(function(a){var match=a.textContent.trim().match(/^(Cart|Bag)\\s*\\(\\d+\\)$/i);if(match)a.textContent=match[1]+' ('+rows.reduce(function(sum,r){return sum+r.qty},0)+')'});\n   carts.forEach(function(cart){cart.querySelectorAll('.crow,.dl-cart-empty').forEach(function(r){r.remove()});rows.forEach(function(row,i){var el=document.createElement('div');el.className='crow';el.dataset.dlCartRow=i;var spacer=document.createElement('div'),info=document.createElement('div'),h=document.createElement('h3'),small=document.createElement('small');h.textContent=row.name;small.textContent=money(row.price)+' each · sample item';info.append(h,small);var qty=document.createElement('div');qty.className='qty';[-1,1].forEach(function(change){var b=document.createElement('button');b.type='button';b.dataset.dlCartChange=change;b.textContent=change<0?'−':'+';b.setAttribute('aria-label',(change<0?'Decrease ':'Increase ')+row.name);if(change>0){var value=document.createElement('span');value.textContent=row.qty;qty.append(value)}qty.append(b)});var price=document.createElement('b');price.textContent=money(row.price*row.qty);var remove=document.createElement('button');remove.type='button';remove.className='btn ghost';remove.dataset.dlCartRemove='';remove.textContent='Remove';remove.setAttribute('aria-label','Remove '+row.name);el.append(spacer,info,qty,price,remove);cart.insertBefore(el,cart.querySelector(':scope>a'))});if(!rows.length){var empty=document.createElement('p');empty.className='dl-cart-empty';empty.setAttribute('role','status');empty.textContent='Your sample cart is empty. Browse the collection to add an item.';cart.prepend(empty)}var aside=cart.parentElement.querySelector('aside.side-card');if(aside){var list=aside.querySelector('.kv');if(list){list.replaceChildren(makeLine('Subtotal',money(totals().subtotal)),makeLine('Demo delivery / fees','Not applied'),makeLine('Total',money(totals().total),true))}var note=aside.querySelector('p');if(note)note.textContent='Local sample cart. Real delivery, tax and payment must be configured before launch.'}});\n   checkouts.forEach(function(aside){var list=aside.querySelector('.kv');list.replaceChildren();rows.forEach(function(r){list.append(makeLine(r.qty+' × '+r.name,money(r.price*r.qty)))});list.append(makeLine('Total · demo only',money(totals().total),true));var form=aside.parentElement.querySelector('form'),button=form&&form.querySelector('[type=submit]');if(button){button.textContent=rows.length?'Preview checkout · '+money(totals().total):'Add an item before checkout';button.disabled=!rows.length}});\n  }\n  details.forEach(function(detail){detail.querySelectorAll('.qty button').forEach(function(b){b.type='button';b.setAttribute('aria-label',b.textContent.trim()==='+'?'Increase quantity':'Decrease quantity')});detail.querySelectorAll('.chips .chip').forEach(function(b){b.type='button';b.setAttribute('aria-pressed',b.classList.contains('on'));b.addEventListener('click',function(){b.parentElement.querySelectorAll('.chip').forEach(function(x){x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)})})})});\n  document.addEventListener('click',function(e){var row=e.target.closest('[data-dl-cart-row]');if(row){var index=Number(row.dataset.dlCartRow),change=e.target.closest('[data-dl-cart-change]');if(e.target.closest('[data-dl-cart-remove]'))rows.splice(index,1);else if(change&&rows[index])rows[index].qty=Math.max(1,Math.min(99,rows[index].qty+Number(change.dataset.dlCartChange)));save();render();return}\n   var detail=e.target.closest('.pdp,[data-dl-product]');if(!detail)return;var button=e.target.closest('.qty button');if(button&&!button.onclick){var span=button.parentElement.querySelector('span');if(span)span.textContent=Math.max(1,Math.min(99,amount(span.textContent)+(button.textContent.trim()==='+'?1:-1)))}\n   var link=e.target.closest('.buy a,[data-dl-add]');if(link&&!e.defaultPrevented&&link.getAttribute('aria-disabled')!=='true'&&/cart(?:\\.|$)|#\\/cart/.test(link.getAttribute('href')||'')){var h=detail.querySelector('.pinfo h1'),price=detail.querySelector('.pinfo .price'),q=detail.querySelector('.qty span');if(h&&price){var chosen=Array.from(detail.querySelectorAll('.pinfo .chip.on,.pinfo .ok-finish [aria-pressed=true]')).map(function(b){return b.getAttribute('aria-label')||b.textContent.trim()}),name=h.textContent+(chosen.length?' · '+chosen.join(' / '):''),quantity=amount(q?q.textContent:1)||1,found=rows.find(function(r){return r.name===name});if(found)found.qty=Math.min(99,found.qty+quantity);else rows.push(item(name,amount(price.textContent),quantity));save();render()}}\n  });\n  render();\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>(function(){document.addEventListener('click',function(e){var link=e.target.closest('[data-pocket-store]');if(!link)return;e.preventDefault();var result=link.closest('main').querySelector('[data-pocket-feedback]');if(result){result.hidden=false;result.textContent=link.dataset.pocketStore+' is a demonstration link. No app is available to install from this template. Replace this button with your published store listing.'}})})();\n</script>","foot":"<footer data-dl-footer class=\"ap-foot\"><div class=\"wrap\" style=\"padding:48px 0 24px\"><div class=\"cols\"><div><div class=\"ap-logo\"><i></i>Pocket</div><p style=\"margin-top:12px;opacity:.7;max-width:30ch\">The calmest way to track money with a partner. Made in Kuala Lumpur.</p></div><div><h4>App</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:features}}\">Features</a></li><li><a href=\"{{p:pricing}}\">Pricing</a></li><li><a href=\"{{p:download}}\">Download</a></li><li><a href=\"{{p:changelog}}\">What’s new</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div><div class=\"copy\"><span>© 2026 Pocket. Template demo content.</span></div></div></footer>","pages":{"home":"<div tabindex=\"-1\" data-dl-content><section class=\"ap-hero\"><small>New · Shared goals for couples</small><h1>Money, made <span>calm.</span></h1><p>Track spending, split bills and save together — without the spreadsheet arguments.</p><a class=\"ap-btn p\" href=\"{{p:download}}\">Download free</a> <a class=\"ap-btn o\" href=\"{{p:features}}\">See how it works</a><div class=\"ap-stage\"><span class=\"ap-chip a\">Dinner · RM 84 split ✓</span><span class=\"ap-chip b\">On track: RM 1,240 left</span><div class=\"ap-phone\"><div class=\"ap-scr\"><h4>October</h4><div class=\"c\"><i></i><span>Groceries<small>Shared · 12 Oct</small></span><b style=\"margin-left:auto\">-RM 142</b></div><div class=\"c\"><i></i><span>Rent<small>You · 1 Oct</small></span><b style=\"margin-left:auto\">-RM 1,800</b></div><div class=\"c\"><i></i><span>Salary<small>Aiden · 28 Sep</small></span><b style=\"margin-left:auto\">+RM 5,200</b></div><div class=\"c\"><i></i><span>Trip fund<small>Goal 62%</small></span><b style=\"margin-left:auto\">RM 3,100</b></div></div></div></div></section><section c