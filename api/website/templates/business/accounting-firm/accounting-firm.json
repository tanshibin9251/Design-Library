n]{display:none}\n.dl-visual{position:relative;isolation:isolate;overflow:hidden;background:var(--c-border)}.dl-visual:before,.dl-visual:after{display:none!important}.dl-visual>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1}.dl-visual>span{position:relative;z-index:1}.dl-photo-failed>img{display:none}.dl-photo-failed:after{display:grid!important;position:absolute;inset:0;place-items:center;content:'Image unavailable · 缺图';padding:16px;background:var(--c-surface);color:var(--c-text);font:500 14px var(--f-body)}\n.dl-stock-label{position:absolute;left:10px;bottom:10px;padding:4px 8px;max-width:calc(100% - 20px);background:var(--c-surface);color:var(--c-text);font-size:11px;line-height:1.5;border-radius:4px}.dl-credits{padding:20px 0;font-size:13px}.dl-credits summary{cursor:pointer;min-height:44px;display:flex;align-items:center}.dl-credits li{margin-block:8px}.dl-credits a{overflow-wrap:anywhere}\n:where(button,a,input,select,textarea,summary):focus-visible{outline:3px solid var(--c-accent);outline-offset:4px}\n@media(max-width:820px){.dl-mobile{display:block;position:relative}.dl-mobile summary{display:flex;align-items:center;justify-content:center;min-width:64px;min-height:44px;padding:8px 12px;border:1px solid var(--c-border);border-radius:var(--radius);cursor:pointer;list-style:none;font:600 14px var(--f-body)}.dl-mobile summary::-webkit-details-marker{display:none}.dl-mobile-links{position:fixed;top:74px;left:12px;right:12px;z-index:9999;max-height:75dvh;overflow:auto;background:var(--c-surface);color:var(--c-text);padding:16px 20px;border:1px solid var(--c-border);border-radius:var(--radius);box-shadow:0 16px 40px #0002}.dl-mobile-links a{display:flex;align-items:center;min-height:44px;text-decoration:none}.dl-mobile-links h4{font-size:12px;margin:18px 0 4px;color:var(--c-secondary)}.burger summary,.bmenu a{min-height:44px}.burger summary{display:flex;align-items:center}.burger:not([open])>.bmenu{display:none}.btn,.chip,.qty button{min-height:44px}.qty button{min-width:44px}[data-dl-footer] .cols{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}[data-dl-footer] .cols>div:first-child{grid-column:1/-1}.pdp,.split{min-width:0}.pdp>*{min-width:0}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n</style><a class=\"dl-skip\" href=\"#dl-content\">Skip to content</a><style>\n/* Verde & Co. — tokens only */\n.ac-head{background:var(--c-surface);border-bottom:1px solid var(--c-border);position:sticky;top:0;z-index:40}\n.ac-head .in{max-width:var(--w);margin:auto;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px 20px}\n.ac-logo{font:600 24px var(--f-head);text-decoration:none;color:var(--c-primary)}.ac-logo small{display:block;font:600 10px var(--f-body);letter-spacing:.24em;text-transform:uppercase;color:var(--c-accent);margin-top:2px}\n.ac-head ul{display:flex;gap:24px;list-style:none;font:600 15px var(--f-body)}.ac-head ul a{text-decoration:none}.ac-head ul a:hover{color:var(--c-accent)}\n.ac-btn{background:var(--c-primary);color:var(--on-primary);padding:.8em 1.4em;border-radius:6px;font:700 14px var(--f-body);text-decoration:none;display:inline-block}\n.ac-btn.o{background:none;color:var(--c-primary);box-shadow:inset 0 0 0 2px var(--c-primary)}\n.ac-hero{max-width:var(--w);margin:auto;padding:clamp(34px,6vw,84px) 20px;display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center}\n.ac-hero h1{font-size:clamp(38px,5.6vw,var(--h1));line-height:1.08;color:var(--c-primary)}\n.ac-hero p{font:400 18px/1.7 var(--f-body);max-width:46ch;margin:18px 0 26px}\n.ac-ledger{border:1px solid var(--c-border);background:var(--c-surface);border-radius:8px;box-shadow:10px 10px 0 color-mix(in srgb,var(--c-primary) 14%,transparent);font:500 15px var(--f-body)}\n.ac-ledger h3{font:700 12px var(--f-body);letter-spacing:.14em;text-transform:uppercase;padding:14px 18px;border-bottom:2px solid var(--c-primary);color:var(--c-primary)}\n.ac-ledger div{display:flex;justify-content:space-between;padding:11px 18px;border-bottom:1px dashed var(--c-border)}\n.ac-ledger div:last-child{border:0;background:color-mix(in srgb,var(--c-accent) 14%,var(--c-surface));font-weight:700}\n.ac-ledger b{font-variant-numeric:tabular-nums}\n.ac-sec{padding:var(--pad) 20px}.ac-sec>.in{max-width:var(--w);margin:auto}\n.ac-svc{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n.ac-sc{border-top:3px solid var(--c-primary);padding-top:16px}.ac-sc h3{font:600 22px var(--f-head);margin-bottom:6px}.ac-sc ul{margin:10px 0 0;padding:0;list-style:none;font:500 15px var(--f-body)}.ac-sc li{padding:6px 0;border-bottom:1px solid var(--c-border)}\n.ac-cal{border:1px solid var(--c-border);border-radius:8px;overflow:hidden}\n.ac-cal div{display:grid;grid-template-columns:110px 1fr auto;gap:16px;padding:14px 18px;border-bottom:1px solid var(--c-border);align-items:center;font:500 15px var(--f-body)}\n.ac-cal div:last-child{border:0}.ac-cal .d{font:700 15px var(--f-head);color:var(--c-primary)}.ac-cal .t{font:700 11px var(--f-body);letter-spacing:.08em;text-transform:uppercase;background:color-mix(in srgb,var(--c-accent) 22%,var(--c-surface));padding:.2em .7em;border-radius:99px}\n.ac-cal .t.u{background:var(--c-accent);color:var(--c-surface)}\n.ac-tm{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}\n.ac-tm .ph{aspect-ratio:1;border-radius:8px}.ac-tm h3{font:600 19px var(--f-head);margin-top:10px}.ac-tm small{opacity:.7}\n.ac-foot{background:var(--c-primary);color:var(--on-primary)}\n@media(max-width:800px){.ac-head ul{display:none}.ac-hero,.ac-svc{grid-template-columns:1fr}.ac-tm{grid-template-columns:1fr 1fr}.ac-cal div{grid-template-columns:90px 1fr}.ac-cal .t{grid-column:2;justify-self:start}}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}.ac-head .more{position:relative}.ac-head .dd{position:absolute;right:0;top:100%;display:none;grid-template-columns:repeat(3,minmax(130px,1fr));gap:20px 30px;padding:22px 26px;background:var(--c-surface);color:var(--c-text);border:1px solid var(--c-border);min-width:500px;z-index:60;text-align:left;font-family:var(--f-body);text-transform:none;letter-spacing:0;font-style:normal;border-radius:8px;}.ac-head .more:hover .dd,.ac-head .more:focus-within .dd{display:grid}.ac-head .dd h4{font:700 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;margin:0 0 8px;opacity:.55;color:inherit}.ac-head .dd a{display:block;padding:4px 0;font:500 14px var(--f-body);text-transform:none;letter-spacing:0;border:0;height:auto;opacity:.85;color:inherit;text-decoration:none;background:none;transform:none}.ac-head .dd a:hover{color:var(--c-accent);opacity:1}\nh1,h2,h3{color:var(--c-primary)}</style><header class=\"ac-head\"><div class=\"in\"><a class=\"ac-logo\" href=\"{{p:home}}\">Verde &amp; Co.<small>Chartered Accountants</small></a><ul><li><a href=\"{{p:services}}\">Services</a></li><li><a href=\"{{p:deadlines}}\">Tax calendar</a></li><li><a href=\"{{p:pricing}}\">Fees</a></li><li><a href=\"{{p:team}}\">Team</a></li><li class=\"more\" style=\"position:relative\"><a href=\"#\" tabindex=\"0\">More ▾</a><div class=\"dd\"><div><h4>Firm</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:services}}\">Services</a><a href=\"{{p:service}}\">Tax service</a><a href=\"{{p:pricing}}\">Fees</a><a href=\"{{p:team}}\">Team</a></div><div><h4>Resources</h4><a href=\"{{p:deadlines}}\">Tax calendar</a><a href=\"{{p:resources}}\">Guides</a><a href=\"{{p:contact}}\">Free consultation</a><a href=\"{{p:faq}}\">FAQ</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li></ul><a class=\"ac-btn\" href=\"{{p:contact}}\">Free consultation</a><details class=\"dl-mobile\"><summary>Menu</summary><nav class=\"dl-mobile-links\" aria-label=\"Template pages\"><h4>Firm</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:services}}\">Services</a><a href=\"{{p:service}}\">Tax service</a><a href=\"{{p:pricing}}\">Fees</a><a href=\"{{p:team}}\">Team</a><h4>Resources</h4><a href=\"{{p:deadlines}}\">Tax calendar</a><a href=\"{{p:resources}}\">Guides</a><a href=\"{{p:contact}}\">Free consultation</a><a href=\"{{p:faq}}\">FAQ</a><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a></nav></details></div></header><script>/* Runs in previews AND exported files. No requests, credentials or submissions. */\n(function(){\n 'use strict';\n function start(){\n  var root=document.querySelector('[data-dl-template]');if(!root)return;\n  document.querySelectorAll('[data-dl-demo-form]').forEach(function(form,index){\n   if(form.dataset.dlBound)return;form.dataset.dlBound='1';\n   var note=document.createElement('p');note.className='dl-form-note';note.textContent='Interactive demo · Nothing is sent. Use sample details only. No account, booking or payment will be created.';form.prepend(note);\n   var result=document.createElement('p');result.className='dl-feedback';result.setAttribute('role','status');result.setAttribute('aria-live','polite');result.hidden=true;form.append(result);\n   form.querySelectorAll('input,textarea,select').forEach(function(input,i){\n    if(!input.name)input.name='demo-'+index+'-'+i;\n    var label=input.closest('label'),text=(label?label.textContent:input.placeholder||'').toLowerCase();\n    if(/name|email|message|date|time/.test(text)&&!/optional/.test(text))input.required=true;\n    if(input.type==='password')input.autocomplete='new-password';\n    if(/card number|cvc|expiry/.test(text)){input.disabled=true;input.placeholder='Disabled in demo';}\n   });\n   function submit(e){if(e)e.preventDefault();if(!form.reportValidity())return;result.hidden=false;result.textContent='Demo complete. Your entries passed the browser checks. Nothing was sent, charged, booked or stored.';}\n   form.addEventListener('submit',submit);\n   if(!form.querySelector('[type=\"submit\"],button:not([type])')){var buttons=form.querySelectorAll('button[type=\"button\"]');if(buttons.length===1)buttons[0].addEventListener('click',submit);}\n  });\n  document.querySelectorAll('.dl-visual img').forEach(function(img){img.addEventListener('error',function(){img.parentElement.classList.add('dl-photo-failed')});if(img.complete&&!img.naturalWidth)img.parentElement.classList.add('dl-photo-failed')});\n  document.querySelectorAll('.shoptop').forEach(function(top){\n   var grid=top.nextElementSibling;if(!grid||!grid.matches('.products'))return;\n   var cards=Array.from(grid.children),chips=Array.from(top.querySelectorAll('.chip')),sort=top.querySelector('select'),category='All';\n   var empty=document.createElement('p');empty.className='dl-filter-empty';empty.textContent='No sample items match this category. Choose All to see the collection.';empty.hidden=true;grid.after(empty);\n   function update(){var shown=0;cards.forEach(function(card){var tag=card.querySelector('small');card.hidden=category!=='All'&&(!tag||tag.textContent.trim()!==category);if(!card.hidden)shown++});empty.hidden=shown!==0;var count=top.querySelector('.sort span');if(count)count.textContent=shown+' sample items';}\n   chips.forEach(function(chip){chip.type='button';chip.setAttribute('aria-pressed',chip.classList.contains('on'));chip.addEventListener('click',function(){category=chip.textContent.trim();chips.forEach(function(c){c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',c===chip)});update()})});\n   if(sort){sort.setAttribute('aria-label','Sort sample items');Array.from(sort.options).forEach(function(o){if(/newest/i.test(o.textContent))o.textContent='Reverse featured'});sort.addEventListener('change',function(){var ordered=cards.slice();if(sort.selectedIndex===1||sort.selectedIndex===2){ordered.sort(function(a,b){function price(c){var p=c.querySelector('.price');return Number((p?p.textContent:'').replace(/[^0-9.]/g,''))||0}return price(a)-price(b)});if(sort.selectedIndex===2)ordered.reverse()}else if(sort.selectedIndex===3)ordered.reverse();ordered.forEach(function(card){grid.append(card)})})}\n  });\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.burger[open],.dl-mobile[open],.nav details[open]').forEach(function(menu){menu.open=false;var summary=menu.querySelector('summary');if(summary)summary.focus()})});\n  document.addEventListener('click',function(e){var a=e.target.closest('.dl-mobile a,.bmenu a');if(a){var menu=a.closest('details');if(menu)menu.open=false;}});\n  document.querySelectorAll('.more>a[href=\"#\"]').forEach(function(a){a.setAttribute('role','button');a.setAttribute('aria-expanded','false');function set(open){a.parentElement.classList.toggle('dl-menu-open',open);a.setAttribute('aria-expanded',open)}function toggle(e){e.preventDefault();set(a.getAttribute('aria-expanded')!=='true')}a.addEventListener('click',toggle);a.addEventListener('keydown',function(e){if(e.key===' ')toggle(e)});a.parentElement.addEventListener('mouseenter',function(){set(true)});a.parentElement.addEventListener('mouseleave',function(){if(!a.parentElement.contains(document.activeElement))set(false)})});\n  document.addEventListener('click',function(e){var a=e.target.closest('a[href=\"#\"]');if(!a||e.defaultPrevented||a.onclick||a.closest('.more'))return;e.preventDefault();var note=a.parentElement.querySelector(':scope>.dl-missing-link');if(!note){note=document.createElement('p');note.className='dl-feedback dl-missing-link';note.setAttribute('role','status');a.after(note)}note.textContent='Demonstration link. Add the real destination before launching this site.'});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.dl-menu-open').forEach(function(menu){menu.classList.remove('dl-menu-open');var a=menu.querySelector(':scope>a');if(a){a.setAttribute('aria-expanded','false');a.focus()}})});\n  document.querySelectorAll('.dl-skip').forEach(function(link){link.addEventListener('click',function(e){e.preventDefault();var target=document.querySelector('main.on [data-dl-content],main:not([data-page]) [data-dl-content]');if(target){target.focus();target.scrollIntoView({block:'start'})}})});\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>/* Sample commerce only: local item choices, quantities and consistent totals. */\n(function(){\n 'use strict';\n function start(){\n  var marker=document.querySelector('[data-dl-template]');if(!marker||marker.dataset.dlTemplate==='restaurant-warm')return;\n  var carts=Array.from(document.querySelectorAll('.cart')).filter(function(x){return x.querySelector('.crow')}),details=Array.from(document.querySelectorAll('.pdp,[data-dl-product]')).filter(function(x){return x.querySelector('.pinfo .price')}),checkouts=Array.from(document.querySelectorAll('aside.side-card')).filter(function(x){return x.querySelector('.kv')&&x.previousElementSibling&&x.previousElementSibling.querySelector('form')});\n  if(!carts.length&&!details.length&&!checkouts.length)return;\n  var currency='RM ',rows=[],key='dl-sample-cart:'+marker.dataset.dlTemplate;\n  function amount(text){return Number(String(text).replace(/[^0-9.]/g,''))||0}\n  function money(n){return currency+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function item(name,price,qty){return {name:String(name).slice(0,120),price:Math.max(0,Math.min(10000000,price)),qty:Math.max(1,Math.min(99,qty))}}\n  if(carts.length){rows=Array.from(carts[0].querySelectorAll('.crow')).map(function(row){var p=row.querySelector(':scope>b'),h=row.querySelector('h3'),q=row.querySelector('.qty span');if(p){currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' '}return item(h?h.textContent:'Sample item',amount(p?p.textContent:0),amount(q?q.textContent:1)||1)})}\n  else if(checkouts.length){rows=Array.from(checkouts[0].querySelectorAll('.kv li:not(.tot)')).filter(function(row){return row.querySelector('b')&&amount(row.querySelector('b').textContent)>0&&!/tax|shipping|delivery|subtotal|fee/i.test(row.textContent)}).map(function(row){var p=row.querySelector('b');currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' ';return item(row.querySelector('span').textContent,amount(p.textContent),1)})}\n  try{var saved=JSON.parse(localStorage.getItem(key));if(saved&&Array.isArray(saved.rows)&&saved.rows.length<=100){rows=saved.rows.filter(function(r){return typeof r.name==='string'&&Number.isFinite(r.price)&&r.price>=0&&Number.isInteger(r.qty)&&r.qty>0&&r.qty<=99}).map(function(r){return item(r.name,r.price,r.qty)});if(typeof saved.currency==='string'&&/^[A-Z$€£¥ ]{1,8}$/.test(saved.currency))currency=saved.currency;}}catch(e){}\n  function save(){try{localStorage.setItem(key,JSON.stringify({currency:currency,rows:rows}))}catch(e){}}\n  function totals(){var sub=rows.reduce(function(sum,r){return sum+r.price*r.qty},0);return {subtotal:sub,total:sub}}\n  function makeLine(label,value,total){var li=document.createElement('li');if(total)li.className='tot';var span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=value;li.append(span,b);return li}\n  function render(){\n   document.querySelectorAll('header a[href]').forEach(function(a){var match=a.textContent.trim().match(/^(Cart|Bag)\\s*\\(\\d+\\)$/i);if(match)a.textContent=match[1]+' ('+rows.reduce(function(sum,r){return sum+r.qty},0)+')'});\n   carts.forEach(function(cart){cart.querySelectorAll('.crow,.dl-cart-empty').forEach(function(r){r.remove()});rows.forEach(function(row,i){var el=document.createElement('div');el.className='crow';el.dataset.dlCartRow=i;var spacer=document.createElement('div'),info=document.createElement('div'),h=document.createElement('h3'),small=document.createElement('small');h.textContent=row.name;small.textContent=money(row.price)+' each · sample item';info.append(h,small);var qty=document.createEleme