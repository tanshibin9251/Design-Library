{"slug":"accounting-firm","name":"Verde & Co. Accountants","zh":"会计师事务所","tag":"Trustworthy accountancy site with a ledger-card hero, upfront deadline calendar, practice lists and fixed-fee packages.","colors":{"primary":"#14532d","secondary":"#6b6b5a","text":"#1c1f1c","accent":"#b45309","surface":"#fbfaf5","border":"#dad8c9"},"fonts":{"head":"Literata","body":"Public Sans"},"tok":{"hlh":"1.1","hw":"600","hcase":"none","hls":"-.01em","h1":"60px","h2":"38px","h3":"22px","pad":"80px","ew":"700","stat":"var(--c-primary)","radius":"8px"},"types":["company"],"ind":["finance","legal"],"styles":["corporate","editorial","minimal"],"license":"库内自有","format":"fragments","pagelist":[{"slug":"home","label":"Home","group":"Firm"},{"slug":"services","label":"Services","group":"Firm"},{"slug":"service","label":"Tax service","group":"Firm"},{"slug":"deadlines","label":"Tax calendar","group":"Resources"},{"slug":"pricing","label":"Fees","group":"Firm"},{"slug":"team","label":"Team","group":"Firm"},{"slug":"resources","label":"Guides","group":"Resources"},{"slug":"contact","label":"Free consultation","group":"Resources"},{"slug":"faq","label":"FAQ","group":"Resources"},{"slug":"privacy","label":"Privacy policy","group":"Utility"},{"slug":"404","label":"404 error","group":"Utility"}],"nav":"<span data-dl-template=\"accounting-firm\" hidden></span><style>/* Shared, exported template behaviour. Scope additions to enhanced fragments. */\n.dl-mobile{display:none}.dl-skip{position:fixed;left:16px;top:-100px;z-index:10000;padding:12px 18px;background:var(--c-surface);color:var(--c-text);border:2px solid var(--c-accent)}.dl-skip:focus{top:12px}\n.nav:has(details[open]){overflow:visible!important}.dl-filter-empty{padding:28px;border:1px dashed var(--c-border);border-radius:var(--radius);margin-top:20px}\n.products>[hidden],.dl-filter-empty[hidden]{display:none!important}\n/* A grid item's default min-content size must not widen its whole page. */\nmain :where(*){min-width:0}\n.more.dl-menu-op