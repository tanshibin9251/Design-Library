isplay:none}\n.dl-visual{position:relative;isolation:isolate;overflow:hidden;background:var(--c-border)}.dl-visual:before,.dl-visual:after{display:none!important}.dl-visual>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1}.dl-visual>span{position:relative;z-index:1}.dl-photo-failed>img{display:none}.dl-photo-failed:after{display:grid!important;position:absolute;inset:0;place-items:center;content:'Image unavailable · 缺图';padding:16px;background:var(--c-surface);color:var(--c-text);font:500 14px var(--f-body)}\n.dl-stock-label{position:absolute;left:10px;bottom:10px;padding:4px 8px;max-width:calc(100% - 20px);background:var(--c-surface);color:var(--c-text);font-size:11px;line-height:1.5;border-radius:4px}.dl-credits{padding:20px 0;font-size:13px}.dl-credits summary{cursor:pointer;min-height:44px;display:flex;align-items:center}.dl-credits li{margin-block:8px}.dl-credits a{overflow-wrap:anywhere}\n:where(button,a,input,select,textarea,summary):focus-visible{outline:3px solid var(--c-accent);outline-offset:4px}\n@media(max-width:820px){.dl-mobile{display:block;position:relative}.dl-mobile summary{display:flex;align-items:center;justify-content:center;min-width:64px;min-height:44px;padding:8px 12px;border:1px solid var(--c-border);border-radius:var(--radius);cursor:pointer;list-style:none;font:600 14px var(--f-body)}.dl-mobile summary::-webkit-details-marker{display:none}.dl-mobile-links{position:fixed;top:74px;left:12px;right:12px;z-index:9999;max-height:75dvh;overflow:auto;background:var(--c-surface);color:var(--c-text);padding:16px 20px;border:1px solid var(--c-border);border-radius:var(--radius);box-shadow:0 16px 40px #0002}.dl-mobile-links a{display:flex;align-items:center;min-height:44px;text-decoration:none}.dl-mobile-links h4{font-size:12px;margin:18px 0 4px;color:var(--c-secondary)}.burger summary,.bmenu a{min-height:44px}.burger summary{display:flex;align-items:center}.burger:not([open])>.bmenu{display:none}.btn,.chip,.qty button{min-height:44px}.qty button{min-width:44px}[data-dl-footer] .cols{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}[data-dl-footer] .cols>div:first-child{grid-column:1/-1}.pdp,.split{min-width:0}.pdp>*{min-width:0}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n</style><a class=\"dl-skip\" href=\"#dl-content\">Skip to content</a><style>\n/* Kissa Maruyo — Showa-era coffee house, tokens only */\n.ks-awning{height:30px;background:repeating-linear-gradient(90deg,var(--c-accent) 0 48px,var(--c-surface) 48px 96px);position:relative;border-bottom:3px solid var(--c-primary)}\n.ks-awning::after{content:\"\";position:absolute;left:0;right:0;top:100%;height:24px;background:\n radial-gradient(circle at 24px 0,var(--c-accent) 23px,transparent 24px) 0 0/96px 24px,\n radial-gradient(circle at 72px 0,var(--c-surface) 23px,var(--c-primary) 23px 26px,transparent 26px) 0 0/96px 24px;z-index:2;pointer-events:none}\n.ks-head{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:34px clamp(18px,4vw,60px) 14px;position:relative}\n.ks-plate{display:flex;align-items:center;gap:14px;text-decoration:none;color:var(--c-primary);border:3px double var(--c-primary);padding:8px 20px;border-radius:14px;background:var(--c-surface)}\n.ks-plate b{font:400 30px var(--f-head);letter-spacing:.1em;line-height:1}\n.ks-plate small{display:block;font:500 10px var(--f-body);letter-spacing:.3em;color:var(--c-secondary);margin-top:4px}\n.ks-tabs{display:flex;gap:6px;list-style:none;flex-wrap:wrap;justify-content:center}\n.ks-tabs a{display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border:2px solid var(--c-primary);border-radius:999px;text-decoration:none;font:500 14px var(--f-body);letter-spacing:.06em;color:var(--c-primary);background:var(--c-surface);transition:background .2s,color .2s}\n.ks-tabs a:hover{background:var(--c-primary);color:var(--on-primary)}\n.ks-tabs .more{position:relative}\n.ks-tabs .dd{position:absolute;right:0;top:calc(100% + 8px);display:none;grid-template-columns:repeat(4,minmax(120px,1fr));gap:18px 28px;padding:22px 26px;background:var(--c-surface);border:3px double var(--c-primary);border-radius:14px;min-width:600px;z-index:60}\n.ks-tabs .more:hover .dd,.ks-tabs .more:focus-within .dd{display:grid}\n.ks-tabs .dd h4{font:700 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-secondary);margin-bottom:6px}\n.ks-tabs .dd a{display:block;border:0;border-radius:0;min-height:0;padding:5px 0;background:none;color:var(--c-text)}\n.ks-tabs .dd a:hover{background:none;color:var(--c-accent)}\n.ks-sign{display:grid;place-items:center;min-width:92px;min-height:44px;padding:0 14px;border-radius:8px;background:var(--c-primary);color:var(--on-primary);font:400 18px var(--f-head);letter-spacing:.12em}\n.ks-sign.off{background:transparent;color:var(--c-secondary);border:2px dashed var(--c-secondary)}\n.ks-m{display:none}.ks-m summary{list-style:none;cursor:pointer;min-height:44px;min-width:44px;display:grid;place-items:center;font:600 12px var(--f-body);letter-spacing:.18em;border:2px solid var(--c-primary);border-radius:999px;padding:0 16px}\n.ks-m summary::-webkit-details-marker{display:none}\n.ks-m nav{position:absolute;left:12px;right:12px;top:100%;background:var(--c-surface);border:3px double var(--c-primary);border-radius:14px;padding:10px 18px;display:grid;z-index:60}\n.ks-m nav a{padding:12px 4px;border-bottom:1px dotted var(--c-secondary);text-decoration:none;font:500 15px var(--f-body);min-height:44px}\n@media(max-width:960px){.ks-head{flex-wrap:wrap}.ks-tabs{display:none}.ks-m{display:block;margin-left:auto}.ks-sign{order:3}}\n\n.ks-sec{padding:var(--pad) clamp(20px,5vw,80px)}\n.ks-hd{display:flex;align-items:center;gap:16px;margin-bottom:30px}\n.ks-hd h2{font:400 clamp(26px,3.4vw,40px) var(--f-head);letter-spacing:.1em;color:var(--c-primary)}\n.ks-hd::before,.ks-hd::after{content:\"\";flex:1;height:0;border-top:3px double var(--c-primary)}\n.ks-hd::before{max-width:60px}\n.ks-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8em 2em;border-radius:999px;border:3px solid var(--c-primary);background:var(--c-primary);color:var(--on-primary);font:600 15px var(--f-body);letter-spacing:.1em;text-decoration:none;cursor:pointer;box-shadow:4px 4px 0 var(--c-accent);transition:transform .15s,box-shadow .15s}\n.ks-btn:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--c-accent)}\n.ks-btn.o{background:var(--c-surface);color:var(--c-primary)}\n.ks-ph{position:relative;min-height:240px;border:3px solid var(--c-primary);border-radius:12px;background:\n radial-gradient(circle at 30% 30%,color-mix(in srgb,var(--c-surface) 55%,transparent) 0 10%,transparent 11%),\n repeating-linear-gradient(135deg,color-mix(in srgb,var(--c-secondary) 22%,var(--c-surface)) 0 12px,color-mix(in srgb,var(--c-secondary) 12%,var(--c-surface)) 12px 24px)}\n.ks-ph::after{content:attr(data-l);position:absolute;left:12px;bottom:10px;font:600 10px var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:var(--c-primary);background:var(--c-surface);padding:2px 8px;border-radius:999px}\n\n.ks-hero{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(24px,5vw,80px);padding:clamp(30px,5vw,64px) clamp(20px,5vw,80px) var(--pad);align-items:center}\n.ks-board{background:var(--c-surface);border:4px double var(--c-primary);border-radius:18px;padding:clamp(22px,3.4vw,44px);position:relative;box-shadow:8px 8px 0 color-mix(in srgb,var(--c-primary) 18%,transparent)}\n.ks-board h1{font:400 clamp(34px,5vw,var(--h1)) var(--f-head);letter-spacing:.08em;line-height:1.25;color:var(--c-primary);margin-bottom:6px}\n.ks-board .sub{font:500 13px var(--f-body);letter-spacing:.24em;color:var(--c-secondary);margin-bottom:24px;display:block}\n.ks-it{display:flex;align-items:baseline;gap:10px;padding:9px 0;font:500 17px var(--f-body)}\n.ks-it i{flex:1;border-bottom:3px dotted var(--c-secondary);transform:translateY(-4px);min-width:20px}\n.ks-it b{font:600 17px var(--f-body);color:var(--c-primary);white-space:nowrap}\n.ks-it small{display:block;font:400 12px var(--f-body);color:var(--c-secondary);letter-spacing:.06em}\n.ks-stick{position:absolute;right:-18px;top:-26px;width:104px;height:104px;border-radius:50%;background:var(--c-accent);color:var(--on-accent);display:grid;place-items:center;text-align:center;font:400 15px/1.3 var(--f-head);letter-spacing:.06em;transform:rotate(12deg);border:3px solid var(--c-primary)}\n.ks-today{margin-top:22px;border:2px dashed var(--c-primary);border-radius:12px;padding:14px 18px;display:grid;grid-template-columns:auto 1fr;gap:6px 16px;align-items:center;background:color-mix(in srgb,var(--c-accent) 10%,var(--c-surface))}\n.ks-today span{font:600 11px var(--f-body);letter-spacing:.24em;color:var(--c-accent)}\n.ks-today b{font:400 22px var(--f-head);letter-spacing:.08em;color:var(--c-primary)}\n.ks-today em{grid-column:1/-1;font:400 14px var(--f-body);font-style:normal;color:var(--c-text);opacity:.85}\n.ks-hero .ks-ph{aspect-ratio:4/5;min-height:300px;transform:rotate(1.4deg);box-shadow:8px 8px 0 var(--c-primary)}\n@media(max-width:900px){.ks-hero{grid-template-columns:1fr}.ks-stick{right:10px;top:-30px}.ks-hero .ks-ph{aspect-ratio:16/10;transform:none}}\n\n.ks-3{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2.4vw,30px)}\n.ks-card{border:3px solid var(--c-primary);border-radius:16px;background:var(--c-surface);padding:26px 24px;display:grid;gap:10px;align-content:start;position:relative}\n.ks-card h3{font:400 24px var(--f-head);letter-spacing:.08em;color:var(--c-primary)}\n.ks-card .pr{font:700 20px var(--f-body);color:var(--c-accent)}\n.ks-card p{font-size:15px;line-height:1.8;opacity:.85}\n.ks-card .tag{position:absolute;right:16px;top:-14px;background:var(--c-accent);color:var(--on-accent);border:2px solid var(--c-primary);border-radius:999px;padding:2px 14px;font:700 12px var(--f-body);letter-spacing:.14em}\n@media(max-width:800px){.ks-3{grid-template-columns:1fr}}\n.ks-menu{display:grid;grid-template-columns:1fr 1fr;gap:0 clamp(30px,6vw,90px)}\n.ks-menu h3{font:400 26px var(--f-head);letter-spacing:.14em;color:var(--c-primary);margin:30px 0 8px;padding-bottom:8px;border-bottom:3px solid var(--c-primary)}\n@media(max-width:800px){.ks-menu{grid-template-columns:1fr}}\n.ks-split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,80px);align-items:center}\n.ks-split h2{font:400 clamp(28px,3.6vw,var(--h2)) var(--f-head);letter-spacing:.08em;color:var(--c-primary);margin-bottom:14px}\n.ks-split p{line-height:2;max-width:46ch}\n@media(max-width:800px){.ks-split{grid-template-columns:1fr}}\n.ks-hours{width:100%;border-collapse:collapse;font:500 16px var(--f-body)}\n.ks-hours td,.ks-hours th{padding:14px 8px;border-bottom:2px dotted var(--c-secondary);text-align:left}\n.ks-hours th{font:400 18px var(--f-head);letter-spacing:.12em;color:var(--c-primary)}\n.ks-hours tr.off td{color:var(--c-secondary)}\n.ks-gal{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}\n.ks-gal .ks-ph{min-height:0;aspect-ratio:1}.ks-gal .w{grid-column:span 2}\n@media(max-width:700px){.ks-gal{grid-template-columns:1fr 1fr}}\n.ks-note{display:grid;grid-template-columns:130px 1fr;gap:20px;padding:20px 0;border-bottom:2px dotted var(--c-secondary);text-decoration:none;align-items:baseline}\n.ks-note time{font:600 13px var(--f-body);letter-spacing:.14em;color:var(--c-accent)}\n.ks-note h3{font:400 20px var(--f-head);letter-spacing:.06em}\n@media(max-width:600px){.ks-note{grid-template-columns:1fr;gap:4px}}\n.ks-foot{background:var(--c-primary);color:var(--on-primary);padding:clamp(40px,5vw,70px) clamp(20px,5vw,80px) 26px;margin-top:var(--pad)}\n.ks-foot .top{display:grid;grid-template-columns:1.2fr 2fr;gap:clamp(24px,6vw,100px)}\n.ks-foot .big{font:400 32px var(--f-head);letter-spacing:.14em}\n.ks-foot h4{font:700 11px var(--f-body);letter-spacing:.2em;text-transform:uppercase;opacity:.7;margin-bottom:10px;color:var(--on-primary)}\n.ks-foot ul{list-style:none}.ks-foot li a{display:inline-block;padding:6px 0;text-decoration:none;font-size:14px;opacity:.9;min-height:32px}\n.ks-foot .cols{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}\n.ks-foot .copy{margin-top:34px;padding-top:16px;border-top:2px dotted color-mix(in srgb,var(--on-primary) 40%,transparent);font-size:12px;letter-spacing:.14em;opacity:.75}\n@media(max-width:800px){.ks-foot .top{grid-template-columns:1fr}.ks-foot .cols{grid-template-columns:1fr 1fr}}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}\n@media(max-width:700px){.ks-sec{padding-left:18px;padding-right:18px}}\n@media(prefers-reduced-motion:reduce){.ks-btn{transition:none}}\n</style><div class=\"ks-awning\"></div><header class=\"ks-head\"><a class=\"ks-plate\" href=\"{{p:home}}\"><b>喫茶 まるよ</b><span><small>KISSA MARUYO</small></span></a><ul class=\"ks-tabs\"><li><a href=\"{{p:menu}}\">お品書き Menu</a></li><li><a href=\"{{p:morning}}\">モーニング</a></li><li><a href=\"{{p:beans}}\">珈琲豆 Beans</a></li><li><a href=\"{{p:access}}\">場所 Access</a></li><li class=\"more\"><a href=\"#\" tabindex=\"0\">他 More</a><div class=\"dd\"><div><h4>Café</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:menu}}\">Menu</a><a href=\"{{p:morning}}\">Morning set</a><a href=\"{{p:beans}}\">Roasted beans</a></div><div><h4>Shop</h4><a href=\"{{p:story}}\">Our story</a><a href=\"{{p:gallery}}\">Gallery</a><a href=\"{{p:news}}\">Notice board</a></div><div><h4>Visit</h4><a href=\"{{p:access}}\">Access & hours</a><a href=\"{{p:faq}}\">FAQ</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li></ul><span class=\"ks-sign\" id=\"ks-sign\">営業中</span><details class=\"ks-m\"><summary>MENU</summary><nav><a href=\"{{p:home}}\">Home</a><a href=\"{{p:menu}}\">Menu</a><a href=\"{{p:morning}}\">Morning set</a><a href=\"{{p:beans}}\">Roasted beans</a><a href=\"{{p:story}}\">Our story</a><a href=\"{{p:gallery}}\">Gallery</a><a href=\"{{p:news}}\">Notice board</a><a href=\"{{p:access}}\">Access & hours</a><a href=\"{{p:faq}}\">FAQ</a><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></nav></details></header>\n<style>/* Export mobile sizing: let grid items shrink within their tracks. */@media(max-width:820px){.ks-hero>*{min-width:0}.ks-board{max-width:100%}.ks-hero p{overflow-wrap:break-word}}</style>\n<script>/* Runs in previews AND exported files. No requests, credentials or submissions. */\n(function(){\n 'use strict';\n function start(){\n  var root=document.querySelector('[data-dl-template]');if(!root)return;\n  document.querySelectorAll('[data-dl-demo-form]').forEach(function(form,index){\n   if(form.dataset.dlBound)return;form.dataset.dlBound='1';\n   var note=document.createElement('p');note.className='dl-form-note';note.textContent='Interactive demo · Nothing is sent. Use sample details only. No account, booking or payment will be created.';form.prepend(note);\n   var result=document.createElement('p');result.className='dl-feedback';result.setAttribute('role','status');result.setAttribute('aria-live','polite');result.hidden=true;form.append(result);\n   form.querySelectorAll('input,textarea,select').forEach(function(input,i){\n    if(!input.name)input.name='demo-'+index+'-'+i;\n    var label=input.closest('label'),text=(label?label.textContent:input.placeholder||'').toLowerCase();\n    if(/name|email|message|date|time/.test(text)&&!/optional/.test(text))input.required=true;\n    if(input.type==='password')input.autocomplete='new-password';\n    if(/card number|cvc|expiry/.test(text)){input.disabled=true;input.placeholder='Disabled in demo';}\n   });\n   function submit(e){if(e)e.preventDefault();if(!form.reportValidity())return;result.hidden=false;result.textContent='Demo complete. Your entries passed the browser checks. Nothing was sent, charged, booked or stored.';}\n   form.addEventListener('submit',submit);\n   if(!form.querySelector('[type=\"submit\"],button:not([type])')){var buttons=form.querySelectorAll('button[type=\"button\"]');if(buttons.length===1)buttons[0].addEventListener('click',submit);}\n  });\n  document.querySelectorAll('.dl-visual img').forEach(function(img){img.addEventListener('error',function(){img.parentElement.classList.add('dl-photo-failed')});if(img.complete&&!img.naturalWidth)img.parentElement.classList.add('dl-photo-failed')});\n  document.querySelectorAll('.shoptop').forEach(function(top){\n   var grid=top.nextElementSibling;if(!grid||!grid.matches('.products'))return;\n   var cards=Array.from(grid.children),chips=Array.from(top.querySelectorAll('.chip')),sort=top.querySelector('select'),category='All';\n   var empty=document.createElement('p');empty.className='dl-filter-empty';empty.textContent='No sample items match this category. Choose All to see the collection.';empty.hidden=true;grid.after(empty);\n   function update(){var shown=0;cards.forEach(function(card){var tag=card.querySelector('small');card.hidden=category!=='All'&&(!tag||tag.textContent.trim()!==category);if(!card.hidden)shown++});empty.hidden=shown!==0;var count=top.querySelector('.sort span');if(count)count.textContent=shown+' sample items';}\n   chips.forEach(function(chip){chip.type='button';chip.setAttribute('aria-pressed',chip.classList.contains('on'));chip.addEventListener('click',function(){category=chip.textContent.trim();chips.forEach(function(c){c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',c===chip)});update()})});\n   if(sort){sort.setAttribute('aria-label','Sort sample items');Array.from(sort.options).forEach(function(o){if(/newest/i.test(o.textContent))o.textContent='Reverse featured'});sort.addEventListener('change',function(){var ordered=cards.slice();if(sort.selectedIndex===1||sort.selectedIndex===2){ordered.sort(function(a,b){function price(c){var p=c.querySelector('.price');return Number((p?p.textContent:'').replace(/[^0-9.]/g,''))||0}return price(a)-price(b)});if(sort.selectedIndex===2)ordered.reverse()}else if(sort.selectedIndex===3)ordered.reverse();ordered.forEach(function(card){grid.append(card)})})}\n  });\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.burger[open],.dl-mobile[open],.nav details[open]').forEach(function(menu){menu.open=false;var summary=menu.querySelector('summary');if(summary)summary.focus()})});\n  document.addEventListener('click',function(e){var a=e.target.closest('.dl-mobile a,.bmenu a');if(a){var menu=a.closest('details');if(menu)menu.open=false;}});\n  document.querySelectorAll('.more>a[href=\"#\"]').forEach(function(a){a.setAttribute('role','button');a.setAttribute('aria-expanded','false');function set(open){a.parentElement.classList.toggle('dl-menu-open',open);a.setAttribute('aria-expanded',open)}function toggle(e){e.preventDefault();set(a.getAttribute('aria-expanded')!=='true')}a.addEventListener('click',toggle);a.addEventListener('keydown',function(e){if(e.key===' ')toggle(e)});a.parentElement.addEventListener('mouseenter',function(){set(true)});a.parentElement.addEventListener('mouseleave',function(){if(!a.parentElement.contains(document.activeElement))set(false)})});\n  document.addEventListener('click',function(e){var a=e.target.closest('a[href=\"#\"]');if(!a||e.defaultPrevented||a.onclick||a.closest('.more'))return;e.preventDefault();var note=a.parentElement.querySelector(':scope>.dl-missing-link');if(!note){note=document.createElement('p');note.className='dl-feedback dl-missing-link';note.setAttribute('role','status');a.after(note)}note.textContent='Demonstration link. Add the real destination before launching this site.'});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.dl-menu-open').forEach(function(menu){menu.classList.remove('dl-menu-open');var a=menu.querySelector(':scope>a');if(a){a.setAttribute('aria-expanded','false');a.focus()}})});\n  document.querySelectorAll('.dl-skip').forEach(function(link){link.addEventListener('click',function(e){e.preventDefault();var target=document.querySelector('main.on [data-dl-content],main:not([data-page]) [data-dl-content]');if(target){target.focus();target.scrollIntoView({block:'start'})}})});\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>/* Sample commerce only: local item choices, quantities and consistent totals. */\n(function(){\n 'use strict';\n function start(){\n  var marker=document.querySelector('[data-dl-template]');if(!marker||marker.dataset.dlTemplate==='restaurant-warm')return;\n  var carts=Array.from(document.querySelectorAll('.cart')).filter(function(x){return x.querySelector('.crow')}),details=Array.from(document.querySelectorAll('.pdp,[data-dl-product]')).filter(function(x){return x.querySelector('.pinfo .price')}),checkouts=Array.from(document.querySelectorAll('aside.side-card')).filter(function(x){return x.querySelector('.kv')&&x.previousElementSibling&&x.previousElementSibling.querySelector('form')});\n  if(!carts.length&&!details.length&&!checkouts.length)return;\n  var currency='RM ',rows=[],key='dl-sample-cart:'+marker.dataset.dlTemplate;\n  function amount(text){return Number(String(text).replace(/[^0-9.]/g,''))||0}\n  function money(n){return currency+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function item(name,price,qty){return {name:String(name).slice(0,120),price:Math.max(0,Math.min(10000000,price)),qty:Math.max(1,Math.min(99,qty))}}\n  if(carts.length){rows=Array.from(carts[0].querySelectorAll('.crow')).map(function(row){var p=row.querySelector(':scope>b'),h=row.querySelector('h3'),q=row.querySelector('.qty span');if(p){currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' '}return item(h?h.textContent:'Sample item',amount(p?p.textContent:0),amount(q?q.textContent:1)||1)})}\n  else if(checkouts.length){rows=Array.from(checkouts[0].querySelectorAll('.kv li:not(.tot)')).filter(function(row){return row.querySelector('b')&&amount(row.querySelector('b').textContent)>0&&!/tax|shipping|delivery|subtotal|fee/i.test(row.textContent)}).map(function(row){var p=row.querySelector('b');currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' ';return item(row.querySelector('span').textContent,amount(p.textContent),1)})}\n  try{var saved=JSON.parse(localStorage.getItem(key));if(saved&&Array.isArray(saved.rows)&&saved.rows.length<=100){rows=saved.rows.filter(function(r){return typeof r.name==='string'&&Number.isFinite(r.price)&&r.price>=0&&Number.isInteger(r.qty)&&r.qty>0&&r.qty<=99}).map(function(r){return item(r.name,r.price,r.qty)});if(typeof saved.currency==='string'&&/^[A-Z$€£¥ ]{1,8}$/.test(saved.currency))currency=saved.currency;}}catch(e){}\n  function save(){try{localStorage.setItem(key,JSON.stringify({currency:currency,rows:rows}))}catch(e){}}\n  function totals(){var sub=rows.reduce(function(sum,r){return sum+r.price*r.qty},0);return {subtotal:sub,total:sub}}\n  function makeLine(label,value,total){var li=document.createElement('li');if(total)li.className='tot';var span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=value;li.append(span,b);return li}\n  function render(){\n   document.querySelectorAll('header a[href]').forEach(function(a){var match=a.textContent.trim().match(/^(Cart|Bag)\\s*\\(\\d+\\)$/i);if(match)a.textContent=match[1]+' ('+rows.reduce(function(sum,r){return sum+r.qty},0)+')'});\n   carts.forEach(function(cart){cart.querySelectorAll('.crow,.dl-cart-empty').forEach(function(r){r.remove()});rows.forEach(function(row,i){var el=document.createElement('div');el.className='crow';el.dataset.dlCartRow=i;var spacer=document.createElement('div'),info=document.createElement('div'),h=document.createElement('h3'),small=document.createElement('small');h.textContent=row.name;small.textContent=money(row.price)+' each · sample item';info.append(h,small);var qty=document.createElement('div');qty.className='qty';[-1,1].forEach(function(change){var b=document.createElement('button');b.type='button';b.dataset.dlCartChange=change;b.textContent=change<0?'−':'+';b.setAttribute('aria-label',(change<0?'Decrease ':'Increase ')+row.name);if(change>0){var value=document.createElement('span');value.textContent=row.qty;qty.append(value)}qty.append(b)});var price=document.createElement('b');price.textContent=money(row.price*row.qty);var remove=document.createElement('button');remove.type='button';remove.className='btn ghost';remove.dataset.dlCartRemove='';remove.textContent='Remove';remove.setAttribute('aria-label','Remove '+row.name);el.append(spacer,info,qty,price,remove);cart.insertBefore(el,cart.querySelector(':scope>a'))});if(!rows.length){var empty=document.createElement('p');empty.className='dl-cart-empty';empty.setAttribute('role','status');empty.textContent='Your sample cart is empty. Browse the collection to add an item.';cart.prepend(empty)}var aside=cart.parentElement.querySelector('aside.side-card');if(aside){var list=aside.querySelector('.kv');if(list){list.replaceChildren(makeLine('Subtotal',money(totals().subtotal)),makeLine('Demo delivery / fees','Not applied'),makeLine('Total',money(totals().total),true))}var note=aside.querySelector('p');if(note)note.textContent='Local sample cart. Real delivery, tax and payment must be configured before launch.'}});\n   checkouts.forEach(function(aside){var list=aside.querySelector('.kv');list.replaceChildren();rows.forEach(function(r){list.append(makeLine(r.qty+' × '+r.name,money(r.price*r.qty)))});list.append(makeLine('Total · demo only',money(totals().total),true));var form=aside.parentElement.querySelector('form'),button=form&&form.querySelector('[type=submit]');if(button){button.textContent=rows.length?'Preview checkout · '+money(totals().total):'Add an item before checkout';button.disabled=!rows.length}});\n  }\n  details.forEach(function(detail){detail.querySelectorAll('.qty button').forEach(function(b){b.type='button';b.setAttribute('aria-label',b.textContent.trim()==='+'?'Increase quantity':'Decrease quantity')});detail.querySelectorAll('.chips .chip').forEach(function(b){b.type='button';b.setAttribute('aria-pressed',b.classList.contains('on'));b.addEventListener('click',function(){b.parentElement.querySelectorAll('.chip').forEach(function(x){x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)})})})});\n  document.addEventListener('click',function(e){var row=e.target.closest('[data-dl-cart-row]');if(row){var index=Number(row.dataset.dlCartRow),change=e.target.closest('[data-dl-cart-change]');if(e.target.closest('[data-dl-cart-remove]'))rows.splice(index,1);else if(change&&rows[index])rows[index].qty=Math.max(1,Math.min(99,rows[index].qty+Number(change.dataset.dlCartChange)));save();render();return}\n   var detail=e.target.closest('.pdp,[data-dl-product]');if(!detail)return;var button=e.target.closest('.qty button');if(button&&!button.onclick){var span=button.parentElement.querySelector('span');if(span)span.textContent=Math.max(1,Math.min(99,amount(span.textContent)+(button.textContent.trim()==='+'?1:-1)))}\n   var link=e.target.closest('.buy a,[data-dl-add]');if(link&&!e.defaultPrevented&&link.getAttribute('aria-disabled')!=='true'&&/cart(?:\\.|$)|#\\/cart/.test(link.getAttribute('href')||'')){var h=detail.querySelector('.pinfo h1'),price=detail.querySelector('.pinfo .price'),q=detail.querySelector('.qty span');if(h&&price){var chosen=Array.from(detail.querySelectorAll('.pinfo .chip.on,.pinfo .ok-finish [aria-pressed=true]')).map(function(b){return b.getAttribute('aria-label')||b.textContent.trim()}),name=h.textContent+(chosen.length?' · '+chosen.join(' / '):''),quantity=amount(q?q.textContent:1)||1,found=rows.find(function(r){return r.name===name});if(found)found.qty=Math.min(99,found.qty+quantity);else rows.push(item(name,amount(price.textContent),quantity));save();render()}}\n  });\n  render();\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script>","foot":"<footer data-dl-footer class=\"ks-foot\"><div class=\"top\"><div><div class=\"big\">喫茶 まるよ</div><p style=\"margin-top:12px;font-size:14px;line-height:1.9;opacity:.85\">Siphon coffee, hot sandwiches and cream soda since 1974. Template demo content.</p></div><div class=\"cols\"><div><h4>Café</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:menu}}\">Menu</a></li><li><a href=\"{{p:morning}}\">Morning set</a></li><li><a href=\"{{p:beans}}\">Roasted beans</a></li></ul></div><div><h4>Shop</h4><ul><li><a href=\"{{p:story}}\">Our story</a></li><li><a href=\"{{p:gallery}}\">Gallery</a></li><li><a href=\"{{p:news}}\">Notice board</a></li></ul></div><div><h4>Visit</h4><ul><li><a href=\"{{p:access}}\">Access & hours</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div></div><div class=\"copy\">© 2026 KISSA MARUYO · OPEN 07:00–18:00 · CLOSED MONDAYS</div><div class=\"wrap\"><details class=\"dl-credits\"><summary>Illustrative photography &amp; credits</summary><p>Stock references for layout demonstration; replace before customer launch. Remote images require internet access.</p><ul><li><a href=\"https://unsplash.com/photos/barista-prepares-coffee-with-siphon-brewer-in-cafe-EPNMqEzb7AY\" target=\"_blank\" rel=\"noopener noreferrer\">Barista prepares coffee with siphon brewer in cafe</a> — Harman Tatla</li></ul><a href=\"https://unsplash.com/license\" target=\"_blank\" rel=\"noopener noreferrer\">Unsplash licence</a></details></div></footer><script>(function(){var s=document.getElementById(\"ks-sign\");if(!s)return;var d=new Date(),h=d.getHours()+d.getMinutes()/60,o=d.getDay()!==1&&h>=7&&h<18;s.textContent=o?\"営業中\":(d.getDay()===1?\"定休日\":\"準備中\");s.className=\"ks-sign\"+(o?\"\":\" off\")})();</script>","pages":{"home":"<div tabindex=\"-1\" data-dl-content><section class=\"ks-hero\"><div class=\"ks-board\"><span class=\"ks-stick\">朝7時<br>から</span><span class=\"sub\">SIPHON COFFEE · TOAST · CREAM SODA</span><h1>珈琲と、<br>ひと休み。</h1>\n<div class=\"ks-it\"><span>Blend coffee <small>ブレンド</small></span><i></i><b>RM 9</b></div><div class=\"ks-it\"><span>Hot egg sandwich <small>玉子サンド</small></span><i></i><b>RM 14</b></div><div class=\"ks-it\"><span>Napolitan <small>ナポリタン</small></span><i></i><b>RM 18</b></div><div class=\"ks-it\"><span>Cream soda <small>クリームソーダ</small></span><i></i><b>RM 13</b></div><div class=\"ks-it\"><span>Pudding à la mode <small>プリンアラモード</small></span><i></i><b>RM 16</b></div>\n<div class=\"ks-today\"><span>TODAY'S SPECIAL · 本日のおすすめ</span><b id=\"ks-sp\">—</b><em id=\"ks-sd\"></em></div>\n<p style=\"margin-top:26px;display:flex;gap:12px;flex-wrap:wrap\"><a class=\"ks-btn\" href=\"{{p:menu}}\">全メニュー</a><a class=\"ks-btn o\" href=\"{{p:access}}\">場所と営業時間</a></p></div>\n<div class=\"ks-ph dl-visual\" data-l=\"Illustrative stock reference\" data-dl-photo-edition><img src=\"https://images.unsplash.com/photo-1774014045872-3cc2b5e7e816?auto=format&amp;fit=crop&amp;w=1920&amp;h=1280&amp;q=85\" alt=\"Barista prepares coffee with siphon brewer in cafe\" width=\"1920\" height=\"1280\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\"><span class=\"dl-stock-label\">Illustrative stock image</span></div></section>\n<section class=\"ks-sec\" style=\"padding-top:0\"><div class=\"ks-hd\"><h2>モーニング</h2></div><div class=\"ks-3\"><div class=\"ks-card\"><span class=\"tag\">A</span><h3>Toast set</h3><span class=\"pr\">RM 12</span><p>Thick toast, butter, boiled egg and a cup of blend. Until 11:00.</p></div><div class=\"ks-card\"><span class=\"tag\">B</span><h3>Egg sandwich set</h3><span class=\"pr\">RM 16</span><p>Fluffy omelette sandwich, small salad, blend or milk tea.</p></div><div class=\"ks-card\"><span class=\"tag\">C</span><h3>Rice &amp; miso</h3><span class=\"pr\">RM 15</span><p>Grilled fish, rice, miso soup. For people who want breakfast to be breakfast.</p></div></div></section>\n<section class=\"ks-sec\" style=\"padding-top:0\"><div class=\"ks-split\"><div class=\"ks-ph\" data-l=\"Hand-drip, close (缺图)\"></div><div><h2>一杯ずつ、ネルドリップ。</h2><p>Every cup is dripped by hand through a flannel filter, the way the founder did it in 1974. We roast in small batches on the premises and serve each pot within the hour.</p><p style=\"margin-top:24px\"><a class=\"ks-btn o\" href=\"{{p:story}}\">お店のこと</a></p></div></div></section><script>(function(){var A=[[\"Napolitan Set\",\"Sunday: ketchup spaghetti, salad and a small coffee. RM 22\"],[\"Closed\",\"Monday is our rest day.\"],[\"Curry rice\",\"Tuesday: beef curry, 6-hour onions. RM 20\"],[\"Hot sand + soda\",\"Wednesday: toasted ham & cheese with cream soda. RM 24\"],[\"Katsu sando\",\"Thursday: pork cutlet, cabbage, brown sauce. RM 22\"],[\"Pudding set\",\"Friday: pudding à la mode plus any drink. RM 22\"],[\"Pancake stack\",\"Saturday: three fluffy pancakes, butter and maple. RM 20\"]],d=new Date().getDay(),a=A[d],t=document.getElementById(\"ks-sp\"),e=document.getElementById(\"ks-sd\");if(t){t.textContent=a[0];e.textContent=a[1]}})();</script></div>","menu":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Menu</b></div><h1 style=\"font-family:var(--f-head);letter-spacing:.12em\">お品書き</h1><p class=\"lead\">Prices in RM. Everything is made to order, so please allow a little time.</p></div></section><section class=\"ks-sec\" style=\"padding-top:0\"><div class=\"ks-menu\"><div><h3>珈琲 Coffee</h3><div class=\"ks-it\"><span>Blend <small>ブレンド</small></span><i></i><b>9</b></div><div class=\"ks-it\"><span>Siphon coffee <small>サイフォン</small></span><i></i><b>14</b></div><div class=\"ks-it\"><span>Café au lait <small>カフェオレ</small></span><i></i><b>11</b></div><div class=\"ks-it\"><span>Iced coffee <small>アイスコーヒー</small></span><i></i><b>10</b></div><h3>ソフトドリンク</h3><div class=\"ks-it\"><span>Cream soda <small>クリームソーダ</small></span><i></i><b>13</b></div><div class=\"ks-it\"><span>Milk tea <small>ミルクティー</small></span><i></i><b>10</b></div><div class=\"ks-it\"><span>Orange juice <small>オレンジジュース</small></span><i></i><b>9</b></div></div><div><h3>軽食 Food</h3><div class=\"ks-it\"><span>Hot egg sandwich <small>玉子サンド</small></span><i></i><b>14</b></div><div class=\"ks-it\"><span>Napolitan <small>ナポリタン</small></span><i></i><b>18</b></div><div class=\"ks-it\"><span>Curry rice <small>カレーライス</small></span><i></i><b>18</b></div><div class=\"ks-it\"><span>Toast & butter <small>トースト</small></span><i></i><b>8</b></div><h3>甘味 Sweets</h3><div class=\"ks-it\"><span>Pudding à la mode <small>プリンアラモード</small></span><i></i><b>16</b></div><div class=\"ks-it\"><span>Hot cake <small>ホットケーキ</small></span><i></i><b>14</b></div><div class=\"ks-it\"><span>Coffee jelly <small>コーヒーゼリー</small></span><i></i><b>10</b></div></div></div></section></div>","morning":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Morning set</b></div><h1 style=\"font-family:var(--f-head);letter-spacing:.12em\">モーニング</h1><p class=\"lead\">Served 07:00–11:00, every day we're open.</p></div></section><section class=\"ks-sec\" style=\"padding-top:0\"><div class=\"ks-3\"><div class=\"ks-card\"><span class=\"tag\">A</span><h3>Toast set</h3><span class=\"pr\">RM 12</span><p>Thick toast, butter, boiled egg, coffee or tea.</p></div><div class=\"ks-card\"><span class=\"tag\">B</span><h3>Egg sandwich set</h3><span class=\"pr\">RM 16</span><p>Omelette sandwich, salad, coffee or tea.</p></div><div class=\"ks-card\"><span class=\"tag\">C</span><h3>Rice &amp; miso</h3><span class=\"pr\">RM 15</span><p>Grilled fish, rice, miso soup, pickles.</p></div></div></section></div>","beans":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Roasted beans</b></div><h1 style=\"font-family:var(--f-head);letter-spacing:.12em\">珈琲豆</h1><p class=\"lead\">Roasted on Fridays, packed on Saturdays. Order online or pick up in the shop.</p></div></section><section class=\"ks-sec\" style=\"padding-top:0\"><div class=\"ks-3\"><div class=\"ks-card\"><span class=\"tag\">浅煎り</span><div class=\"ks-ph\" style=\"min-height:160px\" data-l=\"Light roast bag (缺图)\"></div><h3>Morning blend</h3><span class=\"pr\">RM 38 / 200 g</span><p>Bright and clean. Good for toast and for people who dislike bitterness.</p></div><div class=\"ks-card\"><span class=\"tag\">中煎り</span><div class=\"ks-ph\" style=\"min-height:160px\" data-l=\"Medium roast bag (缺图)\"></div><h3>Maruyo blend</h3><span class=\"pr\">RM 42 / 200 g</span><p>Our house cup since 1974. Round, nutty, slightly sweet.</p></div><div class=\"ks-card\"><span class=\"tag\">深煎り</span><div class=\"ks-ph\" style=\"min-height:160px\" data-l=\"Dark roast bag (缺图)\"></div><h3>Night blend</h3><span class=\"pr\">RM 44 / 200 g</span><p>Dark and heavy. Made for milk, or for the last cup of the day.</p></div></div></section></div>","story":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Our story</b></div><h1 style=\"font-family:var(--f-head);letter-spacing:.12em\">お店のこと</h1></div></section><section class=\"ks-sec\" style=\"padding-top:0\"><div class=\"ks-split\"><div class=\"ks-ph\" style=\"min-height:360px\" data-l=\"Founder at the counter, 1974 (缺图)\"></div><div><h2>1974年、六席から。</h2><p>Maruyo opened with six seats, one siphon and a radio. Fifty years on we still have the six seats, and the radio still plays the same station. Replace this with your shop's 