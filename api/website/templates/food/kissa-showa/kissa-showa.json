orm:uppercase;color:var(--c-primary);background:var(--c-surface);padding:2px 8px;border-radius:999px}\n\n.ks-hero{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(24px,5vw,80px);padding:clamp(30px,5vw,64px) clamp(20px,5vw,80px) var(--pad);align-items:center}\n.ks-board{background:var(--c-surface);border:4px double var(--c-primary);border-radius:18px;padding:clamp(22px,3.4vw,44px);position:relative;box-shadow:8px 8px 0 color-mix(in srgb,var(--c-primary) 18%,transparent)}\n.ks-board h1{font:400 clamp(34px,5vw,var(--h1)) var(--f-head);letter-spacing:.08em;line-height:1.25;color:var(--c-primary);margin-bottom:6px}\n.ks-board .sub{font:500 13px var(--f-body);letter-spacing:.24em;color:var(--c-secondary);margin-bottom:24px;display:block}\n.ks-it{display:flex;align-items:baseline;gap:10px;padding:9px 0;font:500 17px var(--f-body)}\n.ks-it i{flex:1;border-bottom:3px dotted var(--c-secondary);transform:translateY(-4px);min-width:20px}\n.ks-it b{font:600 17px var(--f-body);color:var(--c-primary);white-space:nowrap}\n.ks-it small{display:block;font:400 12px var(--f-body);color:var(--c-secondary);letter-spacing:.06em}\n.ks-stick{position:absolute;right:-18px;top:-26px;width:104px;height:104px;border-radius:50%;background:var(--c-accent);color:var(--on-accent);display:grid;place-items:center;text-align:center;font:400 15px/1.3 var(--f-head);letter-spacing:.06em;transform:rotate(12deg);border:3px solid var(--c-primary)}\n.ks-today{margin-top:22px;border:2px dashed var(--c-primary);border-radius:12px;padding:14px 18px;display:grid;grid-template-columns:auto 1fr;gap:6px 16px;align-items:center;background:color-mix(in srgb,var(--c-accent) 10%,var(--c-surface))}\n.ks-today span{font:600 11px var(--f-body);letter-spacing:.24em;color:var(--c-accent)}\n.ks-today b{font:400 22px var(--f-head);letter-spacing:.08em;color:var(--c-primary)}\n.ks-today em{grid-column:1/-1;font:400 14px var(--f-body);font-style:normal;color:var(--c-text);opacity:.85}\n.ks-hero .ks-ph{aspect-ratio:4/5;