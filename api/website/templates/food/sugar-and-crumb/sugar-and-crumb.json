play:none}\n.dl-visual{position:relative;isolation:isolate;overflow:hidden;background:var(--c-border)}.dl-visual:before,.dl-visual:after{display:none!important}.dl-visual>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1}.dl-visual>span{position:relative;z-index:1}.dl-photo-failed>img{display:none}.dl-photo-failed:after{display:grid!important;position:absolute;inset:0;place-items:center;content:'Image unavailable · 缺图';padding:16px;background:var(--c-surface);color:var(--c-text);font:500 14px var(--f-body)}\n.dl-stock-label{position:absolute;left:10px;bottom:10px;padding:4px 8px;max-width:calc(100% - 20px);background:var(--c-surface);color:var(--c-text);font-size:11px;line-height:1.5;border-radius:4px}.dl-credits{padding:20px 0;font-size:13px}.dl-credits summary{cursor:pointer;min-height:44px;display:flex;align-items:center}.dl-credits li{margin-block:8px}.dl-credits a{overflow-wrap:anywhere}\n:where(button,a,input,select,textarea,summary):focus-visible{outline:3px solid var(--c-accent);outline-offset:4px}\n@media(max-width:820px){.dl-mobile{display:block;position:relative}.dl-mobile summary{display:flex;align-items:center;justify-content:center;min-width:64px;min-height:44px;padding:8px 12px;border:1px solid var(--c-border);border-radius:var(--radius);cursor:pointer;list-style:none;font:600 14px var(--f-body)}.dl-mobile summary::-webkit-details-marker{display:none}.dl-mobile-links{position:fixed;top:74px;left:12px;right:12px;z-index:9999;max-height:75dvh;overflow:auto;background:var(--c-surface);color:var(--c-text);padding:16px 20px;border:1px solid var(--c-border);border-radius:var(--radius);box-shadow:0 16px 40px #0002}.dl-mobile-links a{display:flex;align-items:center;min-height:44px;text-decoration:none}.dl-mobile-links h4{font-size:12px;margin:18px 0 4px;color:var(--c-secondary)}.burger summary,.bmenu a{min-height:44px}.burger summary{display:flex;align-items:center}.burger:not([open])>.bmenu{display:none}.btn,.chip,.qty button{min-height:44px}.qty button{min-width:44px}[data-dl-footer] .cols{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}[data-dl-footer] .cols>div:first-child{grid-column:1/-1}.pdp,.split{min-width:0}.pdp>*{min-width:0}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n</style><a class=\"dl-skip\" href=\"#dl-content\">Skip to content</a><style>\n/* Sugar & Crumb — baking and dessert recipe site, tokens only */\nbody{background-image:radial-gradient(circle,color-mix(in srgb,var(--c-secondary) 55%,transparent) 0 2px,transparent 3px);background-size:34px 34px;background-color:var(--c-surface)}\n.sc-head{text-align:center;padding:clamp(16px,2vw,26px) clamp(14px,4vw,50px) 0;position:relative}\n.sc-logo{display:inline-flex;flex-direction:column;align-items:center;text-decoration:none;color:var(--c-primary)}\n.sc-logo b{font:800 clamp(30px,4vw,48px)/1 var(--f-head);letter-spacing:.01em}\n.sc-logo b span{color:var(--c-accent)}\n.sc-logo small{font:700 11px var(--f-body);letter-spacing:.34em;text-transform:uppercase;margin-top:6px;color:var(--c-secondary)}\n.sc-nav{display:flex;justify-content:center;gap:10px;margin:18px 0 0;list-style:none;flex-wrap:wrap}\n.sc-nav a{display:inline-flex;align-items:center;min-height:46px;padding:0 20px;border-radius:999px 999px 14px 14px;text-decoration:none;font:800 14px var(--f-head);color:var(--c-primary);background:var(--bg,var(--c-secondary));border:2px solid var(--c-primary);border-bottom-width:5px;transition:transform .15s}\n.sc-nav a:hover{transform:translateY(-3px)}\n.sc-nav li:nth-child(1) a{--bg:var(--c-secondary)}.sc-nav li:nth-child(2) a{--bg:var(--c-accent)}.sc-nav li:nth-child(3) a{--bg:color-mix(in srgb,var(--c-primary) 30%,var(--c-surface))}.sc-nav li:nth-child(4) a{--bg:color-mix(in srgb,var(--c-accent) 40%,var(--c-surface))}\n.sc-nav .more{position:relative}\n.sc-nav .dd{position:absolute;left:50%;transform:translateX(-50%);top:calc(100% + 6px);display:none;grid-template-columns:repeat(4,minmax(120px,1fr));gap:14px 26px;padding:20px 24px;background:var(--c-surface);border:2px solid var(--c-primary);border-radius:20px;min-width:580px;z-index:60;text-align:left}\n.sc-nav .more:hover .dd,.sc-nav .more:focus-within .dd{display:grid}\n.sc-nav .dd h4{font:800 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:var(--c-primary);margin-bottom:6px}\n.sc-nav .dd a{display:block;min-height:0;padding:5px 0;border:0;background:none;border-radius:0;font:600 14px var(--f-body)}\n.sc-m{display:none}\n.sc-m summary{list-style:none;cursor:pointer;min-height:44px;min-width:44px;display:grid;place-items:center;border:2px solid var(--c-primary);border-bottom-width:5px;border-radius:999px 999px 14px 14px;padding:0 18px;font:800 13px var(--f-head);letter-spacing:.1em;background:var(--c-secondary);margin:14px auto 0;width:max-content}\n.sc-m summary::-webkit-details-marker{display:none}\n.sc-m nav{display:grid;margin:10px 0 0;background:var(--c-surface);border:2px solid var(--c-primary);border-radius:20px;padding:8px 18px;text-align:left}\n.sc-m nav a{padding:12px 0;border-bottom:2px dotted var(--c-border);text-decoration:none;font:600 15px var(--f-body);min-height:44px}\n@media(max-width:860px){.sc-nav{display:none}.sc-m{display:block}}\n.sc-sec{padding:clamp(34px,5vw,76px) clamp(16px,5vw,80px)}\n.sc-hero{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,5vw,80px);align-items:center;padding:clamp(30px,5vw,70px) clamp(16px,5vw,80px)}\n.sc-hero h1{font:800 clamp(40px,6vw,var(--h1))/1.05 var(--f-head);color:var(--c-primary)}\n.sc-hero h1 em{font-style:normal;color:var(--c-accent);display:inline-block;transform:rotate(-2deg)}\n.sc-hero p{font:600 18px/1.7 var(--f-body);margin:18px 0 26px;max-width:40ch}\n@media(max-width:860px){.sc-hero{grid-template-columns:1fr}}\n.sc-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 28px;border-radius:999px;background:var(--c-primary);color:var(--on-primary);text-decoration:none;font:800 15px var(--f-head);border:2px solid var(--c-primary);border-bottom-width:5px;cursor:pointer}\n.sc-btn:hover{transform:translateY(-2px)}\n.sc-btn.y{background:var(--c-accent);color:var(--on-accent)}.sc-btn.o{background:var(--c-surface);color:var(--c-primary)}\n/* CSS layer cake */\n.sc-cake{width:min(100%,400px);margin:0 auto;position:relative;padding-top:60px}\n.sc-cake .t{height:86px;border-radius:22px 22px 10px 10px;border:3px solid var(--c-primary);position:relative;margin:0 auto}\n.sc-cake .t::before{content:\"\";position:absolute;left:-3px;right:-3px;top:-3px;height:30px;border-radius:22px 22px 0 0;background:var(--c-surface);border:3px solid var(--c-primary);border-bottom:0;clip-path:polygon(0 0,100% 0,100% 100%,92% 60%,84% 100%,76% 60%,68% 100%,60% 60%,52% 100%,44% 60%,36% 100%,28% 60%,20% 100%,12% 60%,4% 100%,0 70%)}\n.sc-cake .t1{width:46%;background:var(--c-secondary);z-index:3;margin-bottom:-3px}\n.sc-cake .t2{width:68%;background:color-mix(in srgb,var(--c-accent) 70%,var(--c-surface));margin-bottom:-3px}\n.sc-cake .t3{width:90%;background:color-mix(in srgb,var(--c-primary) 25%,var(--c-surface))}\n.sc-cake .cherry{position:absolute;left:50%;top:6px;width:42px;height:42px;margin-left:-21px;border-radius:50%;background:var(--c-primary);border:3px solid var(--c-primary)}\n.sc-cake .cherry::before{content:\"\";position:absolute;left:50%;bottom:90%;width:3px;height:22px;background:var(--c-primary);transform:rotate(18deg);transform-origin:bottom}\n.sc-cake .plate{height:18px;width:104%;margin:0 -2%;border-radius:0 0 30px 30px;background:var(--c-primary)}\n.sc-cake .flag{position:absolute;right:0;top:20px;background:var(--c-accent);color:var(--on-accent);font:800 15px var(--f-head);padding:10px 14px;border-radius:14px;border:3px solid var(--c-primary);transform:rotate(8deg)}\n.sc-h{display:flex;align-items:center;gap:14px;margin-bottom:26px;flex-wrap:wrap}\n.sc-h h2{font:800 clamp(26px,3.4vw,var(--h2)) var(--f-head);color:var(--c-primary)}\n.sc-h span{background:var(--c-accent);color:var(--on-accent);border:2px solid var(--c-primary);padding:3px 14px;border-radius:999px;font:800 12px var(--f-head);letter-spacing:.1em}\n.sc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2.4vw,32px)}\n.sc-card{display:grid;text-decoration:none;background:var(--c-surface);border:3px solid var(--c-primary);border-radius:28px;overflow:hidden;transition:transform .2s}\n.sc-card:hover{transform:rotate(-1deg) translateY(-4px)}\n.sc-card .ph{aspect-ratio:5/4;border-bottom:3px solid var(--c-primary);background:radial-gradient(circle at 32% 38%,var(--c1,var(--c-accent)) 0 18%,transparent 19%),radial-gradient(circle at 70% 60%,var(--c2,var(--c-secondary)) 0 24%,transparent 25%),color-mix(in srgb,var(--c-secondary) 35%,var(--c-surface));position:relative}\n.sc-card .ph::after{content:\"缺图\";position:absolute;right:10px;bottom:8px;font:800 10px var(--f-body);letter-spacing:.14em;background:var(--c-surface);padding:2px 8px;border-radius:99px}\n.sc-card .b{padding:18px 20px 22px;display:grid;gap:6px}\n.sc-card h3{font:800 22px/1.15 var(--f-head);color:var(--c-primary)}\n.sc-card .m{display:flex;gap:10px;flex-wrap:wrap;font:700 12px var(--f-body);color:var(--c-primary)}\n.sc-card .m span{background:color-mix(in srgb,var(--c-secondary) 55%,var(--c-surface));padding:3px 10px;border-radius:99px}\n@media(max-width:900px){.sc-grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.sc-grid{grid-template-columns:1fr}}\n/* pan converter */\n.sc-conv{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,4vw,50px);align-items:start}\n@media(max-width:860px){.sc-conv{grid-template-columns:1fr}}\n.sc-box{background:var(--c-surface);border:3px solid var(--c-primary);border-radius:28px;padding:clamp(20px,2.6vw,34px)}\n.sc-box h3{font:800 22px var(--f-head);margin-bottom:14px}\n.sc-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}\n.sc-box label{display:grid;gap:6px;font:800 12px var(--f-body);letter-spacing:.1em;text-transform:uppercase;color:var(--c-primary)}\n.sc-box select,.sc-box input{border:2px solid var(--c-primary);border-radius:14px;background:var(--c-surface);min-height:48px;padding:0 14px;font:700 16px var(--f-body);color:var(--c-text);width:100%}\n.sc-res{background:var(--c-accent);color:var(--on-accent);border-radius:28px;border:3px solid var(--c-primary);padding:clamp(24px,3vw,40px);text-align:center}\n.sc-res .x{font:800 clamp(56px,9vw,100px)/1 var(--f-head)}\n.sc-res p{font:700 16px/1.7 var(--f-body);margin-top:8px}\n.sc-res .t{display:inline-block;margin-top:14px;background:var(--c-surface);color:var(--c-primary);border-radius:999px;padding:6px 18px;font:800 14px var(--f-head)}\n.sc-tbl{width:100%;border-collapse:separate;border-spacing:0;border:3px solid var(--c-primary);border-radius:20px;overflow:hidden;background:var(--c-surface)}\n.sc-tbl th,.sc-tbl td{padding:14px 16px;text-align:left;border-bottom:2px dotted var(--c-secondary);font:600 15px var(--f-body)}\n.sc-tbl th{background:var(--c-secondary);font:800 13px var(--f-head);letter-spacing:.1em;text-transform:uppercase;color:var(--c-primary)}\n.sc-tbl tr:last-child td{border-bottom:0}\n.sc-ing{list-style:none}.sc-ing li{display:flex;justify-content:space-between;padding:10px 0;border-bottom:2px dotted var(--c-secondary);font:700 15px var(--f-body)}\n.sc-steps{counter-reset:s;list-style:none;display:grid;gap:16px}\n.sc-steps li{counter-increment:s;display:grid;grid-template-columns:46px 1fr;gap:14px;font:600 16px/1.8 var(--f-body)}\n.sc-steps li::before{content:counter(s);display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:var(--c-accent);color:var(--on-accent);border:2px solid var(--c-primary);font:800 20px var(--f-head)}\n.sc-foot{background:var(--c-primary);color:var(--on-primary);margin-top:clamp(34px,5vw,80px);border-radius:48px 48px 0 0;padding:clamp(34px,4vw,60px) clamp(16px,5vw,80px) 22px;position:relative}\n.sc-foot .top{display:grid;grid-template-columns:1.1fr 2fr;gap:clamp(24px,6vw,90px)}\n.sc-foot .big{font:800 34px var(--f-head)}\n.sc-foot h4{font:800 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-secondary);margin-bottom:10px}\n.sc-foot ul{list-style:none}.sc-foot li a{display:inline-block;padding:6px 0;text-decoration:none;font:600 14px var(--f-body);min-height:32px}\n.sc-foot .cols{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n.sc-foot .copy{margin-top:26px;font:600 12px var(--f-body);opacity:.75}\n@media(max-width:800px){.sc-foot .top{grid-template-columns:1fr}}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}\n@media(prefers-reduced-motion:reduce){.sc-nav a,.sc-card,.sc-btn{transition:none}}\n</style><header class=\"sc-head\"><a class=\"sc-logo\" href=\"{{p:home}}\"><b>Sugar <span>&amp;</span> Crumb</b><small>Baking &amp; dessert recipes</small></a><ul class=\"sc-nav\"><li><a href=\"{{p:recipes}}\">All bakes</a></li><li><a href=\"{{p:pans}}\">Pan converter</a></li><li><a href=\"{{p:conversions}}\">Conversions</a></li><li><a href=\"{{p:troubleshoot}}\">Why did it sink?</a></li><li class=\"more\"><a href=\"#\" tabindex=\"0\">More</a><div class=\"dd\"><div><h4>Bake</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:recipes}}\">All bakes</a><a href=\"{{p:recipe}}\">Recipe: Vanilla sponge</a></div><div><h4>Tools</h4><a href=\"{{p:pans}}\">Pan converter</a><a href=\"{{p:conversions}}\">Cups, grams & oven temps</a><a href=\"{{p:troubleshoot}}\">Why did it sink?</a></div><div><h4>Kitchen</h4><a href=\"{{p:about}}\">About</a><a href=\"{{p:faq}}\">FAQ</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li></ul><details class=\"sc-m\"><summary>MENU</summary><nav><a href=\"{{p:home}}\">Home</a><a href=\"{{p:recipes}}\">All bakes</a><a href=\"{{p:recipe}}\">Recipe: Vanilla sponge</a><a href=\"{{p:pans}}\">Pan converter</a><a href=\"{{p:conversions}}\">Cups, grams & oven temps</a><a href=\"{{p:troubleshoot}}\">Why did it sink?</a><a href=\"{{p:about}}\">About</a><a href=\"{{p:faq}}\">FAQ</a><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></nav></details></header><script>/* Runs in previews AND exported files. No requests, credentials or submissions. */\n(function(){\n 'use strict';\n function start(){\n  var root=document.querySelector('[data-dl-template]');if(!root)return;\n  document.querySelectorAll('[data-dl-demo-form]').forEach(function(form,index){\n   if(form.dataset.dlBound)return;form.dataset.dlBound='1';\n   var note=document.createElement('p');note.className='dl-form-note';note.textContent='Interactive demo · Nothing is sent. Use sample details only. No account, booking or payment will be created.';form.prepend(note);\n   var result=document.createElement('p');result.className='dl-feedback';result.setAttribute('role','status');result.setAttribute('aria-live','polite');result.hidden=true;form.append(result);\n   form.querySelectorAll('input,textarea,select').forEach(function(input,i){\n    if(!input.name)input.name='demo-'+index+'-'+i;\n    var label=input.closest('label'),text=(label?label.textContent:input.placeholder||'').toLowerCase();\n    if(/name|email|message|date|time/.test(text)&&!/optional/.test(text))input.required=true;\n    if(input.type==='password')input.autocomplete='new-password';\n    if(/card number|cvc|expiry/.test(text)){input.disabled=true;input.placeholder='Disabled in demo';}\n   });\n   function submit(e){if(e)e.preventDefault();if(!form.reportValidity())return;result.hidden=false;result.textContent='Demo complete. Your entries passed the browser checks. Nothing was sent, charged, booked or stored.';}\n   form.addEventListener('submit',submit);\n   if(!form.querySelector('[type=\"submit\"],button:not([type])')){var buttons=form.querySelectorAll('button[type=\"button\"]');if(buttons.length===1)buttons[0].addEventListener('click',submit);}\n  });\n  document.querySelectorAll('.dl-visual img').forEach(function(img){img.addEventListener('error',function(){img.parentElement.classList.add('dl-photo-failed')});if(img.complete&&!img.naturalWidth)img.parentElement.classList.add('dl-photo-failed')});\n  document.querySelectorAll('.shoptop').forEach(function(top){\n   var grid=top.nextElementSibling;if(!grid||!grid.matches('.products'))return;\n   var cards=Array.from(grid.children),chips=Array.from(top.querySelectorAll('.chip')),sort=top.querySelector('select'),category='All';\n   var empty=document.createElement('p');empty.className='dl-filter-empty';empty.textContent='No sample items match this category. Choose All to see the collection.';empty.hidden=true;grid.after(empty);\n   function update(){var shown=0;cards.forEach(function(card){var tag=card.querySelector('small');card.hidden=category!=='All'&&(!tag||tag.textContent.trim()!==category);if(!card.hidden)shown++});empty.hidden=shown!==0;var count=top.querySelector('.sort span');if(count)count.textContent=shown+' sample items';}\n   chips.forEach(function(chip){chip.type='button';chip.setAttribute('aria-pressed',chip.classList.contains('on'));chip.addEventListener('click',function(){category=chip.textContent.trim();chips.forEach(function(c){c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',c===chip)});update()})});\n   if(sort){sort.setAttribute('aria-label','Sort sample items');Array.from(sort.options).forEach(function(o){if(/newest/i.test(o.textContent))o.textContent='Reverse featured'});sort.addEventListener('change',function(){var ordered=cards.slice();if(sort.selectedIndex===1||sort.selectedIndex===2){ordered.sort(function(a,b){function price(c){var p=c.querySelector('.price');return Number((p?p.textContent:'').replace(/[^0-9.]/g,''))||0}return price(a)-price(b)});if(sort.selectedIndex===2)ordered.reverse()}else if(sort.selectedIndex===3)ordered.reverse();ordered.forEach(function(card){grid.append(card)})})}\n  });\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.burger[open],.dl-mobile[open],.nav details[open]').forEach(function(menu){menu.open=false;var summary=menu.querySelector('summary');if(summary)summary.focus()})});\n  document.addEventListener('click',function(e){var a=e.target.closest('.dl-mobile a,.bmenu a');if(a){var menu=a.closest('details');if(menu)menu.open=false;}});\n  document.querySelectorAll('.more>a[href=\"#\"]').forEach(function(a){a.setAttribute('role','button');a.setAttribute('aria-expanded','false');function set(open){a.parentElement.classList.toggle('dl-menu-open',open);a.setAttribute('aria-expanded',open)}function toggle(e){e.preventDefault();set(a.getAttribute('aria-expanded')!=='true')}a.addEventListener('click',toggle);a.addEventListener('keydown',function(e){if(e.key===' ')toggle(e)});a.parentElement.addEventListener('mouseenter',function(){set(true)});a.parentElement.addEventListener('mouseleave',function(){if(!a.parentElement.contains(document.activeElement))set(false)})});\n  document.addEventListener('click',function(e){var a=e.target.closest('a[href=\"#\"]');if(!a||e.defaultPrevented||a.onclick||a.closest('.more'))return;e.preventDefault();var note=a.parentElement.querySelector(':scope>.dl-missing-link');if(!note){note=document.createElement('p');note.className='dl-feedback dl-missing-link';note.setAttribute('role','status');a.after(note)}note.textContent='Demonstration link. Add the real destination before launching this site.'});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.dl-menu-open').forEach(function(menu){menu.classList.remove('dl-menu-open');var a=menu.querySelector(':scope>a');if(a){a.setAttribute('aria-expanded','false');a.focus()}})});\n  document.querySelectorAll('.dl-skip').forEach(function(link){link.addEventListener('click',function(e){e.preventDefault();var target=document.querySelector('main.on [data-dl-content],main:not([data-page]) [data-dl-content]');if(target){target.focus();target.scrollIntoView({block:'start'})}})});\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>/* Sample commerce only: local item choices, quantities and consistent totals. */\n(function(){\n 'use strict';\n function start(){\n  var marker=document.querySelector('[data-dl-template]');if(!marker||marker.dataset.dlTemplate==='restaurant-warm')return;\n  var carts=Array.from(document.querySelectorAll('.cart')).filter(function(x){return x.querySelector('.crow')}),details=Array.from(document.querySelectorAll('.pdp,[data-dl-product]')).filter(function(x){return x.querySelector('.pinfo .price')}),checkouts=Array.from(document.querySelectorAll('aside.side-card')).filter(function(x){return x.querySelector('.kv')&&x.previousElementSibling&&x.previousElementSibling.querySelector('form')});\n  if(!carts.length&&!details.length&&!checkouts.length)return;\n  var currency='RM ',rows=[],key='dl-sample-cart:'+marker.dataset.dlTemplate;\n  function amount(text){return Number(String(text).replace(/[^0-9.]/g,''))||0}\n  function money(n){return currency+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function item(name,price,qty){return {name:String(name).slice(0,120),price:Math.max(0,Math.min(10000000,price)),qty:Math.max(1,Math.min(99,qty))}}\n  if(carts.length){rows=Array.from(carts[0].querySelectorAll('.crow')).map(function(row){var p=row.querySelector(':scope>b'),h=row.querySelector('h3'),q=row.querySelector('.qty span');if(p){currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' '}return item(h?h.textContent:'Sample item',amount(p?p.textContent:0),amount(q?q.textContent:1)||1)})}\n  else if(checkouts.length){rows=Array.from(checkouts[0].querySelectorAll('.kv li:not(.tot)')).filter(function(row){return row.querySelector('b')&&amount(row.querySelector('b').textContent)>0&&!/tax|shipping|delivery|subtotal|fee/i.test(row.textContent)}).map(function(row){var p=row.querySelector('b');currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' ';return item(row.querySelector('span').textContent,amount(p.textContent),1)})}\n  try{var saved=JSON.parse(localStorage.getItem(key));if(saved&&Array.isArray(saved.rows)&&saved.rows.length<=100){rows=saved.rows.filter(function(r){return typeof r.name==='string'&&Number.isFinite(r.price)&&r.price>=0&&Number.isInteger(r.qty)&&r.qty>0&&r.qty<=99}).map(function(r){return item(r.name,r.price,r.qty)});if(typeof saved.currency==='string'&&/^[A-Z$€£¥ ]{1,8}$/.test(saved.currency))currency=saved.currency;}}catch(e){}\n  function save(){try{localStorage.setItem(key,JSON.stringify({currency:currency,rows:rows}))}catch(e){}}\n  function totals(){var sub=rows.reduce(function(sum,r){return sum+r.price*r.qty},0);return {subtotal:sub,total:sub}}\n  function makeLine(label,value,total){var li=document.createElement('li');if(total)li.className='tot';var span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=value;li.append(span,b);return li}\n  function render(){\n   document.querySelectorAll('header a[href]').forEach(function(a){var match=a.textContent.trim().match(/^(Cart|Bag)\\s*\\(\\d+\\)$/i);if(match)a.textContent=match[1]+' ('+rows.reduce(function(sum,r){return sum+r.qty},0)+')'});\n   carts.forEach(function(cart){cart.querySelectorAll('.crow,.dl-cart-empty').forEach(function(r){r.remove()});rows.forEach(function(row,i){var el=document.createElement('div');el.className='crow';el.dataset.dlCartRow=i;var spacer=document.createElement('div'),info=document.createElement('div'),h=document.createElement('h3'),small=document.createElement('small');h.textContent=row.name;small.textContent=money(row.price)+' each · sample item';info.append(h,small);var qty=document.createElement('div');qty.className='qty';[-1,1].forEach(function(change){var b=document.createElement('button');b.type='button';b.dataset.dlCartChange=change;b.textContent=change<0?'−':'+';b.setAttribute('aria-label',(change<0?'Decrease ':'Increase ')+row.name);if(change>0){var value=document.createElement('span');value.textContent=row.qty;qty.append(value)}qty.append(b)});var price=document.createElement('b');price.textContent=money(row.price*row.qty);var remove=document.createElement('button');remove.type='button';remove.className='btn ghost';remove.dataset.dlCartRemove='';remove.textContent='Remove';remove.setAttribute('aria-label','Remove '+row.name);el.append(spacer,info,qty,price,remove);cart.insertBefore(el,cart.querySelector(':scope>a'))});if(!rows.length){var empty=document.createElement('p');empty.className='dl-cart-empty';empty.setAttribute('role','status');empty.textContent='Your sample cart is empty. Browse the collection to add an item.';cart.prepend(empty)}var aside=cart.parentElement.querySelector('aside.side-card');if(aside){var list=aside.querySelector('.kv');if(list){list.replaceChildren(makeLine('Subtotal',money(totals().subtotal)),makeLine('Demo delivery / fees','Not applied'),makeLine('Total',money(totals().total),true))}var note=aside.querySelector('p');if(note)note.textContent='Local sample cart. Real delivery, tax and payment must be configured before launch.'}});\n   checkouts.forEach(function(aside){var list=aside.querySelector('.kv');list.replaceChildren();rows.forEach(function(r){list.append(makeLine(r.qty+' × '+r.name,money(r.price*r.qty)))});list.append(makeLine('Total · demo only',money(totals().total),true));var form=aside.parentElement.querySelector('form'),button=form&&form.querySelector('[type=submit]');if(button){button.textContent=rows.length?'Preview checkout · '+money(totals().total):'Add an item before checkout';button.disabled=!rows.length}});\n  }\n  details.forEach(function(detail){detail.querySelectorAll('.qty button').forEach(function(b){b.type='button';b.setAttribute('aria-label',b.textContent.trim()==='+'?'Increase quantity':'Decrease quantity')});detail.querySelectorAll('.chips .chip').forEach(function(b){b.type='button';b.setAttribute('aria-pressed',b.classList.contains('on'));b.addEventListener('click',function(){b.parentElement.querySelectorAll('.chip').forEach(function(x){x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)})})})});\n  document.addEventListener('click',function(e){var row=e.target.closest('[data-dl-cart-row]');if(row){var index=Number(row.dataset.dlCartRow),change=e.target.closest('[data-dl-cart-change]');if(e.target.closest('[data-dl-cart-remove]'))rows.splice(index,1);else if(change&&rows[index])rows[index].qty=Math.max(1,Math.min(99,rows[index].qty+Number(change.dataset.dlCartChange)));save();render();return}\n   var detail=e.target.closest('.pdp,[data-dl-product]');if(!detail)return;var button=e.target.closest('.qty button');if(button&&!button.onclick){var span=button.parentElement.querySelector('span');if(span)span.textContent=Math.max(1,Math.min(99,amount(span.textContent)+(button.textContent.trim()==='+'?1:-1)))}\n   var link=e.target.closest('.buy a,[data-dl-add]');if(link&&!e.defaultPrevented&&link.getAttribute('aria-disabled')!=='true'&&/cart(?:\\.|$)|#\\/cart/.test(link.getAttribute('href')||'')){var h=detail.querySelector('.pinfo h1'),price=detail.querySelector('.pinfo .price'),q=detail.querySelector('.qty span');if(h&&price){var chosen=Array.from(detail.querySelectorAll('.pinfo .chip.on,.pinfo .ok-finish [aria-pressed=true]')).map(function(b){return b.getAttribute('aria-label')||b.textContent.trim()}),name=h.textContent+(chosen.length?' · '+chosen.join(' / '):''),quantity=amount(q?q.textContent:1)||1,found=rows.find(function(r){return r.name===name});if(found)found.qty=Math.min(99,found.qty+quantity);else rows.push(item(name,amount(price.textContent),quantity));save();render()}}\n  });\n  render();\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script>","foot":"<footer data-dl-footer class=\"sc-foot\"><div class=\"top\"><div><div class=\"big\">Sugar &amp; Crumb</div><p style=\"margin-top:10px;font:600 14px/1.8 var(--f-body);opacity:.85;max-width:34ch\">Recipes that behave. Tested in a home oven, in grams, with the failures written down. Template demo content.</p></div><div class=\"cols\"><div><h4>Bake</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:recipes}}\">All bakes</a></li><li><a href=\"{{p:recipe}}\">Recipe: Vanilla sponge</a></li></ul></div><div><h4>Tools</h4><ul><li><a href=\"{{p:pans}}\">Pan converter</a></li><li><a href=\"{{p:conversions}}\">Cups, grams & oven temps</a></li><li><a href=\"{{p:troubleshoot}}\">Why did it sink?</a></li></ul></div><div><h4>Kitchen</h4><ul><li><a href=\"{{p:about}}\">About</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div></div><div class=\"copy\">© 2026 Sugar &amp; Crumb</div><div class=\"wrap\"><details class=\"dl-credits\"><summary>Illustrative photography &amp; credits</summary><p>Stock references for layout demonstration; replace before customer launch. Remote images require internet access.</p><ul><li><a href=\"https://unsplash.com/photos/a-decadent-chocolate-cake-with-slices-on-plates-cAy6uai7l5U\" target=\"_blank\" rel=\"noopener noreferrer\">Chocolate cake and plated slices for a shared table</a> — Just Capturing It</li><li><a href=\"https://unsplash.com/photos/croissants-on-display-TG77ANwm3MQ\" target=\"_blank\" rel=\"noopener noreferrer\">Fresh croissants arranged at a bakery counter</a> — Mimi Thian</li></ul><a href=\"https://unsplash.com/license\" target=\"_blank\" rel=\"noopener noreferrer\">Unsplash licence</a></details></div></footer>","pages":{"home":"<div tabindex=\"-1\" data-dl-content><section class=\"sc-hero\"><div><h1>Bake it right,<br>the <em>first</em> time.</h1><p>Cakes, cookies and tarts tested in a home oven, written in grams, with every way it can go wrong spelled out.</p><p style=\"display:flex;gap:12px;flex-wrap:wrap;margin:0\"><a class=\"sc-btn y\" href=\"{{p:recipes}}\">All the bakes</a><a class=\"sc-btn o\" href=\"{{p:pans}}\">Pan converter</a></p></div>\n<div class=\"sc-cake\" aria-hidden=\"true\"><span class=\"cherry\"></span><span class=\"flag\">Fresh today</span><div class=\"t t1\"></div><div class=\"t t2\"></div><div class=\"t t3\"></div><div class=\"plate\"></div></div></section><section class=\"dl-photo-story\" data-dl-photo-edition><div class=\"dl-photo-wrap\"><div class=\"dl-photo-head\"><h2>Around the table</h2><p>Good food starts with ingredients, care and a place to gather.</p></div><div class=\"dl-photo-grid\"><figure><div class=\"dl-visual\" style=\"aspect-ratio:3/2\"><img src=\"https://images.unsplash.com/photo-1767044315790-bc0fe664fd0b?auto=format&amp;fit=crop&amp;w=1920&amp;h=1280&amp;q=85\" alt=\"Chocolate cake and plated slices for a shared table\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span class=\"dl-stock-label\">Illustrative stock image</span></div><figcaption>Chocolate cake and plated slices for a shared table</figcaption></figure><figure><div class=\"dl-visual\" style=\"aspect-ratio:3/2\"><img src=\"https://images.unsplash.com/photo-1548538931-b47653628cdc?auto=format&amp;fit=crop&amp;w=1920&amp;h=1280&amp;q=85\" alt=\"Fresh croissants arranged at a bakery counter\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span class=\"dl-stock-label\">Illustrative stock image</span></div><figcaption>Fresh croissants arranged at a bakery counter</figcaption></figure></div></div></section>\n<section class=\"sc-sec\" style=\"padding-top:0\"><div class=\"sc-h\"><h2>Fresh from the oven</h2><span>NEW</span></div><div class=\"sc-grid\"><a class=\"sc-card\" href=\"{{p:recipe}}\"><div class=\"ph\" style=\"--c1:#f2b84b;--c2:#f7c6c7\"></div><div class=\"b\"><h3>Vanilla sponge cake</h3><div class=\"m\"><span>Cake</span><span>55 min</span><span>Easy</span></div></div></a><a class=\"sc-card\" href=\"{{p:recipe}}\"><div class=\"ph\" style=\"--c1:#8a5a2b;--c2:#f2b84b\"></div><div class=\"b\"><h3>Brown butter chocolate chip cookies</h3><div class=\"m\"><span>Cookies</span><span>30 min</span><span>Easy</span></div></div></a><a class=\"sc-card\" href=\"{{p:recipe}}\"><div class=\"ph\" style=\"--c1:#f2d649;--c2:#f7c6c7\"></div><div class=\"b\"><h3>Lemon tart</h3><div class=\"m\"><span>Tart</span><span>90 min</span><span>Medium</span></div></div></a></div></section>\n<section class=\"sc-sec\" style=\"padding-top:0\"><div class=\"sc-conv\"><div class=\"sc-box\"><h3>No 20 cm pan?</h3><p style=\"font:600 16px/1.8 var(--f-body);margin-bottom:18px\">Tell us the pan in the recipe and the one in your cupboard. We'll scale the batter and adjust the time.</p><a class=\"sc-btn\" href=\"{{p:pans}}\">Open the converter</a></div><div class=\"sc-box\" style=\"background:var(--c-secondary)\"><h3>Why did it sink?</h3><p style=\"font:600 16px/1.8 var(--f-body);margin-bottom:18px\">A short guide to the eight most common cake, cookie and tart failures.</p><a class=\"sc-btn o\" href=\"{{p:troubleshoot}}\">Read the guide</a></div></div></section></div>","recipes":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>All bakes</b></div><h1 style=\"font-family:var(--f-head);font-weight:800\">All bakes</h1><p class=\"lead\">Six reliable bakes. Pick one and pre-heat the oven.</p></div></section><section class=\"sc-sec\" style=\"padding-top:0\"><div class=\"sc-grid\"><a class=\"sc-card\" href=\"{{p:recipe}}\"><div class=\"ph\" style=\"--c1:#f2b84b;--c2:#f7c6c7\"></div><div class=\"b\"><h3>Vanilla sponge cake</h3><div class=\"m\"><span>Cake</span><span>55 min</span><span>Easy</span></div></div></a><a class=\"sc-card\" href=\"{{p:recipe}}\"><div class=\"ph\" style=\"--c1:#8a5a2b;--c2:#f2b84b\"></div><div class=\"b\"><h3>Brown butter chocolate chip cookies</h3><div class=\"m\"><span>Cookies</span><span>30 min</span><span>Easy</span></div></div></a><a class=\"sc-card\" href=\"{{p:recipe}}\"><div class=\"ph\" style=\"--c1:#f2d649;--c2:#f7c6c7\"></div><div class=\"b\"><h3>Lemon tart</h3><div class=\"m\"><span>Tart</span><span>90 min</span><span>Medium</span></div></div></a><a class=\"sc-card\" href=\"{{p:recipe}}\"><div class=\"ph\" style=\"--c1:#c98a43;--c2:#f7c6c7\"></div><div class=\"b\"><h3>Basque cheesecake</h3><div class=\"m\"><span>Cake</span><span>70 min</span><span>Easy</span></div></div></a><a class=\"sc-card\" href=\"{{p:recipe}}\"><div class=\"ph\" style=\"--c1:#b36b3a;--c2:#f7c6c7\"></div><div class=\"b\"><h3>Cinnamon rolls</h3><div class=\"m\"><span>Bread</span><span>3 hr</span><span>Medium</span></div></div></a><a class=\"sc-card\" href=\"{{p:recipe}}\"><div class=\"ph\" style=\"--c1:#e45a6b;--c2:#f7c6c7\"></div><div class=\"b\"><h3>Strawberry shortcake</h3><div class=\"m\"><span>Cake</span><span>60 min</span><span>Medium</span></div></div></a></div></section></div>","recipe":"<div tabindex=\"-1\" data-dl-content><section class=\"sc-sec\"><div class=\"sc-h\"><h1 style=\"font:800 clamp(32px,4.6vw,60px)/1.05 var(--f-head);color:var(--c-primary)\">Vanilla sponge cake</h1><span>EASY · 55 MIN</span></div><p style=\"font:600 18px/1.8 var(--f-body);max-width:56ch;margin-bottom:26px\">A light, even sponge that holds frosting and fruit. One bowl, five ingredients, no creaming marathon.</p>\n<div class=\"sc-conv\"><div class=\"sc-box\"><h3>Ingredients · 20 cm round</h3><ul class=\"sc-ing\"><li><span>Butter, soft</span><span>150 g</span></li><li><span>Caster sugar</span><span>150 g</span></li><li><span>Eggs</span><span>3</span></li><li><span>Self-raising flour</span><span>150 g</span></li><li><span>Milk</span><span>2 tbsp</span></li><li><span>Vanilla extract</span><span>2 tsp</span></li></ul><p style=\"margin-top:16px\"><a class=\"sc-btn o\" href=\"{{p:pans}}\">Different pan?</a></p></div>\n<div><ol class=\"sc-steps\"><li><span>Heat the oven to 170°C fan. Grease and line a 20 cm round tin.</span></li><li><span>Beat butter and sugar for 3 minutes until pale. Add eggs one at a time, with a spoon of flour each.</span></li><li><span>Fold in the rest of the flour, milk and vanilla until just combined.</span></li><li><span>Bake 28–32 minutes, until a skewer comes out clean. Cool in the tin for 10 minutes.</span></li></ol></div></div></section></div>","pans":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Pan converter</b></div><h1 style=\"font-family:var(--f-head);font-weight:800\">Pan converter</h1><p class=\"lead\">Round to square, 15 to 26 cm. Get the multiplier and a bake-time hint.</p></div></section><section class=\"sc-sec\" style=\"padding-top:0\"><div class=\"sc-conv\"><div class=\"sc-box\"><h3>Recipe calls for…</h3><div class=\"sc-row\"><label>Shape<select id=\"sc-s1\"><option value=\"r\">Round</option><option value=\"q\">Square</option></select></label><label>Size (cm)<select id=\"sc-z1\"><option>15</option><option selected>18</option><option>20</option><option>23</option><option>26</option></select></label></div><h3 style=\"margin-top:20px\">I have…</h3><div class=\"sc-row\"><label>Shape<select id=\"sc-s2\"><option value=\"r\">Round</option><option value=\"q\" selected>Square</option></select></label><label>Size (cm)<select id=\"sc-z2\"><option>15</option><option>18</option><option>20</option><option selected>23</option><option>26</option></select></label></div></div><div class=\"sc-res\" aria-live=\"polite\"><div class=\"x\" id=\"sc-x\">×1.0</div><p id=\"sc-m\">Same area. No changes needed.</p><span class=\"t\" id=\"sc-b\"></span></div></div></section><script>(function(){var a=document.getElementById(\"sc-s1\");if(!a)return;var ids=[\"sc-s1\",\"sc-z1\",\"sc-s2\",\"sc-z2\"].map(function(i){return document.getElementById(i)});function area(s,z){return s===\"r\"?Math.PI*Math.pow(z/2,2):z*z}function u(){var A=area(ids[0].value,+ids[1].value),B=area(ids[2].value,+ids[3].value),k=B/A,x=document.getElementById(\"sc-x\");x.textContent=\"×\"+(Math.round(k*100)/100).toFixed(2);var m=document.getElementById(\"sc-m\"),b=document.getElementById(\"sc-b\");if(Math.abs(k-1)<.06){m.textContent=\"Nearly the same area. No changes needed.\";b.textContent=\"Bake time: as written\"}else if(k>1){m.textContent=\"Your pan is bigger. Multiply every ingredient by \"+x.textContent.slice(1)+\". The batter will be shallower.\";b.textContent=\"Bake ~\"+Math.round((1-Math.min(.3,(k-1)*.2))*100)+\"% of the time; start checking early\"}else{m.textContent=\"Your pan is smaller. Multiply every ingredient by \"+x.textContent.slice(1)+\". The batter will be deeper.\";b.textContent=\"Bake ~\"+Math.round((1+Math.min(.35,(1-k)*.35))*100)+\"% of the time; lower the oven by 10°C\"}}ids.forEach(function(e){e.addEventListener(\"change\",u)});u()})();</script></div>","conversions":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Cups, grams & oven temps</b></div><h1 style=\"font-family:var(--f-head);font-weight:800\">Cups, grams &amp; oven temps</h1><p class=\"lead\">Quick reference. When in doubt, weigh it.</p></div></section><section class=\"sc-sec\" style=\"padding-top:0\"><div class=\"sc-conv\"><table class=\"sc-tbl\"><tr><th>Ingredient</th><th>1 cup</th><th>1 tbsp</th></tr><tr><td>Plain flour</td><td>125 g</td><td>8 g</td></tr><tr><td>Caster sugar</td><td>200 g</td><td>12 g</td></tr><tr><td>Brown sugar, packed</td><td>210 g</td><td>14 g</td></tr><tr><td>Butter</td><td>225 g</td><td>14 g</td></tr><tr><td>Cocoa powder</td><td>85 g</td><td>5 g</td></tr></table><table class=\"sc-tbl\"><tr><th>°C</th><th>°C fan</th><th>°F</th><th>Gas</th></tr><tr><td>150</td><td>130</td><td>300</td><td>2</td></tr><tr><td>160</td><td>140</td><td>325</td><td>3</td></tr><tr><td>180</td><td>160</td><td>350</td><td>4</td></tr><tr><td>200</td><td>180</td><td>400</td><td>6</td></tr><tr><td>220</td><td>200</td><td>425</td><td>7</td></tr></table></div></section></div>","troubleshoot":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Why did it sink?</b></div><h1 style=\"font-family:var(--f-head);font-weight:800\">Why did it sink?</h1><p class=\"lead\">Eight things that go wrong, and what to change.</p></div></section><section class=\"sc-sec\" style=\"padding-top:0\"><div class=\"faq\"><details open><summary>My cake sank in the middle</summary><p>The oven door opened too early, or the oven ran cold. Wait until the last 5 minutes before checking, and use an oven thermometer.</p></details><details><summary>Cookies spread into one sheet</summary><p>Butter too warm or too little flour. Chill the dough for 30 minutes and weigh the flour.</p></details><details><summary>Tart base shrank</summary><p>Rest the dough in the tin for 30 minutes before blind-baking, and don't stretch it.</p></details><details><summary>Dense, heavy crumb</summary><p>Over-mixing after adding flour, or old baking powder. Fold gently; test the powder in hot water.</p></details></div></section></div>","about":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>About</b></div><h1 style=\"font-family:var(--f-head);font-weight:800\">About</h1></div></section><section class=\"sc-sec\" style=\"padding-top:0\"><div class=\"sc-box\" style=\"max-width:640px\"><p style=\"font:600 17px/2 var(--f-body)\">Sugar &amp; Crumb is one baker, one oven and a lot of sunk cakes. Replace this with your story and a photo of your kitchen.</p></div></section></div>","faq":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>FAQ</b></div><h1 style=\"font-family:var(--f-head);font-weight:800\">FAQ</h1></div></section><section class=\"sc-sec\" style=\"padding-top:0\"><div class=\"faq\"><details open><summary>Why grams and not cups?</summary><p>Cups vary by up to 30%. Grams are the same every time.</p></details><details><summary>Can I swap butter for oil?</summary><p>In cakes, yes, but the crumb changes. We note it on each recipe.</p></details><details><summary>Do I need a stand mixer?</summary><p>No recipe here requires one.</p></details></div></section></div>","privacy":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Privacy policy</b></div><h1 style=\"\">Privacy policy</h1></div></section><section class=\"sc-sec\" style=\"padding-top:20px\"><div class=\"prose\"><p>Replace with your privacy policy: what you collect, why, how long you keep it and how customers can ask for deletion.</p></div></section></div>","404":"<div tabindex=\"-1\" data-dl-content><section class=\"sc-sec\" style=\"text-align:center;padding-top:clamp(50px,9vw,120px)\"><div class=\"sc-cake\" style=\"max-width:240px\" aria-hidden=\"true\"><span class=\"cherry\"></span><div class=\"t t1\"></div><div class=\"t t3\"></div><div class=\"plate\"></div></div><h1 style=\"font:800 clamp(60px,12vw,140px)/1 var(--f-head);color:var(--c-accent);margin-top:14px\">404</h1><p style=\"margin:10px 0 26px;font:700 20px var(--f-body)\">Someone ate this page.</p><a class=\"sc-btn y\" href=\"{{p:home}}\">Back to the bakery</a></section></div>"}}