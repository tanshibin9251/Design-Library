}\n@media(max-width:860px){.dt-rail{position:static;grid-template-columns:repeat(3,1fr);gap:8px 20px}}\n.dt-plan{display:grid;gap:10px;max-width:760px}\n.dt-plan label{display:grid;grid-template-columns:100px 1fr;gap:14px;align-items:center;padding:10px 14px;border:1px solid var(--c-border);border-radius:14px;background:color-mix(in srgb,var(--c-surface) 40%,#fff)}\n.dt-plan label b{font:700 14px var(--f-body);letter-spacing:.1em;text-transform:uppercase;color:var(--c-primary)}\n.dt-plan select{min-height:46px;border:1px solid var(--c-border);border-radius:10px;padding:0 12px;font:600 16px var(--f-body);background:var(--c-surface);color:var(--c-text);width:100%}\n.dt-shop{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,4vw,50px);align-items:start}\n@media(max-width:860px){.dt-shop{grid-template-columns:1fr}}\n.dt-box{border:1px solid var(--c-border);border-radius:18px;padding:clamp(20px,2.6vw,32px);background:color-mix(in srgb,var(--c-surface) 40%,#fff)}\n.dt-box h3{font:700 24px var(--f-head);margin-bottom:12px}\n.dt-ul{list-style:none}\n.dt-ul li{display:flex;gap:12px;align-items:center;padding:6px 0;border-bottom:1px dashed var(--c-border);font:600 17px var(--f-body);min-height:46px}\n.dt-ul input{width:22px;height:22px;accent-color:var(--c-accent);padding:0;min-height:0;flex:none}\n.dt-ul input:checked+span{text-decoration:line-through;opacity:.5}\n.dt-ul small{margin-left:auto;font:600 12px var(--f-body);color:var(--c-secondary)}\n.dt-rec{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,1fr);gap:clamp(20px,4vw,60px);align-items:start}\n@media(max-width:860px){.dt-rec{grid-template-columns:1fr}}\n.dt-steps{counter-reset:s;list-style:none;display:grid;gap:20px}\n.dt-steps li{counter-increment:s;display:grid;grid-template-columns:44px 1fr;gap:16px;font:400 19px/1.65 var(--f-body)}\n.dt-steps li::before{content:counter(s);font:700 38px/1 var(--f-head);color:var(--c-accent)}\n.dt-facts{display:flex;gap:28px;flex-wrap:wrap;padding:14px 0;border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border);margin:18px 0 26px}\n.dt-facts b{display:block;font:700 24px var(--f-head);color:var(--c-primary)}.dt-facts span{font:700 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:var(--c-secondary)}\n.dt-foot{background:var(--c-primary);color:var(--on-primary);margin-top:clamp(34px,5vw,80px);padding:clamp(34px,4vw,60px) clamp(14px,4vw,56px) 22px}\n.dt-foot .top{display:grid;grid-template-columns:1.1fr 2fr;gap:clamp(24px,6vw,90px)}\n.dt-foot .big{font:700 32px var(--f-head)}.dt-foot .big i{color:var(--c-accent);font-style:normal}\n.dt-foot h4{font:700 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-accent);margin-bottom:10px}\n.dt-foot ul{list-style:none}.dt-foot li a{display:inline-block;padding:6px 0;text-decoration:none;font:500 15px var(--f-body);min-height:32px}\n.dt-foot .cols{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n.dt-foot .copy{margin-top:26px;font:500 12px var(--f-body);opacity:.7}\n@media(max-width:800px){.dt-foot .top{grid-template-columns:1fr}}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}\n@media(prefers-reduced-motion:reduce){.dt-row{transition:none}}\n</style><div class=\"dt-util\"><span>Free weekly meal plan, every Sunday</span><a href=\"{{p:planner}}\">Plan this week →</a></div><header class=\"dt-head\"><a class=\"dt-logo\" href=\"{{p:home}}\">daily table<i>.</i></a><ul class=\"dt-tabs\"><li><a href=\"{{p:recipes}}\">Recipes</a></li><li><a href=\"{{p:planner}}\">Planner</a></li><li><a href=\"{{p:shopping}}\">Shopping list</a></li><li><a href=\"{{p:staples}}\">Pantry</a></li><li class=\"more\"><a href=\"#\" tabindex=\"0\">More</a><div class=\"dd\"><div><h4>Cook</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:recipes}}\">All recipes</a><a href=\"{{p:recipe}}\">Recipe: Sheet-pan chicken</a></div><div><h4>Plan</h4><a href=\"{{p:planner}}\">Weekly planner</a><a href=\"{{p:shopping}}\">Shopping list</a><a href=\"{