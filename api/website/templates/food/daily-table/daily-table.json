px,4vw,56px) 0}\n.dt-hero h1{font:700 clamp(42px,7vw,var(--h1))/1 var(--f-head);letter-spacing:-.02em;color:var(--c-primary);max-width:15ch}\n.dt-hero h1 em{color:var(--c-accent);font-style:italic}\n.dt-hero p{font:400 20px/1.55 var(--f-body);margin:16px 0 24px;max-width:46ch}\n.dt-btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;border-radius:999px;background:var(--c-primary);color:var(--on-primary);text-decoration:none;font:700 16px var(--f-body);border:2px solid var(--c-primary);cursor:pointer}\n.dt-btn:hover{background:var(--c-accent);border-color:var(--c-accent);color:var(--on-accent)}\n.dt-btn.o{background:transparent;color:var(--c-primary)}.dt-btn.o:hover{background:var(--c-primary);color:var(--on-primary);border-color:var(--c-primary)}\n.dt-week{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;margin-top:clamp(28px,4vw,54px)}\n.dt-day{background:color-mix(in srgb,var(--c-surface) 40%,#fff);border:1px solid var(--c-border);border-radius:14px;padding:14px 12px;display:grid;gap:6px;align-content:start;min-height:130px}\n.dt-day b{font:700 12px var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:var(--c-secondary)}\n.dt-day span{font:700 16px/1.25 var(--f-head);color:var(--c-primary)}\n.dt-day em{font:500 13px var(--f-body);font-style:normal;color:var(--c-secondary)}\n.dt-day.today{border:2px solid var(--c-accent);background:color-mix(in srgb,var(--c-accent) 8%,var(--c-surface))}\n@media(max-width:900px){.dt-week{grid-template-columns:repeat(2,1fr)}.dt-day{min-height:0}}\n.dt-h{display:flex;justify-content:space-between;align-items:baseline;gap:14px;margin-bottom:22px;flex-wrap:wrap}\n.dt-h h2{font:700 clamp(26px,3.2vw,var(--h2)) var(--f-head);letter-spacing:-.01em;color:var(--c-primary)}\n.dt-h a{font:700 15px var(--f-body);color:var(--c-accent)}\n.dt-list{display:grid;gap:14px}\n.dt-row{display:grid;grid-template-columns:160px 1fr auto;gap:clamp(14px,2vw,28px);align-items:center;padding:12p