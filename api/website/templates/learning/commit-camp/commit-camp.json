lay:none}\n.dl-visual{position:relative;isolation:isolate;overflow:hidden;background:var(--c-border)}.dl-visual:before,.dl-visual:after{display:none!important}.dl-visual>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1}.dl-visual>span{position:relative;z-index:1}.dl-photo-failed>img{display:none}.dl-photo-failed:after{display:grid!important;position:absolute;inset:0;place-items:center;content:'Image unavailable · 缺图';padding:16px;background:var(--c-surface);color:var(--c-text);font:500 14px var(--f-body)}\n.dl-stock-label{position:absolute;left:10px;bottom:10px;padding:4px 8px;max-width:calc(100% - 20px);background:var(--c-surface);color:var(--c-text);font-size:11px;line-height:1.5;border-radius:4px}.dl-credits{padding:20px 0;font-size:13px}.dl-credits summary{cursor:pointer;min-height:44px;display:flex;align-items:center}.dl-credits li{margin-block:8px}.dl-credits a{overflow-wrap:anywhere}\n:where(button,a,input,select,textarea,summary):focus-visible{outline:3px solid var(--c-accent);outline-offset:4px}\n@media(max-width:820px){.dl-mobile{display:block;position:relative}.dl-mobile summary{display:flex;align-items:center;justify-content:center;min-width:64px;min-height:44px;padding:8px 12px;border:1px solid var(--c-border);border-radius:var(--radius);cursor:pointer;list-style:none;font:600 14px var(--f-body)}.dl-mobile summary::-webkit-details-marker{display:none}.dl-mobile-links{position:fixed;top:74px;left:12px;right:12px;z-index:9999;max-height:75dvh;overflow:auto;background:var(--c-surface);color:var(--c-text);padding:16px 20px;border:1px solid var(--c-border);border-radius:var(--radius);box-shadow:0 16px 40px #0002}.dl-mobile-links a{display:flex;align-items:center;min-height:44px;text-decoration:none}.dl-mobile-links h4{font-size:12px;margin:18px 0 4px;color:var(--c-secondary)}.burger summary,.bmenu a{min-height:44px}.burger summary{display:flex;align-items:center}.burger:not([open])>.bmenu{display:none}.btn,.chip,.qty button{min-height:44px}.qty button{min-width:44px}[data-dl-footer] .cols{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}[data-dl-footer] .cols>div:first-child{grid-column:1/-1}.pdp,.split{min-width:0}.pdp>*{min-width:0}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n</style><a class=\"dl-skip\" href=\"#dl-content\">Skip to content</a><style>\n/* Commit Camp — IDE-chrome coding bootcamp, tokens only */\nbody{font-feature-settings:\"liga\" 1}\n.cc-shell{display:grid;grid-template-columns:250px minmax(0,1fr);min-height:100vh}\n.cc-side{position:sticky;top:0;align-self:start;height:100vh;overflow:auto;border-right:1px solid var(--c-border);background:color-mix(in srgb,var(--c-surface) 82%,#000);display:flex;flex-direction:column}\n.cc-dots{display:flex;gap:7px;padding:14px 16px}.cc-dots i{width:11px;height:11px;border-radius:50%;background:var(--c-border)}.cc-dots i:nth-child(1){background:var(--c-accent)}\n.cc-logo{display:block;padding:6px 16px 18px;font:700 17px var(--f-head);color:var(--c-primary);text-decoration:none;letter-spacing:0}\n.cc-logo span{color:var(--c-accent)}\n.cc-tree h4{font:600 11px var(--f-head);letter-spacing:.14em;text-transform:uppercase;color:var(--c-secondary);padding:14px 16px 6px}\n.cc-tree a{display:flex;align-items:center;gap:8px;padding:8px 16px 8px 22px;min-height:40px;text-decoration:none;font:400 13px var(--f-head);color:var(--c-text);border-left:2px solid transparent}\n.cc-tree a::before{content:\"▸\";color:var(--c-secondary);font-size:10px}\n.cc-tree a:hover{background:color-mix(in srgb,var(--c-primary) 6%,transparent)}\n.cc-tree a.on{background:color-mix(in srgb,var(--c-accent) 12%,transparent);border-left-color:var(--c-accent);color:var(--c-primary)}\n.cc-side .cta{margin:auto 16px 18px;display:grid;place-items:center;min-height:44px;background:var(--c-accent);color:var(--on-accent);text-decoration:none;font:700 13px var(--f-head);border-radius:6px}\n.cc-main{min-width:0;display:flex;flex-direction:column}\n.cc-tabs{display:flex;gap:0;border-bottom:1px solid var(--c-border);background:color-mix(in srgb,var(--c-surface) 82%,#000);overflow:auto}\n.cc-tabs span{padding:11px 18px;font:400 12px var(--f-head);color:var(--c-secondary);border-right:1px solid var(--c-border);white-space:nowrap}\n.cc-tabs span.on{color:var(--c-primary);background:var(--c-surface);box-shadow:inset 0 2px 0 var(--c-accent)}\n.cc-body{flex:1;min-width:0}\n.cc-m{display:none}\n@media(max-width:900px){.cc-shell{grid-template-columns:1fr}.cc-side{display:none}.cc-m{display:block;position:sticky;top:0;z-index:40;background:var(--c-surface);border-bottom:1px solid var(--c-border)}\n .cc-m summary{list-style:none;cursor:pointer;min-height:48px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;font:700 15px var(--f-head);color:var(--c-primary)}\n .cc-m summary::-webkit-details-marker{display:none}.cc-m summary b{font:400 12px var(--f-head);color:var(--c-secondary);border:1px solid var(--c-border);padding:6px 10px;border-radius:6px}\n .cc-m nav{display:grid;padding:4px 16px 16px}.cc-m nav a{padding:12px 0;border-bottom:1px solid var(--c-border);text-decoration:none;font:400 14px var(--f-head);min-height:44px}}\n\n.cc-sec{padding:clamp(40px,6vw,84px) clamp(18px,4vw,64px)}\n.cc-cm{font:400 13px var(--f-head);color:var(--c-secondary);margin-bottom:14px}\n.cc-cm b{color:var(--c-accent);font-weight:400}\n.cc-h1{font:700 clamp(34px,5.2vw,var(--h1)) var(--f-head);letter-spacing:-.02em;line-height:1.08;color:var(--c-primary)}\n.cc-h1 em{font-style:normal;color:var(--c-accent)}\n.cc-btn{display:inline-flex;align-items:center;gap:10px;min-height:46px;padding:0 22px;border:1px solid var(--c-accent);background:var(--c-accent);color:var(--on-accent);font:700 14px var(--f-head);text-decoration:none;border-radius:6px;cursor:pointer}\n.cc-btn.o{background:transparent;color:var(--c-accent)}\n.cc-btn:hover{filter:brightness(1.12)}\n.cc-term{border:1px solid var(--c-border);border-radius:10px;background:color-mix(in srgb,var(--c-surface) 70%,#000);overflow:hidden;font:400 14px/1.8 var(--f-head)}\n.cc-term .bar{display:flex;gap:7px;padding:10px 14px;border-bottom:1px solid var(--c-border)}.cc-term .bar i{width:10px;height:10px;border-radius:50%;background:var(--c-border)}\n.cc-term pre{padding:18px 20px;white-space:pre-wrap;word-break:break-word;color:var(--c-text)}\n.cc-term .p{color:var(--c-accent)}.cc-term .d{color:var(--c-secondary)}.cc-term .k{color:var(--c-primary)}\n.cc-cur{display:inline-block;width:.6em;height:1.1em;background:var(--c-accent);vertical-align:-.15em;animation:ccb 1s steps(2) infinite}\n@keyframes ccb{50%{opacity:0}}\n.cc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n.cc-card{border:1px solid var(--c-border);border-radius:10px;background:color-mix(in srgb,var(--c-surface) 70%,#000);padding:22px;display:grid;gap:10px;align-content:start;text-decoration:none;transition:border-color .2s,transform .2s}\n.cc-card:hover{border-color:var(--c-accent);transform:translateY(-2px)}\n.cc-card .t{font:400 12px var(--f-head);color:var(--c-accent)}\n.cc-card h3{font:700 19px var(--f-head);letter-spacing:-.01em;color:var(--c-primary)}\n.cc-card p{font:400 14px/1.7 var(--f-body);color:var(--c-text);opacity:.85}\n.cc-card .m{display:flex;gap:14px;font:400 12px var(--f-head);color:var(--c-secondary);margin-top:6px}\n.cc-bar{height:6px;border-radius:99px;background:var(--c-border);overflow:hidden}.cc-bar i{display:block;height:100%;background:var(--c-accent);width:var(--p)}\n@media(max-width:1000px){.cc-grid{grid-template-columns:1fr 1fr}}@media(max-width:640px){.cc-grid{grid-template-columns:1fr}}\n.cc-log{font:400 14px/1.9 var(--f-head);display:grid;gap:0}\n.cc-log a,.cc-log div{display:grid;grid-template-columns:62px 1fr auto;gap:14px;padding:6px 0;text-decoration:none;align-items:baseline}\n.cc-log .g{color:var(--c-accent);white-space:pre}.cc-log .h{color:var(--c-secondary)}\n.cc-log .tag{font-size:11px;border:1px solid var(--c-accent);color:var(--c-accent);padding:1px 8px;border-radius:99px}\n.cc-log b{font-weight:400;color:var(--c-primary)}\n.cc-play{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--c-border);border-radius:10px;overflow:hidden;min-height:440px}\n.cc-play textarea{width:100%;height:100%;min-height:440px;border:0;border-radius:0;border-right:1px solid var(--c-border);background:color-mix(in srgb,var(--c-surface) 70%,#000);color:var(--c-text);font:400 14px/1.7 var(--f-head);padding:18px;resize:none;outline:0;box-shadow:none}\n.cc-play iframe{width:100%;height:100%;min-height:440px;border:0;background:#fff}\n@media(max-width:800px){.cc-play{grid-template-columns:1fr}.cc-play textarea{border-right:0;border-bottom:1px solid var(--c-border);min-height:260px}.cc-play iframe{min-height:300px}}\n.cc-player{border:1px solid var(--c-border);border-radius:10px;overflow:hidden;background:color-mix(in srgb,var(--c-surface) 70%,#000)}\n.cc-vid{aspect-ratio:16/9;display:grid;place-items:center;background:repeating-linear-gradient(45deg,transparent 0 16px,color-mix(in srgb,var(--c-primary) 5%,transparent) 16px 17px);position:relative}\n.cc-vid span{width:68px;height:68px;border-radius:50%;background:var(--c-accent);color:var(--on-accent);display:grid;place-items:center;font-size:22px}\n.cc-vid em{position:absolute;left:14px;bottom:10px;font:400 11px var(--f-head);font-style:normal;color:var(--c-secondary)}\n.cc-ctl{display:flex;justify-content:space-between;padding:12px 16px;font:400 12px var(--f-head);color:var(--c-secondary);border-top:1px solid var(--c-border)}\n.cc-split{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,1fr);gap:clamp(20px,3vw,40px);align-items:start}\n@media(max-width:900px){.cc-split{grid-template-columns:1fr}}\n.cc-list{display:grid;gap:0;border:1px solid var(--c-border);border-radius:10px;overflow:hidden}\n.cc-list a{display:grid;grid-template-columns:30px 1fr auto;gap:10px;padding:13px 16px;border-bottom:1px solid var(--c-border);text-decoration:none;font:400 13px var(--f-head);min-height:44px;align-items:center}\n.cc-list a:last-child{border-bottom:0}.cc-list .n{color:var(--c-secondary)}.cc-list .on{color:var(--c-accent)}\n.cc-list a.cur{background:color-mix(in srgb,var(--c-accent) 12%,transparent)}\n.cc-price{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n.cc-price>div{border:1px solid var(--c-border);border-radius:10px;padding:26px;display:grid;gap:12px;align-content:start}\n.cc-price>.hl{border-color:var(--c-accent);box-shadow:0 0 0 1px var(--c-accent)}\n.cc-price .p{font:700 38px var(--f-head);color:var(--c-primary)}.cc-price .p small{font:400 14px var(--f-head);color:var(--c-secondary)}\n.cc-price li{list-style:none;font:400 14px var(--f-body);padding:7px 0;border-top:1px solid var(--c-border)}.cc-price li::before{content:\"✓ \";color:var(--c-accent)}\n@media(max-width:900px){.cc-price{grid-template-columns:1fr}}\n.cc-status{display:flex;gap:18px;flex-wrap:wrap;align-items:center;background:var(--c-accent);color:var(--on-accent);padding:0 16px;min-height:28px;font:400 12px var(--f-head);position:sticky;bottom:0;z-index:10}\n.cc-status a{color:inherit;text-decoration:none}\n.faq summary{font-family:var(--f-head);font-size:16px}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}\n@media(prefers-reduced-motion:reduce){.cc-cur{animation:none}.cc-card{transition:none}}\n</style><details class=\"cc-m\"><summary><span>commit<span style=\"color:var(--c-accent)\">.</span>camp</span><b>menu</b></summary><nav><a href=\"{{p:home}}\">index.html</a><a href=\"{{p:courses}}\">courses/</a><a href=\"{{p:course}}\">web-dev-101.md</a><a href=\"{{p:lesson}}\">lesson-03.js</a><a href=\"{{p:roadmap}}\">roadmap.log</a><a href=\"{{p:playground}}\">playground.html</a><a href=\"{{p:pricing}}\">pricing.json</a><a href=\"{{p:mentors}}\">mentors.yml</a><a href=\"{{p:faq}}\">faq.md</a><a href=\"{{p:privacy}}\">privacy.txt</a><a href=\"{{p:404}}\">404.err</a></nav></details><div class=\"cc-shell\"><aside class=\"cc-side\"><div class=\"cc-dots\"><i></i><i></i><i></i></div><a class=\"cc-logo\" href=\"{{p:home}}\">commit<span>.</span>camp</a><div class=\"cc-tree\"><h4>Learn</h4><a class=\"\" href=\"{{p:home}}\">index.html</a><a class=\"\" href=\"{{p:courses}}\">courses/</a><a class=\"\" href=\"{{p:course}}\">web-dev-101.md</a><a class=\"\" href=\"{{p:lesson}}\">lesson-03.js</a><a class=\"\" href=\"{{p:roadmap}}\">roadmap.log</a><a class=\"\" href=\"{{p:playground}}\">playground.html</a></div><div class=\"cc-tree\"><h4>Camp</h4><a class=\"\" href=\"{{p:pricing}}\">pricing.json</a><a class=\"\" href=\"{{p:mentors}}\">mentors.yml</a><a class=\"\" href=\"{{p:faq}}\">faq.md</a></div><div class=\"cc-tree\"><h4>Utility</h4><a class=\"\" href=\"{{p:privacy}}\">privacy.txt</a><a class=\"\" href=\"{{p:404}}\">404.err</a></div><a class=\"cta\" href=\"{{p:pricing}}\">$ enroll --free-week</a></aside><div class=\"cc-main\"><div class=\"cc-tabs\"><span class=\"on\">commit.camp</span><span>~/learn</span><span>main ✓</span></div><div class=\"cc-body\"><script>/* Runs in previews AND exported files. No requests, credentials or submissions. */\n(function(){\n 'use strict';\n function start(){\n  var root=document.querySelector('[data-dl-template]');if(!root)return;\n  document.querySelectorAll('[data-dl-demo-form]').forEach(function(form,index){\n   if(form.dataset.dlBound)return;form.dataset.dlBound='1';\n   var note=document.createElement('p');note.className='dl-form-note';note.textContent='Interactive demo · Nothing is sent. Use sample details only. No account, booking or payment will be created.';form.prepend(note);\n   var result=document.createElement('p');result.className='dl-feedback';result.setAttribute('role','status');result.setAttribute('aria-live','polite');result.hidden=true;form.append(result);\n   form.querySelectorAll('input,textarea,select').forEach(function(input,i){\n    if(!input.name)input.name='demo-'+index+'-'+i;\n    var label=input.closest('label'),text=(label?label.textContent:input.placeholder||'').toLowerCase();\n    if(/name|email|message|date|time/.test(text)&&!/optional/.test(text))input.required=true;\n    if(input.type==='password')input.autocomplete='new-password';\n    if(/card number|cvc|expiry/.test(text)){input.disabled=true;input.placeholder='Disabled in demo';}\n   });\n   function submit(e){if(e)e.preventDefault();if(!form.reportValidity())return;result.hidden=false;result.textContent='Demo complete. Your entries passed the browser checks. Nothing was sent, charged, booked or stored.';}\n   form.addEventListener('submit',submit);\n   if(!form.querySelector('[type=\"submit\"],button:not([type])')){var buttons=form.querySelectorAll('button[type=\"button\"]');if(buttons.length===1)buttons[0].addEventListener('click',submit);}\n  });\n  document.querySelectorAll('.dl-visual img').forEach(function(img){img.addEventListener('error',function(){img.parentElement.classList.add('dl-photo-failed')});if(img.complete&&!img.naturalWidth)img.parentElement.classList.add('dl-photo-failed')});\n  document.querySelectorAll('.shoptop').forEach(function(top){\n   var grid=top.nextElementSibling;if(!grid||!grid.matches('.products'))return;\n   var cards=Array.from(grid.children),chips=Array.from(top.querySelectorAll('.chip')),sort=top.querySelector('select'),category='All';\n   var empty=document.createElement('p');empty.className='dl-filter-empty';empty.textContent='No sample items match this category. Choose All to see the collection.';empty.hidden=true;grid.after(empty);\n   function update(){var shown=0;cards.forEach(function(card){var tag=card.querySelector('small');card.hidden=category!=='All'&&(!tag||tag.textContent.trim()!==category);if(!card.hidden)shown++});empty.hidden=shown!==0;var count=top.querySelector('.sort span');if(count)count.textContent=shown+' sample items';}\n   chips.forEach(function(chip){chip.type='button';chip.setAttribute('aria-pressed',chip.classList.contains('on'));chip.addEventListener('click',function(){category=chip.textContent.trim();chips.forEach(function(c){c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',c===chip)});update()})});\n   if(sort){sort.setAttribute('aria-label','Sort sample items');Array.from(sort.options).forEach(function(o){if(/newest/i.test(o.textContent))o.textContent='Reverse featured'});sort.addEventListener('change',function(){var ordered=cards.slice();if(sort.selectedIndex===1||sort.selectedIndex===2){ordered.sort(function(a,b){function price(c){var p=c.querySelector('.price');return Number((p?p.textContent:'').replace(/[^0-9.]/g,''))||0}return price(a)-price(b)});if(sort.selectedIndex===2)ordered.reverse()}else if(sort.selectedIndex===3)ordered.reverse();ordered.forEach(function(card){grid.append(card)})})}\n  });\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.burger[open],.dl-mobile[open],.nav details[open]').forEach(function(menu){menu.open=false;var summary=menu.querySelector('summary');if(summary)summary.focus()})});\n  document.addEventListener('click',function(e){var a=e.target.closest('.dl-mobile a,.bmenu a');if(a){var menu=a.closest('details');if(menu)menu.open=false;}});\n  document.querySelectorAll('.more>a[href=\"#\"]').forEach(function(a){a.setAttribute('role','button');a.setAttribute('aria-expanded','false');function set(open){a.parentElement.classList.toggle('dl-menu-open',open);a.setAttribute('aria-expanded',open)}function toggle(e){e.preventDefault();set(a.getAttribute('aria-expanded')!=='true')}a.addEventListener('click',toggle);a.addEventListener('keydown',function(e){if(e.key===' ')toggle(e)});a.parentElement.addEventListener('mouseenter',function(){set(true)});a.parentElement.addEventListener('mouseleave',function(){if(!a.parentElement.contains(document.activeElement))set(false)})});\n  document.addEventListener('click',function(e){var a=e.target.closest('a[href=\"#\"]');if(!a||e.defaultPrevented||a.onclick||a.closest('.more'))return;e.preventDefault();var note=a.parentElement.querySelector(':scope>.dl-missing-link');if(!note){note=document.createElement('p');note.className='dl-feedback dl-missing-link';note.setAttribute('role','status');a.after(note)}note.textContent='Demonstration link. Add the real destination before launching this site.'});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.dl-menu-open').forEach(function(menu){menu.classList.remove('dl-menu-open');var a=menu.querySelector(':scope>a');if(a){a.setAttribute('aria-expanded','false');a.focus()}})});\n  document.querySelectorAll('.dl-skip').forEach(function(link){link.addEventListener('click',function(e){e.preventDefault();var target=document.querySelector('main.on [data-dl-content],main:not([data-page]) [data-dl-content]');if(target){target.focus();target.scrollIntoView({block:'start'})}})});\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>/* Sample commerce only: local item choices, quantities and consistent totals. */\n(function(){\n 'use strict';\n function start(){\n  var marker=document.querySelector('[data-dl-template]');if(!marker||marker.dataset.dlTemplate==='restaurant-warm')return;\n  var carts=Array.from(document.querySelectorAll('.cart')).filter(function(x){return x.querySelector('.crow')}),details=Array.from(document.querySelectorAll('.pdp,[data-dl-product]')).filter(function(x){return x.querySelector('.pinfo .price')}),checkouts=Array.from(document.querySelectorAll('aside.side-card')).filter(function(x){return x.querySelector('.kv')&&x.previousElementSibling&&x.previousElementSibling.querySelector('form')});\n  if(!carts.length&&!details.length&&!checkouts.length)return;\n  var currency='RM ',rows=[],key='dl-sample-cart:'+marker.dataset.dlTemplate;\n  function amount(text){return Number(String(text).replace(/[^0-9.]/g,''))||0}\n  function money(n){return currency+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function item(name,price,qty){return {name:String(name).slice(0,120),price:Math.max(0,Math.min(10000000,price)),qty:Math.max(1,Math.min(99,qty))}}\n  if(carts.length){rows=Array.from(carts[0].querySelectorAll('.crow')).map(function(row){var p=row.querySelector(':scope>b'),h=row.querySelector('h3'),q=row.querySelector('.qty span');if(p){currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' '}return item(h?h.textContent:'Sample item',amount(p?p.textContent:0),amount(q?q.textContent:1)||1)})}\n  else if(checkouts.length){rows=Array.from(checkouts[0].querySelectorAll('.kv li:not(.tot)')).filter(function(row){return row.querySelector('b')&&amount(row.querySelector('b').textContent)>0&&!/tax|shipping|delivery|subtotal|fee/i.test(row.textContent)}).map(function(row){var p=row.querySelector('b');currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' ';return item(row.querySelector('span').textContent,amount(p.textContent),1)})}\n  try{var saved=JSON.parse(localStorage.getItem(key));if(saved&&Array.isArray(saved.rows)&&saved.rows.length<=100){rows=saved.rows.filter(function(r){return typeof r.name==='string'&&Number.isFinite(r.price)&&r.price>=0&&Number.isInteger(r.qty)&&r.qty>0&&r.qty<=99}).map(function(r){return item(r.name,r.price,r.qty)});if(typeof saved.currency==='string'&&/^[A-Z$€£¥ ]{1,8}$/.test(saved.currency))currency=saved.currency;}}catch(e){}\n  function save(){try{localStorage.setItem(key,JSON.stringify({currency:currency,rows:rows}))}catch(e){}}\n  function totals(){var sub=rows.reduce(function(sum,r){return sum+r.price*r.qty},0);return {subtotal:sub,total:sub}}\n  function makeLine(label,value,total){var li=document.createElement('li');if(total)li.className='tot';var span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=value;li.append(span,b);return li}\n  function render(){\n   document.querySelectorAll('header a[href]').forEach(function(a){var match=a.textContent.trim().match(/^(Cart|Bag)\\s*\\(\\d+\\)$/i);if(match)a.textContent=match[1]+' ('+rows.reduce(function(sum,r){return sum+r.qty},0)+')'});\n   carts.forEach(function(cart){cart.querySelectorAll('.crow,.dl-cart-empty').forEach(function(r){r.remove()});rows.forEach(function(row,i){var el=document.createElement('div');el.className='crow';el.dataset.dlCartRow=i;var spacer=document.createElement('div'),info=document.createElement('div'),h=document.createElement('h3'),small=document.createElement('small');h.textContent=row.name;small.textContent=money(row.price)+' each · sample item';info.append(h,small);var qty=document.createElement('div');qty.className='qty';[-1,1].forEach(function(change){var b=document.createElement('button');b.type='button';b.dataset.dlCartChange=change;b.textContent=change<0?'−':'+';b.setAttribute('aria-label',(change<0?'Decrease ':'Increase ')+row.name);if(change>0){var value=document.createElement('span');value.textContent=row.qty;qty.append(value)}qty.append(b)});var price=document.createElement('b');price.textContent=money(row.price*row.qty);var remove=document.createElement('button');remove.type='button';remove.className='btn ghost';remove.dataset.dlCartRemove='';remove.textContent='Remove';remove.setAttribute('aria-label','Remove '+row.name);el.append(spacer,info,qty,price,remove);cart.insertBefore(el,cart.querySelector(':scope>a'))});if(!rows.length){var empty=document.createElement('p');empty.className='dl-cart-empty';empty.setAttribute('role','status');empty.textContent='Your sample cart is empty. Browse the collection to add an item.';cart.prepend(empty)}var aside=cart.parentElement.querySelector('aside.side-card');if(aside){var list=aside.querySelector('.kv');if(list){list.replaceChildren(makeLine('Subtotal',money(totals().subtotal)),makeLine('Demo delivery / fees','Not applied'),makeLine('Total',money(totals().total),true))}var note=aside.querySelector('p');if(note)note.textContent='Local sample cart. Real delivery, tax and payment must be configured before launch.'}});\n   checkouts.forEach(function(aside){var list=aside.querySelector('.kv');list.replaceChildren();rows.forEach(function(r){list.append(makeLine(r.qty+' × '+r.name,money(r.price*r.qty)))});list.append(makeLine('Total · demo only',money(totals().total),true));var form=aside.parentElement.querySelector('form'),button=form&&form.querySelector('[type=submit]');if(button){button.textContent=rows.length?'Preview checkout · '+money(totals().total):'Add an item before checkout';button.disabled=!rows.length}});\n  }\n  details.forEach(function(detail){detail.querySelectorAll('.qty button').forEach(function(b){b.type='button';b.setAttribute('aria-label',b.textContent.trim()==='+'?'Increase quantity':'Decrease quantity')});detail.querySelectorAll('.chips .chip').forEach(function(b){b.type='button';b.setAttribute('aria-pressed',b.classList.contains('on'));b.addEventListener('click',function(){b.parentElement.querySelectorAll('.chip').forEach(function(x){x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)})})})});\n  document.addEventListener('click',function(e){var row=e.target.closest('[data-dl-cart-row]');if(row){var index=Number(row.dataset.dlCartRow),change=e.target.closest('[data-dl-cart-change]');if(e.target.closest('[data-dl-cart-remove]'))rows.splice(index,1);else if(change&&rows[index])rows[index].qty=Math.max(1,Math.min(99,rows[index].qty+Number(change.dataset.dlCartChange)));save();render();return}\n   var detail=e.target.closest('.pdp,[data-dl-product]');if(!detail)return;var button=e.target.closest('.qty button');if(button&&!button.onclick){var span=button.parentElement.querySelector('span');if(span)span.textContent=Math.max(1,Math.min(99,amount(span.textContent)+(button.textContent.trim()==='+'?1:-1)))}\n   var link=e.target.closest('.buy a,[data-dl-add]');if(link&&!e.defaultPrevented&&link.getAttribute('aria-disabled')!=='true'&&/cart(?:\\.|$)|#\\/cart/.test(link.getAttribute('href')||'')){var h=detail.querySelector('.pinfo h1'),price=detail.querySelector('.pinfo .price'),q=detail.querySelector('.qty span');if(h&&price){var chosen=Array.from(detail.querySelectorAll('.pinfo .chip.on,.pinfo .ok-finish [aria-pressed=true]')).map(function(b){return b.getAttribute('aria-label')||b.textContent.trim()}),name=h.textContent+(chosen.length?' · '+chosen.join(' / '):''),quantity=amount(q?q.textContent:1)||1,found=rows.find(function(r){return r.name===name});if(found)found.qty=Math.min(99,found.qty+quantity);else rows.push(item(name,amount(price.textContent),quantity));save();render()}}\n  });\n  render();\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script>","foot":"</div><div class=\"cc-status\"><span>⎇ main</span><span>✓ 0 errors</span><span>UTF-8</span><span style=\"margin-left:auto\">© 2026 commit.camp · template demo content</span><a href=\"{{p:privacy}}\">privacy</a></div></div></div>","pages":{"home":"<div tabindex=\"-1\" data-dl-content><section class=\"cc-sec\"><div class=\"cc-cm\">// 10-week online bootcamp · live mentors · build in public</div><h1 class=\"cc-h1\">Learn to code by<br><em>shipping</em> every week.</h1>\n<p style=\"max-width:52ch;line-height:1.8;margin:22px 0 28px;font-size:17px\">Short lessons, a real editor in the browser, and a mentor who reviews your pull request the next morning. No slides to memorise.</p>\n<p style=\"display:flex;gap:12px;flex-wrap:wrap\"><a class=\"cc-btn\" href=\"{{p:pricing}}\">$ start --free-week</a><a class=\"cc-btn o\" href=\"{{p:roadmap}}\">$ git log roadmap</a></p>\n<div class=\"cc-term\" style=\"margin-top:44px;max-width:760px\"><div class=\"bar\"><i></i><i></i><i></i></div><pre><span class=\"p\">learner@camp</span>:<span class=\"d\">~/week-03</span>$ npm test\n<span class=\"k\">PASS</span> js/closures.test.js\n<span class=\"k\">PASS</span> js/dom.test.js\n<span class=\"d\">Tests: 12 passed, 12 total</span>\n<span class=\"p\">learner@camp</span>:<span class=\"d\">~/week-03</span>$ git push origin feature/gallery <span class=\"cc-cur\"></span></pre></div></section>\n<section class=\"cc-sec\" style=\"padding-top:0\"><div class=\"cc-cm\">// <b>courses</b> — pick a track or follow the roadmap</div><div class=\"cc-grid\"><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// beginner</span><h3>Web Dev 101</h3><p>HTML, CSS and just enough JavaScript to ship a real page.</p><div class=\"cc-bar\"><i style=\"--p:72%\"></i></div><div class=\"m\"><span>8 weeks</span><span>42 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// beginner</span><h3>Python from zero</h3><p>Variables to small programs. Automate something you do daily.</p><div class=\"cc-bar\"><i style=\"--p:40%\"></i></div><div class=\"m\"><span>6 weeks</span><span>36 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// intermediate</span><h3>JavaScript, properly</h3><p>Closures, async, the DOM and testing without the fog.</p><div class=\"cc-bar\"><i style=\"--p:0%\"></i></div><div class=\"m\"><span>6 weeks</span><span>30 lessons</span></div></a></div><p style=\"margin-top:26px\"><a class=\"cc-btn o\" href=\"{{p:courses}}\">$ ls courses/</a></p></section>\n<section class=\"cc-sec\" style=\"padding-top:0\"><div class=\"cc-cm\">// how a week works</div><div class=\"cc-grid\"><div class=\"cc-card\"><span class=\"t\">mon</span><h3>Learn</h3><p>5 short lessons with an editor beside the video.</p></div><div class=\"cc-card\"><span class=\"t\">wed</span><h3>Build</h3><p>A weekly project, started from a template repo.</p></div><div class=\"cc-card\"><span class=\"t\">fri</span><h3>Review</h3><p>Mentor code review and a 20-minute live Q&amp;A.</p></div></div></section></div>","courses":"<div tabindex=\"-1\" data-dl-content><section class=\"cc-sec\"><div class=\"cc-cm\">// ls courses/</div><h1 class=\"cc-h1\">All courses</h1><p style=\"margin:18px 0 30px;max-width:52ch;line-height:1.8\">Six courses in three levels. Each has a free first lesson.</p><div class=\"cc-grid\"><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// beginner</span><h3>Web Dev 101</h3><p>HTML, CSS and just enough JavaScript to ship a real page.</p><div class=\"cc-bar\"><i style=\"--p:72%\"></i></div><div class=\"m\"><span>8 weeks</span><span>42 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// beginner</span><h3>Python from zero</h3><p>Variables to small programs. Automate something you do daily.</p><div class=\"cc-bar\"><i style=\"--p:40%\"></i></div><div class=\"m\"><span>6 weeks</span><span>36 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// intermediate</span><h3>JavaScript, properly</h3><p>Closures, async, the DOM and testing without the fog.</p><div class=\"cc-bar\"><i style=\"--p:0%\"></i></div><div class=\"m\"><span>6 weeks</span><span>30 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// intermediate</span><h3>React in practice</h3><p>Components, state and a capstone that talks to an API.</p><div class=\"cc-bar\"><i style=\"--p:0%\"></i></div><div class=\"m\"><span>8 weeks</span><span>38 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// intermediate</span><h3>APIs & databases</h3><p>Design endpoints, model data, write the SQL you actually need.</p><div class=\"cc-bar\"><i style=\"--p:0%\"></i></div><div class=\"m\"><span>6 weeks</span><span>28 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// advanced</span><h3>Ship it: deploy & CI</h3><p>Containers, pipelines and monitoring for a project you can show.</p><div class=\"cc-bar\"><i style=\"--p:0%\"></i></div><div class=\"m\"><span>4 weeks</span><span>20 lessons</span></div></a></div></section></div>","course":"<div tabindex=\"-1\" data-dl-content><section class=\"cc-sec\"><div class=\"cc-cm\">// courses/web-dev-101.md</div><h1 class=\"cc-h1\">Web Dev 101</h1><p style=\"margin:18px 0 26px;max-width:56ch;line-height:1.8;font-size:17px\">Eight weeks from a blank file to a deployed multi-page site. Beginner friendly; no prior coding needed.</p>\n<div class=\"cc-split\"><div><div class=\"cc-cm\">// syllabus</div><div class=\"faq\" style=\"max-width:none\"><details open><summary>Week 1 · HTML you will actually use</summary><p>Elements, semantics, forms, accessibility basics. Project: a personal page.</p></details><details><summary>Week 2–3 · CSS layout</summary><p>Flexbox, grid, responsive design. Project: a magazine layout.</p></details><details><summary>Week 4–5 · JavaScript fundamentals</summary><p>Variables, functions, the DOM, events. Project: an interactive gallery.</p></details><details><summary>Week 6–7 · Fetching data</summary><p>fetch, JSON, loading states. Project: a weather dashboard.</p></details><details><summary>Week 8 · Ship it</summary><p>Git, deploy and a code review. Capstone.</p></details></div></div>\n<aside class=\"cc-card\"><span class=\"t\">// enrol</span><h3>RM 590</h3><p>One-off, with 12 months of access and mentor reviews.</p><a class=\"cc-btn\" href=\"{{p:pricing}}\">$ enrol</a><a class=\"cc-btn o\" href=\"{{p:lesson}}\">preview lesson 1</a></aside></div></section></div>","lesson":"<div tabindex=\"-1\" data-dl-content><section class=\"cc-sec\"><div class=\"cc-cm\">// web-dev-101 / week-04 / lesson-03</div><div class=\"cc-split\"><div><div class=\"cc-player\"><div class=\"cc-vid\"><span>▶</span><em>03 · Events and listeners — 08:42</em></div><div class=\"cc-ctl\"><span>00:00 ━━━━━━━━━━ 08:42</span><span>1.0× · cc · full</span></div></div>\n<h2 style=\"font:700 24px var(--f-head);margin:22px 0 8px;color:var(--c-primary)\">Events and listeners</h2><p style=\"line-height:1.8;max-width:60ch\">A click is just a message. Listen for it, run a function, and update the page. Try the exercise on the right after the video.</p><pre class=\"cc-term\" style=\"margin-top:18px;padding:18px;font:400 14px/1.8 var(--f-head)\">button.addEventListener(<span class=\"p\">\"click\"</span>, () => {\n  count++;\n  label.textContent = count;\n});</pre></div>\n<div><div class=\"cc-cm\">// week 4 · 5 lessons</div><div class=\"cc-list\"><a href=\"#\"><span class=\"n\">01</span><span>Variables recap</span><span class=\"on\">✓</span></a><a href=\"#\"><span class=\"n\">02</span><span>Selecting elements</span><span class=\"on\">✓</span></a><a class=\"cur\" href=\"#\"><span class=\"n\">03</span><span>Events and listeners</span><span>▶</span></a><a href=\"#\"><span class=\"n\">04</span><span>Updating the DOM</span><span></span></a><a href=\"#\"><span class=\"n\">05</span><span>Mini project</span><span></span></a></div><p style=\"margin-top:16px\"><a class=\"cc-btn\" href=\"{{p:playground}}\">open in playground</a></p></div></div></section></div>","roadmap":"<div tabindex=\"-1\" data-dl-content><section class=\"cc-sec\"><div class=\"cc-cm\">// git log --graph --oneline roadmap</div><h1 class=\"cc-h1\">The roadmap</h1><p style=\"margin:18px 0 30px;max-width:56ch;line-height:1.8\">Four tracks branch from the same trunk. Merge when you're ready.</p>\n<div class=\"cc-log\"><a href=\"{{p:course}}\"><span class=\"h\">a1f3c2e</span><span><span class=\"g\">* </span><b>Capstone: ship a full-stack project</b></span><span class=\"tag\">HEAD</span></a><a href=\"{{p:courses}}\"><span class=\"h\">8d02b91</span><span><span class=\"g\">*   </span><b>Ship it: deploy &amp; CI</b></span><span class=\"tag\">4w</span></a><div><span class=\"h\"></span><span class=\"g\">|\\</span><span></span></div><a href=\"{{p:courses}}\"><span class=\"h\">3be7a40</span><span><span class=\"g\">| * </span><b>APIs &amp; databases</b></span><span class=\"tag\">6w</span></a><a href=\"{{p:courses}}\"><span class=\"h\">c9d61f8</span><span><span class=\"g\">* | </span><b>React in practice</b></span><span class=\"tag\">8w</span></a><div><span class=\"h\"></span><span class=\"g\">|/</span><span></span></div><a href=\"{{p:courses}}\"><span class=\"h\">f72ab05</span><span><span class=\"g\">* </span><b>JavaScript, properly</b></span><span class=\"tag\">6w</span></a><a href=\"{{p:course}}\"><span class=\"h\">1c48e3d</span><span><span class=\"g\">* </span><b>Web Dev 101</b></span><span class=\"tag\">8w</span></a><a href=\"{{p:courses}}\"><span class=\"h\">0a000b1</span><span><span class=\"g\">* </span><b>Initial commit: you, today</b></span><span class=\"tag\">0w</span></a></div></section></div>","playground":"<div tabindex=\"-1\" data-dl-content><section class=\"cc-sec\"><div class=\"cc-cm\">// playground.html</div><h1 class=\"cc-h1\" style=\"font-size:clamp(28px,4vw,48px)\">Playground</h1><p style=\"margin:14px 0 22px;color:var(--c-secondary)\">Edit HTML and CSS on the left. The preview runs in a sandbox, no scripts.</p><div class=\"cc-play\"><textarea id=\"cc-src\" spellcheck=\"false\" aria-label=\"HTML editor\">&lt;h1>Hello, camp&lt;/h1>\n&lt;p>Edit me. The preview updates as you type.&lt;/p>\n&lt;button>Click&lt;/button>\n\n&lt;style>\n  body{font-family:system-ui;padding:24px}\n  h1{color:#2563eb}\n  button{padding:8px 16px;border-radius:6px}\n&lt;/style></textarea><iframe id=\"cc-out\" sandbox title=\"Preview\"></iframe></div></section><script>(function(){var t=document.getElementById(\"cc-src\"),f=document.getElementById(\"cc-out\");if(!t)return;function u(){f.srcdoc=t.value}t.addEventListener(\"input\",u);u()})();</script></div>","pricing":"<div tabindex=\"-1\" data-dl-content><section class=\"cc-sec\"><div class=\"cc-cm\">// pricing.json</div><h1 class=\"cc-h1\">Pricing</h1><p style=\"margin:18px 0 30px;color:var(--c-secondary)\">First week free on every plan. Cancel from the dashboard.</p><div class=\"cc-price\"><div><span class=\"t cc-cm\">single course</span><div class=\"p\">RM 590 <small>/ course</small></div><ul><li>12 months of access</li><li>Weekly mentor review</li><li>Certificate of completion</li></ul><a class=\"cc-btn o\" href=\"{{p:courses}}\">choose course</a></div><div class=\"hl\"><span class=\"t cc-cm\">all courses</span><div class=\"p\">RM 99 <small>/ month</small></div><ul><li>Every course and track</li><li>Unlimited reviews</li><li>Private community</li></ul><a class=\"cc-btn\" href=\"#\">$ start free week</a></div><div><span class=\"t cc-cm\">teams</span><div class=\"p\">Custom</div><ul><li>Seats from 5</li><li>Progress dashboard</li><li>Private cohorts</li></ul><a class=\"cc-btn o\" href=\"#\">talk to us</a></div></div></section></div>","mentors":"<div tabindex=\"-1\" data-dl-content><section class=\"cc-sec\"><div class=\"cc-cm\">// mentors.yml</div><h1 class=\"cc-h1\">Mentors</h1><div class=\"cc-grid\" style=\"margin-top:28px\"><div class=\"cc-card\"><span class=\"t\">frontend</span><h3>Aisha R.</h3><p>Ex-agency developer, 9 years. Reviews your CSS before breakfast.</p></div><div class=\"cc-card\"><span class=\"t\">backend</span><h3>Daniel T.</h3><p>Built payments APIs. Will ask about your error handling.</p></div><div class=\"cc-card\"><span class=\"t\">career</span><h3>Mei L.</h3><p>Hiring manager turned coach. Portfolio and interview prep.</p></div></div></section></div>","faq":"<div tabindex=\"-1\" data-dl-content><section class=\"cc-sec\"><div class=\"cc-cm\">// faq.md</div><h1 class=\"cc-h1\">FAQ</h1><div class=\"faq\" style=\"margin-top:26px\"><details open><summary>Do I need a laptop with special specs?</summary><p>No. Any laptop with a modern browser works; the editor runs in the page.</p></details><details><summary>How many hours a week?</summary><p>Plan for 8–10 hours. Live sessions are recorded.</p></details><details><summary>Will you help me find a job?</summary><p>Career sessions and portfolio reviews are included; we can't promise a job.</p></details></div></section></div>","privacy":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Privacy policy</b></div><h1 style=\"\">Privacy policy</h1></div></section><section class=\"cc-sec\" style=\"padding-top:20px\"><div class=\"prose\"><p>Replace with your privacy policy: what you collect, why, how long you keep it and how customers can ask for deletion.</p></div></section></div>","404":"<div tabindex=\"-1\" data-dl-content><section class=\"cc-sec\"><div class=\"cc-term\" style=\"max-width:640px\"><div class=\"bar\"><i></i><i></i><i></i></div><pre><span class=\"p\">learner@camp</span>:~$ cat page.html\n<span class=\"k\">cat: page.html: No such file or directory</span>\n<span class=\"d\">404 — this route returned nothing.</span>\n<span class=\"p\">learner@camp</span>:~$ cd <span class=\"cc-cur\"></span></pre></div><p style=\"margin-top:26px\"><a class=\"cc-btn\" href=\"{{p:home}}\">$ cd ~</a></p></section></div>"}}