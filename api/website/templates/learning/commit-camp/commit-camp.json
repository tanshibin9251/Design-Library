{"slug":"commit-camp","name":"Commit Camp","zh":"编程训练营","tag":"Online coding bootcamp platform in an IDE shell: file-tree navigation, terminal hero, git-log roadmap and a live HTML/CSS playground.","colors":{"primary":"#e6edf3","secondary":"#8b949e","text":"#c9d1d9","accent":"#3fb950","surface":"#0d1117","border":"#30363d"},"fonts":{"head":"Geist Mono","body":"Geist"},"tok":{"hlh":"1.1","hw":"700","hcase":"none","hls":"-.02em","h1":"64px","h2":"40px","h3":"20px","pad":"84px","ew":"600","stat":"var(--c-accent)","radius":"6px"},"types":["landing","company"],"ind":["coding","education"],"styles":["dark","futuristic","monochrome"],"license":"库内自有","format":"fragments","pagelist":[{"slug":"home","label":"Home","group":"Learn"},{"slug":"courses","label":"Courses","group":"Learn"},{"slug":"course","label":"Course: Web Dev 101","group":"Learn"},{"slug":"lesson","label":"Lesson player","group":"Learn"},{"slug":"roadmap","label":"Roadmap","group":"Learn"},{"slug":"playground","label":"Playground","group":"Learn"},{"slug":"pricing","label":"Pricing","group":"Camp"},{"slug":"mentors","label":"Mentors","group":"Camp"},{"slug":"faq","label":"FAQ","group":"Camp"},{"slug":"privacy","label":"Privacy policy","group":"Utility"},{"slug":"404","label":"404 error","group":"Utility"}],"nav":"<style>\n/* Commit Camp — IDE-chrome coding bootcamp, tokens only */\nbody{font-feature-settings:\"liga\" 1}\n.cc-shell{display:grid;grid-template-columns:250px minmax(0,1fr);min-height:100vh}\n.cc-side{position:sticky;top:0;align-self:start;height:100vh;overflow:auto;border-right:1px solid var(--c-border);background:color-mix(in srgb,var(--c-surface) 82%,#000);display:flex;flex-direction:column}\n.cc-dots{display:flex;gap:7px;padding:14px 16px}.cc-dots i{width:11px;height:11px;border-radius:50%;background:var(--c-border)}.cc-dots i:nth-child(1){background:var(--c-accent)}\n.cc-logo{display:block;padding:6px 16px 18px;font:700 17px var(--f-head);color:var(--c-primary);text-decoration:none;letter-spacing:0}\n.cc-logo span{color:var(--c-accent)}\n.cc-tree h4{font:600 11px var(--f-head);letter-spacing:.14em;text-transform:uppercase;color:var(--c-secondary);padding:14px 16px 6px}\n.cc-tree a{display:flex;align-items:center;gap:8px;padding:8px 16px 8px 22px;min-height:40px;text-decoration:none;font:400 13px var(--f-head);color:var(--c-text);border-left:2px solid transparent}\n.cc-tree a::before{content:\"▸\";color:var(--c-secondary);font-size:10px}\n.cc-tree a:hover{background:color-mix(in srgb,var(--c-primary) 6%,transparent)}\n.cc-tree a.on{background:color-mix(in srgb,var(--c-accent) 12%,transparent);border-left-color:var(--c-accent);color:var(--c-primary)}\n.cc-side .cta{margin:auto 16px 18px;display:grid;place-items:center;min-height:44px;background:var(--c-accent);color:var(--on-accent);text-decoration:none;font:700 13px var(--f-head);border-radius:6px}\n.cc-main{min-width:0;display:flex;flex-direction:column}\n.cc-tabs{display:flex;gap:0;border-bottom:1px solid var(--c-border);background:color-mix(in srgb,var(--c-surface) 82%,#000);overflow:auto}\n.cc-tabs span{padding:11px 18px;font:400 12px var(--f-head);color:var(--c-secondary);border-right:1px solid var(--c-border);white-space:nowrap}\n.cc-tabs span.on{color:var(--c-primary);background:var(--c-surface);box-shadow:inset 0 2px 0 var(--c-accent)}\n.cc-body{flex:1;min-width:0}\n.cc-m{display:none}\n@media(max-width:900px){.cc-shell{grid-template-columns:1fr}.cc-side{display:none}.cc-m{display:block;position:sticky;top:0;z-index:40;background:var(--c-surface);border-bottom:1px solid var(--c-border)}\n .cc-m summary{list-style:none;cursor:pointer;min-height:48px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;font:700 15px var(--f-head);color:var(--c-primary)}\n .cc-m summary::-webkit-details-marker{display:none}.cc-m summary b{font:400 12px var(--f-head);color:var(--c-secondary);border:1px solid var(--c-border);padding:6px 10px;border-radius:6px}\n .cc-m nav{display:grid;padding:4px 16px 16px}.cc-m nav a{padding:12px 0;border-bottom:1px solid var(--c-border);text-decoration:none;font:400 14px var(--f-head);min-height:44px}}\n\n.cc-sec{padding:clamp(40px,6vw,84px) clamp(18px,4vw,64px)}\n.cc-cm{font:400 13px var(--f-head);color:var(--c-secondary);margin-bottom:14px}\n.cc-cm b{color:var(--c-accent);font-weight:400}\n.cc-h1{font:700 clamp(34px,5.2vw,var(--h1)) var(--f-head);letter-spacing:-.02em;line-height:1.08;color:var(--c-primary)}\n.cc-h1 em{font-style:normal;color:var(--c-accent)}\n.cc-btn{display:inline-flex;align-items:center;gap:10px;min-height:46px;padding:0 22px;border:1px solid var(--c-accent);background:var(--c-accent);color:var(--on-accent);font:700 14px var(--f-head);text-decoration:none;border-radius:6px;cursor:pointer}\n.cc-btn.o{background:transparent;color:var(--c-accent)}\n.cc-btn:hover{filter:brightness(1.12)}\n.cc-term{border:1px solid var(--c-border);border-radius:10px;background:color-mix(in srgb,var(--c-surface) 70%,#000);overflow:hidden;font:400 14px/1.8 var(--f-head)}\n.cc-term .bar{display:flex;gap:7px;padding:10px 14px;border-bottom:1px solid var(--c-border)}.cc-term .bar i{width:10px;height:10px;border-radius:50%;background:var(--c-border)}\n.cc-term pre{padding:18px 20px;white-space:pre-wrap;word-break:break-word;color:var(--c-text)}\n.cc-term .p{color:var(--c-accent)}.cc-term .d{color:var(--c-secondary)}.cc-term .k{color:var(--c-primary)}\n.cc-cur{display:inline-block;width:.6em;height:1.1em;background:var(--c-accent);vertical-align:-.15em;animation:ccb 1s steps(2) infinite}\n@keyframes ccb{50%{opacity:0}}\n.cc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n.cc-card{border:1px solid var(--c-border);border-radius:10px;background:color-mix(in srgb,var(--c-surface) 70%,#000);padding:22px;display:grid;gap:10px;align-content:start;text-decoration:none;transition:border-color .2s,transform .2s}\n.cc-card:hover{border-color:var(--c-accent);transform:translateY(-2px)}\n.cc-card .t{font:400 12px var(--f-head);color:var(--c-accent)}\n.cc-card h3{font:700 19px var(--f-head);letter-spacing:-.01em;color:var(--c-primary)}\n.cc-card p{font:400 14px/1.7 var(--f-body);color:var(--c-text);opacity:.85}\n.cc-card .m{display:flex;gap:14px;font:400 12px var(--f-head);color:var(--c-secondary);margin-top:6px}\n.cc-bar{height:6px;border-radius:99px;background:var(--c-border);overflow:hidden}.cc-bar i{display:block;height:100%;background:var(--c-accent);width:var(--p)}\n@media(max-width:1000px){.cc-grid{grid-template-columns:1fr 1fr}}@media(max-width:640px){.cc-grid{grid-template-columns:1fr}}\n.cc-log{font:400 14px/1.9 var(--f-head);display:grid;gap:0}\n.cc-log a,.cc-log div{display:grid;grid-template-columns:62px 1fr auto;gap:14px;padding:6px 0;text-decoration:none;align-items:baseline}\n.cc-log .g{color:var(--c-accent);white-space:pre}.cc-log .h{color:var(--c-secondary)}\n.cc-log .tag{font-size:11px;border:1px solid var(--c-accent);color:var(--c-accent);padding:1px 8px;border-radius:99px}\n.cc-log b{font-weight:400;color:var(--c-primary)}\n.cc-play{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--c-border);border-radius:10px;overflow:hidden;min-height:440px}\n.cc-play textarea{width:100%;height:100%;min-height:440px;border:0;border-radius:0;border-right:1px solid var(--c-border);background:color-mix(in srgb,var(--c-surface) 70%,#000);color:var(--c-text);font:400 14px/1.7 var(--f-head);padding:18px;resize:none;outline:0;box-shadow:none}\n.cc-play iframe{width:100%;height:100%;min-height:440px;border:0;background:#fff}\n@media(max-width:800px){.cc-play{grid-template-columns:1fr}.cc-play textarea{border-right:0;border-bottom:1px solid var(--c-border);min-height:260px}.cc-play iframe{min-height:300px}}\n.cc-player{border:1px solid var(--c-border);border-radius:10px;overflow:hidden;background:color-mix(in srgb,var(--c-surface) 70%,#000)}\n.cc-vid{aspect-ratio:16/9;display:grid;place-items:center;background:repeating-linear-gradient(45deg,transparent 0 16px,color-mix(in srgb,var(--c-primary) 5%,transparent) 16px 17px);position:relative}\n.cc-vid span{width:68px;height:68px;border-radius:50%;background:var(--c-accent);color:var(--on-accent);display:grid;place-items:center;font-size:22px}\n.cc-vid em{position:absolute;left:14px;bottom:10px;font:400 11px var(--f-head);font-style:normal;color:var(--c-secondary)}\n.cc-ctl{display:flex;justify-content:space-between;padding:12px 16px;font:400 12px var(--f-head);color:var(--c-secondary);border-top:1px solid var(--c-border)}\n.cc-split{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,1fr);gap:clamp(20px,3vw,40px);align-items:start}\n@media(max-width:900px){.cc-split{grid-template-columns:1fr}}\n.cc-list{display:grid;gap:0;border:1px solid var(--c-border);border-radius:10px;overflow:hidden}\n.cc-list a{display:grid;grid-template-columns:30px 1fr auto;gap:10px;padding:13px 16px;border-bottom:1px solid var(--c-border);text-decoration:none;font:400 13px var(--f-head);min-height:44px;align-items:center}\n.cc-list a:last-child{border-bottom:0}.cc-list .n{color:var(--c-secondary)}.cc-list .on{color:var(--c-accent)}\n.cc-list a.cur{background:color-mix(in srgb,var(--c-accent) 12%,transparent)}\n.cc-price{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n.cc-price>div{border:1px solid var(--c-border);border-radius:10px;padding:26px;display:grid;gap:12px;align-content:start}\n.cc-price>.hl{border-color:var(--c-accent);box-shadow:0 0 0 1px var(--c-accent)}\n.cc-price .p{font:700 38px var(--f-head);color:var(--c-primary)}.cc-price .p small{font:400 14px var(--f-head);color:var(--c-secondary)}\n.cc-price li{list-style:none;font:400 14px var(--f-body);padding:7px 0;border-top:1px solid var(--c-border)}.cc-price li::before{content:\"✓ \";color:var(--c-accent)}\n@media(max-width:900px){.cc-price{grid-template-columns:1fr}}\n.cc-status{display:flex;gap:18px;flex-wrap:wrap;align-items:center;background:var(--c-accent);color:var(--on-accent);padding:0 16px;min-height:28px;font:400 12px var(--f-head);position:sticky;bottom:0;z-index:10}\n.cc-status a{color:inherit;text-decoration:none}\n.faq summary{font-family:var(--f-head);font-size:16px}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}\n@media(prefers-reduced-motion:reduce){.cc-cur{animation:none}.cc-card{transition:none}}\n</style><details class=\"cc-m\"><summary><span>commit<span style=\"color:var(--c-accent)\">.</span>camp</span><b>menu</b></summary><nav><a href=\"{{p:home}}\">index.html</a><a href=\"{{p:courses}}\">courses/</a><a href=\"{{p:course}}\">web-dev-101.md</a><a href=\"{{p:lesson}}\">lesson-03.js</a><a href=\"{{p:roadmap}}\">roadmap.log</a><a href=\"{{p:playground}}\">playground.html</a><a href=\"{{p:pricing}}\">pricing.json</a><a href=\"{{p:mentors}}\">mentors.yml</a><a href=\"{{p:faq}}\">faq.md</a><a href=\"{{p:privacy}}\">privacy.txt</a><a href=\"{{p:404}}\">404.err</a></nav></details><div class=\"cc-shell\"><aside class=\"cc-side\"><div class=\"cc-dots\"><i></i><i></i><i></i></div><a class=\"cc-logo\" href=\"{{p:home}}\">commit<span>.</span>camp</a><div class=\"cc-tree\"><h4>Learn</h4><a class=\"\" href=\"{{p:home}}\">index.html</a><a class=\"\" href=\"{{p:courses}}\">courses/</a><a class=\"\" href=\"{{p:course}}\">web-dev-101.md</a><a class=\"\" href=\"{{p:lesson}}\">lesson-03.js</a><a class=\"\" href=\"{{p:roadmap}}\">roadmap.log</a><a class=\"\" href=\"{{p:playground}}\">playground.html</a></div><div class=\"cc-tree\"><h4>Camp</h4><a class=\"\" href=\"{{p:pricing}}\">pricing.json</a><a class=\"\" href=\"{{p:mentors}}\">mentors.yml</a><a class=\"\" href=\"{{p:faq}}\">faq.md</a></div><div class=\"cc-tree\"><h4>Utility</h4><a class=\"\" href=\"{{p:privacy}}\">privacy.txt</a><a class=\"\" href=\"{{p:404}}\">404.err</a></div><a class=\"cta\" href=\"{{p:pricing}}\">$ enroll --free-week</a></aside><div class=\"cc-main\"><div class=\"cc-tabs\"><span class=\"on\">commit.camp</span><span>~/learn</span><span>main ✓</span></div><div class=\"cc-body\">","foot":"</div><div class=\"cc-status\"><span>⎇ main</span><span>✓ 0 errors</span><span>UTF-8</span><span style=\"margin-left:auto\">© 2026 commit.camp · template demo content</span><a href=\"{{p:privacy}}\">privacy</a></div></div></div>","pages":{"home":"<section class=\"cc-sec\"><div class=\"cc-cm\">// 10-week online bootcamp · live mentors · build in public</div><h1 class=\"cc-h1\">Learn to code by<br><em>shipping</em> every week.</h1>\n<p style=\"max-width:52ch;line-height:1.8;margin:22px 0 28px;font-size:17px\">Short lessons, a real editor in the browser, and a mentor who reviews your pull request the next morning. No slides to memorise.</p>\n<p style=\"display:flex;gap:12px;flex-wrap:wrap\"><a class=\"cc-btn\" href=\"{{p:pricing}}\">$ start --free-week</a><a class=\"cc-btn o\" href=\"{{p:roadmap}}\">$ git log roadmap</a></p>\n<div class=\"cc-term\" style=\"margin-top:44px;max-width:760px\"><div class=\"bar\"><i></i><i></i><i></i></div><pre><span class=\"p\">learner@camp</span>:<span class=\"d\">~/week-03</span>$ npm test\n<span class=\"k\">PASS</span> js/closures.test.js\n<span class=\"k\">PASS</span> js/dom.test.js\n<span class=\"d\">Tests: 12 passed, 12 total</span>\n<span class=\"p\">learner@camp</span>:<span class=\"d\">~/week-03</span>$ git push origin feature/gallery <span class=\"cc-cur\"></span></pre></div></section>\n<section class=\"cc-sec\" style=\"padding-top:0\"><div class=\"cc-cm\">// <b>courses</b> — pick a track or follow the roadmap</div><div class=\"cc-grid\"><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// beginner</span><h3>Web Dev 101</h3><p>HTML, CSS and just enough JavaScript to ship a real page.</p><div class=\"cc-bar\"><i style=\"--p:72%\"></i></div><div class=\"m\"><span>8 weeks</span><span>42 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// beginner</span><h3>Python from zero</h3><p>Variables to small programs. Automate something you do daily.</p><div class=\"cc-bar\"><i style=\"--p:40%\"></i></div><div class=\"m\"><span>6 weeks</span><span>36 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// intermediate</span><h3>JavaScript, properly</h3><p>Closures, async, the DOM and testing without the fog.</p><div class=\"cc-bar\"><i style=\"--p:0%\"></i></div><div class=\"m\"><span>6 weeks</span><span>30 lessons</span></div></a></div><p style=\"margin-top:26px\"><a class=\"cc-btn o\" href=\"{{p:courses}}\">$ ls courses/</a></p></section>\n<section class=\"cc-sec\" style=\"padding-top:0\"><div class=\"cc-cm\">// how a week works</div><div class=\"cc-grid\"><div class=\"cc-card\"><span class=\"t\">mon</span><h3>Learn</h3><p>5 short lessons with an editor beside the video.</p></div><div class=\"cc-card\"><span class=\"t\">wed</span><h3>Build</h3><p>A weekly project, started from a template repo.</p></div><div class=\"cc-card\"><span class=\"t\">fri</span><h3>Review</h3><p>Mentor code review and a 20-minute live Q&amp;A.</p></div></div></section>","courses":"<section class=\"cc-sec\"><div class=\"cc-cm\">// ls courses/</div><h1 class=\"cc-h1\">All courses</h1><p style=\"margin:18px 0 30px;max-width:52ch;line-height:1.8\">Six courses in three levels. Each has a free first lesson.</p><div class=\"cc-grid\"><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// beginner</span><h3>Web Dev 101</h3><p>HTML, CSS and just enough JavaScript to ship a real page.</p><div class=\"cc-bar\"><i style=\"--p:72%\"></i></div><div class=\"m\"><span>8 weeks</span><span>42 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// beginner</span><h3>Python from zero</h3><p>Variables to small programs. Automate something you do daily.</p><div class=\"cc-bar\"><i style=\"--p:40%\"></i></div><div class=\"m\"><span>6 weeks</span><span>36 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// intermediate</span><h3>JavaScript, properly</h3><p>Closures, async, the DOM and testing without the fog.</p><div class=\"cc-bar\"><i style=\"--p:0%\"></i></div><div class=\"m\"><span>6 weeks</span><span>30 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// intermediate</span><h3>React in practice</h3><p>Components, state and a capstone that talks to an API.</p><div class=\"cc-bar\"><i style=\"--p:0%\"></i></div><div class=\"m\"><span>8 weeks</span><span>38 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// intermediate</span><h3>APIs & databases</h3><p>Design endpoints, model data, write the SQL you actually need.</p><div class=\"cc-bar\"><i style=\"--p:0%\"></i></div><div class=\"m\"><span>6 weeks</span><span>28 lessons</span></div></a><a class=\"cc-card\" href=\"{{p:course}}\"><span class=\"t\">// advanced</span><h3>Ship it: deploy & CI</h3><p>Containers, pipelines and monitoring for a project you can show.</p><div class=\"cc-bar\"><i style=\"--p:0%\"></i></div><div class=\"m\"><span>4 weeks</span><span>20 lessons</span></div></a></div></section>","course":"<section class=\"cc-sec\"><div class=\"cc-cm\">// courses/web-dev-101.md</div><h1 class=\"cc-h1\">Web Dev 101</h1><p style=\"margin:18px 0 26px;max-width:56ch;line-height:1.8;font-size:17px\">Eight weeks from a blank file to a deployed multi-page site. Beginner friendly; no prior coding needed.</p>\n<div class=\"cc-split\"><div><div class=\"cc-cm\">// syllabus</div><div class=\"faq\" style=\"max-width:none\"><details open><summary>Week 1 · HTML you will actually use</summary><p>Elements, semantics, forms, accessibility basics. Project: a personal page.</p></details><details><summary>Week 2–3 · CSS layout</summary><p>Flexbox, grid, responsive design. Project: a magazine layout.</p></details><details><summary>Week 4–5 · JavaScript fundamentals</summary><p>Variables, functions, the DOM, events. Project: an interactive gallery.</p></details><details><summary>Week 6–7 · Fetching data</summary><p>fetch, JSON, loading states. Project: a weather dashboard.</p></details><details><summary>Week 8 · Ship it</summary><p>Git, deploy and a code review. Capstone.</p></details></div></div>\n<aside class=\"cc-card\"><span class=\"t\">// enrol</span><h3>RM 590</h3><p>One-off, with 12 months of access and mentor reviews.</p><a class=\"cc-btn\" href=\"{{p:pricing}}\">$ enrol</a><a class=\"cc-btn o\" href=\"{{p:lesson}}\">preview lesson 1</a></aside></div></section>","lesson":"<section class=\"cc-sec\"><div class=\"cc-cm\">// web-dev-101 / week-04 / lesson-03</div><div class=\"cc-split\"><div><div class=\"cc-player\"><div class=\"cc-vid\"><span>▶</span><em>03 · Events and listeners — 08:42</em></div><div class=\"cc-ctl\"><span>00:00 ━━━━━━━━━━ 08:42</span><span>1.0× · cc · full</span></div></div>\n<h2 style=\"font:700 24px var(--f-head);margin:22px 0 8px;color:var(--c-primary)\">Events and listeners</h2><p style=\"line-height:1.8;max-width:60ch\">A click is just a message. Listen for it, run a function, and update the page. Try the exercise on the right after the video.</p><pre class=\"cc-term\" style=\"margin-top:18px;padding:18px;font:400 14px/1.8 var(--f-head)\">button.addEventListener(<span class=\"p\">\"click\"</span>, () => {\n  count++;\n  label.textContent = count;\n});</pre></div>\n<div><div class=\"cc-cm\">// week 4 · 5 lessons</div><div class=\"cc-list\"><a href=\"#\"><span class=\"n\">01</span><span>Variables recap</span><span class=\"on\">✓</span></a><a href=\"#\"><span class=\"n\">02</span><span>Selecting elements</span><span class=\"on\">✓</span></a><a class=\"cur\" href=\"#\"><span class=\"n\">03</span><span>Events and listeners</span><span>▶</span></a><a href=\"#\"><span class=\"n\">04</span><span>Updating the DOM</span><span></span></a><a href=\"#\"><span class=\"n\">05</span><span>Mini project</span><span></span></a></div><p style=\"margin-top:16px\"><a class=\"cc-btn\" href=\"{{p:playground}}\">open in playground</a></p></div></div></section>","roadmap":"<section class=\"cc-sec\"><div class=\"cc-cm\">// git log --graph --oneline roadmap</div><h1 class=\"cc-h1\">The roadmap</h1><p style=\"margin:18px 0 30px;max-width:56ch;line-height:1.8\">Four tracks branch from the same trunk. Merge when you're ready.</p>\n<div class=\"cc-log\"><a href=\"{{p:course}}\"><span class=\"h\">a1f3c2e</span><span><span class=\"g\">* </span><b>Capstone: ship a full-stack project</b></span><span class=\"tag\">HEAD</span></a><a href=\"{{p:courses}}\"><span class=\"h\">8d02b91</span><span><span class=\"g\">*   </span><b>Ship it: deploy &amp; CI</b></span><span class=\"tag\">4w</span></a><div><span class=\"h\"></span><span class=\"g\">|\\</span><span></span></div><a href=\"{{p:courses}}\"><span class=\"h\">3be7a40</span><span><span class=\"g\">| * </span><b>APIs &amp; databases</b></span><span class=\"tag\">6w</span></a><a href=\"{{p:courses}}\"><span class=\"h\">c9d61f8</span><span><span class=\"g\">* | </span><b>React in practice</b></span><span class=\"tag\">8w</span></a><div><span class=\"h\"></span><span class=\"g\">|/</span><span></span></div><a href=\"{{p:courses}}\"><span class=\"h\">f72ab05</span><span><span class=\"g\">* </span><b>JavaScript, properly</b></span><span class=\"tag\">6w</span></a><a href=\"{{p:course}}\"><span class=\"h\">1c48e3d</span><span><span class=\"g\">* </span><b>Web Dev 101</b></span><span class=\"tag\">8w</span></a><a href=\"{{p:courses}}\"><span class=\"h\">0a000b1</span><span><span class=\"g\">* </span><b>Initial commit: you, today</b></span><span class=\"tag\">0w</span></a></div></section>","playground":"<section class=\"cc-sec\"><div class=\"cc-cm\">// playground.html</div><h1 class=\"cc-h1\" style=\"font-size:clamp(28px,4vw,48px)\">Playground</h1><p style=\"margin:14px 0 22px;color:var(--c-secondary)\">Edit HTML and CSS on the left. The preview runs in a sandbox, no scripts.</p><div class=\"cc-play\"><textarea id=\"cc-src\" spellcheck=\"false\" aria-label=\"HTML editor\">&lt;h1>Hello, camp&lt;/h1>\n&lt;p>Edit me. The preview updates as you type.&lt;/p>\n&l