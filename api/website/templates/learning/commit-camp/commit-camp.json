{"slug":"commit-camp","name":"Commit Camp","zh":"编程训练营","tag":"Online coding bootcamp platform in an IDE shell: file-tree navigation, terminal hero, git-log roadmap and a live HTML/CSS playground.","colors":{"primary":"#e6edf3","secondary":"#8b949e","text":"#c9d1d9","accent":"#3fb950","surface":"#0d1117","border":"#30363d"},"fonts":{"head":"Geist Mono","body":"Geist"},"tok":{"hlh":"1.1","hw":"700","hcase":"none","hls":"-.02em","h1":"64px","h2":"40px","h3":"20px","pad":"84px","ew":"600","stat":"var(--c-accent)","radius":"6px"},"types":["landing","company"],"ind":["coding","education"],"styles":["dark","futuristic","monochrome"],"license":"库内自有","format":"fragments","pagelist":[{"slug":"home","label":"Home","group":"Learn"},{"slug":"courses","label":"Courses","group":"Learn"},{"slug":"course","label":"Course: Web Dev 101","group":"Learn"},{"slug":"lesson","label":"Lesson player","group":"Learn"},{"slug":"roadmap","label":"Roadmap","group":"Learn"},{"slug":"playground","label":"Playground","group":"Learn"},{"slug":"pricing","label":"Pricing","group":"Camp"},{"slug":"mentors","label":"Mentors","group":"Camp"},{"slug":"faq","label":"FAQ","group":"Camp"},{"slug":"privacy","label":"Privacy policy","group":"Utility"},{"slug":"404","label":"404 error","group":"Utility"}],"nav":"<span data-dl-template=\"commit-camp\" hidden></span><style>/* Shared, exported template behaviour. Scope additions to enhanced fragments. */\n.dl-mobile{display:none}.dl-skip{position:fixed;left:16px;top:-100px;z-index:10000;padding:12px 18px;background:var(--c-surface);color:var(--c-text);border:2px solid var(--c-accent)}.dl-skip:focus{top:12px}\n.nav:has(details[open]){overflow:visible!important}.dl-filter-empty{padding:28px;border:1px dashed var(--c-border);border-radius:var(--radius);margin-top:20px}\n.products>[hidden],.dl-filter-empty[hidden]{display:none!important}\n/* A grid item's default min-content size must not widen its whole page. */\nmain :where(*){min-width:0}\n.more.dl-menu-open>.dd{