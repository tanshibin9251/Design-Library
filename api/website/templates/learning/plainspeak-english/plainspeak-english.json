ry);position:relative;min-height:280px}\n.ps-ph::after{content:attr(data-l);position:absolute;left:12px;bottom:10px;font:600 10px var(--f-body);letter-spacing:.14em;text-transform:uppercase}\n.ps-q{border-top:2px solid var(--c-primary);padding-top:20px}\n.ps-q h2{font:700 clamp(24px,3vw,38px)/1.2 var(--f-head);letter-spacing:-.02em;margin:10px 0 22px}\n.ps-q .o{display:grid;gap:10px}\n.ps-q button.opt{text-align:left;min-height:52px;padding:0 18px;border:1px solid var(--c-primary);background:transparent;font:500 17px var(--f-body);cursor:pointer;color:var(--c-text);display:flex;gap:14px;align-items:center}\n.ps-q button.opt b{font:700 12px var(--f-body);color:var(--c-accent);width:18px}\n.ps-q button.opt:hover{background:var(--c-primary);color:var(--on-primary)}\n.ps-prog{display:flex;gap:4px;margin-bottom:6px}.ps-prog i{flex:1;height:6px;background:var(--c-border)}.ps-prog i.d{background:var(--c-primary)}.ps-prog i.c{background:var(--c-accent)}\n.ps-res{font:800 clamp(80px,16vw,220px)/.9 var(--f-head);letter-spacing:-.05em;color:var(--c-accent)}\n.ps-plans{display:grid;grid-template-columns:repeat(3,1fr);border-top:2px solid var(--c-primary)}\n.ps-plans>div{padding:26px 22px 30px 0;border-right:1px solid var(--c-border);padding-left:22px;display:grid;gap:10px;align-content:start}\n.ps-plans>div:first-child{padding-left:0}.ps-plans>div:last-child{border-right:0}\n.ps-plans .p{font:800 44px var(--f-head);letter-spacing:-.04em}.ps-plans li{list-style:none;padding:8px 0;border-top:1px solid var(--c-border);font:400 15px var(--f-body)}\n@media(max-width:800px){.ps-plans{grid-template-columns:1fr}.ps-plans>div{border-right:0;border-bottom:1px solid var(--c-border);padding-left:0}}\n.ps-foot{background:var(--c-primary);color:var(--on-primary);padding:clamp(44px,6vw,80px) clamp(16px,3vw,44px) 22px}\n.ps-foot .big{font:800 clamp(60px,12vw,180px)/.85 var(--f-head);letter-spacing:-.05em;color:var(--on-primary)}\n.ps-foot .big i{font-style:normal;color:var(--c-accent)}\n.ps-foot .cols{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:40px;border-top:1px solid color-mix(in srgb,var(--on-primary) 30%,transparent);padding-top:22px}\n.ps-foot h4{font:700 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:var(--c-accent);margin-bottom:10px}\n.ps-foot ul{list-style:none}.ps-foot li a{display:inline-block;padding:6px 0;text-decoration:none;font:500 14px var(--f-body);min-height:32px}\n.ps-foot .copy{margin-top:28px;font:500 12px var(--f-body);opacity:.7}\n@media(max-width:700px){.ps-foot .cols{grid-template-columns:1fr 1fr}}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}\n@media(prefers-reduced-motion:reduce){.ps-tr{transition:none}}\n</style><header class=\"ps-head\"><div class=\"ps-row\"><a class=\"ps-logo\" href=\"{{p:home}}\">plainspeak<i>.</i></a><ul class=\"ps-nav\"><li><a href=\"{{p:courses}}\"><b>01</b>Courses</a></li><li><a href=\"{{p:level}}\"><b>02</b>Level check</a></li><li><a href=\"{{p:method}}\"><b>03</b>Method</a></li><li><a href=\"{{p:tutors}}\"><b>04</b>Tutors</a></li><li class=\"more\"><a href=\"#\" tabindex=\"0\"><b>05</b>More</a><div class=\"dd\"><div><h4>Learn</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:courses}}\">Courses</a><a href=\"{{p:course}}\">Course: Everyday Conversation</a><a href=\"{{p:lesson}}\">Lesson</a><a href=\"{{p:level}}\">Level check</a></div><div><h4>School</h4><a href=\"{{p:method}}\">Method</a><a href=\"{{p:tutors}}\">Tutors</a><a href=\"{{p:pricing}}\">Pricing</a><a href=\"{{p:faq}}\">FAQ</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li></ul><div class=\"ps-act\"><a href=\"#\">Log in</a><a class=\"b\" href=\"{{p:pricing}}\">Start free</a></div><details class=\"ps-m\"><summary>MENU</summary><nav><a href=\"{{p:home}}\">Home</a><a href=\"{{p:courses}}\">Courses</a><a href=\"{{p:course}}\">Course: Everyday Conversation</a><a href=\"{{p:lesson}}\">Lesson</a><a href=\"{{p:level}}\">Level check</a><a href=\"{{p:method}}\">Method</a><a href=\"{{p:tutors}}\">Tutors</a><a href=\"{{p:pricing}}\">Pricing</a><a href=\"{{p:faq}}\">FAQ</a><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></nav></details></div></header><script>/* Runs in previews AND exported files. No requests, credentials or submissions. */\n(function(){\n 'use strict';\n function start(){\n  var root=document.querySelector('[data-dl-template]');if(!root)return;\n  document.querySelectorAll('[data-dl-demo-form]').forEach(function(form,index){\n   if(form.dataset.dlBound)return;form.dataset.dlBound='1';\n   var note=document.createElement('p');note.className='dl-form-note';note.textContent='Interactive demo · Nothing is sent. Use sample details only. No account, booking or payment will be created.';form.prepend(note);\n   var result=document.createElement('p');result.className='dl-feedback';result.setAttribute('role','status');result.setAttribute('aria-live','polite');result.hidden=true;form.append(result);\n   form.querySelectorAll('input,textarea,select').forEach(function(input,i){\n    if(!input.name)input.name='demo-'+index+'-'+i;\n    var label=input.closest('label'),text=(label?label.textContent:input.placeholder||'').toLowerCase();\n    if(/name|email|message|date|time/.test(text)&&!/optional/.test(text))input.required=true;\n    if(input.type==='password')input.autocomplete='new-password';\n    if(/card number|cvc|expiry/.test(text)){input.disabled=true;input.placeholder='Disabled in demo';}\n   });\n   function submit(e){if(e)e.preventDefault();if(!form.reportValidity())return;result.hidden=false;result.textContent='Demo complete. Your entries passed the browser checks. Nothing was sent, charged, booked or stored.';}\n   form.addEventListener('submit',submit);\n   if(!form.querySelector('[type=\"submit\"],button:not([type])')){var buttons=form.querySelectorAll('button[type=\"button\"]');if(buttons.length===1)buttons[0].addEventListener('click',submit);}\n  });\n  document.querySelectorAll('.dl-visual img').forEach(function(img){img.addEventListener('error',function(){img.parentElement.classList.add('dl-photo-failed')});if(img.complete&&!img.naturalWidth)img.parentElement.classList.add('dl-photo-failed')});\n  document.querySelectorAll('.shoptop').forEach(function(top){\n   var grid=top.nextElementSibling;if(!grid||!grid.matches('.products'))return;\n   var cards=Array.from(grid.children),chips=Array.from(top.querySelectorAll('.chip')),sort=top.querySelector('select'),category='All';\n   var empty=document.createElement('p');empty.className='dl-filter-empty';empty.textContent='No sample items match this category. Choose All to see the collection.';empty.hidden=true;grid.after(empty);\n   function update(){var shown=0;cards.forEach(function(card){var tag=card.querySelector('small');card.hidden=category!=='All'&&(!tag||tag.textContent.trim()!==category);if(!card.hidden)shown++});empty.hidden=shown!==0;var count=top.querySelector('.sort span');if(count)count.textContent=shown+' sample items';}\n   chips.forEach(function(chip){chip.type='button';chip.setAttribute('aria-pressed',chip.classList.contains('on'));chip.addEventListener('click',function(){category=chip.textContent.trim();chips.forEach(function(c){c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',c===chip)});update()})});\n   if(sort){sort.setAttribute('aria-label','Sort sample items');Array.from(sort.options).forEach(function(o){if(/newest/i.test(o.textContent))o.textContent='Reverse featured'});sort.addEventListener('change',function(){var ordered=cards.slice();if(sort.selectedIndex===1||sort.selectedIndex===2){ordered.sort(function(a,b){function price(c){var p=c.querySelector('.price');return Number((p?p.textContent:'').replace(/[^0-9.]/g,''))||0}return price(a)-price(b)});if(sort.selectedIndex===2)ordered.reverse()}else if(sort.selectedIndex===3)ordered.reverse();ordered.forEach(function(card){grid.append(card)})})}\n  });\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.burger[open],.dl-mobile[open],.nav details[open]').forEach(function(menu){menu.open=false;var summary=menu.querySelector('summary');if(summary)summary.focus()})});\n  document.addEventListener('click',function(e){var a=e.target.closest('.dl-mobile a,.bmenu a');if(a){var menu=a.closest('details');if(menu)menu.open=false;}});\n  document.querySelectorAll('.more>a[href=\"#\"]').forEach(function(a){a.setAttribute('role','button');a.setAttribute('aria-expanded','false');function set(open){a.parentElement.classList.toggle('dl-menu-open',open);a.setAttribute('aria-expanded',open)}function toggle(e){e.preventDefault();set(a.getAttribute('aria-expanded')!=='true')}a.addEventListener('click',toggle);a.addEventListener('keydown',function(e){if(e.key===' ')toggle(e)});a.parentElement.addEventListener('mouseenter',function(){set(true)});a.parentElement.addEventListener('mouseleave',function(){if(!a.parentElement.contains(document.activeElement))set(false)})});\n  document.addEventListener('click',function(e){var a=e.target.closest('a[href=\"#\"]');if(!a||e.defaultPrevented||a.onclick||a.closest('.more'))return;e.preventDefault();var note=a.parentElement.querySelector(':scope>.dl-missing-link');if(!note){note=document.createElement('p');note.className='dl-feedback dl-missing-link';note.setAttribute('role','status');a.after(note)}note.textContent='Demonstration link. Add the real destination before launching this site.'});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.dl-menu-open').forEach(function(menu){menu.classList.remove('dl-menu-open');var a=menu.querySelector(':scope>a');if(a){a.setAttribute('aria-expanded','false');a.focus()}})});\n  document.querySelectorAll('.dl-skip').forEach(function(link){link.addEventListener('click',function(e){e.preventDefault();var target=document.querySelector('main.on [data-dl-content],main:not([data-page]) [data-dl-content]');if(target){target.focus();target.scrollIntoView({block:'start'})}})});\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>/* Sample commerce only: local item choices, quantities and consistent totals. */\n(function(){\n 'use strict';\n function start(){\n  var marker=document.querySelector('[data-dl-template]');if(!marker||marker.dataset.dlTemplate==='restaurant-warm')return;\n  var carts=Array.from(document.querySelectorAll('.cart')).filter(function(x){return x.querySelector('.crow')}),details=Array.from(document.querySelectorAll('.pdp,[data-dl-product]')).filter(function(x){return x.querySelector('.pinfo .price')}),checkouts=Array.from(document.querySelectorAll('aside.side-card')).filter(function(x){return x.querySelector('.kv')&&x.previousElementSibling&&x.previousElementSibling.querySelector('form')});\n  if(!carts.length&&!details.length&&!checkouts.length)return;\n  var currency='RM ',rows=[],key='dl-sample-cart:'+marker.dataset.dlTemplate;\n  function amount(text){return Number(String(text).replace(/[^0-9.]/g,''))||0}\n  function money(n){return currency+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function item(name,price,qty){return {name:String(name).slice(0,120),price:Math.max(0,Math.min(10000000,price)),qty:Math.max(1,Math.min(99,qty))}}\n  if(carts.length){rows=Array.from(carts[0].querySelectorAll('.crow')).map(function(row){var p=row.querySelector(':scope>b'),h=row.querySelector('h3'),q=row.querySelector('.qty span');if(p){currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' '}return item(h?h.textContent:'Sample item',amount(p?p.textContent:0),amount(q?q.textContent:1)||1)})}\n  else if(checkouts.length){rows=Array.from(checkouts[0].querySelectorAll('.kv li:not(.tot)')).filter(function(row){return row.querySelector('b')&&amount(row.querySelector('b').textContent)>0&&!/tax|shipping|delivery|subtotal|fee/i.test(row.textContent)}).map(function(row){var p=row.querySelector('b');currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' ';return item(row.querySelector('span').textContent,amount(p.textContent),1)})}\n  try{var saved=JSON.parse(localStorage.getItem(key));if(saved&&Array.isArray(saved.rows)&&saved.rows.length<=100){rows=saved.rows.filter(function(r){return typeof r.name==='string'&&Number.isFinite(r.price)&&r.price>=0&&Number.isInteger(r.qty)&&r.qty>0&&r.qty<=99}).map(function(r){return item(r.name,r.price,r.qty)});if(typeof saved.currency==='string'&&/^[A-Z$€£¥ ]{1,8}$/.test(saved.currency))currency=saved.currency;}}catch(e){}\n  function save(){try{localStorage.setItem(key,JSON.stringify({currency:currency,rows:rows}))}catch(e){}}\n  function totals(){var sub=rows.reduce(function(sum,r){return sum+r.price*r.qty},0);return {subtotal:sub,total:sub}}\n  function makeLine(label,value,total){var li=document.createElement('li');if(total)li.className='tot';var span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=value;li.append(span,b);return li}\n  function render(){\n   document.querySelectorAll('header a[href]').forEach(function(a){var match=a.textContent.trim().match(/^(Cart|Bag)\\s*\\(\\d+\\)$/i);if(match)a.textContent=match[1]+' ('+rows.reduce(function(sum,r){return sum+r.qty},0)+')'});\n   carts.forEach(function(cart){cart.querySelectorAll('.crow,.dl-cart-empty').forEach(function(r){r.remove()});rows.forEach(function(row,i){var el=document.createElement('div');el.className='crow';el.dataset.dlCartRow=i;var spacer=document.createElement('div'),info=document.createElement('div'),h=document.createElement('h3'),small=document.createElement('small');h.textContent=row.name;small.textContent=money(row.price)+' each · sample item';info.append(h,small);var qty=document.createElement('div');qty.className='qty';[-1,1].forEach(function(change){var b=document.createElement('button');b.type='button';b.dataset.dlCartChange=change;b.textContent=change<0?'−':'+';b.setAttribute('aria-label',(change<0?'Decrease ':'Increase ')+row.name);if(change>0){var value=document.createElement('span');value.textContent=row.qty;qty.append(value)}qty.append(b)});var price=document.createElement('b');price.textContent=money(row.price*row.qty);var remove=document.createElement('button');remove.type='button';remove.className='btn ghost';remove.dataset.dlCartRemove='';remove.textContent='Remove';remove.setAttribute('aria-label','Remove '+row.name);el.append(spacer,info,qty,price,remove);cart.insertBefore(el,cart.querySelector(':scope>a'))});if(!rows.length){var empty=document.createElement('p');empty.className='dl-cart-empty';empty.setAttribute('role','status');empty.textContent='Your sample cart is empty. Browse the collection to add an item.';cart.prepend(empty)}var aside=cart.parentElement.querySelector('aside.side-card');if(aside){var list=aside.querySelector('.kv');if(list){list.replaceChildren(makeLine('Subtotal',money(totals().subtotal)),makeLine('Demo delivery / fees','Not applied'),makeLine('Total',money(totals().total),true))}var note=aside.querySelector('p');if(note)note.textContent='Local sample cart. Real delivery, tax and payment must be configured before launch.'}});\n   checkouts.forEach(function(aside){var list=aside.querySelector('.kv');list.replaceChildren();rows.forEach(function(r){list.append(makeLine(r.qty+' × '+r.name,money(r.price*r.qty)))});list.append(makeLine('Total · demo only',money(totals().total),true));var form=aside.parentElement.querySelector('form'),button=form&&form.querySelector('[type=submit]');if(button){button.textContent=rows.length?'Preview checkout · '+money(totals().total):'Add an item before checkout';button.disabled=!rows.length}});\n  }\n  details.forEach(function(detail){detail.querySelectorAll('.qty button').forEach(function(b){b.type='button';b.setAttribute('aria-label',b.textContent.trim()==='+'?'Increase quantity':'Decrease quantity')});detail.querySelectorAll('.chips .chip').forEach(function(b){b.type='button';b.setAttribute('aria-pressed',b.classList.contains('on'));b.addEventListener('click',function(){b.parentElement.querySelectorAll('.chip').forEach(function(x){x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)})})})});\n  document.addEventListener('click',function(e){var row=e.target.closest('[data-dl-cart-row]');if(row){var index=Number(row.dataset.dlCartRow),change=e.target.closest('[data-dl-cart-change]');if(e.target.closest('[data-dl-cart-remove]'))rows.splice(index,1);else if(change&&rows[index])rows[index].qty=Math.max(1,Math.min(99,rows[index].qty+Number(change.dataset.dlCartChange)));save();render();return}\n   var detail=e.target.closest('.pdp,[data-dl-product]');if(!detail)return;var button=e.target.closest('.qty button');if(button&&!button.onclick){var span=button.parentElement.querySelector('span');if(span)span.textContent=Math.max(1,Math.min(99,amount(span.textContent)+(button.textContent.trim()==='+'?1:-1)))}\n   var link=e.target.closest('.buy a,[data-dl-add]');if(link&&!e.defaultPrevented&&link.getAttribute('aria-disabled')!=='true'&&/cart(?:\\.|$)|#\\/cart/.test(link.getAttribute('href')||'')){var h=detail.querySelector('.pinfo h1'),price=detail.querySelector('.pinfo .price'),q=detail.querySelector('.qty span');if(h&&price){var chosen=Array.from(detail.querySelectorAll('.pinfo .chip.on,.pinfo .ok-finish [aria-pressed=true]')).map(function(b){return b.getAttribute('aria-label')||b.textContent.trim()}),name=h.textContent+(chosen.length?' · '+chosen.join(' / '):''),quantity=amount(q?q.textContent:1)||1,found=rows.find(function(r){return r.name===name});if(found)found.qty=Math.min(99,found.qty+quantity);else rows.push(item(name,amount(price.textContent),quantity));save();render()}}\n  });\n  render();\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script>","foot":"<footer data-dl-footer class=\"ps-foot\"><div class=\"big\">plainspeak<i>.</i></div><div class=\"cols\"><div><h4>Learn</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:courses}}\">Courses</a></li><li><a href=\"{{p:course}}\">Course: Everyday Conversation</a></li><li><a href=\"{{p:lesson}}\">Lesson</a></li><li><a href=\"{{p:level}}\">Level check</a></li></ul></div><div><h4>School</h4><ul><li><a href=\"{{p:method}}\">Method</a></li><li><a href=\"{{p:tutors}}\">Tutors</a></li><li><a href=\"{{p:pricing}}\">Pricing</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div><div class=\"copy\">© 2026 Plainspeak English · Template demo content</div></footer>","pages":{"home":"<div tabindex=\"-1\" data-dl-content><section class=\"ps-sec\"><div class=\"ps-g\"><div style=\"grid-column:1/-1\"><div class=\"ps-lab\">Online English school · live tutors · since 2016</div></div><h1 class=\"ps-mega\" style=\"grid-column:1/-1;margin:26px 0 30px\">Say it<br>plainly<i>.</i></h1><p style=\"grid-column:1/span 5;font:400 20px/1.55 var(--f-body);margin-bottom:28px\">English that works in a meeting, a shop and a phone call. Short lessons, one tutor who knows your name, and feedback you can hear.</p><p style=\"grid-column:1/-1;display:flex;gap:12px;flex-wrap:wrap\"><a class=\"ps-btn\" href=\"{{p:level}}\">Check my level →</a><a class=\"ps-btn o\" href=\"{{p:courses}}\">Browse courses</a></p></div>\n<div class=\"ps-facts\"><div><b>12k</b><span>learners in 54 countries</span></div><div><b>1:1</b><span>tutor feedback on every task</span></div><div><b>15′</b><span>average lesson length</span></div><div><b>4.8</b><span>average course rating</span></div></div></section>\n<section class=\"ps-sec\" style=\"padding-top:0\"><div class=\"ps-lab\" style=\"margin-bottom:14px\">Courses</div><div class=\"ps-tbl\"><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">01</span><div><h3>Everyday Conversation</h3><small>Speak up at work, shops and cafés.</small></div><span class=\"lv\">A2–B1</span><span class=\"tm\">8 wks</span><span class=\"pr\">RM 390</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">02</span><div><h3>Business Email & Meetings</h3><small>Write clearly. Run a call. Say no politely.</small></div><span class=\"lv\">B1–B2</span><span class=\"tm\">6 wks</span><span class=\"pr\">RM 450</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">03</span><div><h3>Pronunciation Lab</h3><small>Sounds, stress and rhythm, recorded and reviewed.</small></div><span class=\"lv\">A2–C1</span><span class=\"tm\">4 wks</span><span class=\"pr\">RM 290</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">04</span><div><h3>IELTS Speaking Sprint</h3><small>Four tutors, twelve mock interviews, one band target.</small></div><span class=\"lv\">B2–C1</span><span class=\"tm\">5 wks</span><span class=\"pr\">RM 520</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">05</span><div><h3>Listening Without Subtitles</h3><small>Podcasts, films, fast speech. Train your ear.</small></div><span class=\"lv\">B1–C1</span><span class=\"tm\">6 wks</span><span class=\"pr\">RM 340</span><span class=\"ar\">→</span></a></div><p style=\"margin-top:28px\"><a class=\"ps-btn o\" href=\"{{p:courses}}\">All courses →</a></p></section>\n<section class=\"ps-sec\" style=\"padding-top:0\"><div class=\"ps-two\"><div class=\"a\"><div class=\"ps-lab\">Method</div><h2 style=\"font:800 clamp(30px,4vw,52px)/1.05 var(--f-head);letter-spacing:-.03em;margin-top:14px\">Speak first. Study the grammar after.</h2></div><div class=\"b\"><p style=\"font:400 19px/1.65 var(--f-body)\">Every lesson starts with something you have to say. We record it, fix it, and ask you to say it again. The grammar becomes a tool, not a subject.</p><p style=\"margin-top:22px\"><a class=\"ps-btn o\" href=\"{{p:method}}\">Read the method →</a></p></div></div></section></div>","courses":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Courses</b></div><h1 style=\"font-family:var(--f-head);letter-spacing:-.03em;font-weight:800\">Courses</h1><p class=\"lead\">Five courses, three levels. Every course has a free first lesson.</p></div></section><section class=\"ps-sec\" style=\"padding-top:0\"><div class=\"ps-tbl\"><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">01</span><div><h3>Everyday Conversation</h3><small>Speak up at work, shops and cafés.</small></div><span class=\"lv\">A2–B1</span><span class=\"tm\">8 wks</span><span class=\"pr\">RM 390</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">02</span><div><h3>Business Email & Meetings</h3><small>Write clearly. Run a call. Say no politely.</small></div><span class=\"lv\">B1–B2</span><span class=\"tm\">6 wks</span><span class=\"pr\">RM 450</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">03</span><div><h3>Pronunciation Lab</h3><small>Sounds, stress and rhythm, recorded and reviewed.</small></div><span class=\"lv\">A2–C1</span><span class=\"tm\">4 wks</span><span class=\"pr\">RM 290</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">04</span><div><h3>IELTS Speaking Sprint</h3><small>Four tutors, twelve mock interviews, one band target.</small></div><span class=\"lv\">B2–C1</span><span class=\"tm\">5 wks</span><span class=\"pr\">RM 520</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">05</span><div><h3>Listening Without Subtitles</h3><small>Podcasts, films, fast speech. Train your ear.</small></div><span class=\"lv\">B1–C1</span><span class=\"tm\">6 wks</span><span class=\"pr\">RM 340</span><span class=\"ar\">→</span></a></div></section></div>","course":"<div tabindex=\"-1\" data-dl-content><section class=\"ps-sec\"><div class=\"ps-two\"><div class=\"a\"><div class=\"ps-lab\">Course 01 · A2–B1 · 8 weeks</div><h1 class=\"ps-mega\" style=\"font-size:clamp(44px,7vw,100px);margin:18px 0 22px\">Everyday<br>Conversation<i>.</i></h1><p style=\"font:400 19px/1.6 var(--f-body);margin-bottom:26px\">Speak up at work, in shops and cafés. Three live sessions a week and daily voice tasks.</p><p style=\"display:flex;gap:12px;flex-wrap:wrap\"><a class=\"ps-btn\" href=\"{{p:pricing}}\">Enrol · RM 390</a><a class=\"ps-btn o\" href=\"{{p:lesson}}\">Free first lesson</a></p></div>\n<div class=\"b\"><div class=\"ps-lab\" style=\"margin-bottom:6px\">Syllabus</div><div class=\"faq\" style=\"max-width:none\"><details open><summary>Weeks 1–2 · Introductions &amp; small talk</summary><p>Greetings, describing your day, asking follow-up questions.</p></details><details><summary>Weeks 3–4 · Shops, cafés and transport</summary><p>Ordering, asking prices, solving problems politely.</p></details><details><summary>Weeks 5–6 · At work</summary><p>Stand-ups, asking for help, short updates.</p></details><details><summary>Weeks 7–8 · Phone calls &amp; plans</summary><p>Booking, rescheduling, making and changing plans.</p></details></div></div></div></section></div>","lesson":"<div tabindex=\"-1\" data-dl-content><section class=\"ps-sec\"><div class=\"ps-two\"><div class=\"a\" style=\"grid-column:1/span 7\"><div class=\"ps-lab\">Week 3 · Lesson 2 of 5</div><h1 style=\"font:800 clamp(30px,4.4vw,56px)/1.05 var(--f-head);letter-spacing:-.03em;margin:14px 0 22px\">Ordering at a café</h1><div class=\"ps-ph\" style=\"min-height:360px\" data-l=\"Lesson video (缺图)\"></div><p style=\"margin-top:16px;font:600 13px var(--f-body);color:var(--c-secondary)\">00:00 ──────────────── 06:12</p></div>\n<div class=\"b\" style=\"grid-column:9/span 4\"><div class=\"ps-lab\">Key phrases</div><ol style=\"margin-top:12px;padding-left:20px;font:500 17px/2 var(--f-body)\"><li>Could I get a flat white, please?</li><li>Is that for here or to go?</li><li>Do you have anything without dairy?</li><li>Can I pay by card?</li></ol><p style=\"margin-top:20px\"><a class=\"ps-btn\" href=\"#\">Record my answer</a></p></div></div></section></div>","level":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Level check</b></div><h1 style=\"font-family:var(--f-head);letter-spacing:-.03em;font-weight:800\">Check your level</h1><p class=\"lead\">Eight questions, three minutes. We'll suggest where to start.</p></div></section><section class=\"ps-sec\" style=\"padding-top:0\"><div style=\"max-width:780px\" id=\"ps-quiz\"></div></section><script>(function(){var Q=[{\"q\": \"She ___ coffee every morning.\", \"o\": [\"drink\", \"drinks\", \"drinking\", \"is drink\"], \"a\": 1}, {\"q\": \"We ___ to the cinema last night.\", \"o\": [\"go\", \"goes\", \"went\", \"gone\"], \"a\": 2}, {\"q\": \"I've lived here ___ 2019.\", \"o\": [\"for\", \"since\", \"from\", \"during\"], \"a\": 1}, {\"q\": \"If it rains, we ___ at home.\", \"o\": [\"stay\", \"stayed\", \"will stay\", \"would stay\"], \"a\": 2}, {\"q\": \"He asked me ___ I was ready.\", \"o\": [\"that\", \"if\", \"what\", \"which\"], \"a\": 1}, {\"q\": \"The report ___ by Friday, so please hurry.\", \"o\": [\"must finish\", \"must be finished\", \"must be finishing\", \"must have finish\"], \"a\": 1}, {\"q\": \"Hardly ___ the door when the phone rang.\", \"o\": [\"I had closed\", \"had I closed\", \"I closed\", \"did I closed\"], \"a\": 1}, {\"q\": \"Had she known, she ___ differently.\", \"o\": [\"would act\", \"will have acted\", \"would have acted\", \"had acted\"], \"a\": 2}],L=[\"A1\",\"A2\",\"B1\",\"B2\",\"C1\"],R=[\"Start with Everyday Conversation, 8 weeks.\",\"Everyday Conversation is the right start.\",\"Try Business Email & Meetings or Everyday Conversation.\",\"Business Email & Meetings fits you.\",\"IELTS Speaking Sprint or Listening Without Subtitles.\"],root=document.getElementById(\"ps-quiz\");if(!root)return;var i=0,s=0;function bar(){var h=\"\";for(var k=0;k<Q.length;k++)h+=\"<i class=\\\"\"+(k<i?\"d\":k===i?\"c\":\"\")+\"\\\"></i>\";return\"<div class=ps-prog>\"+h+\"</div>\"}function show(){if(i>=Q.length){var lv=s<=1?0:s<=3?1:s<=5?2:s<=6?3:4;root.innerHTML=bar()+\"<div class=ps-lab>Your level</div><div class=ps-res>\"+L[lv]+\"</div><p style=\\\"font:500 18px/1.6 var(--f-body);margin:12px 0 24px;max-width:46ch\\\">\"+s+\" of \"+Q.length+\" correct. \"+R[lv]+\"</p><a class=ps-btn href=\\\"#\\\" id=ps-again>Try again</a>\";document.getElementById(\"ps-again\").onclick=function(e){e.preventDefault();i=0;s=0;show()};return}var q=Q[i];root.innerHTML=bar()+\"<div class=ps-q><div class=ps-lab>Question \"+(i+1)+\" / \"+Q.length+\"</div><h2>\"+q.q+\"</h2><div class=o>\"+q.o.map(function(o,k){return\"<button type=button class=opt data-k=\\\"\"+k+\"\\\"><b>\"+\"ABCD\"[k]+\"</b>\"+o+\"</button>\"}).join(\"\")+\"</div></div>\";root.querySelectorAll(\".opt\").forEach(function(b){b.onclick=function(){if(+b.dataset.k===q.a)s++;i++;show()}})}show()})();</script></div>","method":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Method</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.03em\">Method</h1></div></section><section class=\"ps-sec\" style=\"padding-top:0\"><div class=\"ps-plans\"><div><div class=\"ps-lab\">01</div><h3 style=\"font:800 24px var(--f-head);letter-spacing:-.02em\">Say</h3><p>Start with a real task. Speak before you study.</p></div><div><div class=\"ps-lab\">02</div><h3 style=\"font:800 24px var(--f-head);letter-spacing:-.02em\">Fix</h3><p>Your tutor marks three things, no more. Hear the correction.</p></div><div><div class=\"ps-lab\">03</div><h3 style=\"font:800 24