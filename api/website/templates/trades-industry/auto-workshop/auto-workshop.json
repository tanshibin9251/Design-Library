n}\n.tq-hero::after{content:\"\";position:absolute;right:-6%;top:0;bottom:0;width:36%;background:repeating-linear-gradient(115deg,var(--c-accent) 0 26px,transparent 26px 52px);opacity:.14}\n.tq-hero .in{position:relative;z-index:2;max-width:var(--w);margin:auto;padding:clamp(34px,6vw,84px) 20px;display:grid;grid-template-columns:1.3fr 1fr;gap:34px;align-items:center}\n.tq-hero h1{font-size:clamp(42px,7vw,var(--h1));line-height:.98;text-transform:uppercase;color:var(--on-primary);letter-spacing:-.01em}\n.tq-hero h1 span{color:var(--c-accent)}\n.tq-hero p{font:500 18px/1.6 var(--f-body);max-width:42ch;margin:16px 0 26px;opacity:.9}\n.tq-plate{background:var(--c-surface);color:var(--c-text);border-radius:14px;padding:22px;box-shadow:0 0 0 4px var(--c-accent)}\n.tq-plate h3{font:700 16px var(--f-body);text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}\n.tq-plate .pl{display:flex;border:3px solid var(--c-text);border-radius:8px;overflow:hidden;background:var(--c-accent)}\n.tq-plate .pl span{background:var(--c-primary);color:var(--on-primary);font:700 12px var(--f-body);padding:0 10px;display:grid;place-items:center;writing-mode:vertical-rl;letter-spacing:.2em}\n.tq-plate input{flex:1;border:0;background:transparent;font:700 clamp(24px,4vw,34px) var(--f-head);letter-spacing:.2em;text-transform:uppercase;padding:10px 12px;color:var(--c-text);min-width:0}\n.tq-plate p{color:var(--c-text);opacity:.7;font-size:13px;margin:10px 0 0}\n.tq-sec{padding:var(--pad) 20px}.tq-sec>.in{max-width:var(--w);margin:auto}\n.tq-svc{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:2px solid var(--c-text)}\n.tq-svc>div{padding:24px;border-right:2px solid var(--c-text);border-bottom:2px solid var(--c-text);background:var(--c-surface)}\n.tq-svc>div:nth-child(3n){border-right:0}.tq-svc>div:nth-last-child(-n+3){border-bottom:0}\n.tq-svc b{font:700 13px var(--f-body);color:var(--c-primary);letter-spacing:.1em}.tq-svc h3{font:700 22px var(--f-head);text-transform:uppercas