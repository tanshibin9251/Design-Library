on{min-height:44px}.qty button{min-width:44px}[data-dl-footer] .cols{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}[data-dl-footer] .cols>div:first-child{grid-column:1/-1}.pdp,.split{min-width:0}.pdp>*{min-width:0}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n</style><a class=\"dl-skip\" href=\"#dl-content\">Skip to content</a><style>\n/* Atelier Wall — online art school as a gallery, tokens only */\n.aw-head{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 clamp(16px,3vw,44px);min-height:72px;background:var(--c-surface);border-bottom:1px solid var(--c-border);position:sticky;top:0;z-index:50}\n.aw-l,.aw-r{display:flex;gap:clamp(14px,2.2vw,32px);list-style:none;align-items:center}\n.aw-r{justify-content:flex-end}\n.aw-l a,.aw-r a{display:inline-flex;align-items:center;min-height:44px;text-decoration:none;font:500 13px var(--f-body);letter-spacing:.04em;color:var(--c-text)}\n.aw-l a:hover,.aw-r a:hover{color:var(--c-accent)}\n.aw-logo{font:800 22px var(--f-head);letter-spacing:-.03em;color:var(--c-primary);text-decoration:none;text-align:center}\n.aw-logo i{font-style:normal;display:inline-block;width:.55em;height:.55em;background:var(--c-accent);margin-left:2px;vertical-align:baseline}\n.aw-r .b{border:1.5px solid var(--c-primary);padding:0 16px}\n.aw-more{position:relative}\n.aw-more .dd{position:absolute;right:0;top:100%;display:none;grid-template-columns:repeat(4,minmax(130px,1fr));gap:16px 26px;padding:22px 26px;background:var(--c-surface);border:1px solid var(--c-primary);min-width:600px;z-index:60}\n.aw-more:hover .dd,.aw-more:focus-within .dd{display:grid}\n.aw-more .dd h4{font:700 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-accent);margin-bottom:6px}\n.aw-more .dd a{padding:5px 0;min-height:0;display:block}\n.aw-m{display:none}\n.aw-m summary{list-style:none;cursor:pointer;min-height:44px;min-width:44px;display:grid;place-items:center;font:700 12px var(--f-body);letter-spacing:.14em;border:1.5px solid var(--c-primary);padding:0 14px}\n.aw-m summary::-webkit-details-marker{display:none}\n.aw-m nav{position:absolute;left:0;right:0;top:100%;background:var(--c-surface);border-bottom:1px solid var(--c-primary);padding:6px 18px 16px;display:grid}\n.aw-m nav a{padding:12px 0;border-bottom:1px solid var(--c-border);text-decoration:none;font:500 15px var(--f-body);min-height:44px}\n@media(max-width:900px){.aw-head{grid-template-columns:auto 1fr}.aw-l,.aw-r{display:none}.aw-m{display:block;justify-self:end}.aw-logo{text-align:left}}\n\n.aw-sec{padding:clamp(48px,7vw,110px) clamp(16px,3vw,44px)}\n.aw-hero{padding:clamp(40px,6vw,90px) clamp(16px,3vw,44px) 0}\n.aw-hero h1{font:800 clamp(44px,9vw,var(--h1))/.94 var(--f-head);letter-spacing:-.045em;color:var(--c-primary);max-width:14ch}\n.aw-hero h1 em{font-style:normal;color:var(--c-accent)}\n.aw-lab{font:600 11px var(--f-body);letter-spacing:.18em;text-transform:uppercase;color:var(--c-secondary)}\n.aw-btn{display:inline-flex;align-items:center;gap:10px;min-height:50px;padding:0 24px;background:var(--c-primary);color:var(--on-primary);text-decoration:none;font:600 14px var(--f-body);border:1.5px solid var(--c-primary);cursor:pointer}\n.aw-btn:hover{background:var(--c-accent);border-color:var(--c-accent);color:var(--on-accent)}\n.aw-btn.o{background:transparent;color:var(--c-primary)}.aw-btn.o:hover{background:var(--c-primary);color:var(--on-primary);border-color:var(--c-primary)}\n\n/* hung works */\n.aw-wall{display:grid;grid-template-columns:repeat(12,1fr);gap:clamp(24px,3vw,48px) clamp(16px,2vw,32px);align-items:end}\n.aw-work{margin:0;grid-column:span 4}\n.aw-work.w{grid-column:span 6}.aw-work.s{grid-column:span 3}.aw-work.xl{grid-column:span 8}\n.aw-work.hide{display:none}\n.aw-pic{position:relative;background:var(--bg,color-mix(in srgb,var(--c-primary) 10%,var(--c-surface)));aspect-ratio:var(--r,4/5);box-shadow:0 20px 30px -22px color-mix(in srgb,var(--c-primary) 55%,transparent);overflow:hidden}\n.aw-pic::before{content:\"\";position:absolute;inset:0;background:radial-gradient(circle at var(--x,30%) var(--y,35%),var(--c1,var(--c-accent)) 0 18%,transparent 19%),radial-gradient(circle at calc(100% - var(--x,30%)) calc(100% - var(--y,35%)),var(--c2,var(--c-primary)) 0 26%,transparent 27%)}\n.aw-pic::after{content:attr(data-l);position:absolute;left:10px;bottom:8px;font:600 10px var(--f-body);letter-spacing:.14em;text-transform:uppercase;background:var(--c-surface);padding:2px 7px}\n.aw-cap{margin-top:12px;display:grid;gap:2px;font:400 13px/1.5 var(--f-body)}\n.aw-cap b{font:700 15px var(--f-body);color:var(--c-primary)}\n.aw-cap span{color:var(--c-secondary)}\n@media(max-width:900px){.aw-work,.aw-work.w,.aw-work.xl,.aw-work.s{grid-column:span 6}}\n@media(max-width:560px){.aw-work,.aw-work.w,.aw-work.xl,.aw-work.s{grid-column:1/-1}}\n.aw-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:30px}\n.aw-chips button{min-height:44px;padding:0 18px;border:1.5px solid var(--c-primary);background:transparent;color:var(--c-primary);font:600 13px var(--f-body);cursor:pointer}\n.aw-chips button[aria-pressed=true]{background:var(--c-primary);color:var(--on-primary)}\n\n/* studios */\n.aw-st{display:grid;grid-template-columns:90px minmax(0,1fr) minmax(0,1fr);gap:clamp(16px,3vw,48px);padding:clamp(24px,3vw,44px) 0;border-top:1.5px solid var(--c-primary);align-items:center;text-decoration:none}\n.aw-st:last-child{border-bottom:1.5px solid var(--c-primary)}\n.aw-st .n{font:800 clamp(40px,5vw,72px)/1 var(--f-head);letter-spacing:-.05em;color:var(--c-accent)}\n.aw-st h3{font:800 clamp(24px,3vw,40px)/1.05 var(--f-head);letter-spacing:-.03em;color:var(--c-primary)}\n.aw-st p{font:400 16px/1.7 var(--f-body);margin-top:8px;max-width:42ch}\n.aw-st .meta{font:600 12px var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:var(--c-secondary);margin-top:12px;display:flex;gap:18px;flex-wrap:wrap}\n.aw-st .aw-pic{aspect-ratio:16/10}\n.aw-st:hover h3{color:var(--c-accent)}\n@media(max-width:800px){.aw-st{grid-template-columns:50px 1fr}.aw-st .aw-pic{grid-column:1/-1}}\n\n/* before/after */\n.aw-ba{position:relative;max-width:760px;aspect-ratio:4/3;overflow:hidden;border:1.5px solid var(--c-primary);--p:50%;touch-action:pan-y}\n.aw-ba>div{position:absolute;inset:0}\n.aw-ba .a{background:repeating-linear-gradient(45deg,transparent 0 14px,color-mix(in srgb,var(--c-primary) 14%,transparent) 14px 15px),color-mix(in srgb,var(--c-secondary) 25%,var(--c-surface))}\n.aw-ba .b{background:radial-gradient(circle at 30% 40%,var(--c-accent) 0 20%,transparent 21%),radial-gradient(circle at 72% 62%,var(--c-primary) 0 28%,transparent 29%),var(--c-surface);clip-path:inset(0 0 0 var(--p))}\n.aw-ba span{position:absolute;top:12px;font:700 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;background:var(--c-surface);padding:4px 10px}\n.aw-ba .a span{left:12px}.aw-ba .b span{right:12px}\n.aw-ba i{position:absolute;top:0;bottom:0;left:var(--p);width:3px;background:var(--c-primary);margin-left:-1px;pointer-events:none}\n.aw-ba i::after{content:\"↔\";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:44px;height:44px;border-radius:50%;background:var(--c-primary);color:var(--on-primary);display:grid;place-items:center;font:700 18px var(--f-body)}\n.aw-ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0;padding:0}\n.aw-split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,80px);align-items:start}\n@media(max-width:860px){.aw-split{grid-template-columns:1fr}}\n.aw-3{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,2vw,32px)}\n@media(max-width:860px){.aw-3{grid-template-columns:1fr}}\n.aw-card{border-top:1.5px solid var(--c-primary);padding-top:16px;display:grid;gap:8px;align-content:start}\n.aw-card h3{font:800 26px var(--f-head);letter-spacing:-.03em}\n.aw-card .p{font:800 44px var(--f-head);letter-spacing:-.04em;color:var(--c-primary)}\n.aw-card li{list-style:none;padding:8px 0;border-top:1px solid var(--c-border);font:400 15px var(--f-body)}\n.aw-foot{padding:clamp(40px,5vw,70px) clamp(16px,3vw,44px) 20px;border-top:1.5px solid var(--c-primary);margin-top:clamp(40px,6vw,100px)}\n.aw-foot .big{font:800 clamp(56px,13vw,200px)/.85 var(--f-head);letter-spacing:-.06em;color:var(--c-primary)}\n.aw-foot .big i{font-style:normal;color:var(--c-accent)}\n.aw-foot .cols{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:34px}\n.aw-foot h4{font:700 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-accent);margin-bottom:8px}\n.aw-foot ul{list-style:none}.aw-foot li a{display:inline-block;padding:6px 0;text-decoration:none;font:500 14px var(--f-body);min-height:32px}\n.aw-foot .copy{margin-top:26px;font:400 12px var(--f-body);color:var(--c-secondary)}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}\n</style><header class=\"aw-head\"><ul class=\"aw-l\"><li><a href=\"{{p:studios}}\">Studios</a></li><li><a href=\"{{p:wall}}\">Student wall</a></li><li><a href=\"{{p:progress}}\">Before &amp; after</a></li></ul><a class=\"aw-logo\" href=\"{{p:home}}\">atelier wall<i></i></a><ul class=\"aw-r\"><li><a href=\"{{p:faculty}}\">Faculty</a></li><li class=\"aw-more\"><a href=\"#\" tabindex=\"0\">More</a><div class=\"dd\"><div><h4>School</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:studios}}\">Studios</a><a href=\"{{p:studio}}\">Studio: Drawing Foundations</a><a href=\"{{p:wall}}\">Student wall</a><a href=\"{{p:progress}}\">Before & after</a><a href=\"{{p:faculty}}\">Faculty</a></div><div><h4>Join</h4><a href=\"{{p:tuition}}\">Tuition</a><a href=\"{{p:faq}}\">FAQ</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li><li><a class=\"b\" href=\"{{p:tuition}}\">Enrol</a></li></ul><details class=\"aw-m\"><summary>MENU</summary><nav><a href=\"{{p:home}}\">Home</a><a href=\"{{p:studios}}\">Studios</a><a href=\"{{p:studio}}\">Studio: Drawing Foundations</a><a href=\"{{p:wall}}\">Student wall</a><a href=\"{{p:progress}}\">Before & after</a><a href=\"{{p:faculty}}\">Faculty</a><a href=\"{{p:tuition}}\">Tuition</a><a href=\"{{p:faq}}\">FAQ</a><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></nav></details></header><script>/* Runs in previews AND exported files. No requests, credentials or submissions. */\n(function(){\n 'use strict';\n function start(){\n  var root=document.querySelector('[data-dl-template]');if(!root)return;\n  document.querySelectorAll('[data-dl-demo-form]').forEach(function(form,index){\n   if(form.dataset.dlBound)return;form.dataset.dlBound='1';\n   var note=document.createElement('p');note.className='dl-form-note';note.textContent='Interactive demo · Nothing is sent. Use sample details only. No account, booking or payment will be created.';form.prepend(note);\n   var result=document.createElement('p');result.className='dl-feedback';result.setAttribute('role','status');result.setAttribute('aria-live','polite');result.hidden=true;form.append(result);\n   form.querySelectorAll('input,textarea,select').forEach(function(input,i){\n    if(!input.name)input.name='demo-'+index+'-'+i;\n    var label=input.closest('label'),text=(label?label.textContent:input.placeholder||'').toLowerCase();\n    if(/name|email|message|date|time/.test(text)&&!/optional/.test(text))input.required=true;\n    if(input.type==='password')input.autocomplete='new-password';\n    if(/card number|cvc|expiry/.test(text)){input.disabled=true;input.placeholder='Disabled in demo';}\n   });\n   function submit(e){if(e)e.preventDefault();if(!form.reportValidity())return;result.hidden=false;result.textContent='Demo complete. Your entries passed the browser checks. Nothing was sent, charged, booked or stored.';}\n   form.addEventListener('submit',submit);\n   if(!form.querySelector('[type=\"submit\"],button:not([type])')){var buttons=form.querySelectorAll('button[type=\"button\"]');if(buttons.length===1)buttons[0].addEventListener('click',submit);}\n  });\n  document.querySelectorAll('.dl-visual img').forEach(function(img){img.addEventListener('error',function(){img.parentElement.classList.add('dl-photo-failed')});if(img.complete&&!img.naturalWidth)img.parentElement.classList.add('dl-photo-failed')});\n  document.querySelectorAll('.shoptop').forEach(function(top){\n   var grid=top.nextElementSibling;if(!grid||!grid.matches('.products'))return;\n   var cards=Array.from(grid.children),chips=Array.from(top.querySelectorAll('.chip')),sort=top.querySelector('select'),category='All';\n   var empty=document.createElement('p');empty.className='dl-filter-empty';empty.textContent='No sample items match this category. Choose All to see the collection.';empty.hidden=true;grid.after(empty);\n   function update(){var shown=0;cards.forEach(function(card){var tag=card.querySelector('small');card.hidden=category!=='All'&&(!tag||tag.textContent.trim()!==category);if(!card.hidden)shown++});empty.hidden=shown!==0;var count=top.querySelector('.sort span');if(count)count.textContent=shown+' sample items';}\n   chips.forEach(function(chip){chip.type='button';chip.setAttribute('aria-pressed',chip.classList.contains('on'));chip.addEventListener('click',function(){category=chip.textContent.trim();chips.forEach(function(c){c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',c===chip)});update()})});\n   if(sort){sort.setAttribute('aria-label','Sort sample items');Array.from(sort.options).forEach(function(o){if(/newest/i.test(o.textContent))o.textContent='Reverse featured'});sort.addEventListener('change',function(){var ordered=cards.slice();if(sort.selectedIndex===1||sort.selectedIndex===2){ordered.sort(function(a,b){function price(c){var p=c.querySelector('.price');return Number((p?p.textContent:'').replace(/[^0-9.]/g,''))||0}return price(a)-price(b)});if(sort.selectedIndex===2)ordered.reverse()}else if(sort.selectedIndex===3)ordered.reverse();ordered.forEach(function(card){grid.append(card)})})}\n  });\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.burger[open],.dl-mobile[open],.nav details[open]').forEach(function(menu){menu.open=false;var summary=menu.querySelector('summary');if(summary)summary.focus()})});\n  document.addEventListener('click',function(e){var a=e.target.closest('.dl-mobile a,.bmenu a');if(a){var menu=a.closest('details');if(menu)menu.open=false;}});\n  document.querySelectorAll('.more>a[href=\"#\"]').forEach(function(a){a.setAttribute('role','button');a.setAttribute('aria-expanded','false');function set(open){a.parentElement.classList.toggle('dl-menu-open',open);a.setAttribute('aria-expanded',open)}function toggle(e){e.preventDefault();set(a.getAttribute('aria-expanded')!=='true')}a.addEventListener('click',toggle);a.addEventListener('keydown',function(e){if(e.key===' ')toggle(e)});a.parentElement.addEventListener('mouseenter',function(){set(true)});a.parentElement.addEventListener('mouseleave',function(){if(!a.parentElement.contains(document.activeElement))set(false)})});\n  document.addEventListener('click',function(e){var a=e.target.closest('a[href=\"#\"]');if(!a||e.defaultPrevented||a.onclick||a.closest('.more'))return;e.preventDefault();var note=a.parentElement.querySelector(':scope>.dl-missing-link');if(!note){note=document.createElement('p');note.className='dl-feedback dl-missing-link';note.setAttribute('role','status');a.after(note)}note.textContent='Demonstration link. Add the real destination before launching this site.'});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.dl-menu-open').forEach(function(menu){menu.classList.remove('dl-menu-open');var a=menu.querySelector(':scope>a');if(a){a.setAttribute('aria-expanded','false');a.focus()}})});\n  document.querySelectorAll('.dl-skip').forEach(function(link){link.addEventListener('click',function(e){e.preventDefault();var target=document.querySelector('main.on [data-dl-content],main:not([data-page]) [data-dl-content]');if(target){target.focus();target.scrollIntoView({block:'start'})}})});\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>/* Sample commerce only: local item choices, quantities and consistent totals. */\n(function(){\n 'use strict';\n function start(){\n  var marker=document.querySelector('[data-dl-template]');if(!marker||marker.dataset.dlTemplate==='restaurant-warm')return;\n  var carts=Array.from(document.querySelectorAll('.cart')).filter(function(x){return x.querySelector('.crow')}),details=Array.from(document.querySelectorAll('.pdp,[data-dl-product]')).filter(function(x){return x.querySelector('.pinfo .price')}),checkouts=Array.from(document.querySelectorAll('aside.side-card')).filter(function(x){return x.querySelector('.kv')&&x.previousElementSibling&&x.previousElementSibling.querySelector('form')});\n  if(!carts.length&&!details.length&&!checkouts.length)return;\n  var currency='RM ',rows=[],key='dl-sample-cart:'+marker.dataset.dlTemplate;\n  function amount(text){return Number(String(text).replace(/[^0-9.]/g,''))||0}\n  function money(n){return currency+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function item(name,price,qty){return {name:String(name).slice(0,120),price:Math.max(0,Math.min(10000000,price)),qty:Math.max(1,Math.min(99,qty))}}\n  if(carts.length){rows=Array.from(carts[0].querySelectorAll('.crow')).map(function(row){var p=row.querySelector(':scope>b'),h=row.querySelector('h3'),q=row.querySelector('.qty span');if(p){currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' '}return item(h?h.textContent:'Sample item',amount(p?p.textContent:0),amount(q?q.textContent:1)||1)})}\n  else if(checkouts.length){rows=Array.from(checkouts[0].querySelectorAll('.kv li:not(.tot)')).filter(function(row){return row.querySelector('b')&&amount(row.querySelector('b').textContent)>0&&!/tax|shipping|delivery|subtotal|fee/i.test(row.textContent)}).map(function(row){var p=row.querySelector('b');currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' ';return item(row.querySelector('span').textContent,amount(p.textContent),1)})}\n  try{var saved=JSON.parse(localStorage.getItem(key));if(saved&&Array.isArray(saved.rows)&&saved.rows.length<=100){rows=saved.rows.filter(function(r){return typeof r.name==='string'&&Number.isFinite(r.price)&&r.price>=0&&Number.isInteger(r.qty)&&r.qty>0&&r.qty<=99}).map(function(r){return item(r.name,r.price,r.qty)});if(typeof saved.currency==='string'&&/^[A-Z$€£¥ ]{1,8}$/.test(saved.currency))currency=saved.currency;}}catch(e){}\n  function save(){try{localStorage.setItem(key,JSON.stringify({currency:currency,rows:rows}))}catch(e){}}\n  function totals(){var sub=rows.reduce(function(sum,r){return sum+r.price*r.qty},0);return {subtotal:sub,total:sub}}\n  function makeLine(label,value,total){var li=document.createElement('li');if(total)li.className='tot';var span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=value;li.append(span,b);return li}\n  function render(){\n   document.querySelectorAll('header a[href]').forEach(function(a){var match=a.textContent.trim().match(/^(Cart|Bag)\\s*\\(\\d+\\)$/i);if(match)a.textContent=match[1]+' ('+rows.reduce(function(sum,r){return sum+r.qty},0)+')'});\n   carts.forEach(function(cart){cart.querySelectorAll('.crow,.dl-cart-empty').forEach(function(r){r.remove()});rows.forEach(function(row,i){var el=document.createElement('div');el.className='crow';el.dataset.dlCartRow=i;var spacer=document.createElement('div'),info=document.createElement('div'),h=document.createElement('h3'),small=document.createElement('small');h.textContent=row.name;small.textContent=money(row.price)+' each · sample item';info.append(h,small);var qty=document.createElement('div');qty.className='qty';[-1,1].forEach(function(change){var b=document.createElement('button');b.type='button';b.dataset.dlCartChange=change;b.textContent=change<0?'−':'+';b.setAttribute('aria-label',(change<0?'Decrease ':'Increase ')+row.name);if(change>0){var value=document.createElement('span');value.textContent=row.qty;qty.append(value)}qty.append(b)});var price=document.createElement('b');price.textContent=money(row.price*row.qty);var remove=document.createElement('button');remove.type='button';remove.className='btn ghost';remove.dataset.dlCartRemove='';remove.textContent='Remove';remove.setAttribute('aria-label','Remove '+row.name);el.append(spacer,info,qty,price,remove);cart.insertBefore(el,cart.querySelector(':scope>a'))});if(!rows.length){var empty=document.createElement('p');empty.className='dl-cart-empty';empty.setAttribute('role','status');empty.textContent='Your sample cart is empty. Browse the collection to add an item.';cart.prepend(empty)}var aside=cart.parentElement.querySelector('aside.side-card');if(aside){var list=aside.querySelector('.kv');if(list){list.replaceChildren(makeLine('Subtotal',money(totals().subtotal)),makeLine('Demo delivery / fees','Not applied'),makeLine('Total',money(totals().total),true))}var note=aside.querySelector('p');if(note)note.textContent='Local sample cart. Real delivery, tax and payment must be configured before launch.'}});\n   checkouts.forEach(function(aside){var list=aside.querySelector('.kv');list.replaceChildren();rows.forEach(function(r){list.append(makeLine(r.qty+' × '+r.name,money(r.price*r.qty)))});list.append(makeLine('Total · demo only',money(totals().total),true));var form=aside.parentElement.querySelector('form'),button=form&&form.querySelector('[type=submit]');if(button){button.textContent=rows.length?'Preview checkout · '+money(totals().total):'Add an item before checkout';button.disabled=!rows.length}});\n  }\n  details.forEach(function(detail){detail.querySelectorAll('.qty button').forEach(function(b){b.type='button';b.setAttribute('aria-label',b.textContent.trim()==='+'?'Increase quantity':'Decrease quantity')});detail.querySelectorAll('.chips .chip').forEach(function(b){b.type='button';b.setAttribute('aria-pressed',b.classList.contains('on'));b.addEventListener('click',function(){b.parentElement.querySelectorAll('.chip').forEach(function(x){x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)})})})});\n  document.addEventListener('click',function(e){var row=e.target.closest('[data-dl-cart-row]');if(row){var index=Number(row.dataset.dlCartRow),change=e.target.closest('[data-dl-cart-change]');if(e.target.closest('[data-dl-cart-remove]'))rows.splice(index,1);else if(change&&rows[index])rows[index].qty=Math.max(1,Math.min(99,rows[index].qty+Number(change.dataset.dlCartChange)));save();render();return}\n   var detail=e.target.closest('.pdp,[data-dl-product]');if(!detail)return;var button=e.target.closest('.qty button');if(button&&!button.onclick){var span=button.parentElement.querySelector('span');if(span)span.textContent=Math.max(1,Math.min(99,amount(span.textContent)+(button.textContent.trim()==='+'?1:-1)))}\n   var link=e.target.closest('.buy a,[data-dl-add]');if(link&&!e.defaultPrevented&&link.getAttribute('aria-disabled')!=='true'&&/cart(?:\\.|$)|#\\/cart/.test(link.getAttribute('href')||'')){var h=detail.querySelector('.pinfo h1'),price=detail.querySelector('.pinfo .price'),q=detail.querySelector('.qty span');if(h&&price){var chosen=Array.from(detail.querySelectorAll('.pinfo .chip.on,.pinfo .ok-finish [aria-pressed=true]')).map(function(b){return b.getAttribute('aria-label')||b.textContent.trim()}),name=h.textContent+(chosen.length?' · '+chosen.join(' / '):''),quantity=amount(q?q.textContent:1)||1,found=rows.find(function(r){return r.name===name});if(found)found.qty=Math.min(99,found.qty+quantity);else rows.push(item(name,amount(price.textContent),quantity));save();render()}}\n  });\n  render();\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script>","foot":"<footer data-dl-footer class=\"aw-foot\"><div class=\"big\">atelier wall<i>.</i></div><div class=\"cols\"><div><h4>School</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:studios}}\">Studios</a></li><li><a href=\"{{p:studio}}\">Studio: Drawing Foundations</a></li><li><a href=\"{{p:wall}}\">Student wall</a></li><li><a href=\"{{p:progress}}\">Before & after</a></li><li><a href=\"{{p:faculty}}\">Faculty</a></li></ul></div><div><h4>Join</h4><ul><li><a href=\"{{p:tuition}}\">Tuition</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div><div class=\"copy\">© 2026 Atelier Wall · Template demo content</div><div class=\"wrap\"><details class=\"dl-credits\"><summary>Illustrative photography &amp; credits</summary><p>Stock references for layout demonstration; replace before customer launch. Remote images require internet access.</p><ul><li><a href=\"https://unsplash.com/photos/museum-exhibition-with-sculpture-and-artwork-on-walls-A7stKKNY1GQ\" target=\"_blank\" rel=\"noopener noreferrer\">Museum exhibition with sculpture and artwork on walls</a> — Filipe Nobre</li><li><a href=\"https://unsplash.com/photos/assortment-of-handmade-ceramic-bowls-and-dishes-on-shelves-1FPwnKpLeOE\" target=\"_blank\" rel=\"noopener noreferrer\">Assortment of handmade ceramic bowls and dishes on shelves</a> — Khanh Do</li></ul><a href=\"https://unsplash.com/license\" target=\"_blank\" rel=\"noopener noreferrer\">Unsplash licence</a></details></div></footer>","pages":{"home":"<div tabindex=\"-1\" data-dl-content><section class=\"aw-hero\"><span class=\"aw-lab\">Online art school · live studios · twelve-week terms</span><h1 style=\"margin:18px 0 28px\">Learn to <em>see</em>, then to make.</h1><p style=\"display:flex;gap:12px;flex-wrap:wrap;margin-bottom:clamp(40px,6vw,80px)\"><a class=\"aw-btn\" href=\"{{p:studios}}\">See the studios</a><a class=\"aw-btn o\" href=\"{{p:progress}}\">Before &amp; after</a></p></section><section class=\"dl-photo-story\" data-dl-photo-edition><div class=\"dl-photo-wrap\"><div class=\"dl-photo-head\"><h2>Craft in the details</h2><p>Materials, texture and the care behind every thoughtful choice.</p></div><div class=\"dl-photo-grid\"><figure><div class=\"dl-visual\" style=\"aspect-ratio:3/2\"><img src=\"https://images.unsplash.com/photo-1774125553858-3f41e84d4e92?auto=format&amp;fit=crop&amp;w=1920&amp;h=1280&amp;q=85\" alt=\"Museum exhibition with sculpture and artwork on walls\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span class=\"dl-stock-label\">Illustrative stock image</span></div><figcaption>Museum exhibition with sculpture and artwork on walls</figcaption></figure><figure><div class=\"dl-visual\" style=\"aspect-ratio:3/2\"><img src=\"https://images.unsplash.com/photo-1764072396689-953cc059db86?auto=format&amp;fit=crop&amp;w=1920&amp;h=1280&amp;q=85\" alt=\"Assortment of handmade ceramic bowls and dishes on shelves\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span class=\"dl-stock-label\">Illustrative stock image</span></div><figcaption>Assortment of handmade ceramic bowls and dishes on shelves</figcaption></figure></div></div></section>\n<section class=\"aw-sec\" style=\"padding-top:0\"><div class=\"aw-lab\" style=\"margin-bottom:22px\">On the wall this term</div><div class=\"aw-wall\"><figure class=\"aw-work xl\" data-k=\"paint\"><div class=\"aw-pic\" style=\"--r:16/10;--bg:#e9d8b4;--c1:#c9582b;--c2:#31443a;--x:30%;--y:40%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Still life with pears</b><span>Studio 01, Oil, 2026</span></figcaption></figure><figure class=\"aw-work s\" data-k=\"drawing\"><div class=\"aw-pic\" style=\"--r:4/5;--bg:#e8e6df;--c1:#222;--c2:#8a8a85;--x:50%;--y:35%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Self-portrait, tired</b><span>Mina K., Charcoal, 2026</span></figcaption></figure><figure class=\"aw-work s\" data-k=\"drawing\"><div class=\"aw-pic\" style=\"--r:4/5;--bg:#1f2540;--c1:#f2b134;--c2:#e9e4d4;--x:70%;--y:30%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Station at night</b><span>Arvind P., Ink, 2026</span></figcaption></figure><figure class=\"aw-work w\" data-k=\"paint\"><div class=\"aw-pic\" style=\"--r:5/4;--bg:#f3d5c0;--c1:#2b6f6b;--c2:#c64a3a;--x:35%;--y:60%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Market, Saturday</b><span>Jo T., Gouache, 2025</span></figcaption></figure><figure class=\"aw-work w\" data-k=\"drawing\"><div class=\"aw-pic\" style=\"--r:5/4;--bg:#efeee9;--c1:#555;--c2:#a9a9a3;--x:60%;--y:45%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Hands, study no. 7</b><span>Lena W., Graphite, 2026</span></figcaption></figure><figure class=\"aw-work s\" data-k=\"paint\"><div class=\"aw-pic\" style=\"--r:4/5;--bg:#dce9e4;--c1:#e0a24b;--c2:#4d7a73;--x:40%;--y:55%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Quiet kitchen</b><span>Omar S., Watercolour, 2026</span></figcaption></figure><figure class=\"aw-work s\" data-k=\"paint\"><div class=\"aw-pic\" style=\"--r:4/5;--bg:#f1e0a8;--c1:#cf3f5b;--c2:#27408b;--x:55%;--y:30%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Neighbours</b><span>Priya D., Acrylic, 2025</span></figcaption></figure></div><p style=\"margin-top:40px\"><a class=\"aw-btn o\" href=\"{{p:wall}}\">See the whole wall</a></p></section>\n<section class=\"aw-sec\" style=\"padding-top:0\"><div class=\"aw-split\"><div><div class=\"aw-lab\">Progress</div><h2 style=\"font:800 clamp(30px,4.4vw,60px)/1.02 var(--f-head);letter-spacing:-.04em;margin:14px 0 18px\">Twelve weeks, one student.</h2><p style=\"font:400 17px/1.8 var(--f-body);max-width:42ch\">Drag to compare a first drawing with the one made at the end of term. Every student keeps a portfolio of their own.</p></div><div class=\"aw-ba\" id=\"aw-ba\"><div class=\"a\"><span>Week 1</span></div><div class=\"b\"><span>Week 12</span></div><i></i><input type=\"range\" min=\"0\" max=\"100\" value=\"50\" aria-label=\"Compare week 1 and week 12\"></div></div></section><script>(function(){var b=document.getElementById(\"aw-ba\");if(!b)return;var r=b.querySelector(\"input\");function u(){b.style.setProperty(\"--p\",r.value+\"%\")}r.addEventListener(\"input\",u);u()})();</script></div>","studios":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Studios</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.04em\">Studios</h1><p class=\"lead\">Four studios, each ten to twelve students and one teacher.</p></div></section><section class=\"aw-sec\" style=\"padding-top:0\"><a class=\"aw-st\" href=\"{{p:studio}}\"><span class=\"n\">01</span><div><h3>Drawing Foundations</h3><p>Line, form, light. The base every other studio stands on.</p><div class=\"meta\"><span>12 weeks</span><span>Beginner</span></div></div><div class=\"aw-pic\" data-l=\"缺图\" style=\"--bg:#e8e6df;--c1:#222;--c2:#8a8a85\"></div></a><a class=\"aw-st\" href=\"{{p:studio}}\"><span class=\"n\">02</span><div><h3>Painting from Life</h3><p>Colour mixing, composition and a finished still life.</p><div class=\"meta\"><span>12 weeks</span><span>Improver</span></div></div><div class=\"aw-pic\" data-l=\"缺图\" style=\"--bg:#e9d8b4;--c1:#c9582b;--c2:#31443a\"></div></a><a class=\"aw-st\" href=\"{{p:studio}}\"><span class=\"n\">03</span><div><h3>Illustration Practice</h3><p>Characters, narrative and building a small series.</p><div class=\"meta\"><span>10 weeks</span><span>Improver</span></div></div><div class=\"aw-pic\" data-l=\"缺图\" style=\"--bg:#f1e0a8;--c1:#cf3f5b;--c2:#27408b\"></div></a><a class=\"aw-st\" href=\"{{p:studio}}\"><span class=\"n\">04</span><div><h3>Portfolio Studio</h3><p>Edit, sequence and present eight finished works.</p><div class=\"meta\"><span>8 weeks</span><span>Advanced</span></div></div><div class=\"aw-pic\" data-l=\"缺图\" style=\"--bg:#dce9e4;--c1:#e0a24b;--c2:#4d7a73\"></div></a></section></div>","studio":"<div tabindex=\"-1\" data-dl-content><section class=\"aw-sec\"><div class=\"aw-split\"><div><div class=\"aw-lab\">Studio 01 · 12 weeks · Beginner</div><h1 style=\"font:800 clamp(38px,6vw,84px)/.98 var(--f-head);letter-spacing:-.045em;color:var(--c-primary);margin:16px 0 20px\">Drawing Foundations</h1><p style=\"font:400 18px/1.8 var(--f-body);max-width:44ch;margin-bottom:26px\">Twelve weekly studios with live critique. You need paper, a 2B pencil and a window.</p><p style=\"display:flex;gap:12px;flex-wrap:wrap\"><a class=\"aw-btn\" href=\"{{p:tuition}}\">Enrol · RM 690</a><a class=\"aw-btn o\" href=\"{{p:progress}}\">See progress</a></p></div>\n<div class=\"faq\" style=\"max-width:none\"><details open><summary>Weeks 1–3 · Line and observation</summary><p>Contour, blind drawing, measuring by eye.</p></details><details><summary>Weeks 4–6 · Light and form</summary><p>Value scales, shading, the cast shadow.</p></details><details><summary>Weeks 7–9 · Composition</summary><p>Thumbnails, cropping, negative space.</p></details><details><summary>Weeks 10–12 · Final study</summary><p>One sustained still life with critique.</p></details></div></div></section></div>","wall":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Student wall</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.04em\">Student wall</h1><p class=\"lead\">Work made in the studios this term, shown with permission.</p></div></section><section class=\"aw-sec\" style=\"padding-top:0\"><div class=\"aw-chips\" role=\"group\" aria-label=\"Filter works\"><button type=\"button\" aria-pressed=\"true\" data-f=\"all\">All</button><button type=\"button\" aria-pressed=\"false\" data-f=\"paint\">Paint</button><button type=\"button\" aria-pressed=\"false\" data-f=\"drawing\">Drawing</button></div><div class=\"aw-wall\"><figure class=\"aw-work xl\" data-k=\"paint\"><div class=\"aw-pic\" style=\"--r:16/10;--bg:#e9d8b4;--c1:#c9582b;--c2:#31443a;--x:30%;--y:40%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Still life with pears</b><span>Studio 01, Oil, 2026</span></figcaption></figure><figure class=\"aw-work s\" data-k=\"drawing\"><div class=\"aw-pic\" style=\"--r:4/5;--bg:#e8e6df;--c1:#222;--c2:#8a8a85;--x:50%;--y:35%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Self-portrait, tired</b><span>Mina K., Charcoal, 2026</span></figcaption></figure><figure class=\"aw-work s\" data-k=\"drawing\"><div class=\"aw-pic\" style=\"--r:4/5;--bg:#1f2540;--c1:#f2b134;--c2:#e9e4d4;--x:70%;--y:30%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Station at night</b><span>Arvind P., Ink, 2026</span></figcaption></figure><figure class=\"aw-work w\" data-k=\"paint\"><div class=\"aw-pic\" style=\"--r:5/4;--bg:#f3d5c0;--c1:#2b6f6b;--c2:#c64a3a;--x:35%;--y:60%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Market, Saturday</b><span>Jo T., Gouache, 2025</span></figcaption></figure><figure class=\"aw-work w\" data-k=\"drawing\"><div class=\"aw-pic\" style=\"--r:5/4;--bg:#efeee9;--c1:#555;--c2:#a9a9a3;--x:60%;--y:45%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Hands, study no. 7</b><span>Lena W., Graphite, 2026</span></figcaption></figure><figure class=\"aw-work s\" data-k=\"paint\"><div class=\"aw-pic\" style=\"--r:4/5;--bg:#dce9e4;--c1:#e0a24b;--c2:#4d7a73;--x:40%;--y:55%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Quiet kitchen</b><span>Omar S., Watercolour, 2026</span></figcaption></figure><figure class=\"aw-work s\" data-k=\"paint\"><div class=\"aw-pic\" style=\"--r:4/5;--bg:#f1e0a8;--c1:#cf3f5b;--c2:#27408b;--x:55%;--y:30%\" data-l=\"缺图\"></div><figcaption class=\"aw-cap\"><b>Neighbours</b><span>Priya D., Acrylic, 2025</span></figcaption></figure></div></section><script>(function(){var c=document.querySelectorAll(\".aw-chips button\");if(!c.length)return;c.forEach(function(b){b.onclick=function(){c.forEach(function(x){x.setAttribute(\"aria-pressed\",x===b)});var f=b.dataset.f;document.querySelectorAll(\".aw-work\").forEach(function(w){w.classList.toggle(\"hide\",f!==\"all\"&&w.dataset.k!==f)})}})})();</script></div>","progress":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Before & after</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.04em\">Before &amp; after</h1><p class=\"lead\">Drag the line. Week 1 on the left, week 12 on the right.</p></div></section><section class=\"aw-sec\" style=\"padding-top:0\"><div class=\"aw-ba\" id=\"aw-ba\"><div class=\"a\"><span>Week 1</span></div><div class=\"b\"><span>Week 12</span></div><i></i><input type=\"range\" min=\"0\" max=\"100\" value=\"50\" aria-label=\"Compare week 1 and week 12\"></div><p style=\"margin-top:18px;font:400 15px/1.8 var(--f-body);max-width:56ch\">Replace with real, permissioned student work: same subject, first week and last week.</p></section><script>(function(){var b=document.getElementById(\"aw-ba\");if(!b)return;var r=b.querySelector(\"input\");function u(){b.style.setProperty(\"--p\",r.value+\"%\")}r.addEventListener(\"input\",u);u()})();</script></div>","faculty":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Faculty</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.04em\">Faculty</h1></div></section><section class=\"aw-sec\" style=\"padding-top:0\"><div class=\"aw-3\"><div class=\"aw-card\"><h3>Rina Okafor</h3><p>Drawing · 15 years teaching · exhibited in Lagos and London.