{"slug":"fermata-piano","name":"Fermata Piano","zh":"钢琴课程","tag":"Online piano school on sheet-music paper: five-line staff header with notes as nav links, playable on-page keyboard, concert-programme course list and a metronome.","colors":{"primary":"#201c17","secondary":"#8a7d68","text":"#2a251f","accent":"#0f7b7b","surface":"#f5efe0","border":"#d8cdb4"},"fonts":{"head":"Old Standard TT","body":"Libre Franklin"},"tok":{"hlh":"1.1","hw":"400","hcase":"none","hls":"-.01em","h1":"84px","h2":"44px","h3":"24px","pad":"92px","ew":"600","stat":"var(--c-accent)","radius":"0"},"types":["landing","company"],"ind":["music","education"],"styles":["elegant","editorial","typographic"],"license":"库内自有","format":"fragments","pagelist":[{"slug":"home","label":"Home","group":"Learn"},{"slug":"courses","label":"Programme","group":"Learn"},{"slug":"course","label":"Course: Piano from Zero","group":"Learn"},{"slug":"lesson","label":"Lesson & metronome","group":"Learn"},{"slug":"keyboard","label":"Keyboard","group":"Learn"},{"slug":"teachers","label":"Teachers","group":"School"},{"slug":"pricing","label":"Tuition","group":"School"},{"slug":"faq","label":"FAQ","group":"School"},{"slug":"privacy","label":"Privacy policy","group":"Utility"},{"slug":"404","label":"404 error","group":"Utility"}],"nav":"<style>\n/* Fermata Piano — sheet-music paper, tokens only */\n.fp-head{background:var(--c-surface);border-bottom:1px solid var(--c-primary);position:sticky;top:0;z-index:50}\n.fp-staff{position:relative;display:flex;align-items:center;gap:clamp(14px,2.6vw,40px);padding:0 clamp(16px,4vw,56px);min-height:84px;background:\n linear-gradient(var(--c-primary),var(--c-primary)) 0 calc(50% - 16px)/100% 1px no-repeat,\n linear-gradient(var(--c-primary),var(--c-primary)) 0 calc(50% - 8px)/100% 1px no-repeat,\n linear-gradient(var(--c-primary),var(--c-primary)) 0 50%/100% 1px no-repeat,\n linear-gradient(var(--c-primary),var(--c-primary)) 0 calc(50% + 8px)/100% 1px no-repeat,\n linear-gradient(var(--c-primary),var(--c-primary)) 0 calc(50% + 16px)/100% 1px no-repeat}\n.fp-logo{background:var(--c-surface);padding:0 14px 0 0;display:flex;align-items:center;gap:10px;font:700 24px var(--f-head);color:var(--c-primary);text-decoration:none;letter-spacing:.01em;position:relative;z-index:1}\n.fp-logo i{font:400 40px/1 var(--f-head);font-style:normal;color:var(--c-accent)}\n.fp-notes{display:flex;gap:clamp(8px,2.4vw,40px);list-style:none;margin-left:auto;align-items:center}\n.fp-notes a{display:flex;align-items:center;gap:9px;background:var(--c-surface);padding:0 8px;min-height:44px;text-decoration:none;font:600 14px var(--f-body);color:var(--c-text);position:relative;z-index:1}\n.fp-notes a::before{content:\"\";width:13px;height:10px;border-radius:50%;background:var(--c-primary);transform:rotate(-20deg)}\n.fp-notes a:hover::before{background:var(--c-accent)}\n.fp-notes a:hover{color:var(--c-accent)}\n.fp-notes .more{position:relative}\n.fp-notes .dd{position:absolute;right:0;top:100%;display:none;grid-template-columns:repeat(3,minmax(140px,1fr));gap:16px 26px;padding:22px 26px;background:var(--c-surface);border:1px solid var(--c-primary);min-width:520px;z-index:60}\n.fp-notes .more:hover .dd,.fp-notes .more:focus-within .dd{display:grid}\n.fp-notes .dd h4{font:700 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-accent);margin-bottom:6px}\n.fp-notes .dd a{padding:5px 0;min-height:0;display:block}.fp-notes .dd a::before{display:none}\n.fp-m{display:none;margin-left:auto;position:relative;z-index:1;background:var(--c-surface)}\n.fp-m summary{list-style:none;cursor:pointer;min-height:44px;display:flex;align-items:center;padding:0 12px;font:700 12px var(--f-body);letter-spacing:.16em;border:1px solid var(--c-primary)}\n.fp-m summary::-webkit-details-marker{display:none}\n.fp-m nav{position:absolute;right:0;top:100%;min-width:240px;background:var(--c-surface);border:1px solid var(--c-primary);padding:8px 18px;display:grid}\n.fp-m nav a{padding:12px 0;border-bottom:1px solid var(--c-border);text-decoration:none;font:600 15px var(--f-body);min-height:44px}\n@media(max-width:900px){.fp-notes{display:none}.fp-m{display:block}}\n\n.fp-sec{padding:clamp(40px,6vw,90px) clamp(18px,5vw,80px)}\n.fp-hero{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(24px,5vw,80px);align-items:center;padding:clamp(40px,6vw,90px) clamp(18px,5vw,80px)}\n.fp-hero h1{font:400 clamp(44px,6.4vw,var(--h1))/1.04 var(--f-head);letter-spacing:-.01em;color:var(--c-primary)}\n.fp-hero h1 em{color:var(--c-accent)}\n.fp-hero .lead{font:400 18px/1.8 var(--f-body);margin:20px 0 26px;max-width:44ch}\n@media(max-width:900px){.fp-hero{grid-template-columns:1fr}}\n.fp-btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;border:1.5px solid var(--c-primary);background:var(--c-primary);color:var(--on-primary);font:600 15px var(--f-body);text-decoration:none;cursor:pointer;letter-spacing:.02em}\n.fp-btn:hover{background:var(--c-accent);border-color:var(--c-accent);color:var(--on-accent)}\n.fp-btn.o{background:transparent;color:var(--c-primary)}.fp-btn.o:hover{background:var(--c-primary);color:var(--on-primary);border-color:var(--c-primary)}\n.fp-hd{display:flex;align-items:baseline;gap:18px;border-bottom:1.5px solid var(--c-primary);padding-bottom:10px;margin-bottom:26px}\n.fp-hd h2{font:400 clamp(26px,3.4vw,var(--h2)) var(--f-head);color:var(--c-primary)}\n.fp-hd span{font:600 12px var(--f-body);letter-spacing:.18em;text-transform:uppercase;color:var(--c-secondary)}\n\n/* keyboard */\n.fp-kb{position:relative;display:flex;user-select:none;touch-action:manipulation;max-width:980px;border:1.5px solid var(--c-primary);background:var(--c-primary);padding:10px 10px 0;border-radius:6px 6px 0 0}\n.fp-w{flex:1;position:relative;height:clamp(150px,22vw,240px);background:var(--c-surface);border:1px solid var(--c-secondary);border-top:0;border-radius:0 0 5px 5px;cursor:pointer;display:flex;align-items:flex-end;justify-content:center;padding-bottom:8px;font:600 11px var(--f-body);color:var(--c-secondary);margin:0 1px;transition:background .08s;min-width:0}\n.fp-w.on{background:color-mix(in srgb,var(--c-accent) 35%,var(--c-surface))}\n.fp-b{position:absolute;top:10px;width:5.2%;height:clamp(92px,13vw,142px);margin-left:-2.6%;background:var(--c-primary);border:1px solid var(--c-text);border-top:0;border-radius:0 0 4px 4px;cursor:pointer;z-index:2;color:var(--on-primary);font:600 9px var(--f-body);display:flex;align-items:flex-end;justify-content:center;padding-bottom:6px;box-shadow:0 4px 8px color-mix(in srgb,#000 30%,transparent)}\n.fp-b.on{background:var(--c-accent);color:var(--on-accent)}\n.fp-read{margin:16px 0 0;display:flex;align-items:baseline;gap:16px;font:400 14px var(--f-body);color:var(--c-secondary)}\n.fp-read b{font:400 clamp(36px,5vw,56px)/1 var(--f-head);color:var(--c-primary);min-width:2.3em}\n.fp-sc{margin-top:12px;display:flex;gap:8px;flex-wrap:wrap}\n.fp-sc button{min-height:44px;padding:0 16px;border:1px solid var(--c-primary);background:transparent;font:600 13px var(--f-body);cursor:pointer;color:var(--c-primary)}\n.fp-sc button:hover{background:var(--c-primary);color:var(--on-primary)}\n\n/* programme list */\n.fp-prog{border-top:1.5px solid var(--c-primary)}\n.fp-prog a{display:grid;grid-template-columns:70px minmax(0,1fr) auto auto;gap:20px;align-items:baseline;padding:22px 0;border-bottom:1px solid var(--c-border);text-decoration:none;transition:padding .15s}\n.fp-prog a:hover{padding-left:12px}\n.fp-prog .r{font:400 28px var(--f-head);color:var(--c-accent)}\n.fp-prog h3{font:400 clamp(22px,2.6vw,32px) var(--f-head);color:var(--c-primary)}\n.fp-prog p{font:400 15px var(--f-body);color:var(--c-secondary);margin-top:2px}\n.fp-prog .m{font:600 13px var(--f-body);letter-spacing:.06em}\n@media(max-width:700px){.fp-prog a{grid-template-columns:44px 1fr;gap:6px 12px}.fp-prog .m{grid-column:2}}\n\n/* metronome */\n.fp-metro{border:1.5px solid var(--c-primary);padding:clamp(22px,3vw,40px);max-width:560px}\n.fp-bpm{font:400 clamp(60px,9vw,110px)/1 var(--f-head);color:var(--c-primary)}\n.fp-bpm small{font:600 14px var(--f-body);letter-spacing:.14em;color:var(--c-secondary)}\n.fp-beats{display:flex;gap:12px;margin:16px 0 22px}\n.fp-beats i{flex:1;height:14px;border-radius:50%;background:var(--c-border);transition:background .05s}\n.fp-beats i.on{background:var(--c-accent)}\n.fp-beats i.on.f{background:var(--c-primary)}\n.fp-metro input[type=range]{width:100%;accent-color:var(--c-accent);padding:0;border:0;background:none;min-height:44px}\n.fp-two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,80px);align-items:start}\n@media(max-width:860px){.fp-two{grid-template-columns:1fr}}\n.fp-score{border:1px solid var(--c-border);background:color-mix(in srgb,var(--c-surface) 60%,#fff);padding:20px;overflow:hidden}\n.fp-score svg{width:100%;height:auto;display:block}\n.fp-card{border:1px solid var(--c-primary);padding:26px;display:grid;gap:10px;align-content:start}\n.fp-card h3{font:400 24px var(--f-head)}\n.fp-card .p{font:400 40px var(--f-head);color:var(--c-primary)}\n.fp-card li{list-style:none;padding:8px 0;border-top:1px solid var(--c-border);font:400 15px var(--f-body)}\n.fp-3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n@media(max-width:860px){.fp-3{grid-template-columns:1fr}}\n.fp-foot{border-top:1.5px solid var(--c-primary);margin-top:clamp(40px,6vw,80px);padding:clamp(36px,5vw,64px) clamp(18px,5vw,80px) 22px;position:relative}\n.fp-foot .fine{position:absolute;right:clamp(18px,5vw,80px);top:14px;font:400 14px var(--f-head);font-style:italic;color:var(--c-secondary)}\n.fp-foot .top{display:grid;grid-template-columns:1.1fr 2fr;gap:clamp(24px,6vw,100px)}\n.fp-foot .big{font:700 30px var(--f-head);color:var(--c-primary)}\n.fp-foot h4{font:700 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-accent);margin-bottom:10px}\n.fp-foot ul{list-style:none}.fp-foot li a{display:inline-block;padding:6px 0;text-decoration:none;font:500 14px var(--f-body);min-height:32px}\n.fp-foot .cols{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n.fp-foot .copy{margin-top:28px;font:400 12px var(--f-body);color:var(--c-secondary)}\n@media(max-width:800px){.fp-foot .top{grid-template-columns:1fr}}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}\n@media(prefers-reduced-motion:reduce){.fp-prog a{transition:none}}\n</style><header class=\"fp-head\"><div class=\"fp-staff\"><a class=\"fp-logo\" href=\"{{p:home}}\"><i>𝄞</i>Fermata</a><ul class=\"fp-notes\"><li><a href=\"{{p:courses}}\">Programme</a></li><li><a href=\"{{p:keyboard}}\">Keyboard</a></li><li><a href=\"{{p:lesson}}\">Metronome</a></li><li><a href=\"{{p:teachers}}\">Teachers</a></li><li><a href=\"{{p:pricing}}\">Tuition</a></li><li class=\"more\"><a href=\"#\" tabindex=\"0\">More</a><div class=\"dd\"><div><h4>Learn</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:courses}}\">Programme</a><a href=\"{{p:course}}\">Course: Piano from Zero</a><a href=\"{{p:lesson}}\">Lesson & metronome</a><a href=\"{{p:keyboard}}\">Keyboard</a></div><div><h4>School</h4><a href=\"{{p:teachers}}\">Teachers</a><a href=\"{{p:pricing}}\">Tuition</a><a href=\"{{p:faq}}\">FAQ</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li></ul><details class=\"fp-m\"><summary>MENU</summary><nav><a href=\"{{p:home}}\">Home</a><a href=\"{{p:courses}}\">Programme</a><a href=\"{{p:course}}\">Course: Piano from Zero</a><a href=\"{{p:lesson}}\">Lesson & metronome</a><a href=\"{{p:keyboard}}\">Keyboard</a><a href=\"{{p:teachers}}\">Teachers</a><a href=\"{{p:pricing}}\">Tuition</a><a href=\"{{p:faq}}\">FAQ</a><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></nav></details></div></header>","foot":"<footer class=\"fp-foot\"><span class=\"fine\">fine.</span><div class=\"top\"><div><div class=\"big\">Fermata Piano</div><p style=\"margin-top:10px;font:400 14px/1.8 var(--f-body);color:var(--c-secondary);max-width:34ch\">Online piano lessons, one phrase at a time. Template demo content.</p></div><div class=\"cols\"><div><h4>Learn</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:courses}}\">Programme</a></li><li><a href=\"{{p:course}}\">Course: Piano from Zero</a></li><li><a href=\"{{p:lesson}}\">Lesson & metronome</a></li><li><a href=\"{{p:keyboard}}\">Keyboard</a></li></ul></div><div><h4>School</h4><ul><li><a href=\"{{p:teachers}}\">Teachers</a></li><li><a href=\"{{p:pricing}}\">Tuition</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div></div><div class=\"copy\">© 2026 Fermata Piano School</div></footer>","pages":{"home":"<section class=\"fp-hero\"><div><h1>Learn piano,<br><em>one phrase</em> at a time.</h1><p class=\"lead\">Fifteen-minute lessons, a real teacher who listens to your recordings, and a keyboard right here in the page to try it first.</p><p style=\"display:flex;gap:12px;flex-wrap:wrap\"><a class=\"fp-btn\" href=\"{{p:courses}}\">See the programme</a><a class=\"fp-btn o\" href=\"{{p:keyboard}}\">Open keyboard</a></p></div><div><div class=\"fp-kb\" role=\"group\" aria-label=\"Piano keyboard\"><button type=\"button\" class=\"fp-w\" data-n=\"C4\" data-f=\"261.63\" aria-label=\"C4\">C4</button><button type=\"button\" class=\"fp-w\" data-n=\"D4\" data-f=\"293.66\" aria-label=\"D4\">D</button><button type=\"button\" class=\"fp-w\" data-n=\"E4\" data-f=\"329.63\" aria-label=\"E4\">E</button><button type=\"button\" class=\"fp-w\" data-n=\"F4\" data-f=\"349.23\" aria-label=\"F4\">F</button><button type=\"button\" class=\"fp-w\" data-n=\"G4\" data-f=\"392.00\" aria-label=\"G4\">G</button><button type=\"button\" class=\"fp-w\" data-n=\"A4\" data-f=\"440.00\" aria-label=\"A4\">A</button><button type=\"button\" class=\"fp-w\" data-n=\"B4\" data-f=\"493.88\" aria-label=\"B4\">B</button><button type=\"button\" class=\"fp-b\" style=\"left:calc(10px + (100% - 20px) * 0.1429)\" data-n=\"C#4\" data-f=\"277.18\" aria-label=\"C#4\"></button><button type=\"button\" class=\"fp-b\" style=\"left:calc(10px + (100% - 20px) * 0.2857)\" data-n=\"D#4\" data-f=\"311.13\" aria-label=\"D#4\"></button><button type=\"button\" class=\"fp-b\" style=\"left:calc(10px + (100% - 20px) * 0.5714)\" data-n=\"F#4\" data-f=\"369.99\" aria-label=\"F#4\"></button><button type=\"button\" class=\"fp-b\" style=\"left:calc(10px + (100% - 20px) * 0.7143)\" data-n=\"G#4\" data-f=\"415.30\" aria-label=\"G#4\"></button><button type=\"button\" class=\"fp-b\" style=\"left:calc(10px + (100% - 20px) * 0.8571)\" data-n=\"A#4\" data-f=\"466.16\" aria-label=\"A#4\"></button></div><div class=\"fp-read\"><b id=\"fp-note\">—</b><span id=\"fp-solf\">Tap or click a key</span></div><div class=\"fp-sc\"><button type=\"button\" data-s=\"0,2,4,5,7,9,11,12\">C major scale</button><button type=\"button\" data-s=\"0,4,7,12\">C major arpeggio</button><button type=\"button\" data-s=\"0,0,7,7,9,9,7\">Twinkle (first line)</button></div></div></section>\n<section class=\"fp-sec\"><div class=\"fp-hd\"><h2>Programme</h2><span>Four movements</span></div><div class=\"fp-prog\"><a href=\"{{p:course}}\"><span class=\"r\">I</span><div><h3>Piano from Zero</h3><p>Posture, notes, both hands, your first piece.</p></div><span class=\"m\">8 weeks</span><span class=\"m\">RM 79/mo</span></a><a href=\"{{p:courses}}\"><span class=\"r\">II</span><div><h3>Reading Music</h3><p>Rhythm, key signatures and sight-reading without panic.</p></div><span class=\"m\">6 weeks</span><span class=\"m\">RM 79/mo</span></a><a href=\"{{p:courses}}\"><span class=\"r\">III</span><div><h3>Chords &amp; Accompaniment</h3><p>Play songs by ear and sing along.</p></div><span class=\"m\">6 weeks</span><span class=\"m\">RM 79/mo</span></a><a href=\"{{p:courses}}\"><span class=\"r\">IV</span><div><h3>Classical Repertoire</h3><p>Bach, Satie, Chopin: small pieces, played well.</p></div><span class=\"m\">10 weeks</span><span class=\"m\">RM 99/mo</span></a></div></section>\n<section class=\"fp-sec\" style=\"padding-top:0\"><div class=\"fp-two\"><div class=\"fp-score\" style=\"color:var(--c-primary)\"><svg viewBox=\"0 0 600 150\" role=\"img\" aria-label=\"Sheet music excerpt\"><g stroke=\"currentColor\" stroke-width=\"1.2\"><path d=\"M20 40H580M20 52H580M20 64H580M20 76H580M20 88H580\"/><path d=\"M20 40V88M580 40V88\"/></g><text x=\"26\" y=\"82\" font-size=\"64\" fill=\"currentColor\">𝄞</text><g fill=\"currentColor\"><ellipse cx=\"150\" cy=\"76\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 150 76)\"/><ellipse cx=\"220\" cy=\"70\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 220 70)\"/><ellipse cx=\"290\" cy=\"64\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 290 64)\"/><ellipse cx=\"360\" cy=\"70\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 360 70)\"/><ellipse cx=\"430\" cy=\"76\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 430 76)\"/><ellipse cx=\"500\" cy=\"64\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 500 64)\"/></g><g stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M156 76V36M226 70V30M296 64V24M366 70V30M436 76V36M506 64V24\"/></g></svg></div><div><div class=\"fp-hd\"><h2>Slowly is fast.</h2></div><p style=\"font:400 17px/1.9 var(--f-body);max-width:46ch\">Every piece is cut into four-bar phrases. You learn one, record it, and get a note back from your teacher the next morning. Speed is the last thing we add.</p><p style=\"margin-top:22px\"><a class=\"fp-btn o\" href=\"{{p:lesson}}\">Try the metronome</a></p></div></div></section><script>(function(){var kb=document.querySelector(\".fp-kb\");if(!kb)return;var A=null,S={C:\"Do\",D:\"Re\",E:\"Mi\",F:\"Fa\",G:\"Sol\",A:\"La\",B:\"Ti\"};function ctx(){if(!A){var C=window.AudioContext||window.webkitAudioContext;if(C)A=new C()}return A}function play(f){var a=ctx();if(!a)return;var o=a.createOscillator(),g=a.createGain();o.type=\"triangle\";o.frequency.value=f;g.gain.setValueAtTime(.0001,a.currentTime);g.gain.exponentialRampToValueAtTime(.35,a.currentTime+.01);g.gain.exponentialRampToValueAtTime(.0001,a.currentTime+1.1);o.connect(g);g.connect(a.destination);o.start();o.stop(a.currentTime+1.15)}var keys=[].slice.call(kb.querySelectorAll(\"button\"));function hit(k){k.classList.add(\"on\");setTimeout(function(){k.classList.remove(\"on\")},180);var n=k.dataset.n;document.getElementById(\"fp-note\").textContent=n;document.getElementById(\"fp-solf\").textContent=n.indexOf(\"#\")>0?\"Sharp of \"+n[0]+\" (\"+S[n[0]]+\"♯)\":\"Solfège: \"+S[n[0]];play(+k.dataset.f)}keys.forEach(function(k){k.addEventListener(\"pointerdown\",function(e){e.preventDefault();hit(k)})});document.querySelectorAll(\".fp-sc button\").forEach(function(b){b.onclick=function(){var white=keys.filter(function(k){return k.classList.contains(\"fp-w\")});var idx=[0,2,4,5,7,9,11,12];var seq=b.dataset.s.split(\",\").map(Number),all=keys.slice().sort(function(a,b){return +a.dataset.f-+b.dataset.f});var base=all.findIndex(function(k){return k.dataset.n===\"C4\"});seq.forEach(function(s,i){setTimeout(function(){var k=all[base+s];if(k)hit(k)},i*340)})}})})();</script>","courses":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Programme</b></div><h1 style=\"font-weight:400\">Programme</h1><p class=\"lead\">Four courses, taken in order or on their own.</p></div></section><section class=\"fp-sec\" style=\"padding-top:0\"><div class=\"fp-prog\"><a href=\"{{p:course}}\"><span class=\"r\">I</span><div><h3>Piano from Zero</h3><p>Posture, notes, both hands, your first piece.</p></div><span class=\"m\">8 weeks</span><span class=\"m\">Beginner</span></a><a href=\"{{p:course}}\"><span class=\"r\">II</span><div><h3>Reading Music</h3><p>Rhythm, key signatures and sight-reading.</p></div><span class=\"m\">6 weeks</span><span class=\"m\">Beginner</span></a><a href=\"{{p:course}}\"><span class=\"r\">III</span><div><h3>Chords &amp; Accompaniment</h3><p>Play songs by ear and sing along.</p></div><span class=\"m\">6 weeks</span><span class=\"m\">Improver</span></a><a href=\"{{p:course}}\"><span class=\"r\">IV</span><div><h3>Classical Repertoire</h3><p>Small pieces, played well.</p></div><span class=\"m\">10 weeks</span><span class=\"m\">Intermediate</span></a></div></section>","course":"<section class=\"fp-sec\"><div class=\"fp-two\"><div><div class=\"fp-hd\"><span>Movement I · 8 weeks</span></div><h1 style=\"font:400 clamp(38px,5vw,68px)/1.05 var(--f-head);color:var(--c-primary);margin-bottom:18px\">Piano from Zero</h1><p style=\"font:400 18px/1.8 var(--f-body);max-width:46ch;margin-bottom:24px\">No keyboard? A phone and a table are enough for week one. By week eight you will play a short piece, hands together.</p><p style=\"display:flex;gap:12px;flex-wrap:wrap\"><a class=\"fp-btn\" href=\"{{p:pricing}}\">Enrol · RM 79/mo</a><a class=\"fp-btn o\" href=\"{{p:lesson}}\">Free lesson</a></p></div>\n<div class=\"faq\" style=\"max-width:none\"><details open><summary>Weeks 1–2 · Finding your way</summary><p>Posture, the keyboard layout, right-hand five-finger positions.</p></details><details><summary>Weeks 3–4 · Left hand and reading</summary><p>Bass notes, simple rhythms, your first lead sheet.</p></details><details><summary>Weeks 5–6 · Hands together</summary><p>Slow, steady, correct. Short exercises with the metronome.</p></details><details><summary>Weeks 7–8 · Your first piece</summary><p>Ode to Joy, arranged for small hands.</p></details></div></div></section>","lesson":"<section class=\"fp-sec\"><div class=\"fp-hd\"><h2>Week 5 · Hands together</h2><span>Lesson 3 of 5</span></div><div class=\"fp-two\"><div><div class=\"fp-score\" style=\"color:var(--c-primary)\"><svg viewBox=\"0 0 600 150\" role=\"img\" aria-label=\"Sheet music excerpt\"><g stroke=\"currentColor\" stroke-width=\"1.2\"><path d=\"M20 40H580M20 52H580M20 64H580M20 76H580M20 88H580\"/><path d=\"M20 40V88M580 40V88\"/></g><text x=\"26\" y=\"82\" font-size=\"64\" fill=\"currentColor\">𝄞</text><g fill=\"currentColor\"><ellipse cx=\"150\" cy=\"76\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 150 76)\"/><ellipse cx=\"220\" cy=\"70\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 220 70)\"/><ellipse cx=\"290\" cy=\"64\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 290 64)\"/><ellipse cx=\"360\" cy=\"70\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 360 70)\"/><ellipse cx=\"430\" cy=\"76\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 430 76)\"/><ellipse cx=\"500\" cy=\"64\" rx=\"7\" ry=\"5\" transform=\"rotate(-20 500 64)\"/></g><g stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M156 76V36M226 70V30M296 64V24M366 70V30M436 76V36M506 64V24\"/></g></svg></div><p style=\"margin-top:18px;font:400 16px/1.8 var(--f-body);max-width:50ch\">Play the phrase at 60 BPM, four times without a mistake. Then add 4 BPM. Record the last pass and send it to your teacher.</p></div>\n<div class=\"fp-metro\"><div class=\"fp-bpm\"><span id=\"fp-bpmv\">72</span> <small>BPM</small></div><div class=\"fp-beats\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></div><input id=\"fp-bpm\" type=\"range\" min=\"40\" max=\"200\" value=\"72\" aria-label=\"Tempo\"><p style=\"margin-top:14px\"><button id=\"fp-go\" type=\"button\" class=\"fp-btn\">Start</button></p></div></div></section><script>(function(){var r=document.getElementById(\"fp-bpm\"),out=document.getElementById(\"fp-bpmv\"),btn=document.getElementById(\"fp-go\"),dots=document.querySelectorAll(\".fp-beats i\");if(!r)return;var t=null,n=0,A=null;function click(f){var C=window.AudioContext||window.webkitAudioContext;if(!C)return;A=A||new C();var o=A.createOscillator(),g=A.createGain();o.frequency.value=f?1200:800;g.gain.setValueAtTime(.3,A.currentTime);g.gain.exponentialRampToValueAtTime(.0001,A.currentTime+.08);o.connect(g);g.connect(A.destination);o.start();o.stop(A.currentTime+.09)}function tick(){dots.forEach(function(d,i){d.classList.toggle(\"on\",i===n%4);d.classList.toggle(\"f\",i===0)});click(n%4===0);n++}function start(){n=0;tick();t=setInterval(tick,60000/+r.value);btn.textContent=\"Stop\"}function stop(){clearInterval(t);t=null;dots.forEach(function(d){d.classList.remove(\"on\")});btn.textContent=\"Start\"}r.oninput=function(){out.textContent=r.value;if(t){stop();start()}};btn.onclick=function(){t?stop():start()}})();</script>","keyboard":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Keyboard</b></div><h1 style=\"font-weight:400\">Keyboard</h1><p class=\"lead\">Two octaves, from middle C. Tap, click or use a touch screen.</p></div></section><section class=\"fp-sec\" style=\"padding-top:0\"><div class=\"fp-kb\" role=\"group\" aria-label=\"Piano keyboard\"><button type=\"button\" class=\"fp-w\" data-n=\"C4\" data-f=\"261.63\" aria-label=\"C4\">C4</button><button type=\"button\" class=\"fp-w\" data-n=\"D4\" data-f=\"293.66\" aria-label=\"D4\">D</button><button type=\"button\" class=\"fp-w\" data-n=\"E4\" data-f=\"329.63\" aria-label=\"E4\">E</button><button type=\"button\" class=\"fp-w\" data-n=\"F4\" data-f=\"349.23\" aria-label=\"F4\">F</button><button type=\"button\" class=\"fp-w\" data-n=\"G4\" data-f=\"392.00\" aria-label=\"G4\">G</button><button type=\"button\" class=\"fp-w\" data-n=\"A4\" data-f=\"440.00\" aria-label=\"A4\">A</button><button type=\"button\" class=\"fp-w\" data-n=\"B4\" data-f=\"493.88\" aria-label=\"B4\">B</button><button type=\"button\" class=\"fp-w\" data-n=\"C5\" data-f=\"523.26\" aria-label=\"C5\">C5</button><button type=\"button\" class=\"fp-w\" data-n=\"D5\" data-f=\"587.32\" aria-label=\"D5\">D</button><button type=\"button\" class=\"fp-w\" data-n=\"E5\" data-f=\"659.26\" aria-label=\"E5\">E</button><button type=\"button\" class=\"fp-w\" data-n=\"F5\" data-f=\"698.46\" aria-label=\"F5\">F</button><button type=\"button\" class=\"fp-w\" data-n=\"G5\" data-f=\"784.00\" aria-label=\"G5\">G</button><butt