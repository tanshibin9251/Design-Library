+\" belt · \"+s.k+\"</h3><p>\"+s.d+\"</p><ul>\"+s.l.map(function(x){return\"<li>\"+x+\"</li>\"}).join(\"\")+\"</ul>\"}bs.forEach(function(b,i){b.onclick=function(){p(i)}});p(0)})();</script>","classes":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Classes</b></div><h1 style=\"font-family:var(--f-head)\">クラス</h1><p class=\"lead\">Five classes, grouped by age and level. Everyone starts with the same bow.</p></div></section><section class=\"dj-sec\" style=\"padding-top:20px\"><div class=\"dj-3\"><div class=\"dj-slab\"><span class=\"kj\">空手</span><span class=\"age\">KIDS 5–14</span><h3>Kids karate</h3><p>45 min · Mon, Wed, Sat. Basics, kata and games.</p></div><div class=\"dj-slab\"><span class=\"kj\">柔道</span><span class=\"age\">KIDS 6–15</span><h3>Kids judo</h3><p>45 min · Tue, Thu, Sat. Falls, throws and holds.</p></div><div class=\"dj-slab\"><span class=\"kj\">大人</span><span class=\"age\">16+</span><h3>Adult karate</h3><p>60 min · Tue, Thu, Sat. Kata, drills and light sparring.</p></div><div class=\"dj-slab\"><span class=\"kj\">投</span><span class=\"age\">16+</span><h3>Adult judo</h3><p>60 min · Mon, Wed. Throws, ground work, randori.</p></div><div class=\"dj-slab\"><span class=\"kj\">組</span><span class=\"age\">ALL</span><h3>Open mat</h3><p>90 min · Fri. Free practice for members.</p></div></div></section>","timetable":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Timetable</b></div><h1 style=\"font-family:var(--f-head)\">時間割</h1><p class=\"lead\">Filter by who the class is for. Times are local; arrive 10 minutes early.</p></div></section><section class=\"dj-sec\" style=\"padding-top:20px\"><div class=\"dj-chips\" role=\"group\" aria-label=\"Filter classes\"><button type=\"button\" aria-pressed=\"true\" data-f=\"all\">All</button><button type=\"button\" aria-pressed=\"false\" data-f=\"kids\">Kids</button><button t