4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li><li><a class=\"td-btn\" style=\"padding:.6em 1.2em\" href=\"{{p:book}}\">Book</a></li></ul><details class=\"dl-mobile\"><summary>Menu</summary><nav class=\"dl-mobile-links\" aria-label=\"Template pages\"><h4>Clinic</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:services}}\">Treatments</a><a href=\"{{p:constitution}}\">Body constitution check</a><a href=\"{{p:conditions}}\">Conditions we treat</a><a href=\"{{p:master}}\">Master practitioner</a><a href=\"{{p:pricing}}\">Fees</a><h4>Visit</h4><a href=\"{{p:book}}\">Book a consultation</a><a href=\"{{p:stories}}\">Patient stories</a><a href=\"{{p:contact}}\">Visit the clinic</a><a href=\"{{p:faq}}\">FAQ</a><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a></nav></details></div></header><script>/* Runs in previews AND exported files. No requests, credentials or submissions. */\n(function(){\n 'use strict';\n function start(){\n  var root=document.querySelector('[data-dl-template]');if(!root)return;\n  document.querySelectorAll('[data-dl-demo-form]').forEach(function(form,index){\n   if(form.dataset.dlBound)return;form.dataset.dlBound='1';\n   var note=document.createElement('p');note.className='dl-form-note';note.textContent='Interactive demo · Nothing is sent. Use sample details only. No account, booking or payment will be created.';form.prepend(note);\n   var result=document.createElement('p');result.className='dl-feedback';result.setAttribute('role','status');result.setAttribute('aria-live','polite');result.hidden=true;form.append(result);\n   form.querySelectorAll('input,textarea,select').forEach(function(input,i){\n    if(!input.name)input.name='demo-'+index+'-'+i;\n    var label=input.closest('label'),text=(label?label.textContent:input.placeholder||'').toLowerCase();\n    if(/name|email|message|date|time/.test(text)&&!/optional/.test(text))input.required=true;\n    if(input.type==='password')input.autocomplete='new-password';\n    if(/card number|cvc|expiry/.test(text)){input.disabled=true;input.placeholder='Disabled in demo';}\n   });\n   function submit(e){if(e)e.preventDefault();if(!form.reportValidity())return;result.hidden=false;result.textContent='Demo complete. Your entries passed the browser checks. Nothing was sent, charged, booked or stored.';}\n   form.addEventListener('submit',submit);\n   if(!form.querySelector('[type=\"submit\"],button:not([type])')){var buttons=form.querySelectorAll('button[type=\"button\"]');if(buttons.length===1)buttons[0].addEventListener('click',submit);}\n  });\n  document.querySelectorAll('.dl-visual img').forEach(function(img){img.addEventListener('error',function(){img.parentElement.classList.add('dl-photo-failed')});if(img.complete&&!img.naturalWidth)img.parentElement.classList.add('dl-photo-failed')});\n  document.querySelectorAll('.shoptop').forEach(function(top){\n   var grid=top.nextElementSibling;if(!grid||!grid.matches('.products'))return;\n   var cards=Array.from(grid.children),chips=Array.from(top.querySelectorAll('.chip')),sort=top.querySelector('select'),category='All';\n   var empty=document.createElement('p');empty.className='dl-filter-empty';empty.textContent='No sample items match this category. Choose All to see the collection.';empty.hidden=true;grid.after(empty);\n   function update(){var shown=0;cards.forEach(function(card){var tag=card.querySelector('small');card.hidden=category!=='All'&&(!tag||tag.textContent.trim()!==category);if(!card.hidden)shown++});empty.hidden=shown!==0;var count=top.querySelector('.sort span');if(count)count.textContent=shown+' sample items';}\n   chips.forEach(function(chip){chip.type='button';chip.setAttribute('aria-pressed',chip.classList.contains('on'));chip.addEventListener('click',function(){category=chip.textContent.trim();chips.forEach(function(c){c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',c===chip)});update()})});\n   if(sort){sort.setAttribute('aria-label','Sort sample items');Array.from(sort.options).forEach(function(o){if(/newest/i.test(o.textContent))o.textContent='Reverse featured'});sort.addEventListener('change',function(){var ordered=cards.slice();if(sort.selectedIndex===1||sort.selectedIndex===2){ordered.sort(function(a,b){function price(c){var p=c.querySelector('.price');return Number((p?p.textContent:'').replace(/[^0-9.]/g,''))||0}return price(a)-price(b)});if(sort.selectedIndex===2)ordered.reverse()}else if(sort.selectedIndex===3)ordered.reverse();ordered.forEach(function(card){grid.append(card)})})}\n  });\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.burger[open],.dl-mobile[open],.nav details[open]').forEach(function(menu){menu.open=false;var summary=menu.querySelector('summary');if(summary)summary.focus()})});\n  document.addEventListener('click',function(e){var a=e.target.closest('.dl-mobile a,.bmenu a');if(a){var menu=a.closest('details');if(menu)menu.open=false;}});\n  document.querySelectorAll('.more>a[href=\"#\"]').forEach(function(a){a.setAttribute('role','button');a.setAttribute('aria-expanded','false');function set(open){a.parentElement.classList.toggle('dl-menu-open',open);a.setAttribute('aria-expanded',open)}function toggle(e){e.preventDefault();set(a.getAttribute('aria-expanded')!=='true')}a.addEventListener('click',toggle);a.addEventListener('keydown',function(e){if(e.key===' ')toggle(e)});a.parentElement.addEventListener('mouseenter',function(){set(true)});a.parentElement.addEventListener('mouseleave',function(){if(!a.parentElement.contains(document.activeElement))set(false)})});\n  document.addEventListener('click',function(e){var a=e.target.closest('a[href=\"#\"]');if(!a||e.defaultPrevented||a.onclick||a.closest('.more'))return;e.preventDefault();var note=a.parentElement.querySelector(':scope>.dl-missing-link');if(!note){note=document.createElement('p');note.className='dl-feedback dl-missing-link';note.setAttribute('role','status');a.after(note)}note.textContent='Demonstration link. Add the real destination before launching this site.'});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.dl-menu-open').forEach(function(menu){menu.classList.remove('dl-menu-open');var a=menu.querySelector(':scope>a');if(a){a.setAttribute('aria-expanded','false');a.focus()}})});\n  document.querySelectorAll('.dl-skip').forEach(function(link){link.addEventListener('click',function(e){e.preventDefault();var target=document.querySelector('main.on [data-dl-content],main:not([data-page]) [data-dl-content]');if(target){target.focus();target.scrollIntoView({block:'start'})}})});\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>/* Sample commerce only: local item choices, quantities and consistent totals. */\n(function(){\n 'use strict';\n function start(){\n  var marker=document.querySelector('[data-dl-template]');if(!marker||marker.dataset.dlTemplate==='restaurant-warm')return;\n  var carts=Array.from(document.querySelectorAll('.cart')).filter(function(x){return x.querySelector('.crow')}),details=Array.from(document.querySelectorAll('.pdp,[data-dl-product]')).filter(function(x){return x.querySelector('.pinfo .price')}),checkouts=Array.from(document.querySelectorAll('aside.side-card')).filter(function(x){return x.querySelector('.kv')&&x.previousElementSibling&&x.previousElementSibling.querySelector('form')});\n  if(!carts.length&&!details.length&&!checkouts.length)return;\n  var currency='RM ',rows=[],key='dl-sample-cart:'+marker.dataset.dlTemplate;\n  function amount(text){return Number(String(text).replace(/[^0-9.]/g,''))||0}\n  function money(n){return currency+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function item(name,price,qty){return {name:String(name).slice(0,120),price:Math.max(0,Math.min(10000000,price)),qty:Math.max(1,Math.min(99,qty))}}\n  if(carts.length){rows=Array.from(carts[0].querySelectorAll('.crow')).map(function(row){var p=row.querySelector(':scope>b'),h=row.querySelector('h3'),q=row.querySelector('.qty span');if(p){currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' '}return item(h?h.textContent:'Sample item',amount(p?p.textContent:0),amount(q?q.textContent:1)||1)})}\n  else if(checkouts.length){rows=Array.from(checkouts[0].querySelectorAll('.kv li:not(.tot)')).filter(function(row){return row.querySelector('b')&&amount(row.querySelector('b').textContent)>0&&!/tax|shipping|delivery|subtotal|fee/i.test(row.textContent)}).map(function(row){var p=row.querySelector('b');currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' ';return item(row.querySelector('span').textContent,amount(p.textContent),1)})}\n  try{var saved=JSON.parse(localStorage.getItem(key));if(saved&&Array.isArray(saved.rows)&&saved.rows.length<=100){rows=saved.rows.filter(function(r){return typeof r.name==='string'&&Number.isFinite(r.price)&&r.price>=0&&Number.isInteger(r.qty)&&r.qty>0&&r.qty<=99}).map(function(r){return item(r.name,r.price,r.qty)});if(typeof saved.currency==='string'&&/^[A-Z$€£¥ ]{1,8}$/.test(saved.currency))currency=saved.currency;}}catch(e){}\n  function save(){try{localStorage.setItem(key,JSON.stringify({currency:currency,rows:rows}))}catch(e){}}\n  function totals(){var sub=rows.reduce(function(sum,r){return sum+r.price*r.qty},0);return {subtotal:sub,total:sub}}\n  function makeLine(label,value,total){var li=document.createElement('li');if(total)li.className='tot';var span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=value;li.append(span,b);return li}\n  function render(){\n   document.querySelectorAll('header a[href]').forEach(function(a){var match=a.textContent.trim().match(/^(Cart|Bag)\\s*\\(\\d+\\)$/i);if(match)a.textContent=match[1]+' ('+rows.reduce(function(sum,r){return sum+r.qty},0)+')'});\n   carts.forEach(function(cart){cart.querySelectorAll('.crow,.dl-cart-empty').forEach(function(r){r.remove()});rows.forEach(function(row,i){var el=document.createElement('div');el.className='crow';el.dataset.dlCartRow=i;var spacer=document.createElement('div'),info=document.createElement('div'),h=document.createElement('h3'),small=document.createElement('small');h.textContent=row.name;small.textContent=money(row.price)+' each · sample item';info.append(h,small);var qty=document.createElement('div');qty.className='qty';[-1,1].forEach(function(change){var b=document.createElement('button');b.type='button';b.dataset.dlCartChange=change;b.textContent=change<0?'−':'+';b.setAttribute('aria-label',(change<0?'Decrease ':'Increase ')+row.name);if(change>0){var value=document.createElement('span');value.textContent=row.qty;qty.append(value)}qty.append(b)});var price=document.createElement('b');price.textContent=money(row.price*row.qty);var remove=document.createElement('button');remove.type='button';remove.className='btn ghost';remove.dataset.dlCartRemove='';remove.textContent='Remove';remove.setAttribute('aria-label','Remove '+row.name);el.append(spacer,info,qty,price,remove);cart.insertBefore(el,cart.querySelector(':scope>a'))});if(!rows.length){var empty=document.createElement('p');empty.className='dl-cart-empty';empty.setAttribute('role','status');empty.textContent='Your sample cart is empty. Browse the collection to add an item.';cart.prepend(empty)}var aside=cart.parentElement.querySelector('aside.side-card');if(aside){var list=aside.querySelector('.kv');if(list){list.replaceChildren(makeLine('Subtotal',money(totals().subtotal)),makeLine('Demo delivery / fees','Not applied'),makeLine('Total',money(totals().total),true))}var note=aside.querySelector('p');if(note)note.textContent='Local sample cart. Real delivery, tax and payment must be configured before launch.'}});\n   checkouts.forEach(function(aside){var list=aside.querySelector('.kv');list.replaceChildren();rows.forEach(function(r){list.append(makeLine(r.qty+' × '+r.name,money(r.price*r.qty)))});list.append(makeLine('Total · demo only',money(totals().total),true));var form=aside.parentElement.querySelector('form'),button=form&&form.querySelector('[type=submit]');if(button){button.textContent=rows.length?'Preview checkout · '+money(totals().total):'Add an item before checkout';button.disabled=!rows.length}});\n  }\n  details.forEach(function(detail){detail.querySelectorAll('.qty button').forEach(function(b){b.type='button';b.setAttribute('aria-label',b.textContent.trim()==='+'?'Increase quantity':'Decrease quantity')});detail.querySelectorAll('.chips .chip').forEach(function(b){b.type='button';b.setAttribute('aria-pressed',b.classList.contains('on'));b.addEventListener('click',function(){b.parentElement.querySelectorAll('.chip').forEach(function(x){x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)})})})});\n  document.addEventListener('click',function(e){var row=e.target.closest('[data-dl-cart-row]');if(row){var index=Number(row.dataset.dlCartRow),change=e.target.closest('[data-dl-cart-change]');if(e.target.closest('[data-dl-cart-remove]'))rows.splice(index,1);else if(change&&rows[index])rows[index].qty=Math.max(1,Math.min(99,rows[index].qty+Number(change.dataset.dlCartChange)));save();render();return}\n   var detail=e.target.closest('.pdp,[data-dl-product]');if(!detail)return;var button=e.target.closest('.qty button');if(button&&!button.onclick){var span=button.parentElement.querySelector('span');if(span)span.textContent=Math.max(1,Math.min(99,amount(span.textContent)+(button.textContent.trim()==='+'?1:-1)))}\n   var link=e.target.closest('.buy a,[data-dl-add]');if(link&&!e.defaultPrevented&&link.getAttribute('aria-disabled')!=='true'&&/cart(?:\\.|$)|#\\/cart/.test(link.getAttribute('href')||'')){var h=detail.querySelector('.pinfo h1'),price=detail.querySelector('.pinfo .price'),q=detail.querySelector('.qty span');if(h&&price){var chosen=Array.from(detail.querySelectorAll('.pinfo .chip.on,.pinfo .ok-finish [aria-pressed=true]')).map(function(b){return b.getAttribute('aria-label')||b.textContent.trim()}),name=h.textContent+(chosen.length?' · '+chosen.join(' / '):''),quantity=amount(q?q.textContent:1)||1,found=rows.find(function(r){return r.name===name});if(found)found.qty=Math.min(99,found.qty+quantity);else rows.push(item(name,amount(price.textContent),quantity));save();render()}}\n  });\n  render();\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script>","foot":"<footer data-dl-footer class=\"td-foot\"><div class=\"wrap\" style=\"padding-top:54px\"><div class=\"cols\"><div><div class=\"td-logo\" style=\"padding:0;color:inherit\"><span class=\"td-seal\" aria-hidden=\"true\">推</span><span><b>Wong Tuina</b><small style=\"color:var(--c-accent)\">Chinese Medical Massage</small></span></div><p style=\"margin-top:14px;opacity:.8;max-width:32ch\">Three generations of tuina practice, now in Kuala Lumpur. 三代推拿, 傳承至今.</p></div><div><h4>Clinic</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:services}}\">Treatments</a></li><li><a href=\"{{p:constitution}}\">Body constitution check</a></li><li><a href=\"{{p:conditions}}\">Conditions we treat</a></li><li><a href=\"{{p:master}}\">Master practitioner</a></li><li><a href=\"{{p:pricing}}\">Fees</a></li></ul></div><div><h4>Visit</h4><ul><li><a href=\"{{p:book}}\">Book a consultation</a></li><li><a href=\"{{p:stories}}\">Patient stories</a></li><li><a href=\"{{p:contact}}\">Visit the clinic</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div><div class=\"copy\" style=\"padding:22px 0\"><span>© 2026 Wong Tuina. Template demo content.</span></div></div><div class=\"wrap\"><details class=\"dl-credits\"><summary>Illustrative photography &amp; credits</summary><p>Stock references for layout demonstration; replace before customer launch. Remote images require internet access.</p><ul><li><a href=\"https://unsplash.com/photos/a-massage-room-is-clean-and-ready-for-a-session-oAvwAKFiU7Q\" target=\"_blank\" rel=\"noopener noreferrer\">A massage room is clean and ready for a session</a> — Jakub Klucký</li></ul><a href=\"https://unsplash.com/license\" target=\"_blank\" rel=\"noopener noreferrer\">Unsplash licence</a></details></div></footer>","pages":{"home":"<div tabindex=\"-1\" data-dl-content><section class=\"td-hero\"><span class=\"td-hanzi\" aria-hidden=\"true\">推拿</span><div class=\"in\"><div><span class=\"eyebrow\" style=\"color:var(--c-accent);letter-spacing:.4em\">Traditional Chinese medical massage</span><h1>Move the <em>qi.</em><br>Ease the pain.</h1><p>Three generations of tuina practice. Each treatment starts with pulse and tongue diagnosis, so the work fits your body, not a menu.</p><a class=\"td-btn\" href=\"{{p:book}}\">Book a consultation</a> &nbsp; <a class=\"td-btn o\" href=\"{{p:constitution}}\">Take the body check</a></div><div class=\"td-gate\"><div class=\"ph soft\" data-l=\"Master at work (缺图)\"></div></div></div></section><section class=\"dl-photo-story\" data-dl-photo-edition><div class=\"dl-photo-wrap\"><div class=\"dl-photo-head\"><h2>A quieter kind of care</h2><p>Space to pause, breathe and make time for yourself.</p></div><div class=\"dl-photo-grid\"><figure><div class=\"dl-visual\" style=\"aspect-ratio:3/2\"><img src=\"https://images.unsplash.com/photo-1745327883290-1e9c6447b938?auto=format&amp;fit=crop&amp;w=1920&amp;h=1280&amp;q=85\" alt=\"A massage room is clean and ready for a session\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span class=\"dl-stock-label\">Illustrative stock image</span></div><figcaption>A massage room is clean and ready for a session</figcaption></figure></div></div></section><section class=\"td-sec\"><div class=\"in\"><div class=\"td-ttl\"><small>Treatments · 療法</small><h2>Four ancient methods</h2></div><div class=\"td-grid\"><div class=\"td-card\"><div class=\"hz\">推</div><h3>Tuina massage</h3><p>Rolling, kneading and pressing along meridians to move qi and release tension.</p></div><div class=\"td-card\"><div class=\"hz\">灸</div><h3>Moxibustion</h3><p>Warming mugwort over acupoints for cold, stiff joints.</p></div><div class=\"td-card\"><div class=\"hz\">拔</div><h3>Cupping</h3><p>Suction cups to draw out stagnation in the back and shoulders.</p></div><div class=\"td-card\"><div class=\"hz\">刮</div><h3>Gua sha</h3><p>Gentle scraping to relieve neck and shoulder tightness.</p></div></div></div></section><section class=\"td-sec\" style=\"padding-top:0\"><div class=\"in\"><div class=\"td-prof\"><div class=\"ph soft\" data-l=\"Master Wong (缺图)\"></div><div><span class=\"eyebrow\">Master practitioner · 師傅</span><h2 style=\"font-weight:400;margin:10px 0\">Master Wong Kar Heng</h2><p>Replace with the practitioner’s lineage and approach. Third-generation tuina practitioner, trained at the Guangzhou University of Chinese Medicine.</p><div class=\"td-cred\"><div><b>32</b><span>Years practising</span></div><div><b>40k</b><span>Treatments</span></div><div><b>TCM</b><span>Registered</span></div></div><a class=\"td-btn\" href=\"{{p:master}}\">Meet the master</a></div></div></div></section><div class=\"td-q\"><blockquote>“Two years of back pain, and after four sessions I could finally garden again. He explained every point.”</blockquote><cite>— Madam Chong, 67</cite></div><section class=\"td-sec\"><div class=\"in\"><div class=\"td-ttl\"><small>Conditions · 病症</small><h2>What we commonly treat</h2></div><div class=\"td-grid\"><a class=\"td-card\" href=\"{{p:conditions}}\" style=\"text-decoration:none\"><div class=\"hz\">頸</div><h3 style=\"margin:0;font-size:18px\">Neck & shoulders</h3></a><a class=\"td-card\" href=\"{{p:conditions}}\" style=\"text-decoration:none\"><div class=\"hz\">腰</div><h3 style=\"margin:0;font-size:18px\">Lower back</h3></a><a class=\"td-card\" href=\"{{p:conditions}}\" style=\"text-decoration:none\"><div class=\"hz\">眠</div><h3 style=\"margin:0;font-size:18px\">Sleep</h3></a><a class=\"td-card\" href=\"{{p:conditions}}\" style=\"text-decoration:none\"><div class=\"hz\">頭</div><h3 style=\"margin:0;font-size:18px\">Headaches</h3></a><a class=\"td-card\" href=\"{{p:conditions}}\" style=\"text-decoration:none\"><div class=\"hz\">膝</div><h3 style=\"margin:0;font-size:18px\">Knee pain</h3></a><a class=\"td-card\" href=\"{{p:conditions}}\" style=\"text-decoration:none\"><div class=\"hz\">胃</div><h3 style=\"margin:0;font-size:18px\">Digestion</h3></a><a class=\"td-card\" href=\"{{p:conditions}}\" style=\"text-decoration:none\"><div class=\"hz\">疲</div><h3 style=\"margin:0;font-size:18px\">Fatigue</h3></a><a class=\"td-card\" href=\"{{p:conditions}}\" style=\"text-decoration:none\"><div class=\"hz\">產</div><h3 style=\"margin:0;font-size:18px\">Postnatal</h3></a></div></div></section></div>","services":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Treatments</b></div><h1>Treatments · 療法</h1></div></section><section class=\"td-sec\"><div class=\"in\"><div class=\"td-grid\"><div class=\"td-card\"><div class=\"hz\">推</div><h3>Tuina massage</h3><p>Rolling, kneading and pressing along meridians to move qi and release tension.</p></div><div class=\"td-card\"><div class=\"hz\">灸</div><h3>Moxibustion</h3><p>Warming mugwort over acupoints for cold, stiff joints.</p></div><div class=\"td-card\"><div class=\"hz\">拔</div><h3>Cupping</h3><p>Suction cups to draw out stagnation in the back and shoulders.</p></div><div class=\"td-card\"><div class=\"hz\">刮</div><h3>Gua sha</h3><p>Gentle scraping to relieve neck and shoulder tightness.</p></div></div></div></section></div>","constitution":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/