ight:44px}.qty button{min-width:44px}[data-dl-footer] .cols{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}[data-dl-footer] .cols>div:first-child{grid-column:1/-1}.pdp,.split{min-width:0}.pdp>*{min-width:0}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n</style><a class=\"dl-skip\" href=\"#dl-content\">Skip to content</a><style>\n/* Sprint Gear — tokens only */\n.sg-tick{background:var(--c-accent);color:var(--c-primary);overflow:hidden;border-bottom:3px solid var(--c-primary)}\n.sg-tick div{display:flex;gap:36px;width:max-content;white-space:nowrap;padding:7px 0;font:400 15px var(--f-head);letter-spacing:.12em;text-transform:uppercase;animation:sg-t 26s linear infinite}\n@keyframes sg-t{to{transform:translateX(-50%)}}\n.sg-head{background:var(--c-surface);border-bottom:3px solid var(--c-primary);position:sticky;top:0;z-index:40}\n.sg-head .in{max-width:var(--w);margin:auto;display:flex;align-items:center;gap:26px;padding:10px 20px}\n.sg-logo{font:400 38px/1 var(--f-head);text-transform:uppercase;text-decoration:none;font-style:italic;transform:skew(-8deg);display:inline-block;background:var(--c-primary);color:var(--c-accent);padding:.05em .4em}\n.sg-head ul{display:flex;gap:6px;list-style:none;margin-left:auto;font:700 14px var(--f-body);text-transform:uppercase;letter-spacing:.04em}\n.sg-head ul>li>a{display:block;padding:.55em 1em;text-decoration:none;border:3px solid transparent;transform:skew(-8deg)}\n.sg-head ul>li>a:hover{border-color:var(--c-primary);background:var(--c-accent)}\n.sg-cart{background:var(--c-secondary);color:var(--c-surface);padding:.55em 1.1em;font:700 14px var(--f-body);text-transform:uppercase;text-decoration:none;border:3px solid var(--c-primary);box-shadow:4px 4px 0 var(--c-primary);transform:skew(-8deg)}\n.sg-head .more{position:relative}\n.sg-hero{position:relative;backgro