lay:block;font-size:.5em;color:var(--c-secondary);letter-spacing:.2em;margin-top:10px;font-weight:600}\n.hb-hero p{font:400 17px/1.8 var(--f-body);max-width:42ch;margin:18px 0 24px}\n.hb-cab{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;padding:12px;background:color-mix(in srgb,var(--c-secondary) 35%,var(--c-surface));border:3px solid var(--c-secondary);border-radius:10px;box-shadow:inset 0 0 0 2px color-mix(in srgb,var(--c-secondary) 55%,#000)}\n.hb-dr{aspect-ratio:1.25;background:color-mix(in srgb,var(--c-secondary) 15%,var(--c-surface));border:2px solid color-mix(in srgb,var(--c-secondary) 70%,#000);border-radius:4px;display:grid;place-items:center;font:700 clamp(14px,2.2vw,22px) var(--f-head);color:var(--c-text);position:relative;transition:translate .2s,background .2s;cursor:default}\n.hb-dr::after{content:\"\";position:absolute;width:30%;height:3px;border-radius:3px;background:color-mix(in srgb,var(--c-secondary) 70%,#000);bottom:12%}\n.hb-dr:hover{translate:0 -4px;background:var(--c-accent);color:var(--c-surface)}\n.hb-sec{padding:var(--pad) 20px}.hb-sec>.in{max-width:var(--w);margin:auto}\n.hb-ttl{margin-bottom:30px}.hb-ttl small{font:700 12px var(--f-body);letter-spacing:.2em;text-transform:uppercase;color:var(--c-accent)}.hb-ttl h2{margin-top:6px}\n.hb-flow{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--c-border)}\n.hb-flow>div{padding:22px;border-right:1px solid var(--c-border)}.hb-flow>div:last-child{border:0}\n.hb-flow b{font:700 36px var(--f-head);color:var(--c-accent)}.hb-flow h3{font:700 18px var(--f-head);margin:4px 0}\n.hb-cond{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}\n.hb-cd{border:1px solid var(--c-border);border-radius:8px;padding:16px;background:var(--c-surface);text-decoration:none}\n.hb-cd b{font:700 30px var(--f-head);color:var(--c-primary);display:block}.hb-cd span{font:600 15px var(--f-body)}\n.hb-pr{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.hb-pr .ph{aspect-rat