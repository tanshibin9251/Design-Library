ate:-50% 0;background:var(--c-surface);color:var(--c-accent);padding:0 14px;font-size:16px}\n.hl-frame::before{top:-12px}.hl-frame::after{bottom:-12px}\n.hl-hero{padding:clamp(30px,5vw,70px) 20px}\n.hl-hero h1{font-size:clamp(46px,8vw,var(--h1));font-weight:400;line-height:1;letter-spacing:.01em}\n.hl-hero h1 i{color:var(--c-accent)}\n.hl-hero p{max-width:52ch;margin:20px auto 30px;font:italic 400 20px/1.6 var(--f-head)}\n.hl-rule{display:flex;align-items:center;gap:18px;color:var(--c-accent);margin:26px auto;max-width:360px}\n.hl-rule::before,.hl-rule::after{content:\"\";flex:1;height:1px;background:currentColor}\n.hl-btn{display:inline-block;padding:1em 2.4em;border:1px solid var(--c-accent);font:500 12px var(--f-body);letter-spacing:.28em;text-transform:uppercase;text-decoration:none;background:var(--c-accent);color:var(--c-surface)}\n.hl-btn.o{background:none;color:var(--c-text)}.hl-btn:hover{background:var(--c-primary);border-color:var(--c-primary);color:var(--on-primary)}\n.hl-sec{padding:var(--pad) 0}\n.hl-title{text-align:center;margin-bottom:46px}\n.hl-title .num{font:400 13px var(--f-body);letter-spacing:.4em;color:var(--c-accent);text-transform:uppercase}\n.hl-title h2{font-weight:400;margin-top:10px}\n.hl-col{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--c-border)}\n.hl-col a{padding:24px 24px 30px;text-align:center;text-decoration:none;border-right:1px solid var(--c-border);display:block}\n.hl-col a:last-child{border-right:0}\n.hl-col .roman{font:400 38px var(--f-head);color:var(--c-accent);margin:18px 0 4px}\n.hl-col h3{font-weight:400;letter-spacing:.06em;text-transform:uppercase;font-size:22px}\n.hl-col p{font:italic 400 17px var(--f-head);opacity:.75;margin-top:6px}\n.hl-col .ph{aspect-ratio:3/4;border-radius:0}\n.hl-bespoke{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--c-primary)}\n.hl-bespoke>div{padding:clamp(30px,5vw,70px)}\n.hl-bespoke .d{background:var(--c-primary);color:var(--on-primary)}.hl