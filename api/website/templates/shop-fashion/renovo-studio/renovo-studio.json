ext);max-width:100%}.dl-feedback{border-left:4px solid var(--c-accent);margin-block:12px}.dl-feedback[hidden]{display:none}\n.dl-visual{position:relative;isolation:isolate;overflow:hidden;background:var(--c-border)}.dl-visual:before,.dl-visual:after{display:none!important}.dl-visual>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1}.dl-visual>span{position:relative;z-index:1}.dl-photo-failed>img{display:none}.dl-photo-failed:after{display:grid!important;position:absolute;inset:0;place-items:center;content:'Image unavailable · 缺图';padding:16px;background:var(--c-surface);color:var(--c-text);font:500 14px var(--f-body)}\n.dl-stock-label{position:absolute;left:10px;bottom:10px;padding:4px 8px;max-width:calc(100% - 20px);background:var(--c-surface);color:var(--c-text);font-size:11px;line-height:1.5;border-radius:4px}.dl-credits{padding:20px 0;font-size:13px}.dl-credits summary{cursor:pointer;min-height:44px;display:flex;align-items:center}.dl-credits li{margin-block:8px}.dl-credits a{overflow-wrap:anywhere}\n:where(button,a,input,select,textarea,summary):focus-visible{outline:3px solid var(--c-accent);outline-offset:4px}\n@media(max-width:820px){.dl-mobile{display:block;position:relative}.dl-mobile summary{display:flex;align-items:center;justify-content:center;min-width:64px;min-height:44px;padding:8px 12px;border:1px solid var(--c-border);border-radius:var(--radius);cursor:pointer;list-style:none;font:600 14px var(--f-body)}.dl-mobile summary::-webkit-details-marker{display:none}.dl-mobile-links{position:fixed;top:74px;left:12px;right:12px;z-index:9999;max-height:75dvh;overflow:auto;background:var(--c-surface);color:var(--c-text);padding:16px 20px;border:1px solid var(--c-border);border-radius:var(--radius);box-shadow:0 16px 40px #0002}.dl-mobile-links a{display:flex;align-items:center;min-height:44px;text-decoration:none}.dl-mobile-links h4{font-size:12px;margin:18px 0 4px;color:var(--c-secondary)}.burger summary,.bmenu a{min-height:44px}.burger summary{display:flex;align-items:center}.burger:not([open])>.bmenu{display:none}.btn,.chip,.qty button{min-height:44px}.qty button{min-width:44px}[data-dl-footer] .cols{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}[data-dl-footer] .cols>div:first-child{grid-column:1/-1}.pdp,.split{min-width:0}.pdp>*{min-width:0}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n</style><a class=\"dl-skip\" href=\"#dl-content\">Skip to content</a><style>\n/* Renovo Studio — editorial, tokens only */\n.rv-head{position:sticky;top:0;z-index:40;background:var(--c-surface);border-bottom:1px solid var(--c-text)}\n.rv-head .in{max-width:var(--w);margin:auto;display:flex;justify-content:space-between;align-items:baseline;padding:16px 20px}\n.rv-logo{font:italic 500 28px var(--f-head);text-decoration:none;letter-spacing:-.01em}\n.rv-logo sup{font:600 10px var(--f-body);letter-spacing:.2em;text-transform:uppercase;margin-left:8px;color:var(--c-accent);font-style:normal}\n.rv-head ul{display:flex;gap:30px;list-style:none;font:500 13px var(--f-body);letter-spacing:.14em;text-transform:uppercase}\n.rv-head ul a{text-decoration:none}.rv-head ul a:hover{color:var(--c-accent)}\n.rv-mast{max-width:var(--w);margin:auto;padding:0 20px}\n.rv-hero{padding:clamp(30px,5vw,70px) 0 0;display:grid;grid-template-columns:1fr;gap:20px}\n.rv-hero .kick{display:flex;justify-content:space-between;font:500 12px var(--f-body);letter-spacing:.22em;text-transform:uppercase;border-bottom:1px solid var(--c-text);padding-bottom:10px}\n.rv-hero h1{font-size:clamp(54px,11.5vw,var(--h1));font-weight:500;line-height:.9;letter-spacing:-.03em;max-width:12ch}\n.rv-hero h1 em{color:var(--c-accent)}\n.rv-collage{display:grid;grid-template-columns:repeat(12,1fr);gap:14px;margin-top:16px}\n.rv-collage .ph{border-radius:0}\n.rv-c1{grid-column:1/8;aspect-ratio:4/3}.rv-c2{grid-column:8/13;aspect-ratio:4/5;margin-top:60px}.rv-c3{grid-column:1/5;aspect-ratio:1}\n.rv-intro{grid-column:5/13;align-self:center;padding:0 0 0 30px;font:400 clamp(20px,2.2vw,28px)/1.35 var(--f-head)}\n.rv-intro span{display:block;font:500 12px var(--f-body);letter-spacing:.18em;text-transform:uppercase;margin-bottom:12px;color:var(--c-accent)}\n.rv-idx{display:grid;grid-template-columns:220px 1fr;gap:40px;padding:var(--pad) 0 0}\n.rv-idx aside{position:sticky;top:90px;align-self:start}\n.rv-idx aside h2{font-size:clamp(34px,4vw,56px);font-weight:500;line-height:1}\n.rv-idx aside p{font:500 13px var(--f-body);margin-top:14px;opacity:.7}\n.rv-case{display:grid;grid-template-columns:1.4fr 1fr;gap:26px;padding:28px 0;border-top:1px solid var(--c-text);text-decoration:none}\n.rv-case:hover h3{color:var(--c-accent)}\n.rv-case .n{font:italic 500 18px var(--f-head);color:var(--c-accent)}\n.rv-case h3{font-size:clamp(28px,3.4vw,50px);font-weight:500;line-height:1;margin:8px 0 12px;transition:color .2s}\n.rv-case dl{display:grid;grid-template-columns:auto 1fr;gap:4px 18px;font:500 13px var(--f-body)}\n.rv-case dt{opacity:.55;text-transform:uppercase;letter-spacing:.14em;font-size:11px;padding-top:2px}\n.rv-ba{position:relative;aspect-ratio:3/2;overflow:hidden;--p:50%}\n.rv-ba .ph{position:absolute;inset:0;border-radius:0;height:100%}\n.rv-ba .af{clip-path:inset(0 0 0 var(--p))}\n.rv-ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}\n.rv-ba .ln{position:absolute;top:0;bottom:0;left:var(--p);width:2px;background:var(--c-surface)}\n.rv-ba .ln::after{content:\"↔\";position:absolute;top:50%;left:50%;translate:-50% -50%;width:42px;height:42px;border-radius:50%;background:var(--c-surface);display:grid;place-items:center;font-weight:700}\n.rv-ba .tg{position:absolute;bottom:12px;background:var(--c-surface);padding:.2em .8em;font:600 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase}\n.rv-quote{padding:var(--pad) 0;text-align:center;max-width:900px;margin:auto}\n.rv-quote blockquote{font:italic 400 clamp(28px,4vw,52px)/1.2 var(--f-head)}\n.rv-quote cite{display:block;margin-top:20px;font:500 12px var(--f-body);letter-spacing:.2em;text-transform:uppercase;font-style:normal}\n.rv-fee{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--c-text)}\n.rv-fee>div{padding:30px;border-right:1px solid var(--c-text)}.rv-fee>div:last-child{border:0}\n.rv-fee .big{font:500 clamp(36px,4vw,56px)/1 var(--f-head);margin:14px 0}\n.rv-fee small{font:600 11px var(--f-body);letter-spacing:.18em;text-transform:uppercase;color:var(--c-accent)}\n.rv-foot{background:var(--c-primary);color:var(--on-primary);margin-top:60px}\n.rv-foot .big{font:italic 500 clamp(60px,15vw,240px)/.85 var(--f-head);padding:50px 0 0;opacity:.9}\n@media(max-width:900px){.rv-head ul{display:none}.rv-idx,.rv-case,.rv-fee{grid-template-columns:1fr}.rv-fee>div{border-right:0;border-bottom:1px solid var(--c-text)}.rv-idx aside{position:static}.rv-c1,.rv-c2,.rv-c3,.rv-intro{grid-column:1/13;margin:0;padding:0}}\n.rv-head .more{position:relative}.rv-head .dd{position:absolute;right:0;top:100%;display:none;grid-template-columns:repeat(3,minmax(130px,1fr));gap:20px 30px;padding:22px 26px;background:var(--c-surface);color:var(--c-text);border:1px solid var(--c-border);min-width:500px;z-index:60;text-align:left;font-family:var(--f-body);text-transform:none;letter-spacing:0;font-style:normal;border-radius:0;}.rv-head .more:hover .dd,.rv-head .more:focus-within .dd{display:grid}.rv-head .dd h4{font:700 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;margin:0 0 8px;opacity:.55;color:inherit}.rv-head .dd a{display:block;padding:4px 0;font:500 14px var(--f-body);text-transform:none;letter-spacing:0;border:0;height:auto;opacity:.85;color:inherit;text-decoration:none;background:none;transform:none}.rv-head .dd a:hover{color:var(--c-accent);opacity:1}\nh1,h2,h3,h4{color:var(--c-text)}/* m-fix */html,body{overflow-x:clip}img,video,svg{max-width:100%}@media(max-width:700px){.rv-hero h1{font-size:clamp(40px,12.5vw,64px)}.rv-collage{gap:10px}.rv-c2{margin-top:0}.rv-intro{font-size:19px}.rv-case h3{font-size:28px}.rv-foot .big{font-size:20vw}}</style><header class=\"rv-head\"><div class=\"in\"><a class=\"rv-logo\" href=\"{{p:home}}\">Renovo<sup>Studio</sup></a><ul><li><a href=\"{{p:projects}}\">Projects</a></li><li><a href=\"{{p:services}}\">Services</a></li><li><a href=\"{{p:investment}}\">Investment</a></li><li><a href=\"{{p:about}}\">Studio</a></li><li class=\"more\"><a href=\"#\" tabindex=\"0\">Index</a><div class=\"dd\"><div><h4>Studio</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:projects}}\">Projects</a><a href=\"{{p:project}}\">Case study</a><a href=\"{{p:services}}\">Services</a><a href=\"{{p:process}}\">How we work</a><a href=\"{{p:investment}}\">Investment guide</a><a href=\"{{p:about}}\">The studio</a></div><div><h4>Contact</h4><a href=\"{{p:visit}}\">Book a site visit</a><a href=\"{{p:journal}}\">Notes</a><a href=\"{{p:faq}}\">FAQ</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li><li><a href=\"{{p:visit}}\" style=\"color:var(--c-accent)\">Book a visit →</a></li></ul><details class=\"dl-mobile\"><summary>Menu</summary><nav class=\"dl-mobile-links\" aria-label=\"Template pages\"><h4>Studio</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:projects}}\">Projects</a><a href=\"{{p:project}}\">Case study</a><a href=\"{{p:services}}\">Services</a><a href=\"{{p:process}}\">How we work</a><a href=\"{{p:investment}}\">Investment guide</a><a href=\"{{p:about}}\">The studio</a><h4>Contact</h4><a href=\"{{p:visit}}\">Book a site visit</a><a href=\"{{p:journal}}\">Notes</a><a href=\"{{p:faq}}\">FAQ</a><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a></nav></details></div></header><script>/* Runs in previews AND exported files. No requests, credentials or submissions. */\n(function(){\n 'use strict';\n function start(){\n  var root=document.querySelector('[data-dl-template]');if(!root)return;\n  document.querySelectorAll('[data-dl-demo-form]').forEach(function(form,index){\n   if(form.dataset.dlBound)return;form.dataset.dlBound='1';\n   var note=document.createElement('p');note.className='dl-form-note';note.textContent='Interactive demo · Nothing is sent. Use sample details only. No account, booking or payment will be created.';form.prepend(note);\n   var result=document.createElement('p');result.className='dl-feedback';result.setAttribute('role','status');result.setAttribute('aria-live','polite');result.hidden=true;form.append(result);\n   form.querySelectorAll('input,textarea,select').forEach(function(input,i){\n    if(!input.name)input.name='demo-'+index+'-'+i;\n    var label=input.closest('label'),text=(label?label.textContent:input.placeholder||'').toLowerCase();\n    if(/name|email|message|date|time/.test(text)&&!/optional/.test(text))input.required=true;\n    if(input.type==='password')input.autocomplete='new-password';\n    if(/card number|cvc|expiry/.test(text)){input.disabled=true;input.placeholder='Disabled in demo';}\n   });\n   function submit(e){if(e)e.preventDefault();if(!form.reportValidity())return;result.hidden=false;result.textContent='Demo complete. Your entries passed the browser checks. Nothing was sent, charged, booked or stored.';}\n   form.addEventListener('submit',submit);\n   if(!form.querySelector('[type=\"submit\"],button:not([type])')){var buttons=form.querySelectorAll('button[type=\"button\"]');if(buttons.length===1)buttons[0].addEventListener('click',submit);}\n  });\n  document.querySelectorAll('.dl-visual img').forEach(function(img){img.addEventListener('error',function(){img.parentElement.classList.add('dl-photo-failed')});if(img.complete&&!img.naturalWidth)img.parentElement.classList.add('dl-photo-failed')});\n  document.querySelectorAll('.shoptop').forEach(function(top){\n   var grid=top.nextElementSibling;if(!grid||!grid.matches('.products'))return;\n   var cards=Array.from(grid.children),chips=Array.from(top.querySelectorAll('.chip')),sort=top.querySelector('select'),category='All';\n   var empty=document.createElement('p');empty.className='dl-filter-empty';empty.textContent='No sample items match this category. Choose All to see the collection.';empty.hidden=true;grid.after(empty);\n   function update(){var shown=0;cards.forEach(function(card){var tag=card.querySelector('small');card.hidden=category!=='All'&&(!tag||tag.textContent.trim()!==category);if(!card.hidden)shown++});empty.hidden=shown!==0;var count=top.querySelector('.sort span');if(count)count.textContent=shown+' sample items';}\n   chips.forEach(function(chip){chip.type='button';chip.setAttribute('aria-pressed',chip.classList.contains('on'));chip.addEventListener('click',function(){category=chip.textContent.trim();chips.forEach(function(c){c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',c===chip)});update()})});\n   if(sort){sort.setAttribute('aria-label','Sort sample items');Array.from(sort.options).forEach(function(o){if(/newest/i.test(o.textContent))o.textContent='Reverse featured'});sort.addEventListener('change',function(){var ordered=cards.slice();if(sort.selectedIndex===1||sort.selectedIndex===2){ordered.sort(function(a,b){function price(c){var p=c.querySelector('.price');return Number((p?p.textContent:'').replace(/[^0-9.]/g,''))||0}return price(a)-price(b)});if(sort.selectedIndex===2)ordered.reverse()}else if(sort.selectedIndex===3)ordered.reverse();ordered.forEach(function(card){grid.append(card)})})}\n  });\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.burger[open],.dl-mobile[open],.nav details[open]').forEach(function(menu){menu.open=false;var summary=menu.querySelector('summary');if(summary)summary.focus()})});\n  document.addEventListener('click',function(e){var a=e.target.closest('.dl-mobile a,.bmenu a');if(a){var menu=a.closest('details');if(menu)menu.open=false;}});\n  document.querySelectorAll('.more>a[href=\"#\"]').forEach(function(a){a.setAttribute('role','button');a.setAttribute('aria-expanded','false');function set(open){a.parentElement.classList.toggle('dl-menu-open',open);a.setAttribute('aria-expanded',open)}function toggle(e){e.preventDefault();set(a.getAttribute('aria-expanded')!=='true')}a.addEventListener('click',toggle);a.addEventListener('keydown',function(e){if(e.key===' ')toggle(e)});a.parentElement.addEventListener('mouseenter',function(){set(true)});a.parentElement.addEventListener('mouseleave',function(){if(!a.parentElement.contains(document.activeElement))set(false)})});\n  document.addEventListener('click',function(e){var a=e.target.closest('a[href=\"#\"]');if(!a||e.defaultPrevented||a.onclick||a.closest('.more'))return;e.preventDefault();var note=a.parentElement.querySelector(':scope>.dl-missing-link');if(!note){note=document.createElement('p');note.className='dl-feedback dl-missing-link';note.setAttribute('role','status');a.after(note)}note.textContent='Demonstration link. Add the real destination before launching this site.'});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')document.querySelectorAll('.dl-menu-open').forEach(function(menu){menu.classList.remove('dl-menu-open');var a=menu.querySelector(':scope>a');if(a){a.setAttribute('aria-expanded','false');a.focus()}})});\n  document.querySelectorAll('.dl-skip').forEach(function(link){link.addEventListener('click',function(e){e.preventDefault();var target=document.querySelector('main.on [data-dl-content],main:not([data-page]) [data-dl-content]');if(target){target.focus();target.scrollIntoView({block:'start'})}})});\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script><script>/* Sample commerce only: local item choices, quantities and consistent totals. */\n(function(){\n 'use strict';\n function start(){\n  var marker=document.querySelector('[data-dl-template]');if(!marker||marker.dataset.dlTemplate==='restaurant-warm')return;\n  var carts=Array.from(document.querySelectorAll('.cart')).filter(function(x){return x.querySelector('.crow')}),details=Array.from(document.querySelectorAll('.pdp,[data-dl-product]')).filter(function(x){return x.querySelector('.pinfo .price')}),checkouts=Array.from(document.querySelectorAll('aside.side-card')).filter(function(x){return x.querySelector('.kv')&&x.previousElementSibling&&x.previousElementSibling.querySelector('form')});\n  if(!carts.length&&!details.length&&!checkouts.length)return;\n  var currency='RM ',rows=[],key='dl-sample-cart:'+marker.dataset.dlTemplate;\n  function amount(text){return Number(String(text).replace(/[^0-9.]/g,''))||0}\n  function money(n){return currency+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function item(name,price,qty){return {name:String(name).slice(0,120),price:Math.max(0,Math.min(10000000,price)),qty:Math.max(1,Math.min(99,qty))}}\n  if(carts.length){rows=Array.from(carts[0].querySelectorAll('.crow')).map(function(row){var p=row.querySelector(':scope>b'),h=row.querySelector('h3'),q=row.querySelector('.qty span');if(p){currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' '}return item(h?h.textContent:'Sample item',amount(p?p.textContent:0),amount(q?q.textContent:1)||1)})}\n  else if(checkouts.length){rows=Array.from(checkouts[0].querySelectorAll('.kv li:not(.tot)')).filter(function(row){return row.querySelector('b')&&amount(row.querySelector('b').textContent)>0&&!/tax|shipping|delivery|subtotal|fee/i.test(row.textContent)}).map(function(row){var p=row.querySelector('b');currency=p.textContent.replace(/[0-9.,\\s]/g,'')+' ';return item(row.querySelector('span').textContent,amount(p.textContent),1)})}\n  try{var saved=JSON.parse(localStorage.getItem(key));if(saved&&Array.isArray(saved.rows)&&saved.rows.length<=100){rows=saved.rows.filter(function(r){return typeof r.name==='string'&&Number.isFinite(r.price)&&r.price>=0&&Number.isInteger(r.qty)&&r.qty>0&&r.qty<=99}).map(function(r){return item(r.name,r.price,r.qty)});if(typeof saved.currency==='string'&&/^[A-Z$€£¥ ]{1,8}$/.test(saved.currency))currency=saved.currency;}}catch(e){}\n  function save(){try{localStorage.setItem(key,JSON.stringify({currency:currency,rows:rows}))}catch(e){}}\n  function totals(){var sub=rows.reduce(function(sum,r){return sum+r.price*r.qty},0);return {subtotal:sub,total:sub}}\n  function makeLine(label,value,total){var li=document.createElement('li');if(total)li.className='tot';var span=document.createElement('span'),b=document.createElement('b');span.textContent=label;b.textContent=value;li.append(span,b);return li}\n  function render(){\n   document.querySelectorAll('header a[href]').forEach(function(a){var match=a.textContent.trim().match(/^(Cart|Bag)\\s*\\(\\d+\\)$/i);if(match)a.textContent=match[1]+' ('+rows.reduce(function(sum,r){return sum+r.qty},0)+')'});\n   carts.forEach(function(cart){cart.querySelectorAll('.crow,.dl-cart-empty').forEach(function(r){r.remove()});rows.forEach(function(row,i){var el=document.createElement('div');el.className='crow';el.dataset.dlCartRow=i;var spacer=document.createElement('div'),info=document.createElement('div'),h=document.createElement('h3'),small=document.createElement('small');h.textContent=row.name;small.textContent=money(row.price)+' each · sample item';info.append(h,small);var qty=document.createElement('div');qty.className='qty';[-1,1].forEach(function(change){var b=document.createElement('button');b.type='button';b.dataset.dlCartChange=change;b.textContent=change<0?'−':'+';b.setAttribute('aria-label',(change<0?'Decrease ':'Increase ')+row.name);if(change>0){var value=document.createElement('span');value.textContent=row.qty;qty.append(value)}qty.append(b)});var price=document.createElement('b');price.textContent=money(row.price*row.qty);var remove=document.createElement('button');remove.type='button';remove.className='btn ghost';remove.dataset.dlCartRemove='';remove.textContent='Remove';remove.setAttribute('aria-label','Remove '+row.name);el.append(spacer,info,qty,price,remove);cart.insertBefore(el,cart.querySelector(':scope>a'))});if(!rows.length){var empty=document.createElement('p');empty.className='dl-cart-empty';empty.setAttribute('role','status');empty.textContent='Your sample cart is empty. Browse the collection to add an item.';cart.prepend(empty)}var aside=cart.parentElement.querySelector('aside.side-card');if(aside){var list=aside.querySelector('.kv');if(list){list.replaceChildren(makeLine('Subtotal',money(totals().subtotal)),makeLine('Demo delivery / fees','Not applied'),makeLine('Total',money(totals().total),true))}var note=aside.querySelector('p');if(note)note.textContent='Local sample cart. Real delivery, tax and payment must be configured before launch.'}});\n   checkouts.forEach(function(aside){var list=aside.querySelector('.kv');list.replaceChildren();rows.forEach(function(r){list.append(makeLine(r.qty+' × '+r.name,money(r.price*r.qty)))});list.append(makeLine('Total · demo only',money(totals().total),true));var form=aside.parentElement.querySelector('form'),button=form&&form.querySelector('[type=submit]');if(button){button.textContent=rows.length?'Preview checkout · '+money(totals().total):'Add an item before checkout';button.disabled=!rows.length}});\n  }\n  details.forEach(function(detail){detail.querySelectorAll('.qty button').forEach(function(b){b.type='button';b.setAttribute('aria-label',b.textContent.trim()==='+'?'Increase quantity':'Decrease quantity')});detail.querySelectorAll('.chips .chip').forEach(function(b){b.type='button';b.setAttribute('aria-pressed',b.classList.contains('on'));b.addEventListener('click',function(){b.parentElement.querySelectorAll('.chip').forEach(function(x){x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)})})})});\n  document.addEventListener('click',function(e){var row=e.target.closest('[data-dl-cart-row]');if(row){var index=Number(row.dataset.dlCartRow),change=e.target.closest('[data-dl-cart-change]');if(e.target.closest('[data-dl-cart-remove]'))rows.splice(index,1);else if(change&&rows[index])rows[index].qty=Math.max(1,Math.min(99,rows[index].qty+Number(change.dataset.dlCartChange)));save();render();return}\n   var detail=e.target.closest('.pdp,[data-dl-product]');if(!detail)return;var button=e.target.closest('.qty button');if(button&&!button.onclick){var span=button.parentElement.querySelector('span');if(span)span.textContent=Math.max(1,Math.min(99,amount(span.textContent)+(button.textContent.trim()==='+'?1:-1)))}\n   var link=e.target.closest('.buy a,[data-dl-add]');if(link&&!e.defaultPrevented&&link.getAttribute('aria-disabled')!=='true'&&/cart(?:\\.|$)|#\\/cart/.test(link.getAttribute('href')||'')){var h=detail.querySelector('.pinfo h1'),price=detail.querySelector('.pinfo .price'),q=detail.querySelector('.qty span');if(h&&price){var chosen=Array.from(detail.querySelectorAll('.pinfo .chip.on,.pinfo .ok-finish [aria-pressed=true]')).map(function(b){return b.getAttribute('aria-label')||b.textContent.trim()}),name=h.textContent+(chosen.length?' · '+chosen.join(' / '):''),quantity=amount(q?q.textContent:1)||1,found=rows.find(function(r){return r.name===name});if(found)found.qty=Math.min(99,found.qty+quantity);else rows.push(item(name,amount(price.textContent),quantity));save();render()}}\n  });\n  render();\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();\n})();\n</script>","foot":"<footer data-dl-footer class=\"rv-foot\"><div class=\"rv-mast\" style=\"padding-top:60px\"><div class=\"cols\"><div><p style=\"max-width:34ch;opacity:.8;font:italic 22px/1.3 var(--f-head)\">Renovations designed and built under one roof, for homes that deserve to be lived in.</p></div><div><h4>Studio</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:projects}}\">Projects</a></li><li><a href=\"{{p:project}}\">Case study</a></li><li><a href=\"{{p:services}}\">Services</a></li><li><a href=\"{{p:process}}\">How we work</a></li><li><a href=\"{{p:investment}}\">Investment guide</a></li><li><a href=\"{{p:about}}\">The studio</a></li></ul></div><div><h4>Contact</h4><ul><li><a href=\"{{p:visit}}\">Book a site visit</a></li><li><a href=\"{{p:journal}}\">Notes</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div><div class=\"big\" aria-hidden=\"true\">Renovo</div><div class=\"copy\" style=\"padding:18px 0\"><span>© 2026 Renovo Studio · Licensed contractor CIDB G5. Template demo content.</span></div></div><div class=\"wrap\"><details class=\"dl-credits\"><summary>Illustrative photography &amp; credits</summary><p>Stock references for layout demonstration; replace before customer launch. Remote images require internet access.</p><ul><li><a href=\"https://unsplash.com/photos/a-living-room-filled-with-furniture-and-a-large-window-hGFu6Wbu7Lw\" target=\"_blank\" rel=\"noopener noreferrer\">Living room with a sofa and coffee table</a> — Blake Wisz</li><li><a href=\"https://unsplash.com/photos/wooden-dining-table-and-chairs-in-sunlit-room-bcaFHquzu3M\" target=\"_blank\" rel=\"noopener noreferrer\">Wooden dining table and chairs in a sunlit room</a> — Clay Banks</li></ul><a href=\"https://unsplash.com/license\" target=\"_blank\" rel=\"noopener noreferrer\">Unsplash licence</a></details></div></footer>","pages":{"home":"<div tabindex=\"-1\" data-dl-content><div class=\"rv-mast\"><section class=\"rv-hero\"><div class=\"kick\"><span>Issue 07 — Residential renovation</span><span>Kuala Lumpur · Penang</span></div><h1>We rebuild homes <em>around</em> the way you live.</h1><div class=\"rv-collage\"><div class=\"ph soft rv-c1 dl-visual\" data-l=\"Illustrative stock reference\" data-dl-photo-edition><img src=\"https://images.unsplash.com/photo-1639422947517-8910fd782193?auto=format&amp;fit=crop&amp;w=1920&amp;h=1280&amp;q=85\" alt=\"Living room with a sofa and coffee table\" width=\"1920\" height=\"1280\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\"><span class=\"dl-stock-label\">Illustrative stock image</span></div><div class=\"ph soft rv-c2\" data-l=\"Detail\"></div><div class=\"ph soft rv-c3\" data-l=\"Detail\"></div><p class=\"rv-intro\"><span>Design + build</span>One team from first sketch to final snag list. Fixed fees, weekly site reports, and no surprises on the invoice.</p></div></section><section class=\"dl-photo-story\" data-dl-photo-edition><div class=\"dl-photo-wrap\"><div class=\"dl-photo-head\"><h2>Made for everyday living</h2><p>Natural textures, considered spaces and room to slow down.</p></div><div class=\"dl-photo-grid\"><figure><div class=\"dl-visual\" style=\"aspect-ratio:3/2\"><img src=\"https://images.unsplash.com/photo-1773847521422-77ff84e29353?auto=format&amp;fit=crop&amp;w=1920&amp;h=1280&amp;q=85\" alt=\"Wooden dining table and chairs in a sunlit room\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span class=\"dl-stock-label\">Illustrative stock image</span></div><figcaption>Wooden dining table and chairs in a sunlit room</figcaption></figure></div></div></section><section class=\"rv-idx\"><aside><h2>Selected work</h2><p>Four of 62 projects completed since 2014.<br><a href=\"{{p:projects}}\" style=\"color:var(--c-accent)\">View all →</a></p></aside><div><a class=\"rv-case\" href=\"{{p:project}}\"><div class=\"ph soft\" data-l=\"The Bangsar Terrace\" style=\"aspect-ratio:3/2;border-radius:0\"></div><div><span class=\"n\">01</span><h3>The Bangsar Terrace</h3><dl><dt>Scope</dt><dd>Full-house renovation</dd><dt>Area</dt><dd>3,200 sq ft</dd><dt>Location</dt><dd>Kuala Lumpur</dd><dt>Duration</dt><dd>5 months</dd></dl></div></a><a class=\"rv-case\" href=\"{{p:project}}\"><div class=\"ph soft\" data-l=\"Casa Sentul\" style=\"aspect-ratio:3/2;border-radius:0\"></div><div><span class=\"n\">02</span><h3>Casa Sentul</h3><dl><dt>Scope</dt><dd>Kitchen + living</dd><dt>Area</dt><dd>1,100 sq ft</dd><dt>Location</dt><dd>Kuala Lumpur</dd><dt>Duration</dt><dd>10 weeks</dd></dl></div></a><a class=\"rv-case\" href=\"{{p:project}}\"><div class=\"ph soft\" data-l=\"Taman Desa Loft\" style=\"aspect-ratio:3/2;border-radius:0\"></div><div><span class=\"n\">03</span><h3>Taman Desa Loft</h3><dl><dt>Scope</dt><dd>Condo conversion</dd><dt>Area</dt><dd>1,800 sq ft</dd><dt>Location</dt><dd>Kuala Lumpur</dd><dt>Duration</dt><dd>4 months</dd></dl></div></a><a class=\"rv-case\" href=\"{{p:project}}\"><div class=\"ph soft\" data-l=\"Penang Shophouse\" style=\"aspect-ratio:3/2;border-radius:0\"></div><div><span class=\"n\">04</span><h3>Penang Shophouse</h3><dl><dt>Scope</dt><dd>Heritage restoration</dd><dt>Area</dt><dd>2,600 sq ft</dd><dt>Location</dt><dd>George Town</dd><dt>Duration</dt><dd>7 months</dd></dl></div></a></div></section></div><section class=\"rv-quote\"><blockquote>“They found the leak the previous contractor never did, then rebuilt the bathroom around it.”</blockquote><cite>Dr. Lim, Bangsar Terrace</cite></section><section class=\"sec\" style=\"padding-top:0\"><div class=\"rv-mast\"><div class=\"head\"><div><span class=\"eyebrow\">Before / after</span><h2>Drag to compare</h2></div></div><div class=\"rv-ba\" onpointermove=\"this.style.setProperty('--p',this.querySelector('input').value+'%')\"><div class=\"ph soft bf\" data-l=\"\" style=\"filter:grayscale(1) brightness(.85)\"></div><div class=\"ph soft af\" data-l=\"\"></div><span class=\"ln\"></span><span class=\"tg\" style=\"left:12px\">Before</span><span class=\"tg\" style=\"right:12px\">After</span><input type=\"range\" min=\"0\" max=\"100\" value=\"50\" aria-label=\"Before and after slider\" oninput=\"this.parentNode.style.setProperty('--p',this.value+'%')\"></div></div></section><section class=\"sec dark\"><div class=\"wrap ctaband\"><div><h2>Thinking about a renovation?</h2><p>We visit, measure and give you a ballpark in one week. No charge.</p></div><a class=\"btn\" href=\"{{p:visit}}\">Book a site visit</a></div></section></div>","projects":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Projects</b></div><h1>Projects</h1></div></section><div class=\"rv-mast\"><section class=\"rv-idx\" style=\"padding-top:20px\"><aside><h2>Index</h2><p>Residential · Commercial · Heritage</p></aside><div><a class=\"rv-case\" href=\"{{p:project}}\"><div class=\"ph soft\" data-l=\"The Bangsar Terrace\" style=\"aspect-ratio:3/2;border-radius:0\"></div><div><span class=\"n\">01</span><h3>The Bangsar Terrace</h3><dl><dt>Scope</dt><dd>Full-house renovation</dd><dt>Area</dt><dd>3,200 sq ft</dd><dt>Location</dt><dd>Kuala Lumpur</dd><dt>Duration</dt><dd>5 months</dd></dl></div></a><a class=\"rv-case\" href=\"{{p:project}}\"><div class=\"ph soft\" data-l=\"Casa Sentul\" style=\"aspect-ratio:3/2;border-radius:0\"></div><div><span class=\"n\">02</span><h3>Casa Sentul</h3><dl><dt>Scope</dt><dd>Kitchen + living</dd><dt>Area</dt><dd>1,100 sq ft</dd><dt>Location</dt><dd>Kuala Lumpur</dd><dt>Duration</dt><dd>10 weeks</dd></dl></div></a><a class=\"rv-case\" href=\"{{p:project}}\"><div class=\"ph soft\" data-l=\"Taman Desa Loft\" style=\"aspect-ratio:3/2;border-radius:0\"></div><div><span class=\"n\">03</span><h3>Taman Desa Loft</h3><dl><dt>Scope</dt><dd>Condo conversion</dd><dt>Area</dt><dd>1,800 sq ft</dd><dt>Location</dt><dd>Kuala Lumpur</dd><dt>Duration</dt><dd>4 months</dd></dl></div></a><a class=\"rv-case\" href=\"{{p:project}}\"><div class=\"ph soft\" data-l=\"Penang Shophouse\" style=\"aspect-ratio:3/2;border-radius:0\"></div><div><span class=\"n\">04</span><h3>Penang Shophouse</h3><dl><dt>Scope</dt><dd>Heritage restoration</dd><dt>Area</dt><dd>2,600 sq ft</dd><dt>Location</dt><dd>George Town</dd><dt>Duration</dt><dd>7 months</dd></dl></div></a></div></section></div></div>","project":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><a href=\"{{p:projects}}\">Projects</a><span>/</span><b>The Bangsar Terrace</b></div><h1>The Bangsar Terrace</h1></div></section><div class=\"rv-mast\"><section style=\"padding:20px 0\"><div class=\"ph soft\" data-l=\"Hero (缺图)\" style=\"aspect-ratio:21/9;border-radius:0\"></div><div class=\"rv-fee\" style=\"margin:30px 0\"><div><small>Scope</small><div class=\"big\">Full house</div></div><div><small>Duration</small><div class=\"big\">5 months</div></div><div><small>Investment</small><div class=\"big\">RM 480k</div></div></div><div class=\"rv-ba\" onpointermove=\"this.style.setProperty('--p',this.querySelector('input').value+'%')\"><div class=\"ph soft bf\" data-l=\"\" style=\"filter:grayscale(1) brightness(.85)\"></div><div class=\"ph soft af\" data-l=\"\"></div><span class=\"ln\"></span><span class=\"tg\" style=\"left:12px\">Before</span><span class=\"tg\" style=\"right:12px\">After</span><input type=\"range\" min=\"0\" max=\"100\" value=\"50\" aria-label=\"Before and after slider\" oninput=\"this.parentNode.style.setProperty('--p',this.value+'%')\"></div><div class=\"rv-idx\"><aside><h2>The brief</h2></aside><div class=\"prose\"><p class=\"lead\">A 1990s terrace, dark and compartmentalised, for a family of five.</p><p>Replace with your project narrative, constraints and what you changed.</p></div></div></section></div></div>","services":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Services</b></div><h1>Services</h1></div></section><div class=\"rv-mast\"><section class=\"rv-idx\" style=\"padding-top:20px\"><aside><h2>What we do</h2></aside><div><div class=\"rv-case\" style=\"grid-template-columns:80px 1fr\"><span class=\"n\">01</span><div><h3>Design</h3><p>Layouts, 3D visuals, material boards, permits.</p></div></div><div class=\"rv-case\" style=\"grid-template-columns:80px 1fr\"><span class=\"n\">02</span><div><h3>Build</h3><p>Demolition, wet works, carpentry, electrical, painting.</p></div></div><div class=\"rv-case\" style=\"grid-template-columns:80px 1fr\"><span class=\"n\">03</span><div><h3>Joinery</h3><p>Made-to-measure cabinets and wardrobes from our own workshop.</p></div></div><div class=\"rv-case\" style=\"grid-template-columns:80px 1fr\"><span class=\"n\">04</span><div><h3>Aftercare</h3><p>12-month defects period and annual check-in.</p></div></div></div></section></div></div>","process":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>How we work</b></div><h1>How we work</h1></div></section><div class=\"rv-mast\"><section class=\"rv-idx\" style=\"padding-top:20px\"><aside><h2>Five stages</h2></aside><div><div class=\"rv-case\" style=\"grid-template-columns:80px 1fr\"><span class=\"n\">01</span><div><h3>Site visit</h3><p>Measure, listen, photograph.</p></div></div><div class=\"rv-case\" style=\"grid-template-columns:80px 1fr\"><span class=\"n\">02</span><div><h3>Concept & fee</h3><p>Layouts, mood board and a fixed design fee.</p></div></div><div class=\"rv-case\" style=\"grid-template-columns:80px 1fr\"><span class=\"n\">03</span><div><h3>Detailed quote</h3><p>Itemised, with allowances named.</p></div></div><div class=\"rv-case\" style=\"grid-template-columns:80px 1fr\"><span class=\"n\">04</span><div><h3>Build</h3><p>Weekly photo reports and a shared schedule.</p></div></div><div class=\"rv-case\" style=\"grid-template-columns:80px 1fr\"><span class=\"n\">05</span><div><h3>Handover</h3><p>Snag list, warranty book and keys.</p></div></div></div></section></div></div>","investment":"<div tabindex=\"-1\" data-dl-content><section class=\"pagehead\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>I