r(--f-body)\">1,800 practice questions · 6 full mock exams · weekly coach call.</p><a class=\"pl-btn\" href=\"{{p:pricing}}\">Enrol · RM 1,490</a></div>\n<div><span class=\"tag pl-card\" style=\"display:inline-block;padding:3px 12px;border-radius:99px\">PMP · Project Management</span><h1 style=\"font:800 clamp(32px,4.4vw,56px)/1.05 var(--f-head);letter-spacing:-.035em;margin:14px 0 16px;color:var(--c-primary)\">PMP Exam Prep</h1><p style=\"font:400 18px/1.7 var(--f-body);max-width:52ch;margin-bottom:22px\">Everything in the PMP exam content outline, in 12 weeks, with exam-style questions from week one.</p>\n<div class=\"faq\" style=\"max-width:none\"><details open><summary>Domain 1 · People (42%)</summary><p>Leadership, conflict, team performance, stakeholder engagement.</p></details><details><summary>Domain 2 · Process (50%)</summary><p>Schedule, cost, risk, quality, procurement, agile and hybrid delivery.</p></details><details><summary>Domain 3 · Business environment (8%)</summary><p>Compliance, benefits realisation, organisational change.</p></details></div></div></div></section>","practice":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Practice test</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.03em\">Free practice test</h1><p class=\"lead\">Five questions, five minutes. Explanations after every answer.</p></div></section><section class=\"pl-sec\" style=\"padding-top:0\"><div class=\"pl-quiz\" id=\"pl-quiz\"></div></section><script>(function(){var Q=[{\"q\": \"Which document formally authorises a project and gives the project manager authority?\", \"o\": [\"Project charter\", \"Project management plan\", \"Scope statement\", \"Work breakdown structure\"], \"a\": 0, \"w\": \"The charter is issued by the sponsor and names the project manager.\"}, {\"q\": \"A critical-path task slips by three days. What happens to the project end date?\", \"o\": [\"It slips by three days\", \"Nothing changes\", \"It slips only if float is exhausted\", \"It moves earlier\"], \"a\": 0, \"w\": \"Delay on the critical path has zero float, so the end date moves.\"}, {\"q\": \"Which tool shows the effect of changing one variable across many outcomes?\", \"o\": [\"Pareto chart\", \"Sensitivity analysis\", \"Fishbone diagram\", \"Control chart\"], \"a\": 1, \"w\": \"Sensitivity (tornado) analysis ranks variables by impact.\"}, {\"q\": \"Stakeholders disagree about scope after approval. First step?\", \"o\": [\"Update the baseline\", \"Follow the change control process\", \"Ask the sponsor to decide\", \"Ignore until closing\"], \"a\": 1, \"w\": \"Changes go through integrated change control.\"}, {\"q\": \"Which is a risk response for a negative risk?\", \"o\": [\"Exploit\", \"Enhance\", \"Mitigate\", \"Share (positive)\"], \"a\": 2, \"w\": \"Mitigate reduces probability or impact of a threat.\"}],root=document.getElementById(\"pl-quiz\");if(!root)return;var i=0,s=0,t=300,tm;function fmt(x){return Math.floor(x/60)+\":\"+(\"0\"+x%60).slice(-2)}function done(){clearInterval(tm);var p=Math.round(s/Q.length*100);root.innerHTML=\"<div class=pl-qtop><span>Result</span><b>\"+fmt(300-t)+\" used</b></div><h2>\"+s+\" of \"+Q.length+\" correct · \"+p+\"%</h2><div class=pl-why>\"+(p>=80?\"You are on track. Book the full mock exam.\":p>=60?\"Close. Focus on risk and scope domains for two weeks.\":\"Start with the 12-week plan and rebuild the basics.\")+\"</div><p style=\\\"margin-top:20px\\\"><a href=\\\"#\\\" class=\\\"pl-btn\\\" id=pl-again>Try again</a></p>\";document.getElementById(\"pl-again\").onclick=function(e){e.preventDefault();i=0;s=0;t=300;start()}}function show(){if(i>=Q.length)return done();var q=Q[i];root.innerHTML=\"<div class=pl-qtop><span>Question \"+(i+1)+\" of \"+Q.length+\"</span><b id=pl-t>\"+fmt(t)+\"</b></div><div class=pl-qbar style=\\\"--p:\"+(i/Q.length*100)+\"%\\\"><i></i></div><h2>\"+q.q+\"</h2><div class=pl-opts>\"+q.o.map(function(o,k){return\"<button type=button data-k=\\\"\"+k+\"\\\"><b>\"+\"ABCD\"[k]+\"</b>\"+o+\"</button>\"}).join(\"\")+\"</div><div id=pl-why></div>\";root.querySelectorAll(\".pl-opts button\").forEach(function(b){b.onclick=function(){var k=+b.dataset.k;root.querySelectorAll(\".pl-opts button\").forEach(function(x,j){x.disabled=true;x.className=j===q.a?\"ok\":\"no\"});if(k===q.a)s++;document.getElementById(\"pl-why\").innerHTML=\"<div class=pl-why><b>\"+(k===q.a?\"Correct. \":\"Not quite. \")+\"</b>\"+q.w+\"</div><p style=\\\"margin-top:16px\\\"><button type=button class=pl-btn id=pl-next>\"+(i+1>=Q.length?\"See result\":\"Next question\")+\"</button></p>\";document.getElementById(\"pl-next\").onclick=function(){i++;show()}}})}function start(){clearInterval(tm);tm=setInterval(function(){t--;var e=document.getElementById(\"pl-t\");if(e)e.textContent=fmt(t);if(t<=0)done()},1000);show()}start()})();</script>","planner":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Study planner</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.03em\">Build your study plan</h1><p class=\"lead\">Tell us how long you have. We split the hours into learn, practise and mock.</p></div></section><section class=\"pl-sec\" style=\"padding-top:0\"><div class=\"pl-plan\"><div class=\"pl-dash\"><label>Weeks until exam<input id=\"pl-w\" type=\"range\" min=\"4\" max=\"20\" value=\"12\"><output id=\"pl-wv\">12 weeks</output></label><label>Hours per week<input id=\"pl-h\" type=\"range\" min=\"3\" max=\"20\" value=\"12\"><output id=\"pl-hv\">12 h / week</output></label></div>\n<div class=\"pl-dash\"><h3>Your plan</h3><div style=\"font:800 clamp(34px,5vw,56px)/1 var(--f-head);letter-spacing:-.03em;margin:8px 0 6px;color:var(--c-primary)\" id=\"pl-tot\">144 hours</div><div class=\"pl-ph\" id=\"pl-ph\"><div>Learn</div><div>Practise</div><div>Mock</div></div><p style=\"font:600 13px var(--f-body);color:var(--c-secondary)\">Learn <span id=\"pl-pa\"></span> · Practise <span id=\"pl-pb\"></span> · Mock <span id=\"pl-pc\"></span></p><p style=\"margin-top:16px;font:500 16px/1.6 var(--f-body)\" id=\"pl-msg\"></p></div></div></section><script>(function(){var w=document.getElementById(\"pl-w\"),h=document.getElementById(\"pl-h\");if(!w)return;function u(){var wk=+w.value,hr=+h.value,tot=wk*hr;document.getElementById(\"pl-wv\").textContent=wk+\" weeks\";document.getElementById(\"pl-hv\").textContent=hr+\" h / week\";document.getElementById(\"pl-tot\").textContent=tot+\" hours\";var a=Math.round(tot*.5),b=Math.round(tot*.3),c=tot-a-b;document.getElementById(\"pl-ph\").style.cssText=\"--a:\"+a+\"fr;--b:\"+b+\"fr;--c:\"+c+\"fr\";document.getElementById(\"pl-pa\").textContent=a+\" h\";document.getElementById(\"pl-pb\").textContent=b+\" h\";document.getElementById(\"pl-pc\").textContent=c+\" h\";document.getElementById(\"pl-msg\").textContent=hr*wk<150?\"Tight. Most candidates need 150–200 hours for PMP.\":hr*wk>260?\"Plenty of time. Consider a second pass on weak domains.\":\"A realistic plan. Keep one mock exam per fortnight.\"}w.oninput=u;h.oninput=u;u()})();</script>","results":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Pass stories</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.03em\">Pass stories</h1></div></section><section class=\"pl-sec\" style=\"padding-top:0\"><div class=\"pl-grid\"><div class=\"pl-card\"><span class=\"tag\">PMP · passed</span><h3>\"12 hours a week, while on shift.\"</h3><p>Nurul, operations lead. Passed first attempt, week 13.</p></div><div class=\"pl-card\"><span class=\"tag\">AWS SAA · passed</span><h3>\"The mocks were harder than the real thing.\"</h3><p>Kevin, support engineer. Score 812/1000.</p></div><div class=\"pl-card\"><span class=\"tag\">IELTS · 7.5</span><h3>\"Speaking drills changed everything.\"</h3><p>Mei, nurse. Moved up from 6.0 in five weeks.</p></div></div></section>","pricing":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Pricing</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.03em\">Pricing</h1><p class=\"lead\">Pass or we extend your access free, until you do.</p></div></section><section class=\"pl-sec\" style=\"padding-top:0\"><div class=\"pl-price\"><div><h3 style=\"font:700 20px var(--f-head)\">Practice</h3><span class=\"p\">RM 290</span><ul><li>Question bank</li><li>3 mock exams</li><li>Explanations</li></ul><a class=\"pl-btn o\" href=\"#\">Choose</a></div><div class=\"hl\"><h3 style=\"font:700 20px var(--f-head)\">Full prep</h3><span class=\"p\">RM 1,490</span><ul><li>Video course</li><li>6 mock exams</li><li>Weekly coach call</li><li>Pass guarantee</li></ul><a class=\"pl-btn\" href=\"#\">Enrol</a></div><div><h3 style=\"font:700 20px var(--f-head)\">Team</h3><span class=\"p\">Custom</span><ul><li>5+ seats</li><li>Progress dashboard</li><li>Invoicing</li></ul><a class=\"pl-btn o\" href=\"#\">Talk to us</a></div></div></section>","faq":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>FAQ</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.03em\">FAQ</h1></div></section><section class=\"pl-sec\" style=\"padding-top:0\"><div class=\"faq\"><details open><summary>How is the pass guarantee defined?</summary><p>Complete the plan and score 70% on the final mocks. If you still fail, your access extends free.</p></details><details><summary>Are the exam fees included?</summary><p>No. Exam fees are paid to the certifying body.</p></details><details><summary>Can my employer pay?</summary><p>Yes, we issue invoices and can provide a progress report.</p></details></div></section>","privacy":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Privacy policy</b></div><h1 style=\"\">Privacy policy</h1></div></section><section class=\"pl-sec\" style=\"padding-top:20px\"><div class=\"prose\"><p>Replace with your privacy policy: what you collect, why, how long you keep it and how customers can ask for deletion.</p></div></section>","404":"<section class=\"pl-sec\" style=\"text-align:center;padding-top:clamp(60px,10vw,140px)\"><div class=\"pl-gauge\" style=\"max-width:240px\"><svg viewBox=\"0 0 200 110\" aria-hidden=\"true\"><path class=\"bg\" d=\"M20 100A80 80 0 0 1 180 100\" pathLength=\"251\"/><path class=\"fg\" style=\"--v:0\" d=\"M20 100A80 80 0 0 1 180 100\" pathLength=\"251\"/></svg><b>404</b></div><h1 style=\"font:800 clamp(30px,5vw,52px) var(--f-head);letter-spacing:-.03em;margin:22px 0 14px\">0% found. Retake?</h1><a class=\"pl-btn\" href=\"{{p:home}}\">Back to home</a></section>"}}