.querySelectorAll(\".opt\").forEach(function(b){b.onclick=function(){if(+b.dataset.k===q.a)s++;i++;show()}})}show()})();</script>","method":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Method</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.03em\">Method</h1></div></section><section class=\"ps-sec\" style=\"padding-top:0\"><div class=\"ps-plans\"><div><div class=\"ps-lab\">01</div><h3 style=\"font:800 24px var(--f-head);letter-spacing:-.02em\">Say</h3><p>Start with a real task. Speak before you study.</p></div><div><div class=\"ps-lab\">02</div><h3 style=\"font:800 24px var(--f-head);letter-spacing:-.02em\">Fix</h3><p>Your tutor marks three things, no more. Hear the correction.</p></div><div><div class=\"ps-lab\">03</div><h3 style=\"font:800 24px var(--f-head);letter-spacing:-.02em\">Repeat</h3><p>Say it again tomorrow. Spaced review keeps it.</p></div></div></section>","tutors":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Tutors</b></div><h1 style=\"font-family:var(--f-head);font-weight:800;letter-spacing:-.03em\">Tutors</h1></div></section><section class=\"ps-sec\" style=\"padding-top:0\"><div class=\"ps-plans\"><div><div class=\"ps-ph\" style=\"min-height:200px\" data-l=\"Tutor photo (缺图)\"></div><h3 style=\"font:800 22px var(--f-head);margin-top:12px\">Hannah Moore</h3><p>Business English · Manchester</p></div><div><div class=\"ps-ph\" style=\"min-height:200px\" data-l=\"Tutor photo (缺图)\"></div><h3 style=\"font:800 22px var(--f-head);margin-top:12px\">David Osei</h3><p>Pronunciation · Accra</p></div><div><div class=\"ps-ph\" style=\"min-height:200px\" data-l=\"Tutor photo (缺图)\"></div><h3 style=\"font:800 22px var(--f-head);margin-top:12px\">Priya Nair</h3><p>IELTS · Auckland</p></div></div></section>","pricing":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"