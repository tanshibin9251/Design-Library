splay:flex;align-items:center;gap:8px;padding:0 clamp(8px,1.4vw,20px);min-height:60px;text-decoration:none;font:500 14px var(--f-body);color:var(--c-text)}\n.ps-nav a b{font:600 11px var(--f-body);color:var(--c-accent)}\n.ps-nav a:hover{background:var(--c-primary);color:var(--on-primary)}\n.ps-nav .more{position:relative}\n.ps-nav .dd{position:absolute;left:0;top:100%;display:none;grid-template-columns:repeat(4,minmax(130px,1fr));gap:18px 28px;padding:22px 26px;background:var(--c-surface);border:1px solid var(--c-primary);min-width:600px;z-index:60}\n.ps-nav .more:hover .dd,.ps-nav .more:focus-within .dd{display:grid}\n.ps-nav .dd h4{font:700 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:var(--c-accent);margin-bottom:6px}\n.ps-nav .dd a{padding:5px 0;min-height:0;display:block}.ps-nav .dd a:hover{background:none;color:var(--c-accent)}\n.ps-act{grid-column:span 2;display:flex;justify-content:flex-end;align-items:center;gap:14px}\n.ps-act a{font:600 14px var(--f-body);text-decoration:none;color:var(--c-primary);min-height:44px;display:flex;align-items:center}\n.ps-act .b{background:var(--c-accent);color:var(--on-accent);padding:0 18px}\n.ps-m{display:none}\n.ps-m summary{list-style:none;cursor:pointer;min-height:44px;display:flex;align-items:center;font:700 12px var(--f-body);letter-spacing:.14em;text-transform:uppercase}\n.ps-m summary::-webkit-details-marker{display:none}\n.ps-m nav{position:absolute;left:0;right:0;top:100%;background:var(--c-surface);border-bottom:1px solid var(--c-primary);padding:6px 16px 16px;display:grid}\n.ps-m nav a{padding:12px 0;border-bottom:1px solid var(--c-border);text-decoration:none;font:500 15px var(--f-body);min-height:44px}\n@media(max-width:960px){.ps-nav,.ps-act{display:none}.ps-m{display:block;grid-column:span 6;justify-self:end}.ps-logo{grid-column:span 6}}\n\n.ps-sec{padding:clamp(48px,7vw,100px) clamp(16px,3vw,44px)}\n.ps-g{display:grid;grid-template-columns:repeat(12,1fr);gap:0 20px}\n.ps-lab{font:600 12px var(--f-body);letter-spacing:.12em;text-transform:uppercase;color:var(--c-accent);border-top:2px solid var(--c-primary);padding-top:10px}\n.ps-mega{font:800 clamp(64px,15vw,var(--h1))/.88 var(--f-head);letter-spacing:-.045em;color:var(--c-primary)}\n.ps-mega i{font-style:normal;color:var(--c-accent)}\n.ps-btn{display:inline-flex;align-items:center;gap:12px;min-height:52px;padding:0 26px;background:var(--c-primary);color:var(--on-primary);text-decoration:none;font:600 15px var(--f-body);border:2px solid var(--c-primary);cursor:pointer}\n.ps-btn:hover{background:var(--c-accent);border-color:var(--c-accent);color:var(--on-accent)}\n.ps-btn.o{background:transparent;color:var(--c-primary)}.ps-btn.o:hover{background:var(--c-primary);color:var(--on-primary);border-color:var(--c-primary)}\n.ps-facts{display:grid;grid-template-columns:repeat(4,1fr);border-top:2px solid var(--c-primary);margin-top:clamp(40px,6vw,80px)}\n.ps-facts>div{padding:18px 18px 22px 0;border-right:1px solid var(--c-border);padding-left:18px}.ps-facts>div:first-child{padding-left:0}.ps-facts>div:last-child{border-right:0}\n.ps-facts b{display:block;font:800 clamp(34px,4.4vw,60px)/1 var(--f-head);letter-spacing:-.04em;color:var(--c-primary)}\n.ps-facts span{font:500 13px var(--f-body);color:var(--c-secondary)}\n@media(max-width:700px){.ps-facts{grid-template-columns:1fr 1fr}.ps-facts>div:nth-child(2n){border-right:0}.ps-facts>div:nth-child(3){padding-left:0}}\n.ps-tbl{border-top:2px solid var(--c-primary)}\n.ps-tr{display:grid;grid-template-columns:60px minmax(0,2fr) 90px 120px 100px 30px;gap:0 16px;align-items:center;padding:20px 0;border-bottom:1px solid var(--c-border);text-decoration:none;transition:background .15s,color .15s,padding .15s}\n.ps-tr:hover{background:var(--c-primary);color:var(--on-primary);padding-left:14px;padding-right:14px}\n.ps-tr .n{font:600 12px var(--f-body);color:var(--c-accent)}\n.ps-tr h3{font:700 clamp(20px,2.2vw,28px) var(--f-head);letter-spacing:-.02em;color:inherit}\n.ps-tr small{display:block;font:400 14px var(--f-body);opacity:.7;margin-top:2px}\n.ps-tr .lv{font:700 13px var(--f-body);border:1px solid currentColor;padding:3px 10px;justify-self:start}\n.ps-tr .tm,.ps-tr .pr{font:500 14px var(--f-body)}\n@media(max-width:800px){.ps-tr{grid-template-columns:36px 1fr auto;gap:6px 12px}.ps-tr .tm,.ps-tr .ar{display:none}.ps-tr .lv{grid-column:3;grid-row:1}.ps-tr .pr{grid-column:2}}\n.ps-two{display:grid;grid-template-columns:repeat(12,1fr);gap:24px 20px;align-items:start}\n.ps-two>.a{grid-column:1/span 5}.ps-two>.b{grid-column:7/span 6}\n@media(max-width:800px){.ps-two>.a,.ps-two>.b{grid-column:1/-1}}\n.ps-ph{background:repeating-linear-gradient(0deg,var(--c-border) 0 1px,transparent 1px 22px),var(--c-surface);border:1px solid var(--c-primary);position:relative;min-height:280px}\n.ps-ph::after{content:attr(data-l);position:absolute;left:12px;bottom:10px;font:600 10px var(--f-body);letter-spacing:.14em;text-transform:uppercase}\n.ps-q{border-top:2px solid var(--c-primary);padding-top:20px}\n.ps-q h2{font:700 clamp(24px,3vw,38px)/1.2 var(--f-head);letter-spacing:-.02em;margin:10px 0 22px}\n.ps-q .o{display:grid;gap:10px}\n.ps-q button.opt{text-align:left;min-height:52px;padding:0 18px;border:1px solid var(--c-primary);background:transparent;font:500 17px var(--f-body);cursor:pointer;color:var(--c-text);display:flex;gap:14px;align-items:center}\n.ps-q button.opt b{font:700 12px var(--f-body);color:var(--c-accent);width:18px}\n.ps-q button.opt:hover{background:var(--c-primary);color:var(--on-primary)}\n.ps-prog{display:flex;gap:4px;margin-bottom:6px}.ps-prog i{flex:1;height:6px;background:var(--c-border)}.ps-prog i.d{background:var(--c-primary)}.ps-prog i.c{background:var(--c-accent)}\n.ps-res{font:800 clamp(80px,16vw,220px)/.9 var(--f-head);letter-spacing:-.05em;color:var(--c-accent)}\n.ps-plans{display:grid;grid-template-columns:repeat(3,1fr);border-top:2px solid var(--c-primary)}\n.ps-plans>div{padding:26px 22px 30px 0;border-right:1px solid var(--c-border);padding-left:22px;display:grid;gap:10px;align-content:start}\n.ps-plans>div:first-child{padding-left:0}.ps-plans>div:last-child{border-right:0}\n.ps-plans .p{font:800 44px var(--f-head);letter-spacing:-.04em}.ps-plans li{list-style:none;padding:8px 0;border-top:1px solid var(--c-border);font:400 15px var(--f-body)}\n@media(max-width:800px){.ps-plans{grid-template-columns:1fr}.ps-plans>div{border-right:0;border-bottom:1px solid var(--c-border);padding-left:0}}\n.ps-foot{background:var(--c-primary);color:var(--on-primary);padding:clamp(44px,6vw,80px) clamp(16px,3vw,44px) 22px}\n.ps-foot .big{font:800 clamp(60px,12vw,180px)/.85 var(--f-head);letter-spacing:-.05em;color:var(--on-primary)}\n.ps-foot .big i{font-style:normal;color:var(--c-accent)}\n.ps-foot .cols{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:40px;border-top:1px solid color-mix(in srgb,var(--on-primary) 30%,transparent);padding-top:22px}\n.ps-foot h4{font:700 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:var(--c-accent);margin-bottom:10px}\n.ps-foot ul{list-style:none}.ps-foot li a{display:inline-block;padding:6px 0;text-decoration:none;font:500 14px var(--f-body);min-height:32px}\n.ps-foot .copy{margin-top:28px;font:500 12px var(--f-body);opacity:.7}\n@media(max-width:700px){.ps-foot .cols{grid-template-columns:1fr 1fr}}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}\n@media(prefers-reduced-motion:reduce){.ps-tr{transition:none}}\n</style><header class=\"ps-head\"><div class=\"ps-row\"><a class=\"ps-logo\" href=\"{{p:home}}\">plainspeak<i>.</i></a><ul class=\"ps-nav\"><li><a href=\"{{p:courses}}\"><b>01</b>Courses</a></li><li><a href=\"{{p:level}}\"><b>02</b>Level check</a></li><li><a href=\"{{p:method}}\"><b>03</b>Method</a></li><li><a href=\"{{p:tutors}}\"><b>04</b>Tutors</a></li><li class=\"more\"><a href=\"#\" tabindex=\"0\"><b>05</b>More</a><div class=\"dd\"><div><h4>Learn</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:courses}}\">Courses</a><a href=\"{{p:course}}\">Course: Everyday Conversation</a><a href=\"{{p:lesson}}\">Lesson</a><a href=\"{{p:level}}\">Level check</a></div><div><h4>School</h4><a href=\"{{p:method}}\">Method</a><a href=\"{{p:tutors}}\">Tutors</a><a href=\"{{p:pricing}}\">Pricing</a><a href=\"{{p:faq}}\">FAQ</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li></ul><div class=\"ps-act\"><a href=\"#\">Log in</a><a class=\"b\" href=\"{{p:pricing}}\">Start free</a></div><details class=\"ps-m\"><summary>MENU</summary><nav><a href=\"{{p:home}}\">Home</a><a href=\"{{p:courses}}\">Courses</a><a href=\"{{p:course}}\">Course: Everyday Conversation</a><a href=\"{{p:lesson}}\">Lesson</a><a href=\"{{p:level}}\">Level check</a><a href=\"{{p:method}}\">Method</a><a href=\"{{p:tutors}}\">Tutors</a><a href=\"{{p:pricing}}\">Pricing</a><a href=\"{{p:faq}}\">FAQ</a><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></nav></details></div></header>","foot":"<footer class=\"ps-foot\"><div class=\"big\">plainspeak<i>.</i></div><div class=\"cols\"><div><h4>Learn</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:courses}}\">Courses</a></li><li><a href=\"{{p:course}}\">Course: Everyday Conversation</a></li><li><a href=\"{{p:lesson}}\">Lesson</a></li><li><a href=\"{{p:level}}\">Level check</a></li></ul></div><div><h4>School</h4><ul><li><a href=\"{{p:method}}\">Method</a></li><li><a href=\"{{p:tutors}}\">Tutors</a></li><li><a href=\"{{p:pricing}}\">Pricing</a></li><li><a href=\"{{p:faq}}\">FAQ</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div><div class=\"copy\">© 2026 Plainspeak English · Template demo content</div></footer>","pages":{"home":"<section class=\"ps-sec\"><div class=\"ps-g\"><div style=\"grid-column:1/-1\"><div class=\"ps-lab\">Online English school · live tutors · since 2016</div></div><h1 class=\"ps-mega\" style=\"grid-column:1/-1;margin:26px 0 30px\">Say it<br>plainly<i>.</i></h1><p style=\"grid-column:1/span 5;font:400 20px/1.55 var(--f-body);margin-bottom:28px\">English that works in a meeting, a shop and a phone call. Short lessons, one tutor who knows your name, and feedback you can hear.</p><p style=\"grid-column:1/-1;display:flex;gap:12px;flex-wrap:wrap\"><a class=\"ps-btn\" href=\"{{p:level}}\">Check my level →</a><a class=\"ps-btn o\" href=\"{{p:courses}}\">Browse courses</a></p></div>\n<div class=\"ps-facts\"><div><b>12k</b><span>learners in 54 countries</span></div><div><b>1:1</b><span>tutor feedback on every task</span></div><div><b>15′</b><span>average lesson length</span></div><div><b>4.8</b><span>average course rating</span></div></div></section>\n<section class=\"ps-sec\" style=\"padding-top:0\"><div class=\"ps-lab\" style=\"margin-bottom:14px\">Courses</div><div class=\"ps-tbl\"><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">01</span><div><h3>Everyday Conversation</h3><small>Speak up at work, shops and cafés.</small></div><span class=\"lv\">A2–B1</span><span class=\"tm\">8 wks</span><span class=\"pr\">RM 390</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">02</span><div><h3>Business Email & Meetings</h3><small>Write clearly. Run a call. Say no politely.</small></div><span class=\"lv\">B1–B2</span><span class=\"tm\">6 wks</span><span class=\"pr\">RM 450</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">03</span><div><h3>Pronunciation Lab</h3><small>Sounds, stress and rhythm, recorded and reviewed.</small></div><span class=\"lv\">A2–C1</span><span class=\"tm\">4 wks</span><span class=\"pr\">RM 290</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">04</span><div><h3>IELTS Speaking Sprint</h3><small>Four tutors, twelve mock interviews, one band target.</small></div><span class=\"lv\">B2–C1</span><span class=\"tm\">5 wks</span><span class=\"pr\">RM 520</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">05</span><div><h3>Listening Without Subtitles</h3><small>Podcasts, films, fast speech. Train your ear.</small></div><span class=\"lv\">B1–C1</span><span class=\"tm\">6 wks</span><span class=\"pr\">RM 340</span><span class=\"ar\">→</span></a></div><p style=\"margin-top:28px\"><a class=\"ps-btn o\" href=\"{{p:courses}}\">All courses →</a></p></section>\n<section class=\"ps-sec\" style=\"padding-top:0\"><div class=\"ps-two\"><div class=\"a\"><div class=\"ps-lab\">Method</div><h2 style=\"font:800 clamp(30px,4vw,52px)/1.05 var(--f-head);letter-spacing:-.03em;margin-top:14px\">Speak first. Study the grammar after.</h2></div><div class=\"b\"><p style=\"font:400 19px/1.65 var(--f-body)\">Every lesson starts with something you have to say. We record it, fix it, and ask you to say it again. The grammar becomes a tool, not a subject.</p><p style=\"margin-top:22px\"><a class=\"ps-btn o\" href=\"{{p:method}}\">Read the method →</a></p></div></div></section>","courses":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Courses</b></div><h1 style=\"font-family:var(--f-head);letter-spacing:-.03em;font-weight:800\">Courses</h1><p class=\"lead\">Five courses, three levels. Every course has a free first lesson.</p></div></section><section class=\"ps-sec\" style=\"padding-top:0\"><div class=\"ps-tbl\"><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">01</span><div><h3>Everyday Conversation</h3><small>Speak up at work, shops and cafés.</small></div><span class=\"lv\">A2–B1</span><span class=\"tm\">8 wks</span><span class=\"pr\">RM 390</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">02</span><div><h3>Business Email & Meetings</h3><small>Write clearly. Run a call. Say no politely.</small></div><span class=\"lv\">B1–B2</span><span class=\"tm\">6 wks</span><span class=\"pr\">RM 450</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">03</span><div><h3>Pronunciation Lab</h3><small>Sounds, stress and rhythm, recorded and reviewed.</small></div><span class=\"lv\">A2–C1</span><span class=\"tm\">4 wks</span><span class=\"pr\">RM 290</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">04</span><div><h3>IELTS Speaking Sprint</h3><small>Four tutors, twelve mock interviews, one band target.</small></div><span class=\"lv\">B2–C1</span><span class=\"tm\">5 wks</span><span class=\"pr\">RM 520</span><span class=\"ar\">→</span></a><a class=\"ps-tr\" href=\"{{p:course}}\"><span class=\"n\">05</span><div><h3>Listening Without Subtitles</h3><small>Podcasts, films, fast speech. Train your ear.</small></div><span class=\"lv\">B1–C1</span><span class=\"tm\">6 wks</span><span class=\"pr\">RM 340</span><span class=\"ar\">→</span></a></div></section>","course":"<section class=\"ps-sec\"><div class=\"ps-two\"><div class=\"a\"><div class=\"ps-lab\">Course 01 · A2–B1 · 8 weeks</div><h1 class=\"ps-mega\" style=\"font-size:clamp(44px,7vw,100px);margin:18px 0 22px\">Everyday<br>Conversation<i>.</i></h1><p style=\"font:400 19px/1.6 var(--f-body);margin-bottom:26px\">Speak up at work, in shops and cafés. Three live sessions a week and daily voice tasks.</p><p style=\"display:flex;gap:12px;flex-wrap:wrap\"><a class=\"ps-btn\" href=\"{{p:pricing}}\">Enrol · RM 390</a><a class=\"ps-btn o\" href=\"{{p:lesson}}\">Free first lesson</a></p></div>\n<div class=\"b\"><div class=\"ps-lab\" style=\"margin-bottom:6px\">Syllabus</div><div class=\"faq\" style=\"max-width:none\"><details open><summary>Weeks 1–2 · Introductions &amp; small talk</summary><p>Greetings, describing your day, asking follow-up questions.</p></details><details><summary>Weeks 3–4 · Shops, cafés and transport</summary><p>Ordering, asking prices, solving problems politely.</p></details><details><summary>Weeks 5–6 · At work</summary><p>Stand-ups, asking for help, short updates.</p></details><details><summary>Weeks 7–8 · Phone calls &amp; plans</summary><p>Booking, rescheduling, making and changing plans.</p></details></div></div></div></section>","lesson":"<section class=\"ps-sec\"><div class=\"ps-two\"><div class=\"a\" style=\"grid-column:1/span 7\"><div class=\"ps-lab\">Week 3 · Lesson 2 of 5</div><h1 style=\"font:800 clamp(30px,4.4vw,56px)/1.05 var(--f-head);letter-spacing:-.03em;margin:14px 0 22px\">Ordering at a café</h1><div class=\"ps-ph\" style=\"min-height:360px\" data-l=\"Lesson video (缺图)\"></div><p style=\"margin-top:16px;font:600 13px var(--f-body);color:var(--c-secondary)\">00:00 ──────────────── 06:12</p></div>\n<div class=\"b\" style=\"grid-column:9/span 4\"><div class=\"ps-lab\">Key phrases</div><ol style=\"margin-top:12px;padding-left:20px;font:500 17px/2 var(--f-body)\"><li>Could I get a flat white, please?</li><li>Is that for here or to go?</li><li>Do you have anything without dairy?</li><li>Can I pay by card?</li></ol><p style=\"margin-top:20px\"><a class=\"ps-btn\" href=\"#\">Record my answer</a></p></div></div></section>","level":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Level check</b></div><h1 style=\"font-family:var(--f-head);letter-spacing:-.03em;font-weight:800\">Check your level</h1><p class=\"lead\">Eight questions, three minutes. We'll suggest where to start.</p></div></section><section class=\"ps-sec\" style=\"padding-top:0\"><div style=\"max-width:780px\" id=\"ps-quiz\"></div></section><script>(function(){var Q=[{\"q\": \"She ___ coffee every morning.\", \"o\": [\"drink\", \"drinks\", \"drinking\", \"is drink\"], \"a\": 1}, {\"q\": \"We ___ to the cinema last night.\", \"o\": [\"go\", \"goes\", \"went\", \"gone\"], \"a\": 2}, {\"q\": \"I've lived here ___ 2019.\", \"o\