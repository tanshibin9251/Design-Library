0 15px var(--f-body);color:var(--c-text);border-bottom:1px solid transparent}\n.mn-nav a:hover{border-bottom-color:var(--c-accent);color:var(--c-primary)}\n.mn-nav .more{position:relative}\n.mn-nav .dd{position:absolute;right:0;top:100%;display:none;grid-template-columns:repeat(4,minmax(130px,1fr));gap:16px 26px;padding:22px 26px;background:var(--c-surface);border:1px solid var(--c-border);border-radius:16px;box-shadow:0 24px 50px -30px color-mix(in srgb,var(--c-primary) 50%,transparent);min-width:580px;z-index:60}\n.mn-nav .more:hover .dd,.mn-nav .more:focus-within .dd{display:grid}\n.mn-nav .dd h4{font:600 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-secondary);margin-bottom:6px}\n.mn-nav .dd a{display:block;min-height:0;padding:5px 0;border:0}\n.mn-m{display:none;position:relative}\n.mn-m summary{list-style:none;cursor:pointer;min-height:44px;min-width:44px;display:grid;place-items:center;border:1px solid var(--c-border);border-radius:999px;padding:0 16px;font:500 13px var(--f-body)}\n.mn-m summary::-webkit-details-marker{display:none}\n.mn-m nav{position:absolute;right:0;top:100%;min-width:250px;background:var(--c-surface);border:1px solid var(--c-border);border-radius:16px;padding:8px 18px;display:grid;z-index:60;box-shadow:0 24px 50px -30px color-mix(in srgb,var(--c-primary) 50%,transparent)}\n.mn-m nav a{padding:12px 0;border-bottom:1px solid var(--c-border);text-decoration:none;font:500 15px var(--f-body);min-height:44px}\n@media(max-width:860px){.mn-nav{display:none}.mn-m{display:block}}\n\n.mn-sec{padding:clamp(40px,6vw,96px) clamp(18px,5vw,72px)}\n.mn-narrow{max-width:720px;margin:0 auto}\n.mn-hero{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(24px,6vw,100px);align-items:center;padding:clamp(30px,6vw,90px) clamp(18px,5vw,72px)}\n.mn-hero h1{font:500 clamp(38px,5.6vw,var(--h1))/1.15 var(--f-head);color:var(--c-primary);letter-spacing:-.01em}\n.mn-hero h1 em{color:var(--c-accent);font-style:italic}\n.mn-hero p{font:400 19px/1.85 var(--f-body);margin:20px 0 28px;max-width:44ch}\n@media(max-width:860px){.mn-hero{grid-template-columns:1fr}}\n.mn-btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 28px;border-radius:999px;background:var(--c-primary);color:var(--on-primary);text-decoration:none;font:500 15px var(--f-body);border:1px solid var(--c-primary);cursor:pointer}\n.mn-btn:hover{background:var(--c-accent);border-color:var(--c-accent);color:var(--on-accent)}\n.mn-btn.o{background:transparent;color:var(--c-primary)}.mn-btn.o:hover{background:var(--c-primary);color:var(--on-primary);border-color:var(--c-primary)}\n/* breathing circle */\n.mn-breath{position:relative;width:min(100%,380px);aspect-ratio:1;margin:0 auto;display:grid;place-items:center}\n.mn-breath .o{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--c-secondary) 55%,var(--c-surface)) 0,color-mix(in srgb,var(--c-secondary) 25%,var(--c-surface)) 60%,transparent 72%);animation:mnbreath 8s ease-in-out infinite}\n.mn-breath .i{position:absolute;inset:26%;border-radius:50%;background:color-mix(in srgb,var(--c-primary) 14%,var(--c-surface));border:1px solid color-mix(in srgb,var(--c-primary) 30%,transparent);animation:mnbreath 8s ease-in-out infinite;animation-delay:-.2s}\n.mn-breath b{position:relative;font:500 22px var(--f-head);color:var(--c-primary);letter-spacing:.04em}\n@keyframes mnbreath{0%,100%{transform:scale(.72)}50%{transform:scale(1)}}\n.mn-h{margin-bottom:28px}\n.mn-h h2{font:500 clamp(26px,3.2vw,var(--h2))/1.2 var(--f-head);color:var(--c-primary)}\n.mn-h p{font:400 17px/1.8 var(--f-body);color:var(--c-secondary);margin-top:6px;max-width:52ch}\n.mn-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,2vw,26px)}\n@media(max-width:900px){.mn-grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.mn-grid{grid-template-columns:1fr}}\n.mn-flip{perspective:900px;background:none;border:0;padding:0;cursor:pointer;text-align:left;min-height:240px;font:inherit;color:inherit}\n.mn-flip .in{position:relative;width:100%;height:100%;min-height:240px;transition:transform .7s cubic-bezier(.2,.8,.2,1);transform-style:preserve-3d}\n.mn-flip[aria-pressed=true] .in{transform:rotateY(180deg)}\n.mn-flip .f,.mn-flip .b{position:absolute;inset:0;border-radius:22px;padding:26px;backface-visibility:hidden;-webkit-backface-visibility:hidden;display:grid;align-content:space-between;gap:12px}\n.mn-flip .f{background:color-mix(in srgb,var(--c-surface) 40%,#fff);border:1px solid var(--c-border)}\n.mn-flip .b{background:var(--c-primary);color:var(--on-primary);transform:rotateY(180deg)}\n.mn-flip .f span,.mn-flip .b span{font:600 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-secondary)}\n.mn-flip .b span{color:var(--c-secondary)}\n.mn-flip h3{font:500 26px/1.2 var(--f-head);color:var(--c-primary)}\n.mn-flip .b p{font:400 16px/1.7 var(--f-body)}\n.mn-flip .f p{font:400 15px/1.6 var(--f-body);color:var(--c-text);opacity:.8}\n.mn-flip .hint{font:500 13px var(--f-body);color:var(--c-accent)}\n.mn-list a{display:grid;grid-template-columns:auto 1fr auto;gap:20px;padding:26px 0;border-bottom:1px solid var(--c-border);text-decoration:none;align-items:baseline}\n.mn-list a:first-child{border-top:1px solid var(--c-border)}\n.mn-list .n{font:italic 400 18px var(--f-head);color:var(--c-accent)}\n.mn-list h3{font:500 clamp(22px,2.6vw,30px)/1.25 var(--f-head);color:var(--c-primary)}\n.mn-list p{font:400 16px/1.7 var(--f-body);color:var(--c-secondary);margin-top:4px}\n.mn-list .m{font:500 13px var(--f-body);color:var(--c-secondary)}\n.mn-list a:hover h3{color:var(--c-accent)}\n@media(max-width:600px){.mn-list a{grid-template-columns:1fr}}\n.mn-read{font:400 20px/1.95 var(--f-body)}\n.mn-read p{margin-bottom:1.4em;max-width:none}\n.mn-read h2{font:500 30px/1.3 var(--f-head);color:var(--c-primary);margin:1.6em 0 .6em}\n.mn-read blockquote{border-left:3px solid var(--c-accent);padding:4px 0 4px 24px;margin:1.8em 0;font:italic 400 26px/1.5 var(--f-head);color:var(--c-primary)}\n.mn-read .lede::first-letter{font:500 3.6em/.9 var(--f-head);float:left;margin:.08em .1em 0 0;color:var(--c-accent)}\n.mn-meta{display:flex;gap:18px;flex-wrap:wrap;font:500 14px var(--f-body);color:var(--c-secondary);margin:14px 0 36px}\n.mn-note{background:color-mix(in srgb,var(--c-secondary) 20%,var(--c-surface));border-radius:16px;padding:20px 24px;font:400 16px/1.8 var(--f-body)}\n/* check-in */\n.mn-q{border-bottom:1px solid var(--c-border);padding:22px 0}\n.mn-q p{font:400 19px/1.6 var(--f-body);margin-bottom:12px;max-width:none}\n.mn-q .sc{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}\n.mn-q label{display:grid;place-items:center;min-height:48px;border:1px solid var(--c-border);border-radius:12px;font:500 14px var(--f-body);cursor:pointer;text-align:center;padding:4px 6px}\n.mn-q label{position:relative;overflow:hidden}.mn-q input{position:absolute;left:0;top:0;width:1px;height:1px;opacity:0;pointer-events:none;min-height:0;padding:0;border:0}\n.mn-q input:checked+span{color:var(--on-primary)}\n.mn-q label:has(input:checked){background:var(--c-primary);color:var(--on-primary);border-color:var(--c-primary)}\n.mn-q label:has(input:focus-visible){outline:2px solid var(--c-accent);outline-offset:2px}\n@media(max-width:560px){.mn-q .sc{grid-template-columns:1fr 1fr}}\n.mn-res{margin-top:30px;border-radius:22px;padding:clamp(22px,3vw,40px);background:var(--c-primary);color:var(--on-primary);display:none}\n.mn-res.on{display:block}\n.mn-res h3{font:500 clamp(26px,3vw,36px) var(--f-head);color:var(--on-primary);margin-bottom:10px}\n.mn-res p{font:400 17px/1.8 var(--f-body);max-width:56ch}\n.mn-res .sc{font:500 54px var(--f-head);color:var(--c-secondary)}\n.mn-pat{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px}\n.mn-pat button{min-height:46px;padding:0 20px;border-radius:999px;border:1px solid var(--c-primary);background:transparent;font:500 15px var(--f-body);cursor:pointer;color:var(--c-primary)}\n.mn-pat button[aria-pressed=true]{background:var(--c-primary);color:var(--on-primary)}\n.mn-big{width:min(100%,460px);aspect-ratio:1;margin:0 auto;position:relative;display:grid;place-items:center}\n.mn-big .o{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--c-secondary) 60%,var(--c-surface)) 0,color-mix(in srgb,var(--c-secondary) 25%,var(--c-surface)) 62%,transparent 74%);transform:scale(.6);transition:transform var(--t,4s) ease-in-out}\n.mn-big .o.in{transform:scale(1)}\n.mn-big b{position:relative;font:500 clamp(24px,3vw,34px) var(--f-head);color:var(--c-primary);text-align:center}\n.mn-big small{display:block;font:500 15px var(--f-body);color:var(--c-secondary);margin-top:6px}\n.mn-bk{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}\n@media(max-width:700px){.mn-bk{grid-template-columns:1fr}}\n.mn-bk div{border:1px solid var(--c-border);border-radius:18px;padding:24px;background:color-mix(in srgb,var(--c-surface) 40%,#fff)}\n.mn-bk h3{font:500 22px/1.25 var(--f-head);color:var(--c-primary)}\n.mn-bk span{font:500 13px var(--f-body);color:var(--c-secondary)}\n.mn-bk p{font:400 15px/1.75 var(--f-body);margin-top:8px}\n.mn-foot{border-top:1px solid var(--c-border);margin-top:clamp(40px,6vw,96px);padding:clamp(34px,4vw,60px) clamp(18px,5vw,72px) 24px}\n.mn-foot .top{display:grid;grid-template-columns:1.1fr 2fr;gap:clamp(24px,6vw,90px)}\n.mn-foot .big{font:500 28px var(--f-head);color:var(--c-primary)}\n.mn-foot h4{font:600 11px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-secondary);margin-bottom:8px}\n.mn-foot ul{list-style:none}.mn-foot li a{display:inline-block;padding:6px 0;text-decoration:none;font:400 15px var(--f-body);min-height:32px}\n.mn-foot .cols{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n.mn-foot .copy{margin-top:26px;font:400 13px/1.7 var(--f-body);color:var(--c-secondary);max-width:70ch}\n@media(max-width:800px){.mn-foot .top{grid-template-columns:1fr}}\nhtml,body{overflow-x:clip}img,svg{max-width:100%}\n@media(prefers-reduced-motion:reduce){.mn-breath .o,.mn-breath .i{animation:none}.mn-flip .in,.mn-big .o{transition:none}}\n</style><div class=\"mn-prog\" id=\"mn-prog\"></div><header class=\"mn-head\"><a class=\"mn-logo\" href=\"{{p:home}}\">mind notes<i>.</i></a><ul class=\"mn-nav\"><li><a href=\"{{p:concepts}}\">Concepts</a></li><li><a href=\"{{p:checkin}}\">Check-in</a></li><li><a href=\"{{p:breathe}}\">Breathe</a></li><li><a href=\"{{p:books}}\">Books</a></li><li class=\"more\"><a href=\"#\" tabindex=\"0\">More</a><div class=\"dd\"><div><h4>Read</h4><a href=\"{{p:home}}\">Home</a><a href=\"{{p:concepts}}\">Concept cards</a><a href=\"{{p:article}}\">Article: Why we keep doing what we regret</a></div><div><h4>Practise</h4><a href=\"{{p:checkin}}\">Stress check-in</a><a href=\"{{p:breathe}}\">Breathing space</a><a href=\"{{p:books}}\">Reading list</a></div><div><h4>About</h4><a href=\"{{p:support}}\">Getting support</a><a href=\"{{p:about}}\">About</a></div><div><h4>Utility</h4><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></div></div></li><li><a href=\"{{p:support}}\">Support</a></li></ul><details class=\"mn-m\"><summary>MENU</summary><nav><a href=\"{{p:home}}\">Home</a><a href=\"{{p:concepts}}\">Concept cards</a><a href=\"{{p:article}}\">Article: Why we keep doing what we regret</a><a href=\"{{p:checkin}}\">Stress check-in</a><a href=\"{{p:breathe}}\">Breathing space</a><a href=\"{{p:books}}\">Reading list</a><a href=\"{{p:support}}\">Getting support</a><a href=\"{{p:about}}\">About</a><a href=\"{{p:privacy}}\">Privacy policy</a><a href=\"{{p:404}}\">404 error</a></nav></details></header><script>(function(){var b=document.getElementById(\"mn-prog\");if(!b)return;function u(){var h=document.documentElement,m=h.scrollHeight-h.clientHeight;b.style.setProperty(\"--p\",(m>0?h.scrollTop/m*100:0)+\"%\")}addEventListener(\"scroll\",u,{passive:true});u()})();</script>","foot":"<footer class=\"mn-foot\"><div class=\"top\"><div><div class=\"big\">mind notes<i style=\"font-style:normal;color:var(--c-accent)\">.</i></div><p style=\"margin-top:8px;font:400 15px/1.8 var(--f-body);color:var(--c-secondary);max-width:34ch\">Plain-language psychology: ideas, small exercises and honest limits. Template demo content.</p></div><div class=\"cols\"><div><h4>Read</h4><ul><li><a href=\"{{p:home}}\">Home</a></li><li><a href=\"{{p:concepts}}\">Concept cards</a></li><li><a href=\"{{p:article}}\">Article: Why we keep doing what we regret</a></li></ul></div><div><h4>Practise</h4><ul><li><a href=\"{{p:checkin}}\">Stress check-in</a></li><li><a href=\"{{p:breathe}}\">Breathing space</a></li><li><a href=\"{{p:books}}\">Reading list</a></li></ul></div><div><h4>About</h4><ul><li><a href=\"{{p:support}}\">Getting support</a></li><li><a href=\"{{p:about}}\">About</a></li></ul></div><div><h4>Utility</h4><ul><li><a href=\"{{p:privacy}}\">Privacy policy</a></li><li><a href=\"{{p:404}}\">404 error</a></li></ul></div></div></div><div class=\"copy\">Mind Notes is educational and is not a substitute for professional diagnosis, treatment or advice. If you are in crisis or worried about your safety, contact your local emergency number or a crisis line in your country.</div></footer>","pages":{"home":"<section class=\"mn-hero\"><div><h1>Understand your mind a little <em>more kindly</em>.</h1><p>Plain-language psychology: the ideas behind how we think, feel and decide, with small exercises you can try in a few minutes.</p><p style=\"display:flex;gap:12px;flex-wrap:wrap;margin:0\"><a class=\"mn-btn\" href=\"{{p:concepts}}\">Explore concepts</a><a class=\"mn-btn o\" href=\"{{p:breathe}}\">Take a minute to breathe</a></p></div><div class=\"mn-breath\" aria-hidden=\"true\"><div class=\"o\"></div><div class=\"i\"></div><b>breathe</b></div></section>\n<section class=\"mn-sec\" style=\"padding-top:0\"><div class=\"mn-h\"><h2>Recent reading</h2></div><div class=\"mn-list\"><a href=\"{{p:article}}\"><span class=\"n\">01</span><div><h3>Why we keep doing what we regret</h3><p>Habits, cues and the strange comfort of the familiar.</p></div><span class=\"m\">8 min read</span></a><a href=\"{{p:article}}\"><span class=\"n\">02</span><div><h3>The spotlight effect: nobody is watching as closely as you think</h3><p>A kinder way to read your own mistakes.</p></div><span class=\"m\">5 min read</span></a><a href=\"{{p:article}}\"><span class=\"n\">03</span><div><h3>What \"burnout\" does and doesn't mean</h3><p>Stress, exhaustion and when to ask for help.</p></div><span class=\"m\">9 min read</span></a></div></section>\n<section class=\"mn-sec\" style=\"padding-top:0\"><div class=\"mn-h\"><h2>Six ideas, turned over</h2><p>Tap a card to read it in plain words.</p></div><div class=\"mn-grid\"><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Confirmation bias. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 01</span><h3>Confirmation bias</h3><p>We search for what agrees with us.</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>You notice and remember information that supports what you already believe, and quietly skip the rest.</p><p style=\"color:var(--c-secondary)\">Try: ask what would change your mind.</p></span></span></button><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Sunk cost. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 02</span><h3>Sunk cost</h3><p>We stay because we've already paid.</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>Time or money already spent feels like a reason to continue, even when the future looks worse.</p><p style=\"color:var(--c-secondary)\">Try: ask whether you'd start this today.</p></span></span></button><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Spotlight effect. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 03</span><h3>Spotlight effect</h3><p>We think everyone is watching.</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>We overestimate how much others notice our mistakes, clothes and slips of the tongue.</p><p style=\"color:var(--c-secondary)\">Try: guess how many people noticed, then halve it.</p></span></span></button><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Hedonic adaptation. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 04</span><h3>Hedonic adaptation</h3><p>New things stop feeling new.</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>We return to a baseline level of happiness after good and bad changes.</p><p style=\"color:var(--c-secondary)\">Try: notice something familiar you still enjoy.</p></span></span></button><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Locus of control. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 05</span><h3>Locus of control</h3><p>Where do you think control sits?</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>People differ in whether they feel outcomes depend on themselves or on outside forces.</p><p style=\"color:var(--c-secondary)\">Try: list what is in your hands today.</p></span></span></button><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Cognitive dissonance. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 06</span><h3>Cognitive dissonance</h3><p>Two beliefs, one uncomfortable feeling.</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>When actions and beliefs clash, we are motivated to resolve the tension, sometimes by distorting the facts.</p><p style=\"color:var(--c-secondary)\">Try: say the clash out loud.</p></span></span></button></div></section><script>(function(){document.querySelectorAll(\".mn-flip\").forEach(function(b){b.onclick=function(){b.setAttribute(\"aria-pressed\",b.getAttribute(\"aria-pressed\")!==\"true\")}})})();</script>","concepts":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Concept cards</b></div><h1 style=\"font-family:var(--f-head);font-weight:500\">Concepts, in plain words</h1><p class=\"lead\">Tap a card. Each has a small thing to try.</p></div></section><section class=\"mn-sec\" style=\"padding-top:0\"><div class=\"mn-grid\"><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Confirmation bias. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 01</span><h3>Confirmation bias</h3><p>We search for what agrees with us.</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>You notice and remember information that supports what you already believe, and quietly skip the rest.</p><p style=\"color:var(--c-secondary)\">Try: ask what would change your mind.</p></span></span></button><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Sunk cost. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 02</span><h3>Sunk cost</h3><p>We stay because we've already paid.</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>Time or money already spent feels like a reason to continue, even when the future looks worse.</p><p style=\"color:var(--c-secondary)\">Try: ask whether you'd start this today.</p></span></span></button><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Spotlight effect. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 03</span><h3>Spotlight effect</h3><p>We think everyone is watching.</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>We overestimate how much others notice our mistakes, clothes and slips of the tongue.</p><p style=\"color:var(--c-secondary)\">Try: guess how many people noticed, then halve it.</p></span></span></button><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Hedonic adaptation. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 04</span><h3>Hedonic adaptation</h3><p>New things stop feeling new.</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>We return to a baseline level of happiness after good and bad changes.</p><p style=\"color:var(--c-secondary)\">Try: notice something familiar you still enjoy.</p></span></span></button><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Locus of control. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 05</span><h3>Locus of control</h3><p>Where do you think control sits?</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>People differ in whether they feel outcomes depend on themselves or on outside forces.</p><p style=\"color:var(--c-secondary)\">Try: list what is in your hands today.</p></span></span></button><button type=\"button\" class=\"mn-flip\" aria-pressed=\"false\" aria-label=\"Cognitive dissonance. Press to flip.\"><span class=\"in\"><span class=\"f\"><span>Concept 06</span><h3>Cognitive dissonance</h3><p>Two beliefs, one uncomfortable feeling.</p><span class=\"hint\">Tap to flip →</span></span><span class=\"b\"><span>In plain words</span><p>When actions and beliefs clash, we are motivated to resolve the tension, sometimes by distorting the facts.</p><p style=\"color:var(--c-secondary)\">Try: say the clash out loud.</p></span></span></button></div></section><script>(function(){document.querySelectorAll(\".mn-flip\").forEach(function(b){b.onclick=function(){b.setAttribute(\"aria-pressed\",b.getAttribute(\"aria-pressed\")!==\"true\")}})})();</script>","article":"<section class=\"mn-sec\"><article class=\"mn-narrow mn-read\"><span style=\"font:600 12px var(--f-body);letter-spacing:.16em;text-transform:uppercase;color:var(--c-accent)\">Habits · 8 min read</span><h1 style=\"font:500 clamp(34px,5vw,56px)/1.15 var(--f-head);color:var(--c-primary);margin:12px 0 0\">Why we keep doing what we regret</h1><div class=\"mn-meta\"><span>By the Mind Notes team</span><span>Reviewed by a registered psychologist (replace)</span></div>\n<p class=\"lede\">You promised yourself you wouldn't. And yet, there you are, scrolling at midnight, again. It is easy to read this as a flaw in character. Psychology offers a gentler and more useful reading.</p><p>Habits are not decisions, they are shortcuts. The brain stores a cue, a routine and a reward, and then runs them with very little attention. Regret arrives afterwards, when attention has caught up.</p>\n<blockquote>Willpower is a poor plan. A better one is to change the cue.</blockquote><h2>Cue, routine, reward</h2><p>Look at the cue first: the time, place, feeling or person that usually comes before the habit. Change one small thing about it, and the routine often loosens without a fight.</p><h2>Make the better thing easy</h2><p>Put the book on the pillow. Move the phone across the room. These are not tricks; they are how attention actually works.</p><div class=\"mn-note\">This article is educational and not a substitute for professional advice. If a habit is harming you or others, please speak to a qualified professional.</div></article></section>","checkin":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Stress check-in</b></div><h1 style=\"font-family:var(--f-head);font-weight:500\">A gentle check-in</h1><p class=\"lead\">Six statements about the last two weeks. About two minutes. Nothing is stored.</p></div></section><section class=\"mn-sec\" style=\"padding-top:0\"><div class=\"mn-narrow\"><form id=\"mn-form\" onsubmit=\"return false\"><div class=\"mn-q\"><p>1. I've felt on edge or unable to relax.</p><div class=\"sc\"><label><input type=\"radio\" name=\"q0\" value=\"0\"><span>Not at all</span></label><label><input type=\"radio\" name=\"q0\" value=\"1\"><span>A little</span></label><label><input type=\"radio\" name=\"q0\" value=\"2\"><span>Sometimes</span></label><label><input type=\"radio\" name=\"q0\" value=\"3\"><span>Often</span></label><label><input type=\"radio\" name=\"q0\" value=\"4\"><span>Almost always</span></label></div></div><div class=\"mn-q\"><p>2. I've had trouble switching my thoughts off at night.</p><div class=\"sc\"><label><input type=\"radio\" name=\"q1\" value=\"0\"><span>Not at all</span></label><label><input type=\"radio\" name=\"q1\" value=\"1\"><span>A little</span></label><label><input type=\"radio\" name=\"q1\" value=\"2\"><span>Sometimes</span></label><label><input type=\"radio\" name=\"q1\" value=\"3\"><span>Often</span></label><label><input type=\"radio\" name=\"q1\" value=\"4\"><span>Almost always</span></label></div></div><div class=\"mn-q\"><p>3. I've felt I had too much to do and too little time.</p><div class=\"sc\"><label><input type=\"radio\" name=\"q2\" value=\"0\"><span>Not at all</span></label><label><input type=\"radio\" name=\"q2\" value=\"1\"><span>A little</span></label><label><input type=\"radio\" name=\"q2\" value=\"2\"><span>Sometimes</span></label><label><input type=\"radio\" name=\"q2\" value=\"3\"><span>Often</span></label><label><input type=\"radio\" name=\"q2\" value=\"4\"><span>Almost always</span></label></div></div><div class=\"mn-q\"><p>4. I've snapped at people or felt irritable.</p><div class=\"sc\"><label><input type=\"radio\" name=\"q3\" value=\"0\"><span>Not at all</span></label><label><input type=\"radio\" name=\"q3\" value=\"1\"><span>A little</span></label><label><input type=\"radio\" name=\"q3\" value=\"2\"><span>Sometimes</span></label><label><input type=\"radio\" name=\"q3\" value=\"3\"><span>Often</span></label><label><input type=\"radio\" name=\"q3\" value=\"4\"><span>Almost always</span></label></div></div><div class=\"mn-q\"><p>5. I've found it hard to enjoy things I normally like.</p><div class=\"sc\"><label><input type=\"radio\" name=\"q4\" value=\"0\"><span>Not at all</span></label><label><input type=\"radio\" name=\"q4\" value=\"1\"><span>A little</span></label><label><input type=\"radio\" name=\"q4\" value=\"2\"><span>Sometimes</span></label><label><input type=\"radio\" name=\"q4\" value=\"3\"><span>Often</span></label><label><input type=\"radio\" name=\"q4\" value=\"4\"><span>Almost always</span></label></div></div><div class=\"mn-q\"><p>6. I've felt overwhelmed by small decisions.</p><div class=\"sc\"><label><input type=\"radio\" name=\"q5\" value=\"0\"><span>Not at all</span></label><label><input type=\"radio\" name=\"q5\" value=\"1\"><span>A little</span></label><label><input type=\"radio\" name=\"q5\" value=\"2\"><span>Sometimes</span></label><label><input type=\"radio\" name=\"q5\" value=\"3\"><span>Often</span></label><label><input type=\"radio\" name=\"q5\" value=\"4\"><span>Almost always</span></label></div></div><p style=\"margin-top:26px\"><button type=\"button\" class=\"mn-btn\" id=\"mn-go\">See my reflection</button></p></form><div class=\"mn-res\" id=\"mn-res\" aria-live=\"polite\"></div></div></section><script>(function(){var go=document.getElementById(\"mn-go\");if(!go)return;var n=6,B=[[0,.25,\"Mostly steady\",\"You reported few signs of strain. Keep the habits that are working, such as regular sleep, movement and time with people you trust.\"],[.25,.5,\"Some strain\",\"A few things are weighing on you. Small, regular rest and talking things through often help. Consider the breathing page.\"],[.5,.75,\"Quite stretched\",\"You are carrying a lot. Think about what you can put down this week, and talk to someone you trust about how things feel.\"],[.75,1.01,\"Heavily loaded\",\"Many of these have been true often. This is a good time to speak to a doctor, counsellor or someone you trust. You do not have to manage it alone.\"]];go.onclick=function(){var s=0,a=0;for(var i=0;i<n;i++){var c=document.querySelector(\"input[name=q\"+i+\"]:checked\");if(c){s+=+c.value;a++}}var r=document.getElementById(\"mn-res\");if(a<n){r.className=\"mn-res on\";r.innerHTML=\"<h3>One moment</h3><p>Please answer all \"+n+\" statements so the reflection is fair to you.</p>\";return}var f=s/(n*4),b=B.filter(function(x){return f>=x[0]&&f<x[1]})[0];r.className=\"mn-res on\";r.innerHTML=\"<div class=sc>\"+s+\" / \"+n*4+\"</div><h3>\"+b[2]+\"</h3><p>\"+b[3]+\"</p><p style=\\\"margin-top:14px;font-size:14px;color:var(--c-secondary)\\\">This is a reflection, not a diagnosis or a clinical score. If you are worried about your wellbeing, please speak to a qualified professional.</p>\";r.scrollIntoView({behavior:\"smooth\",block:\"nearest\"})}})();</script>","breathe":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Breathing space</b></div><h1 style=\"font-family:var(--f-head);font-weight:500\">A minute to breathe</h1><p class=\"lead\">Choose a pattern, press start and follow the circle.</p></div></section><section class=\"mn-sec\" style=\"padding-top:0\"><div class=\"mn-narrow\"><div class=\"mn-pat\" role=\"group\" aria-label=\"Pattern\"><button type=\"button\" aria-pressed=\"false\" data-p=\"Box 4-4-4-4\">Box 4-4-4-4</button><button type=\"button\" aria-pressed=\"true\" data-p=\"Calm 4-6\">Calm 4-6</button><button type=\"button\" aria-pressed=\"false\" data-p=\"Sleep 4-7-8\">Sleep 4-7-8</button></div><div class=\"mn-big\" aria-live=\"polite\"><div class=\"o\" id=\"mn-o\"></div><b id=\"mn-w\">Ready<small id=\"mn-c\">Press start</small></b></div><p style=\"text-align:center;margin-top:26px\"><button type=\"button\" class=\"mn-btn\" id=\"mn-s\">Start</button></p></div></section><script>(function(){var P={\"Box 4-4-4-4\": [[\"Breathe in\", 4], [\"Hold\", 4], [\"Breathe out\", 4], [\"Hold\", 4]], \"Calm 4-6\": [[\"Breathe in\", 4], [\"Breathe out\", 6]], \"Sleep 4-7-8\": [[\"Breathe in\", 4], [\"Hold\", 7], [\"Breathe out\", 8]]};var s=document.getElementById(\"mn-s\");if(!s)return;var cur=\"Calm 4-6\",run=false,t,i=0,left=0,o=document.getElementById(\"mn-o\"),w=document.getElementById(\"mn-w\"),c=document.getElementById(\"mn-c\");document.querySelectorAll(\".mn-pat button\").forEach(function(b){b.onclick=function(){document.querySelectorAll(\".mn-pat button\").forEach(function(x){x.setAttribute(\"aria-pressed\",x===b)});cur=b.dataset.p;if(run)stop()}});function show(){var st=P[cur][i];w.firstChild.textContent=st[0];c.textContent=left+\" s\";o.style.setProperty(\"--t\",st[1]+\"s\");o.classList.toggle(\"in\",/in/i.test(st[0])||(i>0&&/hold/i.test(st[0])&&/in/i.test(P[cur][i-1][0])))}function tick(){left--;if(left<=0){i=(i+1)%P[cur].length;left=P[cur][i][1]}show()}function start(){run=true;i=0;left=P[cur][0][1];s.textContent=\"Stop\";show();t=setInterval(tick,1000)}function stop(){run=false;clearInterval(t);o.classList.remove(\"in\");w.firstChild.textContent=\"Ready\";c.textContent=\"Press start\";s.textContent=\"Start\"}s.onclick=function(){run?stop():start()}})();</script>","books":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Reading list</b></div><h1 style=\"font-family:var(--f-head);font-weight:500\">Reading list</h1><p class=\"lead\">Eight books we return to. Replace with your own recommendations.</p></div></section><section class=\"mn-sec\" style=\"padding-top:0\"><div class=\"mn-bk\"><div><h3>Thinking, Fast and Slow</h3><span>Daniel Kahneman</span><p>How two systems of thought shape judgement, and where they go wrong.</p></div><div><h3>Man's Search for Meaning</h3><span>Viktor Frankl</span><p>A short, serious book about finding purpose in difficulty.</p></div><div><h3>Atomic Habits</h3><span>James Clear</span><p>Practical, cue-based ideas for changing small behaviours.</p></div><div><h3>The Body Keeps the Score</h3><span>Bessel van der Kolk</span><p>On trauma and the body. Read with care and support.</p></div></div></section>","support":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Getting support</b></div><h1 style=\"font-family:var(--f-head);font-weight:500\">Getting support</h1><p class=\"lead\">Reading is not treatment. Here is where to go when you need more.</p></div></section><section class=\"mn-sec\" style=\"padding-top:0\"><div class=\"mn-narrow mn-read\" style=\"font-size:18px\"><div class=\"mn-note\" style=\"margin-bottom:28px\"><b>If you are in immediate danger</b> or thinking about harming yourself, contact your local emergency number now, or go to the nearest emergency department.</div><h2 style=\"font-size:26px\">Talking to someone</h2><p>A family doctor or general practitioner is a good first step. They can talk with you, check for physical causes and refer you to a counsellor, psychologist or psychiatrist.</p><h2 style=\"font-size:26px\">Crisis lines</h2><p>Add your country's mental-health crisis line and hours here. Keep it visible, and test the number before you publish.</p><h2 style=\"font-size:26px\">What this site is</h2><p>Mind Notes is educational. It cannot diagnose, treat or replace professional care.</p></div></section>","about":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>About</b></div><h1 style=\"font-family:var(--f-head);font-weight:500\">About</h1></div></section><section class=\"mn-sec\" style=\"padding-top:0\"><div class=\"mn-narrow mn-read\" style=\"font-size:18px\"><p>Mind Notes is written by a small team of writers and a reviewing psychologist. We aim to be accurate, kind and honest about what we do not know. Replace this with your editors, credentials and review process.</p></div></section>","privacy":"<section class=\"pagehead alt\"><div class=\"wrap\"><div class=\"crumbs\"><a href=\"{{p:home}}\">Home</a><span>/</span><b>Privacy policy</b></div><h1 style=\"\">Privacy policy</h1></div></section><section class=\"mn-sec\" style=\"padding-top:20px\"><div class=\"prose\"><p>Replace with your privacy policy: what you collect, why, how long you keep it and how customers can ask for deletion.</p></div></section>","404":"<section class=\"mn-sec\" style=\"text-align:center;padding-top:clamp(50px,9vw,120px)\"><div class=\"mn-breath\" style=\"width:200px\" aria-hidden=\"true\"><div class=\"o\"></div><div class=\"i\"></div></div><h1 style=\"font:500 clamp(40px,7vw,80px)/1.1 var(--f-head);color:var(--c-primary);margin-top:20px\">Take a breath.</h1><p style=\"margin:12px auto 26px;font:400 19px/1.8 var(--f-body);max-width:36ch\">We couldn't find that page. It happens. Let's start again.</p><a class=\"mn-btn\" href=\"{{p:home}}\">Back to the beginning</a></section>"}}