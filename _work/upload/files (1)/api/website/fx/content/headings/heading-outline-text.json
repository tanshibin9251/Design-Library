{"css":".fx-hout{width:min(1040px,100%);display:grid;gap:.6em}\n.fx-hout .eye{font-size:.78em;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--accent)}\n.fx-hout .w{display:block;width:fit-content;max-width:100%;font:700 clamp(3em,15vw,9.5em)/1 var(--font-heading);letter-spacing:-.03em;color:transparent;-webkit-text-stroke:1.6px var(--text);background:linear-gradient(var(--primary),var(--primary)) 0 0/0% 100% no-repeat;-webkit-background-clip:text;background-clip:text;transition:background-size calc(.7s/var(--speed)) cubic-bezier(.7,0,.2,1);cursor:default;padding-bottom:.04em}\n.fx-hout .w:hover{background-size:100% 100%}\n.fx-hout .w.f{-webkit-text-stroke-color:var(--accent);background-image:linear-gradient(var(--accent),var(--accent));background-size:100% 100%}\n.fx-hout .w.f:hover{background-size:0% 100%}\n.fx-hout p{max-width:40ch;opacity:.7;margin-top:1em;font-size:1.05em}\n@media(prefers-reduced-motion:reduce){.fx-hout .w{transition:none}}\n/* touch: :hover mirrored as .is-tap */\n.fx-hout .w.is-tap{background-size:100% 100%}\n.fx-hout .w.f.is-tap{background-size:0% 100%}\n","html":"<div class=\"fx fx-hout\"><span class=\"eye\">What we do</span><span class=\"w\" role=\"presentation\">Design</span><span class=\"w f\" role=\"presentation\">Build</span><span class=\"w\" role=\"presentation\">Launch</span><p>Stroked type keeps a headline airy; the fill arrives only when you ask for it.</p></div>","js":"/* fx-touch */\n(function(){if(window.__fxTap)return;window.__fxTap=1;var cur=[];function clr(){cur.forEach(function(e){e.classList.remove('is-tap')});cur=[]}\ndocument.addEventListener('pointerdown',function(e){if(e.pointerType!=='touch')return;clr();var n=e.target.closest&&e.target.closest('.fx');if(!n)return;for(var el=e.target;el&&el!==n.parentNode;el=el.parentNode){if(el.classList){el.classList.add('is-tap');cur.push(el)}}},{passive:true});\ndocument.addEventListener('pointerup',function(){setTimeout(clr,1400)},{passive:true})})();"}