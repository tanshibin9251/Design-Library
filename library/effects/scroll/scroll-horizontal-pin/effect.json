{
 "slug": "scroll-horizontal-pin",
 "cat": "scroll",
 "name": "Horizontal scroll (pinned)",
 "zh": "纵向滚动驱动横向滚动",
 "tech": "js",
 "tag": "The section pins to the screen and a row of cards slides sideways as you keep scrolling down, then releases the page.",
 "bleed": true,
 "css": ".fx-hsc{background:var(--surface)}\n.fx-hsc .hint{opacity:.5;font-size:.85em;text-align:center;padding:2em 0}\n.fx-hsc .run{position:relative;height:calc(var(--n,5)*60vh + 40vh)}\n.fx-hsc .pin{position:sticky;top:0;height:100vh;overflow:hidden;display:flex;flex-direction:column;justify-content:center;gap:1.6em}\n.fx-hsc .hd{width:min(1100px,90%);margin:0 auto}\n.fx-hsc .hd .k{font-size:.78em;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}\n.fx-hsc .hd h2{font-size:clamp(1.8em,4.5vw,3em);margin-top:.2em}\n.fx-hsc .track{display:flex;gap:1.4em;padding:0 max(5vw,calc((100vw - 1100px)/2));width:max-content;will-change:transform;transform:translate3d(calc(var(--x,0)*-1px),0,0)}\n.fx-hsc .cd{flex:none;width:min(340px,72vw);aspect-ratio:3/4;border-radius:var(--radius);padding:1.4em;display:flex;flex-direction:column;justify-content:flex-end;color:var(--on-primary);position:relative;overflow:hidden}\n.fx-hsc .cd .fx-art{position:absolute;inset:0}\n.fx-hsc .cd>*:not(.fx-art){position:relative}\n.fx-hsc .cd small{opacity:.85;font-weight:700;letter-spacing:.14em}.fx-hsc .cd b{font:600 1.5em var(--font-heading);margin-top:.2em}.fx-hsc .cd span{opacity:.88;font-size:.92em}\n.fx-hsc .bar{width:min(1100px,90%);margin:0 auto;height:3px;border-radius:3px;background:var(--border);overflow:hidden}\n.fx-hsc .bar i{display:block;height:100%;background:var(--primary);transform-origin:left;transform:scaleX(var(--p,0))}\n@media(prefers-reduced-motion:reduce){.fx-hsc .run{height:auto}.fx-hsc .pin{position:static;height:auto;padding:3em 0}.fx-hsc .track{width:auto;overflow-x:auto;transform:none;scroll-snap-type:x mandatory}.fx-hsc .cd{scroll-snap-align:start}.fx-hsc .bar{display:none}}\n",
 "html": "<div class=\"fx fx-hsc\"><p class=\"hint\">Keep scrolling down ↓ — the cards travel sideways</p>\n<div class=\"run\" style=\"--n:5\"><div class=\"pin\"><div class=\"hd\"><span class=\"k\">Selected work</span><h2>Five projects, one scroll</h2></div>\n<div class=\"track\">\n<article class=\"cd\"><div class=\"fx-art\"></div><small>01</small><b>Harbour Café</b><span>Identity &amp; web</span></article>\n<article class=\"cd\"><div class=\"fx-art a2\"></div><small>02</small><b>Northwind</b><span>E-commerce</span></article>\n<article class=\"cd\"><div class=\"fx-art a3\"></div><small>03</small><b>Lumen Clinic</b><span>Booking system</span></article>\n<article class=\"cd\"><div class=\"fx-art\"></div><small>04</small><b>Fieldnote</b><span>Editorial site</span></article>\n<article class=\"cd\"><div class=\"fx-art a2\"></div><small>05</small><b>Orbit Fitness</b><span>Membership app</span></article></div>\n<div class=\"bar\" aria-hidden=\"true\"><i></i></div></div></div>\n<p class=\"hint\">Released — back to normal scrolling</p></div>",
 "js": "(function(){var root=document.querySelector('.fx-hsc'),run=root.querySelector('.run'),tr=root.querySelector('.track'),bar=root.querySelector('.bar i'),tk=false;\nfunction upd(){tk=false;var r=run.getBoundingClientRect(),h=r.height-innerHeight,p=h>0?Math.min(1,Math.max(0,-r.top/h)):0,max=Math.max(0,tr.scrollWidth-innerWidth);\ntr.style.setProperty('--x',p*max);bar.style.setProperty('--p',p)}\nfunction req(){if(!tk){tk=true;requestAnimationFrame(upd)}}\nif(!matchMedia('(prefers-reduced-motion:reduce)').matches){addEventListener('scroll',req,{passive:true});addEventListener('resize',req);upd()}})();"
}